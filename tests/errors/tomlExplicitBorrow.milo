// Borrows are implicit: a `&T` parameter is fed the value bare. `&"title"` is
// the mistake std/toml's own doc page used to teach, so it gets a test rather
// than a correction alone.
from "std/toml" import {
    Toml
}

pub fn main(): i32 {
    let t = Toml.parse("title = \"x\"\n")!
    let title = t.str(&"title")
    match title {
        Option.Some(s) => {
            print(s)
        }
        Option.None => {
            print("none")
        }
    }
    return 0
}
// @error: borrows are implicit
