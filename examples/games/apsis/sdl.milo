// SDL2 bindings and one frame of input, for FLYBY.
//
// Raw pointers live here and in sound.milo (the audio device queue) and nowhere
// else. Everything above — flight model, terrain, rasteriser, framebuffer — is
// safe Milo.

@link("SDL2")
pub extern fn SDL_Init(flags: u32): i32

pub extern fn SDL_CreateWindow(title: *u8, x: i32, y: i32, w: i32, h: i32, flags: u32): *u8

pub extern fn SDL_SetWindowFullscreen(win: *u8, flags: u32): i32

pub extern fn SDL_MaximizeWindow(win: *u8)

// The frame is rendered once at 1280x720 whatever the window is doing. This
// tells SDL that texture IS the picture, so RenderCopy scales it to the window
// and letterboxes to keep the aspect — without it, maximising stretches a 16:9
// frame across a 16:10 display and every circle on the HUD becomes an ellipse.
pub extern fn SDL_RenderSetLogicalSize(ren: *u8, w: i32, h: i32): i32

pub extern fn SDL_CreateRenderer(win: *u8, index: i32, flags: u32): *u8

pub extern fn SDL_CreateTexture(ren: *u8, format: u32, access: i32, w: i32, h: i32): *u8

pub extern fn SDL_UpdateTexture(tex: *u8, rect: *u8, pixels: *u8, pitch: i32): i32

pub extern fn SDL_RenderClear(ren: *u8): i32

pub extern fn SDL_RenderCopy(ren: *u8, tex: *u8, src: *u8, dst: *u8): i32

pub extern fn SDL_RenderPresent(ren: *u8): void

pub extern fn SDL_PollEvent(event: *u8): i32

pub extern fn SDL_GetKeyboardState(numkeys: *i32): *u8

pub extern fn SDL_ShowCursor(toggle: i32): i32

pub extern fn SDL_GetTicks(): u32

pub extern fn SDL_Delay(ms: u32): void

pub extern fn SDL_DestroyTexture(tex: *u8): void

pub extern fn SDL_DestroyRenderer(ren: *u8): void

pub extern fn SDL_DestroyWindow(win: *u8): void

pub extern fn SDL_Quit(): void

pub let SDL_INIT_VIDEO: u32 = 0x20

// SDL will not open an audio device unless the audio subsystem was initialised.
// Leaving this out does not error — SDL_OpenAudioDevice just returns 0, the
// Sound struct records ok=false, and every play() silently no-ops. The game runs
// perfectly and makes no noise at all.
pub let SDL_INIT_AUDIO: u32 = 0x10

pub let SDL_WINDOWPOS_CENTERED: i32 = 0x2FFF0000

pub let SDL_WINDOW_SHOWN: u32 = 0x4

pub let SDL_WINDOW_RESIZABLE: u32 = 0x20

// The borderless "fake" fullscreen: it takes the whole display at the desktop's
// own resolution rather than asking the driver for a mode change, which on macOS
// is the difference between instant and a black screen for two seconds.
pub let SDL_WINDOW_FULLSCREEN_DESKTOP: u32 = 0x1001

pub let SDL_TEXTUREACCESS_STREAMING: i32 = 1

pub let SDL_PIXELFORMAT_ABGR8888: u32 = 0x16762004

pub let SDL_QUIT: u32 = 0x100

pub let SDL_RENDERER_ACCELERATED: u32 = 0x2

pub let SDL_RENDERER_PRESENTVSYNC: u32 = 0x4

// USB HID scancodes, which is what SDL_GetKeyboardState is indexed by.
pub let SC_A: i64 = 4

pub let SC_D: i64 = 7

pub let SC_M: i64 = 16

pub let SC_F: i64 = 9

pub let SC_S: i64 = 22

pub let SC_W: i64 = 26

pub let SC_ESC: i64 = 41

pub let SC_RETURN: i64 = 40

pub let SC_SPACE: i64 = 44

pub let SC_RIGHT: i64 = 79

pub let SC_LEFT: i64 = 80

pub let SC_DOWN: i64 = 81

pub let SC_UP: i64 = 82

// One frame of input, snapshotted out of SDL so the rest of the game never
// touches a pointer.

// Mouse. The map is dragged and the maneuver handles are pulled, so unlike
// FLYBY this game needs a pointer as well as a keyboard.
pub extern fn SDL_GetMouseState(x: *i32, y: *i32): u32

pub let SC_TAB: i64 = 43

pub let SC_COMMA: i64 = 54

pub let SC_PERIOD: i64 = 55

pub let SC_P: i64 = 19

pub let SC_R: i64 = 21

pub let SC_H: i64 = 11

pub let SC_1: i64 = 30

pub let SDL_MOUSEWHEEL: u32 = 0x403

pub let SDL_BUTTON_LMASK: u32 = 1

pub struct Input {
    quit: bool,
    // Pointer position in FRAME coordinates, not window coordinates. The window
    // is resizable and the frame is a fixed 1280x720 letterboxed into it, so a
    // raw SDL mouse position is in the wrong space the moment anybody drags a
    // corner — which is exactly when a handle stops landing where it is drawn.
    mx: f64,
    my: f64,
    dragX: f64,
    dragY: f64,
    down: bool,
    pressed: bool, // edge: true only on the frame the button goes down
    released: bool,
    wheel: f64,
    // Edge-triggered keys. Everything the game does on a key is a state change,
    // and a held key that fires every frame would rewind the campaign in a third
    // of a second.
    fullscreen: bool,
    fullHeld: bool,
    pause: bool,
    pauseHeld: bool,
    warpUp: bool,
    warpUpHeld: bool,
    warpDown: bool,
    warpDownHeld: bool,
    nextFocus: bool,
    focusHeld: bool,
    plan: bool,
    planHeld: bool,
    execute: bool,
    execHeld: bool,
    reset: bool,
    resetHeld: bool,
    help: bool,
    helpHeld: bool,
}

pub fn inputNew(): Input {
    return Input {
        quit: false, mx: 0.0, my: 0.0, dragX: 0.0, dragY: 0.0,
        down: false, pressed: false, released: false, wheel: 0.0,
        fullscreen: false, fullHeld: false, pause: false, pauseHeld: false,
        warpUp: false, warpUpHeld: false, warpDown: false, warpDownHeld: false,
        nextFocus: false, focusHeld: false, plan: false, planHeld: false,
        execute: false, execHeld: false, reset: false, resetHeld: false,
        help: false, helpHeld: false,
    }
}

fn edge(now: bool, held: &mut bool): bool {
    let fired = now && !held
    held = now
    return fired
}

// Poll SDL and fill `inp`. `sx`/`sy` map window pixels onto the fixed frame.
pub fn pollInput(inp: &mut Input, ev: &mut [u8; 64], sx: f64, sy: f64, ox: f64, oy: f64) {
    inp.wheel = 0.0
    inp.pressed = false
    inp.released = false
    unsafe {
        while SDL_PollEvent(ev) != 0 {
            let evType: u32 = (ev[0] as u32) | ((ev[1] as u32) << 8) | ((ev[2] as u32) << 16) | ((ev[3] as u32) << 24)
            if evType == SDL_QUIT {
                inp.quit = true
            }
            if evType == SDL_MOUSEWHEEL {
                // SDL_MouseWheelEvent: the y delta is a signed 32-bit field at
                // offset 20. Read as little-endian bytes because the event union
                // arrives here as raw storage.
                let raw: u32 = (ev[20] as u32) | ((ev[21] as u32) << 8) | ((ev[22] as u32) << 16) | ((ev[23] as u32) << 24)
                inp.wheel = inp.wheel + (raw as i32 as f64)
            }
        }
        var wx: i32 = 0
        var wy: i32 = 0
        let buttons = SDL_GetMouseState(wx.addrOf(), wy.addrOf())
        let nx = ((wx as f64) - ox) * sx
        let ny = ((wy as f64) - oy) * sy
        let downNow = (buttons & SDL_BUTTON_LMASK) != 0
        if downNow && !inp.down {
            inp.pressed = true
            inp.dragX = 0.0
            inp.dragY = 0.0
        } else {
            if downNow {
                inp.dragX = nx - inp.mx
                inp.dragY = ny - inp.my
            } else {
                inp.dragX = 0.0
                inp.dragY = 0.0
            }
        }
        if !downNow && inp.down {
            inp.released = true
        }
        inp.down = downNow
        inp.mx = nx
        inp.my = ny

        let ks = SDL_GetKeyboardState(0 as *i32)
        if ks[SC_ESC] != 0 {
            inp.quit = true
        }
        inp.fullscreen = edge(ks[SC_F] != 0, inp.fullHeld)
        inp.pause = edge(ks[SC_SPACE] != 0, inp.pauseHeld)
        inp.warpUp = edge(ks[SC_PERIOD] != 0, inp.warpUpHeld)
        inp.warpDown = edge(ks[SC_COMMA] != 0, inp.warpDownHeld)
        inp.nextFocus = edge(ks[SC_TAB] != 0, inp.focusHeld)
        inp.plan = edge(ks[SC_P] != 0, inp.planHeld)
        inp.execute = edge(ks[SC_RETURN] != 0, inp.execHeld)
        inp.reset = edge(ks[SC_R] != 0, inp.resetHeld)
        inp.help = edge(ks[SC_H] != 0, inp.helpHeld)
    }
}
