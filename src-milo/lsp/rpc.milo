// JSON-RPC 2.0 transport over stdio, Content-Length framed — the LSP wire
// format. Mirrors src/lsp.ts's send/sendResponse/sendNotification and its
// stdin reader; that file is the oracle for the exact framing rules.
from "std/io" import {
    FdReader, writeStdout
}
from "std/json" import {
    Json, JsonObj
}

// A JSON-RPC id is either a number or a string on the wire; None marks a
// notification (no response expected). Keeping the wire shape instead of
// collapsing to string avoids handing back `"3"` for a client that sent `3`.
pub enum RpcId {
    IdNum(i64),
    IdStr(string),
    IdNone,
}

pub struct RpcMessage {
    id: RpcId,
    method: string,
    hasMethod: bool,
    params: Json,
    hasParams: bool,
}

// Send one Content-Length-framed JSON body on stdout.
pub fn send(json: string): void {
    let header = "Content-Length: " + json.len.toString() + "\r\n\r\n"
    writeStdout(header)
    writeStdout(json)
}

// `resultJson`/`paramsJson` are already-serialized JSON (build them with
// Json.obj()/Json.arr()...build(), or pass the literal "null") — spliced in
// verbatim via JsonObj.raw rather than round-tripped through JsonVal, which
// keeps every caller's own builder chain (hover markdown, diagnostics
// arrays, …) the only place that has to know its own shape.
pub fn sendResponse(id: RpcId, resultJson: string): void {
    var o = Json.obj().str("jsonrpc", "2.0")
    o = idField(o, id)
    o = o.raw("result", resultJson)
    send(o.build())
}

pub fn sendNotification(method: string, paramsJson: string): void {
    let o = Json.obj().str("jsonrpc", "2.0").str("method", method).raw("params", paramsJson)
    send(o.build())
}

fn idField(o: JsonObj, id: RpcId): JsonObj {
    match id {
        RpcId.IdNum(n) => {
            return o.int("id", n)
        }
        RpcId.IdStr(s) => {
            return o.str("id", s)
        }
        RpcId.IdNone => {
            return o.raw("id", "null")
        }
    }
}

// Extract "Content-Length: N" from the raw header bytes (case-insensitive,
// tolerant of any header ordering — only Content-Length is required by LSP).
fn parseContentLength(header: &string): i64 {
    let lower = header.toLower()
    var idx: i64 = -1
    match lower.indexOf("content-length:") {
        Option.Some(n) => {
            idx = n
        }
        Option.None => {
            return -1 as i64
        }
    }
    var i = idx + 16 // len("content-length:")
    while i < header.len && header[i] == ' ' {
        i = i + 1
    }
    var digits: string = ""
    while i < header.len && header[i] >= '0' && header[i] <= '9' {
        digits.push(header[i])
        i = i + 1
    }
    match digits.parseInt() {
        Option.Some(n) => {
            return n
        }
        Option.None => {
            return -1 as i64
        }
    }
}

// Block for one framed message on `r` (blocking fd read — the LSP process
// has nothing else to do between messages). Returns None at EOF: the client
// is supposed to send `exit` first, but a crashed client won't, so EOF must
// end the loop rather than spin re-reading a closed pipe.
pub fn readMessage(r: &FdReader): Option<string> {
    var header: string = ""
    while true {
        let b = r.readByte()
        if b < 0 {
            return Option.None
        }
        header.push(b as u8)
        if header.len >= 4 && header.endsWith("\r\n\r\n") {
            break
        }
    }
    let contentLength = parseContentLength(header)
    if contentLength < 0 {
        return Option.None
    }
    match r.readExact(contentLength) {
        Result.Ok(body) => {
            return Option.Some(body)
        }
        Result.Err(_) => {
            return Option.None
        }
    }
}

// Parse a raw JSON-RPC frame body into (id, method, params). A malformed
// body reports hasMethod=false so the dispatch loop can skip it and keep
// running — same "drop silently, stay alive" policy as the TS oracle's catch
// around JSON.parse.
pub fn parseMessage(body: string): RpcMessage {
    match Json.parse(body) {
        Result.Ok(j) => {
            var id = RpcId.IdNone
            match j.i64("id") {
                Option.Some(n) => {
                    id = RpcId.IdNum(n)
                }
                Option.None => {
                    match j.str("id") {
                        Option.Some(s) => {
                            id = RpcId.IdStr(s)
                        }
                        Option.None => {
                        }
                    }
                }
            }
            var method = ""
            var hasMethod = false
            match j.str("method") {
                Option.Some(m) => {
                    method = m
                    hasMethod = true
                }
                Option.None => {
                }
            }
            match j.get("params") {
                Option.Some(p) => {
                    return RpcMessage {
                        id: id, method: method, hasMethod: hasMethod, params: p, hasParams: true
                    }
                }
                Option.None => {
                    return RpcMessage {
                        id: id, method: method, hasMethod: hasMethod, params: j, hasParams: false
                    }
                }
            }
        }
        Result.Err(_) => {
            return RpcMessage {
                id: RpcId.IdNone, method: "", hasMethod: false, params: Json.parse("null")!, hasParams: false
            }
        }
    }
}
