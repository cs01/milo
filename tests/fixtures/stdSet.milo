// @expect: 3
// @expect: has 2
// @expect: no 5
// @expect: 2
// @expect: no 2
// @expect: 2
// @expect: has apple
// @expect: no grape

from "std/set" import {
    HashSet
}

pub fn main(): i32 {
    var s: HashSet<i32> = HashSet<i32>.new()
    s.add(1)
    s.add(2)
    s.add(3)
    s.add(2)
    print(s.len().toString())
    if s.contains(2) {
        print("has 2")
    }
    if s.contains(5) {
        print("has 5")
    } else {
        print("no 5")
    }
    s.remove(2)
    print(s.len().toString())
    if s.contains(2) {
        print("has 2")
    } else {
        print("no 2")
    }

    var words: HashSet<string> = HashSet<string>.new()
    words.add("apple")
    words.add("banana")
    words.add("apple")
    print(words.len().toString())
    if words.contains("apple") {
        print("has apple")
    }
    if words.contains("grape") {
        print("has grape")
    } else {
        print("no grape")
    }
    return 0
}
