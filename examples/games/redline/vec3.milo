// 3D vector maths. Right-handed, +Y up, metres — the same convention the range
// is laid out in and the same one GL clip space expects after `mat4.lookAt`.

from "std/math" import {
    Math
}

pub struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

impl Add for Vec3 {
    fn add(self: &Self, o: &Self): Self {
        return Vec3 {
            x: self.x + o.x, y: self.y + o.y, z: self.z + o.z
        }
    }
}

impl Sub for Vec3 {
    fn sub(self: &Self, o: &Self): Self {
        return Vec3 {
            x: self.x - o.x, y: self.y - o.y, z: self.z - o.z
        }
    }
}

impl Mul for Vec3 {
    fn mul(self: &Self, o: &Self): Self {
        return Vec3 {
            x: self.x * o.x, y: self.y * o.y, z: self.z * o.z
        }
    }
}

impl Vec3 {
    fn scale(self: &Self, k: f64): Vec3 {
        return Vec3 {
            x: self.x * k, y: self.y * k, z: self.z * k
        }
    }

    fn dot(self: &Self, o: &Vec3): f64 {
        return self.x * o.x + self.y * o.y + self.z * o.z
    }

    fn cross(self: &Self, o: &Vec3): Vec3 {
        return Vec3 {
            x: self.y * o.z - self.z * o.y,
            y: self.z * o.x - self.x * o.z,
            z: self.x * o.y - self.y * o.x,
        }
    }

    fn len(self: &Self): f64 {
        return Math.sqrt(self.dot(self))
    }

    fn len2(self: &Self): f64 {
        return self.dot(self)
    }

    // A zero-length direction is a bug upstream, and NaN would carry it a long
    // way from the cause — into a vertex buffer, where it drags a whole triangle
    // off screen and says nothing about where it came from.
    fn norm(self: &Self): Vec3 {
        let l = self.len()
        if l <= 0.0 {
            return Vec3 {
                x: 0.0, y: 0.0, z: 0.0
            }
        }
        return self.scale(1.0 / l)
    }

    fn lerp(self: &Self, o: &Vec3, t: f64): Vec3 {
        return Vec3 {
            x: self.x + (o.x - self.x) * t,
            y: self.y + (o.y - self.y) * t,
            z: self.z + (o.z - self.z) * t,
        }
    }

    // Rodrigues' rotation about a unit axis. The hinge swings a whole target rig
    // about one horizontal line, and spelling that out per component in three
    // places is how a sign error hides.
    fn rotate(self: &Self, axis: &Vec3, angle: f64): Vec3 {
        let c = Math.cos(angle)
        let s = Math.sin(angle)
        return self.scale(c) + axis.cross(self).scale(s) + axis.scale(axis.dot(self) * (1.0 - c))
    }

    fn anyPerp(self: &Self): Vec3 {
        var other = v3(0.0, 0.0, 1.0)
        if Math.abs(self.z) > 0.9 {
            other = v3(1.0, 0.0, 0.0)
        }
        return self.cross(other).norm()
    }

    fn reflect(self: &Self, n: &Vec3): Vec3 {
        return self - n.scale(2.0 * self.dot(n))
    }
}

pub fn v3(x: f64, y: f64, z: f64): Vec3 {
    return Vec3 {
        x: x, y: y, z: z
    }
}

pub fn vzero(): Vec3 {
    return Vec3 {
        x: 0.0, y: 0.0, z: 0.0
    }
}
