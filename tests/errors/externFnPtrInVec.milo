// @error: 'Ops.read' is a C function pointer and cannot be used as a value
// Storage outside the extern struct is the case that would need the thin pointer to
// become a Milo fn value. A Vec element is storage.
extern struct Ops {
    read: (*u8, i32) => i32,
}

fn bump(_p: *u8, n: i32): i32 {
    return n + 1
}

fn main() {
    let ops = Ops {
        read: bump,
    }
    var fs: Vec<(*u8, i32) => i32> = Vec.new()
    fs.push(ops.read)
    print(fs.len)
}
