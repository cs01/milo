// FLYBY — a 3D flying game written in Milo.
//
//   milo build examples/games/flight/main.milo -o /tmp/flyby --release && /tmp/flyby
//   /tmp/flyby --help
//
// San Francisco is baked into the binary (see `usage` below), so the game ships
// as one file with no asset path to get wrong.
//
// Real 3D: a perspective camera, near-plane clipping and a depth-buffered
// triangle rasteriser, all on the CPU in safe Milo (see gfx3d.milo). There is no
// GPU pipeline here — SDL only blits the finished frame.
//
// You cannot crash. The ground pushes you up if you dive into it.

from "./sdl" import {
    SDL_Init, SDL_CreateWindow, SDL_CreateRenderer, SDL_CreateTexture,
    SDL_UpdateTexture, SDL_RenderClear, SDL_RenderCopy, SDL_RenderPresent,
    SDL_ShowCursor, SDL_GetTicks, SDL_DestroyTexture, SDL_DestroyRenderer,
    SDL_DestroyWindow, SDL_Quit,
    SDL_INIT_VIDEO, SDL_INIT_AUDIO, SDL_WINDOWPOS_CENTERED, SDL_WINDOW_SHOWN,
    SDL_TEXTUREACCESS_STREAMING, SDL_PIXELFORMAT_ABGR8888,
    SDL_RENDERER_ACCELERATED, SDL_RENDERER_PRESENTVSYNC,
    inputNew, pollInput
}
from "./gfx" import {
    canvasNew, present
}
from "./gfx3d" import {
    sceneNew, viewOf
}
from "./sound" import {
    soundNew, playRing, playRingBonus, playRegion, playBoost, playMiss,
    musicTick, musicToggle
}
from "./textures" import {
    groundTexture, planeTexture
}
from "./world3d" import {
    worldIn, worldUpdate, SEED
}
from "./city" import {
    City, cityLoad, cityParse, cityEmpty, cityAttachOrtho
}
from "std/argparse" import {
    ArgParser, ParsedArgs
}
from "./render3d" import {
    drawWorld, drawHud, drawGuide, drawSpeedLines
}

pub let W: i64 = 1280

pub let H: i64 = 720

pub let EPILOG: string = "built-in places (--place):
  sf          San Francisco — hills, bay, downtown towers
  hongkong    Hong Kong — harbour, peaks straight out of the water
  rio         Rio de Janeiro — Sugarloaf, Corcovado, the beaches
  canyon      the Grand Canyon — no buildings at all, just the rock

controls:
  UP / DOWN                   pitch — the only axis; the plane steers itself
  LEFT / RIGHT                bank (--pro only)
  SPACE                       afterburner
  M                           music on / off
  ESC                         quit

Up dives and down climbs, the way a stick works; --natural flips it.
Fly through the rings. You cannot crash. Every ten rings you arrive somewhere
new — all four places are baked into the binary, so nothing is read or fetched
while flying.

Terrain: NASA SRTM (public domain). Buildings and land cover:
(c) OpenStreetMap contributors, ODbL — openstreetmap.org/copyright."

// std/argparse owns --help, unknown flags and missing values, so the game does
// not grow its own half of a CLI parser.
fn parseOpts(): ParsedArgs {
    var p = ArgParser.new("flyby", "a 3D flying game written in Milo")
    p.addString("place", "P", "Which built-in place to fly (default: a different one each launch)", "")
    p.addString("city", "c", "Fly a .city asset from disk instead of a built-in place", "")
    p.addBool("procedural", "", "Fly the endless generated world instead of a real place")
    p.addBool("pro", "p", "Give back the bank axis on LEFT / RIGHT, and the corridor")
    p.addBool("natural", "n", "UP climbs (default is stick-style: UP dives, DOWN climbs)")
    p.setEpilog(EPILOG)
    return p.parse()
}

pub let PLACES: string = "sf hongkong rio canyon"

// Every place is an @embedFile of the same bytes `--city` would read off disk,
// so the decoder cannot tell the difference. They cost about 3 MB of binary
// between them and buy a game that runs from anywhere with no asset directory
// beside it — and four landscapes instead of one.
//
// All four are embedded whichever this returns: @embedFile is resolved at
// compile time, so the branch picks bytes that are already in the binary.
fn placeBytes(name: &string): string {
    if name == "hongkong" {
        return @embedFile("cities/hongkong.city")
    }
    if name == "rio" {
        return @embedFile("cities/rio.city")
    }
    if name == "canyon" {
        return @embedFile("cities/canyon.city")
    }
    return @embedFile("cities/sf.city")
}

fn placeName(i: i64): string {
    if i == 1 {
        return "hongkong"
    }
    if i == 2 {
        return "rio"
    }
    if i == 3 {
        return "canyon"
    }
    return "sf"
}

fn placeIndex(name: &string): i64 {
    for i in 0..4 {
        if placeName(i) == name {
            return i
        }
    }
    return 0 - 1
}

// The aerial photograph for a built-in place, or "" if it has none yet. Same
// @embedFile story as the .city itself — resolved at compile time, so every arm
// is in the binary whichever this returns.
fn orthoBytes(name: &string): string {
    if name == "sf" {
        return @embedFile("cities/sf.ortho.png")
    }
    if name == "canyon" {
        return @embedFile("cities/canyon.ortho.png")
    }
    // Hong Kong and Rio have none: NAIP is a USDA survey and stops at the US
    // border, and the open global alternative (Sentinel-2 via EOX) serves JPEG,
    // which nothing here can decode. They fall back to the land-cover palette.
    return ""
}

fn parsePlace(name: &string): City {
    match cityParse(placeBytes(name)) {
        Result.Ok(city) => {
            var c = city
            let png = orthoBytes(name)
            if png != "" {
                match cityAttachOrtho(c, png) {
                    Result.Ok(_) => {
                    }
                    Result.Err(e) => {
                        print("built-in place '" + name + "' has a bad ortho: " + e)
                    }
                }
            }
            return c
        }
        Result.Err(e) => {
            print("built-in place '" + name + "' is corrupt: " + e)
            return cityEmpty()
        }
    }
}

// Every built-in place, starting from `first` and wrapping. The world flies the
// head of this list and rotates the rest in, one per region change — so a run
// crosses four real places instead of mirroring one forever. Which one you
// start on comes off the wall clock, so two launches in a row are not the same
// flight.
fn allPlaces(first: i64): Vec<City> {
    var v: Vec<City> = Vec.new()
    for k in 0..4 {
        v.push(parsePlace(placeName((first + k) % 4)))
    }
    return v
}

// A .city file from disk, or an empty city (the procedural world) if it will
// not load. Only failure says anything on the terminal — the place's name is on
// the HUD the moment the window opens, which is where a player is looking.
fn loadFile(path: &string): City {
    match cityLoad(path) {
        Result.Ok(city) => {
            return city
        }
        Result.Err(e) => {
            print("could not load city: " + e)
            return cityEmpty()
        }
    }
}

fn placesFor(o: &ParsedArgs): Vec<City> {
    var v: Vec<City> = Vec.new()
    if o.getBool("procedural") {
        v.push(cityEmpty())
        return v
    }
    let path = o.getString("city")
    if path != "" {
        v.push(loadFile(path))
        return v
    }
    let want = o.getString("place")
    if want == "" {
        // Start on the place that has an aerial photograph, so the first thing
        // anyone sees on a bare `milo run` is the drape rather than the palette.
        // The rotation still carries the other three in behind it.
        return allPlaces(placeIndex("sf"))
    }
    let idx = placeIndex(want)
    if idx < 0 {
        print("no built-in place called '" + want + "' — try: " + PLACES)
        v.push(cityEmpty())
        return v
    }
    // An explicit --place is a request to fly THAT place, so nothing rotates in
    // behind it.
    v.push(parsePlace(want))
    return v
}

pub fn main(): i32 {
    let o = parseOpts()
    var places = placesFor(o)
    let easy = !o.getBool("pro")
    let invert = !o.getBool("natural")
    if SDL_Init(SDL_INIT_VIDEO | SDL_INIT_AUDIO) != 0 {
        print("SDL_Init failed")
        return 1
    }
    var win: *u8 = 0 as *u8
    var ren: *u8 = 0 as *u8
    var tex: *u8 = 0 as *u8
    var ok = true
    unsafe {
        let title = "FLYBY — written in Milo"
        win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, W as i32, H as i32, SDL_WINDOW_SHOWN)
        ren = SDL_CreateRenderer(win, 0 - 1, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC)
        tex = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING, W as i32, H as i32)
        if (win as i64) == 0 || (ren as i64) == 0 || (tex as i64) == 0 {
            ok = false
        }
        let _ = SDL_ShowCursor(0)
    }
    if !ok {
        print("SDL setup failed")
        return 2
    }

    var c = canvasNew(W, H)
    var s = sceneNew(W, H)
    var w = worldIn(SEED, places, easy)
    let groundTex = groundTexture()
    let skinTex = planeTexture()
    var snd = soundNew()
    var inp = inputNew(invert)
    var ev: [u8; 64] = [0; 64]
    var last = SDL_GetTicks()
    var fpsAccum: f64 = 0.0
    var fpsFrames: i64 = 0
    var fpsShown: i64 = 0

    while !inp.quit {
        let now = SDL_GetTicks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        if dt > 0.05 {
            dt = 0.05
        }
        if dt < 0.0005 {
            dt = 0.0005
        }
        pollInput(inp, ev)

        if inp.mute {
            musicToggle(snd)
        }
        musicTick(snd)

        worldUpdate(w, dt, inp.moveX, inp.moveY, inp.boost)
        let view = viewOf(w.cam, c.w, c.h)
        drawWorld(c, s, w, groundTex, skinTex, view)

        fpsAccum = fpsAccum + dt
        fpsFrames = fpsFrames + 1
        if fpsAccum > 0.5 {
            fpsShown = ((fpsFrames as f64) / fpsAccum) as i64
            fpsAccum = 0.0
            fpsFrames = 0
        }
        if w.evRing {
            playRing(snd)
        }
        if w.evBonus {
            playRingBonus(snd)
        }
        if w.evRegion {
            playRegion(snd)
        }
        if w.evBoost {
            playBoost(snd)
        }
        if w.evMiss {
            playMiss(snd)
        }
        drawSpeedLines(c, w)
        drawGuide(c, w, view)
        drawHud(c, w, s, fpsShown)

        var exposure = 1.0
        if w.flash > 0.0 {
            exposure = 1.0 + w.flash * 0.8
        }
        present(c, 0.35, exposure)

        unsafe {
            SDL_UpdateTexture(tex, 0 as *u8, c.fb[0].addrOf() as *u8, (W * 4) as i32)
            SDL_RenderClear(ren)
            SDL_RenderCopy(ren, tex, 0 as *u8, 0 as *u8)
            SDL_RenderPresent(ren)
        }
    }
    // Tear down in creation order's reverse. SDL_Quit would reclaim all of it
    // anyway, but a leak an example teaches is a leak someone copies.
    SDL_DestroyTexture(tex)
    SDL_DestroyRenderer(ren)
    SDL_DestroyWindow(win)
    SDL_Quit()
    return 0
}
