// Baseline: scan JSON, materialize every string literal as an OWNED string.
// Same generator + scanner as the span version; only "what we keep" differs.
from "std/time" import {
    epochMillis
}
from "std/fmt" import {
    join
}

fn genDoc(records: i64): string {
    var parts: Vec<string> = Vec.withCapacity(records + 2)
    parts.push("[")
    var i: i64 = 0
    while i < records {
        let id = i.toString()
        var pad = ""
        var z = id.len
        while z < 6 {
            pad = pad + "0"
            z = z + 1
        }
        var rec = ""
        if i > 0 {
            rec = ","
        }
        rec = rec + "{\"name\":\"user_" + pad + id + "\",\"mail\":\"user_" + pad + id
        + "@example.com\",\"note\":\"lorem ipsum dolor sit amet " + pad + id + "\"}"
        parts.push(rec)
        i = i + 1
    }
    parts.push("]")
    return join(parts, "")
}

pub fn main(): i32 {
    let records: i64 = 500000
    let doc = genDoc(records)
    print("doc bytes=" + doc.len.toString())

    let t0 = epochMillis()
    var values: Vec<string> = Vec.new()
    var i: i64 = 0
    let n = doc.len
    while i < n {
        if doc[i] == 34 {
            let start = i + 1
            var j = start
            while j < n {
                if doc[j] == 34 {
                    break
                }
                j = j + 1
            }
            values.push(doc[start..j].clone()) // alloc + memcpy per literal
            i = j + 1
        } else {
            i = i + 1
        }
    }

    var sum: i64 = 0
    for v in values {
        var k: i64 = 0
        while k < v.len {
            sum = sum + (v[k] as i64)
            k = k + 1
        }
    }
    let t1 = epochMillis()
    print("owned ms=" + (t1 - t0).toString() + " strings=" + values.len.toString() + " sum=" + sum.toString())
    return 0
}
