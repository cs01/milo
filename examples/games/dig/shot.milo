// Headless capture: drives the digger on a scripted path and dumps PPM frames.
// Also a deterministic smoke test for worldgen and the drill.

from "std/math" import {
    Math
}
from "std/args" import {
    args
}
from "./gfx" import {
    Canvas, canvasNew, present
}
from "./world" import {
    Mine, mineNew, mineUpdate, TILE
}
from "./render" import {
    drawMine, drawHud
}

pub extern fn fopen(path: *u8, mode: *u8): *u8

pub extern fn fwrite(ptr: *u8, size: i64, count: i64, stream: *u8): i64

pub extern fn fclose(stream: *u8): i32

pub let W: i64 = 1280

pub let H: i64 = 720

fn writePpm(path: &string, c: &Canvas) {
    var rgb: Vec<u8> = Vec.filled(W * H * 3, 0)
    for i in 0..W * H {
        let px = c.fb[i]
        rgb[i * 3] = (px & 0xFF) as u8
        rgb[i * 3 + 1] = ((px >> 8) & 0xFF) as u8
        rgb[i * 3 + 2] = ((px >> 16) & 0xFF) as u8
    }
    let header = "P6\n" + W.toString() + " " + H.toString() + "\n255\n"
    unsafe {
        let f = fopen(path.cstr(), "wb".cstr())
        if (f as i64) == 0 {
            print("cannot open " + path)
            return
        }
        let _ = fwrite(header.cstr(), 1, header.len, f)
        let _ = fwrite(rgb.ptr() as *u8, 1, W * H * 3, f)
        let _ = fclose(f)
    }
}

pub fn main(): i32 {
    let argv = args()
    var prefix = "/tmp/prospect"
    if argv.len > 1 {
        prefix = argv[1]
    }
    var shots: Vec<i64> = Vec.new()
    for i in 2..argv.len {
        shots.push(argv[i].parseInt())
    }
    if shots.len == 0 {
        shots.push(300)
        shots.push(1500)
    }
    var maxFrame: i64 = 0
    for i in 0..shots.len {
        maxFrame = Math.maxI64(maxFrame, shots[i])
    }

    var c = canvasNew(W, H)
    var m = mineNew()
    let dt = 1.0 / 60.0

    for frame in 0..maxFrame + 1 {
        // Dig down for a while, then east, alternating — a plausible tunnel.
        // Once the door opens, steer at it: that turns this from a worldgen smoke
        // test into an end-to-end one that actually finishes a level.
        var ix = 0.0
        var iy = 0.0
        if m.exitOpen {
            let dx = ((m.exitX as f64) + 0.5) * TILE - m.px
            let dy = ((m.gateY as f64) + 0.5) * TILE - m.py
            if Math.abs(dx) > Math.abs(dy) {
                ix = if dx > 0.0 {
                    1.0
                } else {
                    0.0 - 1.0
                }
            } else if Math.abs(dy) > 4.0 {
                iy = if dy > 0.0 {
                    1.0
                } else {
                    0.0 - 1.0
                }
            }
        } else {
            // down, right, down, left — a sweep rather than a single corner to
            // wedge itself into once it runs out of map
            let phase = (frame / 150) % 4
            if phase == 0 || phase == 2 {
                iy = 1.0
            } else if phase == 1 {
                ix = 1.0
            } else {
                ix = 0.0 - 1.0
            }
        }
        mineUpdate(m, dt, ix, iy, W as f64, H as f64)

        var want = false
        for i in 0..shots.len {
            if shots[i] == frame {
                want = true
            }
        }
        if want {
            drawMine(c, m, 0.0, 0.0)
            drawHud(c, m)
            present(c, 0.18, 1.0)
            writePpm(prefix + "-" + frame.toString() + ".ppm", c)
            print("wrote " + prefix + "-" + frame.toString() + ".ppm")
        }
    }
    print("level " + m.level.toString() + " value " + m.score.toString() + " gold " + m.gold.toString() + " gems " + m.gems.toString() + " depth " + m.deepest.toString())
    return 0
}
