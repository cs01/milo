// Drawing the map.
//
// One camera, one scale factor, and everything expressed relative to whatever
// the player is looking at. The solar system spans eleven orders of magnitude
// between a parking orbit and Saturn's, which no single set of world coordinates
// survives in an f32 depth buffer — so nothing is ever drawn in absolute metres.
// Positions are made camera-relative and scaled by 1/camDist FIRST, in f64, and
// only then handed to the rasteriser, which therefore always sees a scene about
// one unit across whatever the zoom is doing.

from "std/math" import {
    Math
}
from "std/strconv" import {
    formatFloat
}
from "./vec3" import {
    Vec3, v3
}
from "./gfx" import {
    Canvas, canvasFill, text, textCentered, textWidth, fillRect, line, thickLine, spot, shadeRect
}
from "./gfx3d" import {
    Camera, Scene, View, sceneClear, viewOf, frameOf, rasterFlush
}
from "./raster" import {
    Texture, texHasImage
}
from "./sphere" import {
    drawSphere, drawGlowSphere, drawRings, segmentsFor, spinOf, Spin
}
from "./ephem" import {
    Body, bodyPos, dateOf, SEC_PER_DAY, AU, BODY_COUNT, SUN, EARTH, MOON, SATURN
}
from "./nbody" import {
    Ship, Ephem, ephemPos, ephemVel, propagate, orbitAbout, dominantBody, Orbit
}
from "./world" import {
    World, shipAbout, shipOrbit, currentCapture, CURVE_N, camDistNow, camPitchNow, arrivalEstimate,
    VIEW_DEPART, VIEW_ROUTE, VIEW_ARRIVE
}
from "./mission" import {
    MISSION_COUNT
}

pub let W: i64 = 1280

pub let H: i64 = 720

// ── camera ────────────────────────────────────────────────────────────────────

pub struct Map {
    view: View,
    focus: Vec3, // world position the camera orbits, metres
    k: f64, // world metres -> render units
}

// The view basis is built here rather than by `viewOf`, because that one takes
// yaw and pitch about a Y-up world and the solar system is Z-up: the ecliptic is
// the XY plane and north is +Z. Feeding it these angles put the ecliptic on edge
// and sent every planet's orbit across the screen as a straight line.
pub fn mapOf(w: &World): Map {
    var focus = ephemPos(w.e, w.focus, w.t)
    if w.focus < 0 {
        focus = w.ship.pos
    }
    let k = 1.0 / camDistNow(w)
    let pitch = camPitchNow(w)
    let cp = Math.cos(pitch)
    // Unit vector from the focus toward the camera.
    let dir = v3(Math.cos(w.camYaw) * cp, Math.sin(w.camYaw) * cp, Math.sin(pitch))
    let eye = dir
    let fwd = dir.scale(-1.0)
    var right = fwd.cross(v3(0.0, 0.0, 1.0))
    if right.len() < 1.0e-9 {
        right = v3(1.0, 0.0, 0.0)
    }
    right = right.norm()
    let up = right.cross(fwd).norm()
    let scale = (H as f64) * 0.5 / Math.tan(0.35)
    return Map {
        view: View {
            right: right, up: up, fwd: fwd, eye: eye,
            scale: scale, cx: (W as f64) * 0.5, cy: (H as f64) * 0.5,
            near: 1.0e-5, far: 1.0e7,
        }
        ,
        focus: focus, k: k
    }
}

pub fn toRender(m: &Map, p: &Vec3): Vec3 {
    return (p - m.focus).scale(m.k)
}

// Project a render-space point to the screen. `z` is depth along the view
// direction; anything at or behind the near plane is reported as z <= 0 and the
// caller must drop it, because the projection divides by z.
pub struct Proj {
    x: f64,
    y: f64,
    z: f64,
}

pub fn project(m: &Map, rp: &Vec3): Proj {
    let d = rp - m.view.eye
    let cx = d.dot(m.view.right)
    let cy = d.dot(m.view.up)
    let cz = d.dot(m.view.fwd)
    if cz <= m.view.near {
        return Proj {
            x: 0.0, y: 0.0, z: cz
        }
    }
    return Proj {
        x: m.view.cx + cx * m.view.scale / cz,
        y: m.view.cy - cy * m.view.scale / cz,
        z: cz,
    }
}

// ── polylines ─────────────────────────────────────────────────────────────────

// Draw a world-space polyline, clipping each segment against the near plane.
//
// Clipping matters here more than it would in a normal scene: an orbit is a
// closed loop around the camera's own focus, so a good fraction of it is behind
// the viewer at any zoom where the orbit is bigger than the screen. Dropping
// whole segments instead of clipping them makes an orbit flicker in and out as
// the camera turns.
fn polyline(c: &mut Canvas, m: &Map, pts: &Vec<Vec3>, from: i64, to: i64, r: f64, g: f64, b: f64, wide: f64) {
    var i = from
    while i < to - 1 {
        let a = toRender(m, pts[i])
        let bb = toRender(m, pts[i + 1])
        drawSeg(c, m, a, bb, r, g, b, wide)
        i = i + 1
    }
}

// The same polyline drawn three times, wide and faint underneath, narrow and
// bright on top. The canvas is additive and gets a bloom pass at present time,
// so the overlap reads as a glow around the path rather than as three lines —
// it is the cheapest way to make a trajectory look like it is emitting light
// instead of being a wire.
fn glowline(c: &mut Canvas, m: &Map, pts: &Vec<Vec3>, r: f64, g: f64, b: f64) {
    let n = pts.len as i64
    polyline(c, m, pts, 0, n, r * 0.16, g * 0.16, b * 0.16, 7.0)
    polyline(c, m, pts, 0, n, r * 0.34, g * 0.34, b * 0.34, 3.4)
    polyline(c, m, pts, 0, n, r, g, b, 1.6)
}

fn drawSeg(c: &mut Canvas, m: &Map, a: &Vec3, b: &Vec3, r: f64, g: f64, bl: f64, wide: f64) {
    var p0 = a
    var p1 = b
    let d0 = (p0 - m.view.eye).dot(m.view.fwd)
    let d1 = (p1 - m.view.eye).dot(m.view.fwd)
    let near = m.view.near
    if d0 <= near && d1 <= near {
        return
    }
    if d0 <= near {
        let t = (near - d0) / (d1 - d0)
        p0 = p0 + (p1 - p0).scale(t)
    }
    if d1 <= near {
        let t = (near - d1) / (d0 - d1)
        p1 = p1 + (p0 - p1).scale(t)
    }
    let s0 = project(m, p0)
    let s1 = project(m, p1)
    if s0.z <= 0.0 || s1.z <= 0.0 {
        return
    }
    // Off-screen by a wide margin on both ends: skip rather than hand the
    // rasteriser a segment kilometres long in screen space.
    if (s0.x < -4000.0 && s1.x < -4000.0) || (s0.x > 5200.0 && s1.x > 5200.0) {
        return
    }
    if (s0.y < -4000.0 && s1.y < -4000.0) || (s0.y > 4700.0 && s1.y > 4700.0) {
        return
    }
    if wide <= 1.0 {
        line(c, s0.x, s0.y, s1.x, s1.y, r, g, bl)
    } else {
        thickLine(c, s0.x, s0.y, s1.x, s1.y, wide, r, g, bl)
    }
}

// A body's own orbit, one full revolution, straight from the analytic elements
// rather than from the sampled grid — Saturn's period is longer than the whole
// campaign, so the grid cannot hold a lap of it.
fn drawBodyOrbit(c: &mut Canvas, m: &Map, w: &World, id: i64, r: f64, g: f64, b: f64) {
    let parent = w.bodies[id].parent
    if id == SUN {
        return
    }
    var period = 0.0
    if id == MOON {
        period = 27.32 * SEC_PER_DAY
    } else {
        let a = w.bodies[id].el.a
        period = Math.pi() * 2.0 * Math.sqrt(a * a * a / w.bodies[SUN].mu)
    }
    let n = 128
    var prev = v3(0.0, 0.0, 0.0)
    var i = 0
    while i <= n {
        let tt = w.t + period * (i as f64) / (n as f64)
        var p = bodyPos(w.bodies, id, tt)
        if id == MOON {
            // The Moon's path is drawn about the Earth, not about the Sun:
            // over one lunar month the Earth moves thirty times further than
            // the Moon does around it, so the heliocentric track is a barely
            // wavy line and tells the player nothing.
            p = bodyPos(w.bodies, EARTH, w.t) + (p - bodyPos(w.bodies, EARTH, tt))
        }
        let rp = toRender(m, p)
        if i > 0 {
            drawSeg(c, m, prev, rp, r, g, b, 1.0)
        }
        prev = rp
        i = i + 1
    }
    let _ = parent
}

// ── the scene ─────────────────────────────────────────────────────────────────

fn sunDirAt(w: &World, p: &Vec3): Vec3 {
    return (v3(0.0, 0.0, 0.0) - p).norm()
}

pub fn drawScene(c: &mut Canvas, s: &mut Scene, w: &World, texes: &Vec<Texture>) {
    canvasFill(c, 0.004, 0.006, 0.014)
    sceneClear(s)
    let m = mapOf(w)
    drawStars(c, w)

    // Orbit tracks first, so bodies and the ship draw over them.
    // Only the orbits worth seeing at this zoom. A track a hundred times wider
    // than the view is not a curve on screen, it is a straight line across it,
    // and eight of them turn a planet into a cat's cradle. One two-hundredth of
    // the view and it is a dot under the body it belongs to.
    var i = 1
    while i < BODY_COUNT {
        var size = w.bodies[i].el.a
        if i == MOON {
            size = 384400.0e3
        }
        let rel = size / w.camDist
        if rel < 60.0 && rel > 0.02 {
            var k = 0.16
            if i == w.missions[w.mission].to {
                k = 0.42
            }
            if i == w.missions[w.mission].from {
                k = 0.30
            }
            // Fade in at both ends so an orbit does not pop as the player zooms.
            var fade = 1.0
            if rel > 20.0 {
                fade = (60.0 - rel) / 40.0
            }
            if rel < 0.10 {
                fade = (rel - 0.02) / 0.08
            }
            k = k * fade
            drawBodyOrbit(c, m, w, i, k * 0.55, k * 0.72, k)
        }
        i = i + 1
    }

    drawShipTrack(c, m, w)
    drawBodies(c, s, m, w, texes)
    rasterFlush(c, s)
    drawBodyLabels(c, m, w)
    drawShip(c, m, w)
}

// A fixed star field, so that turning the camera reads as turning rather than as
// nothing happening. Positions come from a hash rather than a table: at this
// brightness they are texture, not constellations.
fn drawStars(c: &mut Canvas, w: &World) {
    let m = mapOf(w)
    var i = 0
    while i < 400 {
        let h = ((i * 2654435761) % 100000) as f64 / 100000.0
        let h2 = ((i * 40503 + 7919) % 100000) as f64 / 100000.0
        let lon = h * Math.pi() * 2.0
        let lat = (h2 - 0.5) * Math.pi()
        let dir = v3(Math.cos(lat) * Math.cos(lon), Math.cos(lat) * Math.sin(lon), Math.sin(lat))
        let p = project(m, m.view.eye + dir.scale(100.0))
        if p.z > 0.0 && p.x >= 0.0 && p.x < (W as f64) && p.y >= 0.0 && p.y < (H as f64) {
            let b = 0.10 + 0.30 * (((i * 31) % 97) as f64 / 97.0)
            spot(c, p.x, p.y, 0.8, b, b, b * 1.1)
        }
        i = i + 1
    }
}

fn drawBodies(c: &mut Canvas, s: &mut Scene, m: &Map, w: &World, texes: &Vec<Texture>) {
    var i = 0
    while i < BODY_COUNT {
        let wp = ephemPos(w.e, i, w.t)
        let rp = toRender(m, wp)
        let rad = w.bodies[i].radius * m.k
        let dist = (rp - m.view.eye).len()
        if dist > 0.0 {
            let pix = rad * m.view.scale / dist
            if i == SUN {
                if pix < 2.0 {
                    let p = project(m, rp)
                    if p.z > 0.0 {
                        spot(c, p.x, p.y, 2.6, 3.0, 2.6, 1.6)
                    }
                } else {
                    drawGlowSphere(s, m.view, rp, rad, 3.4, 2.9, 2.0, segmentsFor(pix))
                }
            } else {
                if pix < 1.6 {
                    // Too small to be a sphere: a dot with a floor on its size,
                    // because a planet that vanishes at solar-system zoom makes
                    // the map useless exactly when it is most needed.
                    let p = project(m, rp)
                    if p.z > 0.0 {
                        let col = bodyTint(i)
                        spot(c, p.x, p.y, 1.7, col.x * 0.9, col.y * 0.9, col.z * 0.9)
                    }
                } else {
                    let sp = spinOf(w.t, w.bodies[i].day, w.bodies[i].tilt)
                    let sd = sunDirAt(w, wp)
                    if i == SATURN {
                        drawRings(s, m.view, rp, rad * 1.24, rad * 2.27, sp, segmentsFor(pix) * 2, 1.0)
                    }
                    if texHasImage(texes[i]) {
                        // Tinted well above 1. These are real albedo maps and
                        // real albedo is dark — open ocean reflects about six
                        // per cent, so a physically honest exposure renders the
                        // Earth almost black. The photograph is the subject
                        // here, not a lighting simulation.
                        drawSphere(s, m.view, texes[i], rp, rad, sd, sp, segmentsFor(pix), 0.05, 2.9)
                    } else {
                        drawGlowSphere(s, m.view, rp, rad, 0.5, 0.5, 0.55, segmentsFor(pix))
                    }
                }
            }
        }
        i = i + 1
    }
}

fn bodyTint(id: i64): Vec3 {
    if id == 1 {
        return v3(0.62, 0.58, 0.54)
    }
    if id == 2 {
        return v3(0.92, 0.78, 0.50)
    }
    if id == 3 {
        return v3(0.42, 0.66, 0.95)
    }
    if id == 4 {
        return v3(0.70, 0.70, 0.72)
    }
    if id == 5 {
        return v3(0.90, 0.48, 0.32)
    }
    if id == 6 {
        return v3(0.86, 0.74, 0.58)
    }
    return v3(0.88, 0.82, 0.62)
}

// A label with a plate behind it. Over a star field, unbacked text at scale 2 is
// legible; over the terminator of a planet or on top of another label it is not,
// and both happen constantly on this map.
fn plate(c: &mut Canvas, x: i64, y: i64, s: &string, scale: i64, r: f64, g: f64, b: f64) {
    let wdt = textWidth(s, scale) as f64
    let hgt = (8 * scale) as f64
    shadeRect(c, (x as f64) - 6.0, (y as f64) - 4.0, (x as f64) + wdt + 6.0, (y as f64) + hgt + 6.0, 0.62)
    text(c, x, y, s, scale, r, g, b)
}

fn drawBodyLabels(c: &mut Canvas, m: &Map, w: &World) {
    // The target and the body under the camera both carry their own, larger
    // markers; labelling them here as well printed two strings in the same spot.
    let skip = w.missions[w.mission].to
    var i = 0
    while i < BODY_COUNT {
        if false {
            let rp = toRender(m, ephemPos(w.e, i, w.t))
            let p = project(m, rp)
            if p.z > 0.0 && p.x > -40.0 && p.x < (W as f64) + 40.0 && p.y > 0.0 && p.y < (H as f64) {
                let t = bodyTint(i)
                var k = 0.55
                if i == w.missions[w.mission].to {
                    k = 1.0
                }
                plate(c, (p.x + 12.0) as i64, (p.y - 8.0) as i64, w.bodies[i].name.toUpper(), UI, t.x * k, t.y * k, t.z * k)
            }
        }
        i = i + 1
    }
}

// The ship: its planned trajectory, its current orbit, and a marker.
fn drawShipTrack(c: &mut Canvas, m: &Map, w: &World) {
    // The osculating orbit it is on right now, integrated rather than drawn from
    // a conic — it is the same code that flies the ship, so what is drawn is
    // what happens, including the parts a conic would get wrong.
    let about = shipAbout(w)
    let ob = orbitAbout(w.e, w.ship, w.t, about)
    var span = 3.0 * 3600.0
    if ob.closed {
        span = ob.period
    }
    if span > 400.0 * SEC_PER_DAY {
        span = 400.0 * SEC_PER_DAY
    }
    let live = propagate(w.e, w.ship, w.t, span, 200, 0 - 1)
    glowline(c, m, live.pts, 0.22, 0.80, 0.95)

    if (w.trackValid || w.preview) && !w.captured {
        // The plan, brighter and thicker. Two lines on the map at once is the
        // whole point: one is where you are going, the other is where you would
        // go if you did nothing.
        let n = w.track.pts.len as i64
        glowline(c, m, w.track.pts, 1.0, 0.66, 0.22)
        // Label the path itself, at its midpoint, so it reads as "this is where
        // you are going" and not as decoration.
        if n > 4 {
            let mid = toRender(m, w.track.pts[n / 2])
            let mp = project(m, mid)
            if mp.z > 0.0 {
                plate(c, (mp.x + 16.0) as i64, (mp.y - 30.0) as i64, "YOUR TRANSFER  " + fmtSpan(w.planTof), UI, 1.0, 0.78, 0.34)
            }
        }
        // The two burns, marked on the path where they happen and priced. These
        // are the only two moments in the whole mission that cost anything, and
        // before this they were invisible.
        if n > 1 {
            let dp = project(m, toRender(m, w.track.pts[0]))
            if dp.z > 0.0 {
                burnMark(c, dp.x, dp.y, 0.35, 0.95, 1.0)
                plate(c, (dp.x + 16.0) as i64, (dp.y - 10.0) as i64, "DEPARTURE BURN  " + fmtDv(w.planEjDv), UI, 0.45, 0.95, 1.0)
            }
        }
        if w.track.caDist > 0.0 && w.track.caDist < 1.0e12 {
            let to = w.missions[w.mission].to
            let cp = ephemPos(w.e, to, w.track.caTime)
            let p = project(m, toRender(m, cp))
            if p.z > 0.0 {
                burnMark(c, p.x, p.y, 1.0, 0.62, 0.25)
                plate(c, (p.x + 16.0) as i64, (p.y + 12.0) as i64, "CAPTURE BURN  " + fmtDv(arrivalEstimate(w, w.track)), UI, 1.0, 0.74, 0.34)
            }
        }
    }
}

// A burn: a bright core with a halo, so it reads as an event on the path rather
// than as another circle among the markers.
fn burnMark(c: &mut Canvas, cx: f64, cy: f64, r: f64, g: f64, b: f64) {
    spot(c, cx, cy, 16.0, r * 0.30, g * 0.30, b * 0.30)
    spot(c, cx, cy, 6.0, r * 1.6, g * 1.6, b * 1.6)
    circleOutline(c, cx, cy, 11.0, r, g, b)
}

fn circleOutline(c: &mut Canvas, cx: f64, cy: f64, rad: f64, r: f64, g: f64, b: f64) {
    var i = 0
    while i < 24 {
        let a0 = Math.pi() * 2.0 * (i as f64) / 24.0
        let a1 = Math.pi() * 2.0 * ((i + 1) as f64) / 24.0
        line(c, cx + Math.cos(a0) * rad, cy + Math.sin(a0) * rad, cx + Math.cos(a1) * rad, cy + Math.sin(a1) * rad, r, g, b)
        i = i + 1
    }
}

fn drawShip(c: &mut Canvas, m: &Map, w: &World) {
    let p = project(m, toRender(m, w.ship.pos))
    if p.z <= 0.0 {
        return
    }
    spot(c, p.x, p.y, 2.4, 2.4, 2.6, 2.2)
    circleOutline(c, p.x, p.y, 7.0, 0.5, 0.95, 1.0)
    plate(c, (p.x + 14.0) as i64, (p.y + 6.0) as i64, "YOU", UI, 0.55, 0.95, 1.0)
}

// ── the sequential ramp ───────────────────────────────────────────────────────

// One hue, dark to bright, for a magnitude. Cheap is bright and expensive is
// nearly the background, which is the right way round on a dark canvas: the eye
// goes to the valley, and the valley is the answer.
//
// Not a rainbow. Porkchop plots are traditionally drawn in one, and a rainbow
// encodes magnitude as hue, which has no perceptual order — readers cannot tell
// which of two colours is larger without consulting the legend every time, and
// it collapses entirely for a red-green colourblind reader. A single hue ramped
// in lightness is monotonic for everyone.
pub fn rampColor(f: f64): Vec3 {
    var x = f
    if x < 0.0 {
        x = 0.0
    }
    if x > 1.0 {
        x = 1.0
    }
    // Cyan through to deep indigo, with the chroma easing off at the dark end so
    // the expensive corner recedes instead of vibrating against the background.
    let l = 1.0 - x
    let r = 0.06 + 0.30 * l * l
    let g = 0.10 + 0.85 * l
    let b = 0.22 + 0.75 * l * (0.5 + 0.5 * l)
    return v3(r * (0.3 + 0.9 * l), g, b)
}

// ── HUD ───────────────────────────────────────────────────────────────────────

pub fn fmtDate(t: f64): string {
    let d = dateOf(t)
    let y = d / 10000
    let mo = (d / 100) % 100
    let da = d % 100
    var s = y.toString() + "-"
    if mo < 10 {
        s = s + "0"
    }
    s = s + mo.toString() + "-"
    if da < 10 {
        s = s + "0"
    }
    return s + da.toString()
}

pub fn fmtDv(v: f64): string {
    if v >= 1000.0 {
        return formatFloat(v / 1000.0, 2) + " km/s"
    }
    return formatFloat(v, 0) + " m/s"
}

pub fn fmtDist(d: f64): string {
    if d > 0.02 * AU {
        return formatFloat(d / AU, 3) + " AU"
    }
    if d > 1.0e6 {
        return formatFloat(d / 1000.0, 0) + " km"
    }
    return formatFloat(d / 1000.0, 1) + " km"
}

pub fn fmtSpan(s: f64): string {
    if s >= 2.0 * SEC_PER_DAY {
        return formatFloat(s / SEC_PER_DAY, 1) + " d"
    }
    if s >= 3600.0 {
        return formatFloat(s / 3600.0, 1) + " h"
    }
    return formatFloat(s / 60.0, 0) + " min"
}

fn warpLabel(v: f64): string {
    if v >= 1000000.0 {
        return formatFloat(v / 1000000.0, 1) + "M x"
    }
    if v >= 1000.0 {
        return formatFloat(v / 1000.0, 0) + "k x"
    }
    return formatFloat(v, 0) + " x"
}

// Everything is drawn at scale 2 or 3. Scale 1 is a 6-pixel glyph, which is
// legible on a 1280x720 frame viewed at 1280x720 and is not legible at all once
// the window is stretched across a 5K display — which is how anyone actually
// runs it.
pub let UI: i64 = 2

pub let UI_BIG: i64 = 3

fn row(c: &mut Canvas, x: i64, y: i64, s: &string, r: f64, g: f64, b: f64) {
    text(c, x, y, s, UI, r, g, b)
}

// Deliberately thin.
//
// The first version put a plan panel, an orbit panel, a fuel panel, a window bar
// and two help lines on screen at once, and the verdict on it was the correct
// one: you could not see the Earth. Everything that is merely INTERESTING has
// been cut, and what is left is the four things a decision needs — where you are
// going, when it is, what it costs, and what to press.
pub fn drawHud(c: &mut Canvas, w: &World) {
    let m = w.mission
    text(c, 16, 14, w.bodies[w.missions[m].from].name.toUpper() + "  TO  " + w.bodies[w.missions[m].to].name.toUpper(), UI_BIG, 0.95, 0.98, 1.0)
    text(c, 16, 50, viewName(w) + "        TAB  CHANGE VIEW", UI, 0.50, 0.60, 0.70)

    let dstr = fmtDate(w.t)
    text(c, W - 18 - textWidth(dstr, UI_BIG), 14, dstr, UI_BIG, 0.92, 0.95, 1.0)
    var wl = "PAUSED"
    if !w.paused {
        wl = warpLabel(w.warp)
    }
    text(c, W - 18 - textWidth(wl, UI), 50, wl, UI, 0.62, 0.74, 0.86)

    drawBudget(c, w)
    drawTargetMarker(c, w)
    drawScrubBar(c, w)
    drawActionBar(c, w)
    drawMessage(c, w)
}

fn viewName(w: &World): string {
    if w.view == VIEW_DEPART {
        return "VIEW: " + w.bodies[w.missions[w.mission].from].name.toUpper()
    }
    if w.view == VIEW_ARRIVE {
        return "VIEW: " + w.bodies[w.missions[w.mission].to].name.toUpper()
    }
    return "VIEW: ROUTE"
}

fn drawBudget(c: &mut Canvas, w: &World) {
    var left = (w.budget - w.spent) / w.budget
    if left < 0.0 {
        left = 0.0
    }
    let y = (H - 42) as f64
    fillRect(c, 16.0, y, 296.0, y + 16.0, 0.08, 0.10, 0.14)
    var br = 0.30
    var bg = 0.85
    var bb = 0.95
    if left < 0.25 {
        br = 0.95
        bg = 0.55
        bb = 0.25
    }
    let fw = 280.0 * left
    if fw > 0.0 {
        fillRect(c, 16.0, y, 16.0 + fw, y + 16.0, br, bg, bb)
    }
    text(c, 16, (y - 26.0) as i64, "FUEL  " + fmtDv(w.budget - w.spent), UI, 0.72, 0.80, 0.88)
}

// Where the target is, when it is not on screen.
//
// The first thing a new player does is look for the Moon, and at the opening
// zoom the Moon is sixty screens away. Without this the map is a planet and a
// void, and the honest reaction is the one this got: no idea what to do.
fn drawTargetMarker(c: &mut Canvas, w: &World) {
    let to = w.missions[w.mission].to
    let m = mapOf(w)
    let wp = ephemPos(w.e, to, w.t)
    let p = project(m, toRender(m, wp))
    let dist = (wp - w.ship.pos).len()
    let label = w.bodies[to].name + "  " + fmtDist(dist)
    let onScreen = p.z > 0.0 && p.x > 60.0 && p.x < (W - 60) as f64 && p.y > 100.0 && p.y < (H - 140) as f64
    if onScreen {
        circleOutline(c, p.x, p.y, 16.0, 1.0, 0.80, 0.30)
        circleOutline(c, p.x, p.y, 18.0, 1.0, 0.80, 0.30)
        plate(c, (p.x - (textWidth(label, UI) as f64) * 0.5) as i64, (p.y - 46.0) as i64, label, UI, 1.0, 0.86, 0.42)
        return
    }
    // Off screen: clamp a marker to the frame edge in the target's direction and
    // say how far away it is.
    var dx = p.x - (W as f64) * 0.5
    var dy = p.y - (H as f64) * 0.5
    if p.z <= 0.0 {
        // Behind the camera: the projection is meaningless, so point with the
        // camera-space direction instead of the projected one.
        let d = toRender(m, wp) - m.view.eye
        dx = d.dot(m.view.right)
        dy = 0.0 - d.dot(m.view.up)
    }
    let len = Math.sqrt(dx * dx + dy * dy)
    if len < 1.0e-9 {
        return
    }
    let ux = dx / len
    let uy = dy / len
    let cx = (W as f64) * 0.5 + ux * 300.0
    let cy = (H as f64) * 0.5 + uy * 240.0
    circleOutline(c, cx, cy, 12.0, 1.0, 0.80, 0.30)
    circleOutline(c, cx, cy, 5.0, 1.0, 0.80, 0.30)
    var lx = (cx + 22.0) as i64
    if ux < 0.0 {
        lx = (cx - 22.0) as i64 - textWidth(label, UI)
    }
    plate(c, lx, (cy - 8.0) as i64, label, UI, 1.0, 0.86, 0.42)
}

// The bottom strip is three fixed panels: fuel on the left, the launch window in
// the middle, the orbit on the right. They are laid out from constants rather
// than eyeballed because the first version put the window bar straight through
// the orbit readout, and at scale 2 there is no room to be approximate.
pub let BAR_X: f64 = 340.0

pub let BAR_W: f64 = 600.0

pub let BAR_Y: f64 = 640.0

pub let BAR_H: f64 = 34.0

// The launch window as one curve you scrub along.
//
// This is the porkchop plot with the second axis held still: cost against
// departure date, at the flight time currently chosen. A grid of five thousand
// cells is the complete picture and it is also a wall of colour to somebody who
// has never seen one — a curve with a low point in it needs no explaining, and
// the trajectory in the sky redraws as the marker moves, so the connection
// between "this date" and "that path" is shown rather than described.
fn drawScrubBar(c: &mut Canvas, w: &World) {
    if w.committed || w.won || w.failed {
        return
    }
    if w.curve.len == 0 {
        return
    }
    text(c, BAR_X as i64, (BAR_Y - 26.0) as i64, "LEAVE ON", UI, 0.50, 0.60, 0.70)
    let lab = "TAKE " + fmtSpan(w.planTof)
    text(c, (BAR_X + BAR_W) as i64 - textWidth(lab, UI), (BAR_Y - 26.0) as i64, lab, UI, 0.50, 0.60, 0.70)

    // The curve is clipped at three times the best cost: past that everything is
    // equally out of the question, and letting one impossible date set the scale
    // flattens the useful part into a straight line.
    let lo = w.curveBest
    var hi = w.curveBest * 3.0
    if w.curveWorst < hi && w.curveWorst > lo {
        hi = w.curveWorst
    }
    var i = 0
    while i < CURVE_N {
        let x = BAR_X + BAR_W * (i as f64) / ((CURVE_N - 1) as f64)
        let cw = BAR_W / (CURVE_N as f64) + 1.0
        let cost = w.curve[i]
        if cost < 1.0e29 {
            var f = (cost - lo) / (hi - lo)
            if f > 1.0 {
                f = 1.0
            }
            let col = rampColor(f)
            let h = BAR_H * (1.0 - f * 0.88)
            fillRect(c, x, BAR_Y + BAR_H - h, x + cw, BAR_Y + BAR_H, col.x * 0.55, col.y * 0.55, col.z * 0.55)
            // A hot rim along the top of the fill. The eye follows the bright
            // edge, and the bright edge is the shape of the answer.
            fillRect(c, x, BAR_Y + BAR_H - h, x + cw, BAR_Y + BAR_H - h + 3.0, col.x * 2.2, col.y * 2.2, col.z * 2.2)
        }
        i = i + 1
    }

    // Where the cheapest departure is, so the target is visible rather than
    // hunted for.
    let bx = BAR_X + BAR_W * (w.curveBestI as f64) / ((CURVE_N - 1) as f64)
    thickLine(c, bx, BAR_Y - 6.0, bx, BAR_Y + BAR_H + 4.0, 1.5, 0.25, 0.95, 0.65)

    // The marker.
    let t0 = w.missions[w.mission].windowOpen
    let span = w.missions[w.mission].windowSpan
    var f = (w.planDep - t0) / span
    if f < 0.0 {
        f = 0.0
    }
    if f > 1.0 {
        f = 1.0
    }
    let mx = BAR_X + BAR_W * f
    thickLine(c, mx, BAR_Y - 12.0, mx, BAR_Y + BAR_H + 10.0, 2.5, 1.0, 0.85, 0.35)
    let cur = cursorCost(w, f)
    var costLab = "NO TRANSFER"
    if cur < 1.0e29 {
        costLab = fmtDv(cur)
    }
    let dl = fmtDate(w.planDep) + "   " + costLab
    var lx = (mx - (textWidth(dl, UI) as f64) * 0.5) as i64
    if (lx as f64) < BAR_X {
        lx = BAR_X as i64
    }
    if (lx as f64) + (textWidth(dl, UI) as f64) > BAR_X + BAR_W {
        lx = (BAR_X + BAR_W) as i64 - textWidth(dl, UI)
    }
    text(c, lx, (BAR_Y + BAR_H + 6.0) as i64, dl, UI, 1.0, 0.88, 0.42)
}

fn cursorCost(w: &World, f: f64): f64 {
    var i = (f * ((CURVE_N - 1) as f64)) as i64
    if i < 0 {
        i = 0
    }
    if i >= CURVE_N {
        i = CURVE_N - 1
    }
    return w.curve[i]
}

// The single most important line on the screen: what to press next.
//
// Everything else here is instrumentation, and instrumentation only helps
// somebody who already knows what they are doing. This is the one element that
// assumes the opposite.
fn drawActionBar(c: &mut Canvas, w: &World) {
    if w.won || w.failed {
        return
    }
    var msg = ""
    var sub = ""
    var r = 1.0
    var g = 0.82
    var b = 0.35
    if !w.planValid {
        msg = "SLIDE THE DATE WITH  LEFT / RIGHT,  THEN PRESS  ENTER"
        sub = "the bar below is what it costs to leave on each day — taller and brighter is cheaper"
    } else {
        if !w.committed {
            msg = "PRESS  ENTER  TO COMMIT  (" + fmtDv(w.planDv) + ")"
            sub = "or LEFT / RIGHT to move the date, UP / DOWN the flight time"
        } else {
            let cap = currentCapture(w)
            let to = w.missions[w.mission].to
            let dist = (ephemPos(w.e, to, w.t) - w.ship.pos).len()
            if cap.possible && dist < w.bodies[to].radius * 60.0 {
                msg = "PRESS  ENTER  TO CAPTURE  (" + fmtDv(cap.dv) + ")"
                sub = "burn now — this is the cheapest moment you will get"
                r = 0.40
                g = 0.95
                b = 0.95
            } else {
                msg = "PRESS  .  TO SPEED UP TIME"
                sub = "coasting to " + w.bodies[to].name + " — arrive " + fmtDate(w.planDep + w.planTof)
            }
        }
    }
    let tw = textWidth(msg, UI_BIG)
    let sw = textWidth(sub, UI)
    var boxW = tw
    if sw > boxW {
        boxW = sw
    }
    let cx = (W / 2) as f64
    let y0 = (H - 210) as f64
    shadeRect(c, cx - (boxW as f64) * 0.5 - 26.0, y0, cx + (boxW as f64) * 0.5 + 26.0, y0 + 76.0, 0.72)
    textCentered(c, W / 2, (y0 + 12.0) as i64, msg, UI_BIG, r, g, b)
    textCentered(c, W / 2, (y0 + 48.0) as i64, sub, UI, 0.70, 0.78, 0.86)
}

fn drawMessage(c: &mut Canvas, w: &World) {
    if w.messageAge > 6.0 || w.message.len == 0 {
        return
    }
    var a = 1.0
    if w.messageAge > 4.5 {
        a = (6.0 - w.messageAge) / 1.5
    }
    let tw = textWidth(w.message, UI_BIG)
    shadeRect(c, ((W / 2) as f64) - (tw as f64) * 0.5 - 20.0, 96.0, ((W / 2) as f64) + (tw as f64) * 0.5 + 20.0, 144.0, 0.6 * a)
    textCentered(c, W / 2, 104, w.message, UI_BIG, a, a * 0.95, a * 0.85)
}

pub fn drawOutcome(c: &mut Canvas, w: &World) {
    if !w.won && !w.failed {
        return
    }
    shadeRect(c, 0.0, 0.0, W as f64, H as f64, 0.78)
    if w.won {
        textCentered(c, W / 2, 250, "CAPTURED", 6, 0.35, 0.95, 0.95)
        textCentered(c, W / 2, 340, w.bodies[w.missions[w.mission].to].name + " ORBIT ACHIEVED", UI_BIG, 0.88, 0.92, 0.96)
        textCentered(c, W / 2, 380, fmtDv(w.budget - w.spent) + " STILL IN THE TANK", UI, 0.70, 0.80, 0.88)
        if w.mission + 1 < MISSION_COUNT {
            textCentered(c, W / 2, 440, "ENTER  FOR " + w.missions[w.mission + 1].name, UI_BIG, 1.0, 0.82, 0.35)
        } else {
            textCentered(c, W / 2, 440, "THAT WAS THE LAST ONE. ALL SIX.", UI_BIG, 1.0, 0.82, 0.35)
        }
    } else {
        textCentered(c, W / 2, 270, "MISSION LOST", 6, 0.95, 0.40, 0.30)
        textCentered(c, W / 2, 370, w.message, UI, 0.85, 0.85, 0.85)
        textCentered(c, W / 2, 430, "R  TO TRY AGAIN", UI_BIG, 0.82, 0.88, 0.94)
    }
}
