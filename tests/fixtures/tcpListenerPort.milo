// @skip-os: win32
// Windows is skipped for the same reason as ioSocketStream and tcpIpv6: TcpListener
// needs the IOCP async tier that the Windows port does not have yet (docs/roadmap.md
// lists Windows as core language + std/io only). Without the skip this fixture just
// prints nothing there, which reads as a compiler fault rather than a missing tier.
//
// `bind(0)` asks the OS for an ephemeral port; without `port()` the caller had no
// way to learn which one it got, so every test and ephemeral server hardcoded a
// number and hoped. TlsListener has had this since the TLS server landed —
// TcpListener did not, which is how the postgres client's tests ended up pinned
// to a fixed port.
from "std/net" import {
    TcpListener
}

// @expect: true
// @expect: true
pub fn main(): i32 {
    let l = TcpListener.bind(0)!
    let p = l.port()
    print((p > 1024).toString())
    // Two listeners must not be handed the same port.
    let m = TcpListener.bind(0)!
    print((m.port() != p).toString())
    return 0
}
