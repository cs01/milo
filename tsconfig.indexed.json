// `noUncheckedIndexedAccess` turned ON, for the ratchet in
// tests/uncheckedIndexRatchet.test.ts. The base tsconfig keeps it off because switching it
// on wholesale would mean ~900 `arr[i]!` assertions, and an assertion silences the check
// rather than proving anything — so this config exists to MEASURE the debt and force it
// down, not to gate the build. See docs/backlog.md.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
