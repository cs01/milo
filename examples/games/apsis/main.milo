// APSIS — plan a trajectory between worlds, under real gravity.
//
//   milo build examples/games/apsis/main.milo -o /tmp/apsis --release && /tmp/apsis
//
// Six missions, from the Moon out to Saturn. You never type a velocity: you pick
// a departure date and a flight time off a heat map, the game works out the
// burn, and the dotted line it draws is the one the integrator will actually
// fly, because the prediction and the flight are the same code (see nbody.milo).
//
// The physics is Newton's, summed over every body at once. The claim is
// executable — `tools/checkphysics.milo` flies the whole Earth-to-Mars mission
// headless and prints what it cost.

from "std/math" import {
    Math
}
from "std/time" import {
    epochMillis
}
from "./sdl" import {
    Input, inputNew, pollInput,
    SDL_Init, SDL_CreateWindow, SDL_CreateRenderer, SDL_CreateTexture,
    SDL_UpdateTexture, SDL_RenderClear, SDL_RenderCopy, SDL_RenderPresent,
    SDL_ShowCursor, SDL_GetTicks, SDL_Delay, SDL_DestroyTexture, SDL_DestroyRenderer,
    SDL_SetWindowFullscreen, SDL_MaximizeWindow, SDL_RenderSetLogicalSize,
    SDL_WINDOW_RESIZABLE, SDL_WINDOW_FULLSCREEN_DESKTOP,
    SDL_DestroyWindow, SDL_Quit,
    SDL_INIT_VIDEO, SDL_WINDOWPOS_CENTERED, SDL_WINDOW_SHOWN,
    SDL_TEXTUREACCESS_STREAMING, SDL_PIXELFORMAT_ABGR8888,
    SDL_RENDERER_ACCELERATED, SDL_RENDERER_PRESENTVSYNC
}
from "./gfx" import {
    Canvas, canvasNew, present, textCentered, text
}
from "./gfx3d" import {
    Scene, sceneNew
}
from "./assets" import {
    loadBodyTextures
}
from "./ephem" import {
    SEC_PER_DAY, BODY_COUNT, SUN
}
from "./world" import {
    World, worldNew, startMission, resetMission, replan, commitPlan, doCapture,
    advanceWorld, buildPorkchop, porkDep, porkTof, say, currentCapture
}
from "./render" import {
    W, H, drawScene, drawHud, drawOutcome, drawPorkchop,
    PORK_X, PORK_Y, PORK_W, PORK_H
}
from "./mission" import {
    MISSION_COUNT
}

// Warp steps, in seconds of simulation per second of wall clock. Geometric
// rather than linear because the interesting timescales are: a burn is seconds,
// a lunar transfer is days, and a Saturn cruise is years.
fn warpSteps(): Vec<f64> {
    var v: Vec<f64> = Vec.new()
    v.push(1.0)
    v.push(60.0)
    v.push(600.0)
    v.push(3600.0)
    v.push(21600.0)
    v.push(86400.0)
    v.push(432000.0)
    v.push(2160000.0)
    return v
}

fn warpIndex(steps: &Vec<f64>, cur: f64): i64 {
    var best = 0
    var i = 0
    while i < steps.len {
        if Math.abs(steps[i] - cur) < Math.abs(steps[best] - cur) {
            best = i
        }
        i = i + 1
    }
    return best
}

pub fn main(): i32 {
    unsafe {
        if SDL_Init(SDL_INIT_VIDEO) != 0 {
            print("SDL_Init failed")
            return 1
        }
    }
    var win = 0 as *u8
    var ren = 0 as *u8
    var tex = 0 as *u8
    unsafe {
        let title = "APSIS — written in Milo"
        win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, W as i32, H as i32, SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE)
        ren = SDL_CreateRenderer(win, -1, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC)
        // The frame is always 1280x720 and SDL letterboxes it into whatever the
        // window becomes, so dragging a corner costs nothing — the software
        // renderer never resizes.
        SDL_RenderSetLogicalSize(ren, W as i32, H as i32)
        tex = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING, W as i32, H as i32)
    }

    var c = canvasNew(W, H)
    var scene = sceneNew(W, H)
    print("decoding planet maps ...")
    let texes = loadBodyTextures()
    var w = worldNew()
    var inp = inputNew()
    var ev: [u8; 64] = [0; 64]
    let steps = warpSteps()
    var full = false
    var last = 0
    unsafe {
        last = SDL_GetTicks() as i64
    }
    say(w, w.missions[0].name.clone())

    var running = true
    while running {
        var now = 0
        unsafe {
            now = SDL_GetTicks() as i64
        }
        var dt = ((now - last) as f64) / 1000.0
        last = now
        // A long stall — the first frame after decoding 23 MB of imagery, or a
        // window drag — must not be handed to the integrator as a real time
        // step, or the ship jumps a month at high warp.
        if dt > 0.1 {
            dt = 0.1
        }

        pollInput(inp, ev, 1.0, 1.0, 0.0, 0.0)
        if inp.quit {
            running = false
        }
        if inp.fullscreen {
            full = !full
            unsafe {
                if full {
                    SDL_SetWindowFullscreen(win, SDL_WINDOW_FULLSCREEN_DESKTOP)
                } else {
                    SDL_SetWindowFullscreen(win, 0)
                }
            }
        }

        if w.showPork {
            handlePorkchop(w, inp)
        } else {
            handleMap(w, inp, steps)
            advanceWorld(w, dt)
        }

        drawScene(c, scene, w, texes)
        drawHud(c, w)
        if w.showPork {
            drawPorkchop(c, w, inp.mx, inp.my)
        }
        drawOutcome(c, w)
        present(c, 0.30, 1.0)
        unsafe {
            SDL_UpdateTexture(tex, 0 as *u8, c.fb[0].addrOf() as *u8, (W * 4) as i32)
            SDL_RenderClear(ren)
            SDL_RenderCopy(ren, tex, 0 as *u8, 0 as *u8)
            SDL_RenderPresent(ren)
        }
    }

    unsafe {
        SDL_DestroyTexture(tex)
        SDL_DestroyRenderer(ren)
        SDL_DestroyWindow(win)
        SDL_Quit()
    }
    return 0
}

fn handleMap(w: &mut World, inp: &Input, steps: &Vec<f64>) {
    // Camera. Dragging turns it; the wheel zooms, geometrically, because the
    // useful range spans a parking orbit to Saturn's and a linear zoom would
    // spend its whole travel in the first hundredth of that.
    if inp.down {
        w.camYaw = w.camYaw - inp.dragX * 0.005
        w.camPitch = w.camPitch + inp.dragY * 0.005
        let lim = Math.pi() * 0.49
        if w.camPitch > lim {
            w.camPitch = lim
        }
        if w.camPitch < -lim {
            w.camPitch = -lim
        }
    }
    if inp.wheel != 0.0 {
        w.camDist = w.camDist * Math.pow(0.86, inp.wheel)
        if w.camDist < 2.0e6 {
            w.camDist = 2.0e6
        }
        if w.camDist > 4.0e12 {
            w.camDist = 4.0e12
        }
    }
    if inp.nextFocus {
        var f = w.focus + 1
        if f >= BODY_COUNT {
            f = 0
        }
        w.focus = f
        // Reframe: each body wants a wildly different default zoom, and landing
        // on Jupiter with the Moon's camera distance shows nothing at all.
        w.camDist = w.bodies[f].radius * 12.0
        if f == SUN {
            w.camDist = 3.0e11
        }
    }
    if inp.pause {
        w.paused = !w.paused
    }
    if inp.warpUp || inp.warpDown {
        var i = warpIndex(steps, w.warp)
        if inp.warpUp {
            i = i + 1
        }
        if inp.warpDown {
            i = i - 1
        }
        if i < 0 {
            i = 0
        }
        if i >= steps.len {
            i = steps.len - 1
        }
        w.warp = steps[i]
        w.paused = false
    }
    if inp.reset {
        resetMission(w)
    }
    if inp.plan {
        if !w.committed {
            buildPorkchop(w, 96, 60)
            w.showPork = true
        } else {
            say(w, "already under way — R to start over")
        }
    }
    if inp.execute {
        if w.won {
            if w.mission + 1 < MISSION_COUNT {
                startMission(w, w.mission + 1)
            }
        } else {
            if w.failed {
                resetMission(w)
            } else {
                if w.committed {
                    doCapture(w)
                } else {
                    commitPlan(w)
                }
            }
        }
    }
}

fn handlePorkchop(w: &mut World, inp: &Input) {
    if inp.plan || inp.quit {
        w.showPork = false
        // ESC closes the plot rather than the game: quitting out of a menu by
        // accident, in a game whose whole state is one plan, is unforgivable.
        return
    }
    if inp.pressed && w.porkW > 0 {
        let cw = PORK_W / (w.porkW as f64)
        let ch = PORK_H / (w.porkH as f64)
        if inp.mx >= PORK_X && inp.mx < PORK_X + PORK_W && inp.my >= PORK_Y && inp.my < PORK_Y + PORK_H {
            let i = ((inp.mx - PORK_X) / cw) as i64
            let j = w.porkH - 1 - (((inp.my - PORK_Y) / ch) as i64)
            if i >= 0 && i < w.porkW && j >= 0 && j < w.porkH {
                w.planDep = porkDep(w, i)
                w.planTof = porkTof(w, j)
                replan(w)
                w.showPork = false
            }
        }
    }
}
