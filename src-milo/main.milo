    startServer
}

// The stdlib root is the directory *containing* `std/` (resolvePath joins it with
// "std/io.milo"), not `std/` itself. Mirrors src/resolver.ts: MILO_ROOT wins,
// otherwise walk up from the source file looking for std/prelude.milo.
// Intermediate artifact paths must be unique per process: `bun test` compiles
// fixtures concurrently, and a shared /tmp/milo_out.ll had every milo-self build
// clobbering its neighbours.
pub extern fn getpid(): i32

// "compiled <src> -> <out> in <t>" with colour on a TTY, plain when piped or
// redirected. Mirrors reportCompiled in src/main.ts — the two compilers are
// supposed to be indistinguishable from the outside, and a missing timing plus
// missing colour is the kind of difference a user notices immediately even
// though no test compares CLI output.
pub fn reportCompiled(source: &string, out: &string, elapsedMs: i64) {
    var t = elapsedMs.toString() + "ms"
    if elapsedMs >= 1000 {
        // Two decimal places, without a float formatter: 7523ms -> "7.52s".
        let whole = elapsedMs / 1000
        let hundredths = (elapsedMs % 1000) / 10
        var frac = hundredths.toString()
        if hundredths < 10 {
            frac = "0" + frac
        }
        t = whole.toString() + "." + frac + "s"
    }
    // fd 1 is stdout. Piping must stay plain so `| tail` and log capture do not
    // collect escape codes.
    if fdIsTerminal(1) {
        let green = "\u{1b}[32m"
        let bold = "\u{1b}[1m"
        let dim = "\u{1b}[2m"
        let reset = "\u{1b}[0m"
        print(green + bold + "compiled" + reset + " " + source.clone() + " " + dim + "->" + reset + " " + bold + out.clone() + reset + " " + dim + "in" + reset + " " + green + t + reset)
    } else {
        print("compiled " + source.clone() + " -> " + out.clone() + " in " + t)
    }
}

pub fn tmpPath(stem: &string, ext: &string): string {
    var p = "/tmp/milo_"
    p = p + stem.clone()
    p = p + "_"
    p = p + getpid().toString()
    return p + ext.clone()
}

pub fn findStdlibRoot(sourceDir: &string): string {
    match Env.get("MILO_ROOT") {
        Option.Some(root) => {
            return root
        }
        Option.None => {
        }
    }
    var dir = sourceDir.clone()
    var depth: i64 = 0
    while depth < 32 {
        if pathExists(Path.join(dir, "std/prelude.milo")) {
            return dir
        }
        let parent = Path.dirname(dir.clone())
        if parent == dir {
            break
        }
        dir = parent
        depth = depth + 1
    }
    return sourceDir.clone()
}

// compile() has to hand back more than the IR text: `@link` names are discovered
// during resolution and are needed by the LINK step, which happens in the driver.
// Returning them alongside keeps the discovery in one place rather than having the
// driver re-scan emitted IR for library names it can only guess at.
pub struct Compiled {
    ir: string,
    linkLibs: Vec<string>,
}

pub fn compile(path: string): Compiled {
    var source = ""
    match readFile(path.clone()) {
        Result.Ok(s) => {
            source = s
        }
        Result.Err(e) => {
            eprint("error: cannot read file '" + path + "'")
            exit(1)
        }
    }

    // Lex
    let tokens = tokenize(source)

    // Parse
    var parser = newParser(tokens, path.clone())
    let program = parse(parser)

    // Resolve imports
    let target = getHostTarget()
    let sourceDir = Path.dirname(path.clone())
    let stdlibDir = findStdlibRoot(sourceDir.clone())
    let resolved = resolveImports(program, sourceDir.clone(), stdlibDir, target.os)

    // Type check
    var checker = newChecker()
    checkProgram(checker, resolved)
    if hasErrors(checker) {
        for i in 0..checker.diagnostics.len {
            let d = checker.diagnostics[i]
            if d.severity == "error" {
                var loc = ""
                match d.span {
                    Option.Some(s) => {
                        // s.file is the span's OWN file — a diagnostic from an imported
                        // module (e.g. std/strconv.milo) must render against that file,
                        // not the entry point `path`, or the location lies.
                        loc = s.file.clone() + ":" + s.line.toString() + ":" + s.col.toString() + ": "
                    }
                    Option.None => {
                    }
                }
                eprint(loc + "error: " + d.message.clone())
                if d.hint.len > 0 {
                    eprint("  hint: " + d.hint.clone())
                }
            }
        }
        exit(1)
    }

    // Codegen: monomorphized decls become ordinary program declarations
    var finalProg = resolved
    for i in 0..checker.monomorphizedEnums.len {
        finalProg.enums.push(checker.monomorphizedEnums[i].clone())
    }
    for i in 0..checker.monomorphizedStructs.len {
        finalProg.structs.push(checker.monomorphizedStructs[i].clone())
    }
    for i in 0..checker.monomorphizedFns.len {
        finalProg.functions.push(checker.monomorphizedFns[i].clone())
    }
    let libs = finalProg.linkLibs.clone()
    return Compiled {
        ir: genProgram(finalProg, sourceDir), linkLibs: libs
    }
}

// Scan the emitted IR for extern symbols that need a link library, mirroring the
// TS driver's detectLibs. Only SSL/crypto/sqlite are auto-linked.
pub fn detectLibs(ir: &string, os: &string, declared: &Vec<string>, sdlFlags: &string): string {
    var libs = ""
    // Libraries the SOURCE asked for via `@link("SDL2")`. Sniffing the IR for known
    // symbol prefixes (below) can only ever recognise libraries the compiler was
    // taught about by name; `@link` lets a program name its own, which is what every
    // SDL example relies on. On darwin the Homebrew prefix is not on the default
    // search path, so it has to be added or the -l resolves to nothing.
    for i in 0..declared.len {
        let name = declared[i].clone()
        // sdl2-config knows the framework soup SDL2 needs on darwin; a bare -lSDL2
        // links but leaves Cocoa/Metal symbols undefined.
        if name == "SDL2" && sdlFlags.len > 0 {
            libs = libs + " " + sdlFlags.clone()
        } else if os == "darwin" {
            libs = libs + " -L/opt/homebrew/lib -l" + name
        } else {
            libs = libs + " -l" + name
        }
    }
    if ir.contains("@SSL_") || ir.contains("@TLS_client_method") {
        if os == "darwin" {
            libs = libs + " -L/opt/homebrew/opt/openssl@3/lib -lssl -lcrypto"
        } else {
            libs = libs + " -lssl -lcrypto"
        }
    }
    if !libs.contains("-lcrypto") && (ir.contains("@SHA256") || ir.contains("@MD5")) {
        libs = libs + " -lcrypto"
    }
    if ir.contains("@sqlite3_") {
        if os == "darwin" {
            libs = libs + " -L/opt/homebrew/opt/sqlite/lib -lsqlite3"
        } else {
            libs = libs + " -lsqlite3"
        }
    }
    return libs
}

// `sdl2-config --libs` is the only reliable source for SDL2's darwin link line —
// it expands to the Cocoa/Metal/CoreAudio frameworks the dylib actually needs.
// Empty string when SDL2 was not requested or the tool is absent, in which case
// detectLibs falls back to a plain -lSDL2.
pub fn sdlConfigFlags(declared: &Vec<string>): string {
    var wants = false
    for i in 0..declared.len {
        if declared[i] == "SDL2" {
            wants = true
        }
    }
    if !wants {
        return ""
    }
    let out = tmpPath("sdlcfg", ".txt")
    match run("sdl2-config --libs > " + out.clone() + " 2>/dev/null") {
        Result.Ok(code) => {
            if code != 0 {
                return ""
            }
        }
        Result.Err(_) => {
            return ""
        }
    }
    match readFile(out) {
        Result.Ok(text) => {
            return text.trim()
        }
        Result.Err(_) => {
            return ""
        }
    }
}

// Link LLVM IR with clang when available, otherwise mirror the TS driver's
// llc + system C compiler path. Some Linux dev hosts ship LLVM tools without a
// clang frontend; linking already-emitted IR does not require that frontend.
// `extra` mirrors src/main.ts's extraLinkFlags: raw, space-prefixed text spliced
// straight into the link command (companion .c/.o/.a translation units, mainly).
pub fn linkIr(irFile: &string, output: &string, libs: &string, extra: &string): i32 {
    let objFile = irFile.clone() + ".o"
    let command = "if command -v clang >/dev/null 2>&1; then clang -Wno-override-module -O2 -o " + output.clone() + " " + irFile.clone() + libs.clone() + extra.clone() + "; else llc -filetype=obj -O2 " + irFile.clone() + " -o " + objFile.clone() + " && cc -o " + output.clone() + " " + objFile + libs.clone() + extra.clone() + "; fi"
    match run(command) {
        Result.Ok(code) => {
            return code
        }
        Result.Err(_) => {
            return 127
        }
    }
}

// A checker Diagnostic, as one JSON object — the wire format `check-lsp` prints
// on stdout for the LSP server (see src-milo/lsp/diagnostics.milo) to consume
// from a guarded child process. JSON instead of the `check` command's
// human-readable stderr lines because a subprocess boundary is the only way
// to survive a fatal lex error (src-milo/lexer.milo's lexError calls exit(1)
// directly — an in-process lex of a mid-edit buffer can hit that on every
// keystroke that leaves a string unterminated) without taking the whole LSP
// session down with it, and free-text scraping across three different
// lex/parse/check error formats is far more fragile than one JSON shape.
//
// Hoisting (see hoistIfImported in src-milo/lsp/diagnostics.milo, mirroring
// src/lsp.ts) happens here rather than in the parent process: this is where
// the span's own file is still cheaply comparable to docPath, before it is
// flattened to text. A hoisted diagnostic reports at line 1 col 1 with the
// real location folded into the message — never a raw sentinel line/col that
// could be mistaken for "diagnostic at line 1 col 1 of THIS file".
pub fn diagnosticToJsonObj(d: Diagnostic, docPath: &string): JsonObj {
    var line: i64 = 1
    var col: i64 = 1
    var message = d.message.clone()
    match d.span {
        Option.Some(sp) => {
            if sp.file == docPath {
                line = sp.line as i64
                col = sp.col as i64
            } else {
                message = "in imported file " + sp.file.clone() + ":" + sp.line.toString() + ":" + sp.col.toString() + ": " + d.message.clone()
            }
        }
        Option.None => {
        }
    }
    return Json.obj().str("severity", d.severity.clone()).str("message", message).str("hint", d.hint.clone()).int("line", line).int("col", col)
}

pub fn main() {
    let argv = args()
    if argv.len < 2 {
        print("usage: milo <command> <file> [options]")
        print("commands: build, run, emit-ir, check, lsp")
        exit(1)
    }

    let cmd = argv[1].clone()
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        print("milo — self-hosted Milo compiler")
        print("")
        print("usage: milo <command> <file> [options]")
        print("")
        print("commands:")
        print("  build <file> [-o out]  compile to executable")
        print("  run <file>             compile and run")
        print("  emit-ir <file>         print LLVM IR to stdout")
        print("  check <file>           type-check only")
        print("  lsp                    start the language server (stdio, JSON-RPC)")
        exit(0)
    }

    if cmd == "lsp" {
        startServer()
        exit(0)
    }

    if argv.len < 3 {
        eprint("error: missing source file")
        exit(1)
    }

    let source = argv[2].clone()

    if cmd == "check-lsp" {
        // Internal: `check-lsp <buffer-file> <doc-path>` — read the (possibly
        // unsaved) buffer from `buffer-file` but label every span with
        // `doc-path`, the real on-disk location, so imports resolve from the
        // real directory and hoistIfImported's file comparison means something.
        // Always exits 0 with a JSON array on stdout (even a single-element
        // array of one hard error) — a nonzero exit here means the pipeline
        // itself died (lex/parse hard failure), which the LSP-side caller
        // detects by the absence of parseable JSON, not by exit code.
        if argv.len < 4 {
            eprint("error: check-lsp requires <buffer-file> <doc-path>")
            exit(1)
        }
        let bufferPath = argv[2].clone()
        let docPath = argv[3].clone()
        var src = ""
        match readFile(bufferPath.clone()) {
            Result.Ok(s) => {
                src = s
            }
            Result.Err(e) => {
                eprint("error: cannot read buffer file '" + bufferPath + "'")
                exit(1)
            }
        }
        let tokens = tokenize(src)
        var parser = newParser(tokens, docPath.clone())
        let program = parse(parser)
        let target = getHostTarget()
        let sourceDir = Path.dirname(docPath.clone())
        let stdlibDir = findStdlibRoot(sourceDir.clone())
        let resolved = resolveImports(program, sourceDir, stdlibDir, target.os)
        var checker = newChecker()
        checkProgram(checker, resolved)
        var arr = Json.arr()
        for i in 0..checker.diagnostics.len {
            let d = checker.diagnostics[i]
            arr = arr.obj(diagnosticToJsonObj(d, docPath))
        }
        print(arr.build())
        exit(0)
    }

    if cmd == "check" {
        // Type-check only, no codegen
        var src = ""
        match readFile(source.clone()) {
            Result.Ok(s) => {
                src = s
            }
            Result.Err(e) => {
                eprint("error: cannot read file '" + source + "'")
                exit(1)
            }
        }
        let tokens = tokenize(src)
        var parser = newParser(tokens, source.clone())
        let program = parse(parser)
        let target = getHostTarget()
        let sourceDir = Path.dirname(source.clone())
        let stdlibDir = findStdlibRoot(sourceDir)
        let resolved = resolveImports(program, sourceDir, stdlibDir, target.os)
        var checker = newChecker()
        checkProgram(checker, resolved)
        if hasErrors(checker) {
            for i in 0..checker.diagnostics.len {
                let d = checker.diagnostics[i]
                if d.severity == "error" {
                    var loc = ""
                    match d.span {
                        Option.Some(sp) => {
                            // sp.file — the span's own file, not necessarily `source`
                            // (the entry point) — see the `compile()` diagnostic loop.
                            loc = sp.file.clone() + ":" + sp.line.toString() + ":" + sp.col.toString() + ": "
                        }
                        Option.None => {
                        }
                    }
                    eprint(loc + "error: " + d.message.clone())
                }
            }
            exit(1)
        }
        print("ok — no errors")
        exit(0)
    }

    if cmd == "emit-ir" {
        let comp = compile(source.clone())
        print(comp.ir)
        exit(0)
    }

    if cmd == "build" {
        let buildStart = now()
        let comp = compile(source.clone())
        // Determine output name. Any other positional argument (companion .c/.o/.a/.cpp
        // translation units — struct-by-value ABI tests link a C peer alongside the
        // generated IR) is forwarded to the linker verbatim, mirroring src/main.ts's
        // extraLinkFlags. Silently dropping these compiled fine but failed to link.
        var output = "a.out"
        var extra = ""
        var i: i64 = 3
        while i < argv.len {
            if argv[i] == "-o" && (i + 1) < argv.len {
                output = argv[i + 1].clone()
                i = i + 2
            } else {
                extra = extra + " " + argv[i].clone()
                i = i + 1
            }
        }
        // Write IR to a temp file and link it with the available LLVM/C tools.
        let irFile = tmpPath("out", ".ll")
        let _ = writeFile(irFile, comp.ir)
        let status = linkIr(irFile, output, detectLibs(comp.ir, getHostTarget().os, comp.linkLibs, sdlConfigFlags(comp.linkLibs)), extra)
        if status != 0 {
            eprint("error: linker failed (exit " + status.toString() + ")")
            exit(1)
        }
        reportCompiled(source.clone(), output, elapsed(buildStart, now()).toMillis())
        exit(0)
    }

    if cmd == "run" {
        let comp = compile(source.clone())
        let irFile = tmpPath("out", ".ll")
        let _ = writeFile(irFile, comp.ir)
        let binary = tmpPath("run", "")
        // Split positionals the same way `build` does: a companion translation unit
        // (.c/.o/.a/.cpp) is a link input, not something the running program should
        // ever see on its argv. Everything else forwards to the child as before.
        var extra = ""
        var childArgs = ""
        var ai: i64 = 3
        while ai < argv.len {
            let a = argv[ai].clone()
            if a == "--" {
                // separator only — skip, don't forward or link it
            } else if a.endsWith(".c") || a.endsWith(".o") || a.endsWith(".a") || a.endsWith(".cpp") {
                extra = extra + " " + a
            } else {
                childArgs = childArgs + " " + a
            }
            ai = ai + 1
        }
        let status = linkIr(irFile, binary, detectLibs(comp.ir, getHostTarget().os, comp.linkLibs, sdlConfigFlags(comp.linkLibs)), extra)
        if status != 0 {
            eprint("error: linker failed")
            exit(1)
        }
        var runStatus: i32 = 127
        match run(binary + childArgs) {
            Result.Ok(c) => {
                runStatus = c
            }
            Result.Err(e) => {
            }
        }
        exit(runStatus)
    }

    eprint("error: unknown command '" + cmd + "'")
    exit(1)
}
