// Parallel transform via Promise.blocking. Milo's model: workers cannot hold
// references into the shared Vec, so each chunk must be COPIED into an owned
// Vec, moved to the worker, transformed, moved back, and COPIED into place.
// Both copies are mandatory, so both are inside the timed region.
from "std/time" import {
    epochMillis
}
from "std/runtime" import {
    Promise
}

pub fn transform(chunk: Vec<f64>): Vec<f64> {
    var c = chunk
    var i: i64 = 0
    let n = c.len
    while i < n {
        c[i] = c[i] * 1.0000001 + 0.5
        i = i + 1
    }
    return c
}

pub fn main(): i32 {
    let n: i64 = 20000000
    let workers: i64 = 4
    var a: Vec<f64> = Vec.filled(n, 1.0)

    let t0 = epochMillis()

    // copy-out: carve owned chunks (the tax, part 1)
    let chunkLen = n / workers
    var ps: Vec<Promise<Vec<f64>>> = Vec.new()
    for k in 0..workers {
        let lo = k * chunkLen
        var hi = lo + chunkLen
        if k == workers - 1 {
            hi = n
        }
        var chunk: Vec<f64> = Vec.withCapacity(hi - lo)
        var i = lo
        while i < hi {
            chunk.push(a[i])
            i = i + 1
        }
        ps.push(Promise<Vec<f64>>.blocking(move(): Vec<f64> => {
            return transform(chunk)
        }
        ))
    }

    let parts = Promise.all(ps).await()!

    // copy-back: stitch results into the original (the tax, part 2)
    var base: i64 = 0
    for part in parts {
        var i: i64 = 0
        let m = part.len
        while i < m {
            a[base + i] = part[i]
            i = i + 1
        }
        base = base + m
    }
    let t1 = epochMillis()

    var sum: f64 = 0.0
    var j: i64 = 0
    while j < n {
        sum = sum + a[j]
        j = j + 1
    }
    print("par ms=" + (t1 - t0).toString() + " sum=" + sum.toString())
    return 0
}
