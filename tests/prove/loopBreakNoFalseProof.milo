// @proven: 1
// @failed: 1
// @unknown: 0
// A break exits the loop with the state at the break, so the invariant that held on
// entry says nothing about `result` — the ensures must fail rather than ride on it.
pub fn breakWithBadResult(): i64
ensures result >= 0
{
    var x: i64 = 0
    while true
    invariant x >= 0
    {
        x = -1
        break
    }
    return x
}
