// Every shape a `move` closure's captures can travel through, counted.
//
// A destructor that never runs leaks nothing when the value owns no heap, so `leaks`
// cannot see it and neither can ASan. Counting Drop runs is the only oracle that can,
// and every id here is ZERO on purpose: an all-zero capture is a live value whose
// destructor must still run, and a version of the env drop glue that sniffed slots for
// all-zero to decide "already moved out" skipped exactly these and nothing else.
//
// The two failures this pins, both found by sweeping the shapes rather than by a
// fixture anyone had written:
//   - a zero-valued capture never destroyed (glue read the value instead of a flag)
//   - a capture re-captured by a NESTED move closure destroyed twice (the inner env
//     took ownership, the outer env's flag was never cleared)
// @expect: neverCalled 1
// @expect: calledOnce 1
// @expect: consumed 1
// @expect: passed 1
// @expect: returned 1
// @expect: twoCapsOneConsumed 2
// @expect: nested 1
// @expect: loop3 3
var drops: i64 = 0

struct Res {
    id: i64,
}

impl Drop for Res {
    fn drop(self: &mut Self): void {
        drops = drops + 1
    }
}

fn take(r: Res): i64 {
    return r.id
}

fn call(f: move () => i64): i64 {
    return f()
}

fn make(): move () => i64 {
    let r = Res {
        id: 0
    }
    return move () => r.id
}

fn report(label: string): void {
    print(label + " " + drops.toString())
    drops = 0
}

fn main(): void {
    // built and dropped without ever running
    if true {
        let r = Res {
            id: 0
        }
        let f = move () => r.id
    }
    report("neverCalled")

    if true {
        let r = Res {
            id: 0
        }
        let f = move () => r.id
        f()
    }
    report("calledOnce")

    // body hands the capture to a callee by value: the callee drops it, not the glue
    if true {
        let r = Res {
            id: 0
        }
        let f = move () => take(r)
        f()
    }
    report("consumed")

    if true {
        let r = Res {
            id: 0
        }
        call(move () => r.id)
    }
    report("passed")

    if true {
        let f = make()
        f()
    }
    report("returned")

    // one capture consumed, one not: the glue must drop exactly the survivor
    if true {
        let a = Res {
            id: 0
        }
        let b = Res {
            id: 0
        }
        let f = move () => take(a) + b.id
        f()
    }
    report("twoCapsOneConsumed")

    // the inner closure takes ownership from the outer environment
    if true {
        let r = Res {
            id: 0
        }
        let outer = move() => {
            let inner = move () => r.id
            return inner()
        }
        outer()
    }
    report("nested")

    var i: i64 = 0
    while i < 3 {
        let r = Res {
            id: 0
        }
        let f = move () => r.id
        f()
        i = i + 1
    }
    report("loop3")
}
