// Locks the pure geometry and the asset decoder the FLYBY example is built on.
// The example's own harness (examples/games/flight/shot.milo) renders frames but
// asserts nothing, so none of this was covered: a mirrored-map bug, a ring-walk
// that skips a tile, or a decoder that aborts on a short file all used to be
// invisible until something looked wrong on screen.

// It reaches no package. The geometry used to be read out of world3d and render3d,
// both of which import ./live -> ./cloud -> `gl`, so this fixture carried
// `@requires-package: gl` and was SKIPPED in CI, which installs nothing. The pure
// half now lives in examples/games/flight/geom.milo, which imports std/math and
// nothing else, so the fixture builds and runs everywhere.

from "../../examples/games/flight/geom" import {
    foldIn, unfold, blockOf, wrapPi, PI, TAU, ringCount, ringOffset
}
from "../../examples/games/flight/city" import {
    City, cityEmpty, cityParse, putI32, putCm, skylineTris, solveCullK,
    CULL_MAX, CULL_MIN, MAGIC, VERSION
}
from "std/math" import {
    Math
}

// The map is mirrored, not wrapped: every world coordinate has to land back on
// itself through fold-then-unfold, including well outside the mapped square and
// on the seams themselves.
fn foldRoundTrip(): bool {
    let reach = 2000.0
    var v = 0.0 - 9000.0
    while v <= 9000.0 {
        let k = blockOf(v, reach)
        let back = unfold(k, foldIn(v, reach), reach)
        if Math.abs(back - v) > 0.000001 {
            print("fold roundtrip FAILED at " + v.toString())
            return false
        }
        // Inside the mapped square by construction — that is what "folded in"
        // means, and the height sampler indexes on it.
        let u = foldIn(v, reach)
        if u < 0.0 - reach - 0.000001 || u > reach + 0.000001 {
            print("foldIn out of range at " + v.toString())
            return false
        }
        v = v + 37.5
    }
    return true
}

fn wrapChecks(): bool {
    if Math.abs(wrapPi(0.25) - 0.25) > 0.000000001 {
        return false
    }
    if Math.abs(wrapPi(TAU + 0.25) - 0.25) > 0.000000001 {
        return false
    }
    if Math.abs(wrapPi(0.0 - TAU - 0.25) + 0.25) > 0.000000001 {
        return false
    }
    // Three turns and a bit still has to come back as the small correction.
    if Math.abs(wrapPi(3.0 * TAU + 0.5) - 0.5) > 0.000000001 {
        return false
    }
    if wrapPi(PI * 0.999) <= 0.0 {
        return false
    }
    return true
}

// The terrain and the city draw walk out in square rings from the tile under the
// camera. Every tile of a square of side 2r+1 must be visited exactly once
// across rings 0..r — a gap is a hole in the world, a repeat is drawing it twice.
fn ringWalkCovers(): bool {
    let r = 4
    let side = 2 * r + 1
    var seen: Vec<i64> = Vec.filled(side * side, 0)
    for ring in 0..(r + 1) {
        for step in 0..ringCount(ring) {
            let o = ringOffset(ring, step)
            if o.x < 0 - r || o.x > r || o.z < 0 - r || o.z > r {
                print("ring offset out of square")
                return false
            }
            let idx = (o.z + r) * side + (o.x + r)
            seen[idx] = seen[idx] + 1
        }
    }
    for i in 0..(side * side) {
        if seen[i] != 1 {
            print("ring walk visits cell " + i.toString() + " " + seen[i].toString() + " times")
            return false
        }
    }
    return true
}

// The smallest asset the decoder accepts: one terrain post, one cover cell, one
// three-sided building.
fn tinyCity(): string {
    var out = ""
    for i in 0..8 {
        out.push(MAGIC[i])
    }
    putI32(out, VERSION)
    putI32(out, 4)
    out.push(84 as u8) // T
    out.push(111 as u8) // o
    out.push(119 as u8) // w
    out.push(110 as u8) // n
    putI32(out, 377897000) // origin lat, 1e-7 degrees
    putI32(out, 0 - 1224000000) // origin lon
    putCm(out, 500.0) // reach
    putI32(out, 1) // demN
    putCm(out, 30.0) // demStep
    putCm(out, 0.0 - 500.0) // demX0
    putCm(out, 0.0 - 500.0) // demZ0
    putCm(out, 12.0) // the one terrain post
    putI32(out, 1) // coverN
    putCm(out, 20.0)
    putCm(out, 0.0 - 500.0)
    putCm(out, 0.0 - 500.0)
    out.push(0 as u8) // one cover cell: urban
    putI32(out, 1) // one building
    putCm(out, 24.0) // its height
    putI32(out, 3) // three points
    putCm(out, 0.0)
    putCm(out, 0.0)
    putCm(out, 10.0)
    putCm(out, 0.0)
    putCm(out, 0.0)
    putCm(out, 10.0)
    // one bridge: a two-point deck, so the truncation sweep below covers the
    // version-2 section too
    putI32(out, 1)
    putCm(out, 6.0) // half-width
    putI32(out, 1) // suspension
    putI32(out, 0xC0552A) // International Orange
    putI32(out, 2) // two points
    putCm(out, 0.0)
    putCm(out, 0.0)
    putCm(out, 0.0)
    putCm(out, 120.0)
    return out
}

// A city of `n` four-sided buildings on a spiral out to radius `r`, tall in the
// middle and low at the edge -- which is the shape of a real one and, more to the
// point here, gives a SPREAD of apparent heights.
//
// A ring of identical buildings at one radius would not exercise the solver at
// all: every building would have the same apparent height, the cull would be a
// step function, and a bisection over a step returns the step. The first version
// of this fixture did exactly that and reported the solver broken.
fn ringCity(n: i64, r: f64, hTop: f64): City {
    var c = cityEmpty()
    c.loaded = true
    c.bCount = n
    for i in 0..n {
        let t = (i as f64) / (n as f64)
        let a = TAU * (i as f64) * 0.381966
        let rad = r * (0.04 + 0.96 * t)
        let x = Math.cos(a) * rad
        let z = Math.sin(a) * rad
        c.bHeight.push(8.0 + (hTop - 8.0) * (1.0 - t) * (1.0 - t))
        c.bMinX.push(x - 10.0)
        c.bMaxX.push(x + 10.0)
        c.bMinZ.push(z - 10.0)
        c.bMaxZ.push(z + 10.0)
        c.bLen.push(4)
        c.bSkip.push(false)
    }
    return c
}

// The skyline budget. Cities differ in density by more than five times, so a
// single hand-tuned cull constant is either wasteful over the sparse city or
// unaffordable over the dense one -- and being tuned against the densest city is
// how it ends up throwing buildings away in every other one.
//
// None of this has a visual tell worth the name: a threshold that is too high
// looks like a city with fewer buildings in it, which is what a city with fewer
// buildings in it also looks like.
fn skylineBudget(): bool {
    let budget = 200000
    let eye = 400.0
    let range = 5000.0
    var ok = true

    // Raising the threshold can only ever drop buildings. The solver is a
    // bisection and bisection on a non-monotone function returns nonsense, so
    // this is the assumption the whole thing rests on rather than a nicety.
    let dense = ringCity(40000, 4800.0, 220.0)
    var prev = skylineTris(dense, eye, range, CULL_MIN)
    var monotone = true
    for i in 1..40 {
        let k = CULL_MIN + (CULL_MAX - CULL_MIN) * (i as f64) / 40.0
        let t = skylineTris(dense, eye, range, k)
        if t > prev {
            monotone = false
        }
        prev = t
    }
    if !monotone {
        print("skyline triangle count is not monotone in the threshold")
        ok = false
    }

    // A city that already fits takes the whole skyline: the budget is a ceiling,
    // not a target to be spent up to.
    let sparse = ringCity(400, 4800.0, 220.0)
    if solveCullK(sparse, eye, range, budget) != CULL_MIN {
        print("a sparse city should keep every building")
        ok = false
    }

    // A city that does not fit gets a threshold that makes it fit.
    let kDense = solveCullK(dense, eye, range, budget)
    if kDense <= CULL_MIN {
        print("a dense city should tighten the threshold")
        ok = false
    }
    let cost = skylineTris(dense, eye, range, kDense)
    if cost > budget {
        print("solved threshold still over budget: " + cost.toString())
        ok = false
    }
    // And not by throwing away far more than it had to. A solver that just
    // returned CULL_MAX would pass the line above and fail this one.
    if cost < budget / 3 {
        print("solved threshold throws away too much: " + cost.toString())
        ok = false
    }

    // Denser city, tighter threshold. This is the whole point of solving rather
    // than hard-coding, and it is the assertion a fixed constant would fail.
    let denser = ringCity(120000, 4800.0, 220.0)
    if solveCullK(denser, eye, range, budget) <= kDense {
        print("a denser city should get a tighter threshold")
        ok = false
    }

    // A city that cannot fit at any threshold in range draws over budget rather
    // than drawing nothing. Losing the towers to hit a number would be the wrong
    // trade in a game whose subject is the towers.
    let impossible = ringCity(200000, 300.0, 400.0)
    let kImp = solveCullK(impossible, eye, range, budget)
    if skylineTris(impossible, eye, range, kImp) == 0 {
        print("an unaffordable city should still draw its skyline")
        ok = false
    }

    // Extent is not density. A pack that reaches twice as far as the aircraft can
    // see must not be charged for the half it cannot: without the draw-distance
    // cull, a wide sparse city solves to a tighter threshold than a compact one
    // holding exactly the same buildings within view, and the visible result is
    // buildings missing from the near field of the wider pack.
    let compact = ringCity(2000, range, 220.0)
    var wide = ringCity(2000, range, 220.0)
    let far = ringCity(6000, range * 4.0, 220.0)
    for b in 0..far.bCount {
        let mx = (far.bMinX[b] + far.bMaxX[b]) * 0.5
        let mz = (far.bMinZ[b] + far.bMaxZ[b]) * 0.5
        if mx * mx + mz * mz <= range * range {
            continue
        }
        wide.bCount = wide.bCount + 1
        wide.bHeight.push(far.bHeight[b])
        wide.bMinX.push(far.bMinX[b])
        wide.bMaxX.push(far.bMaxX[b])
        wide.bMinZ.push(far.bMinZ[b])
        wide.bMaxZ.push(far.bMaxZ[b])
        wide.bLen.push(far.bLen[b])
        wide.bSkip.push(false)
    }
    if wide.bCount <= compact.bCount {
        print("the wide city gained no out-of-range buildings")
        ok = false
    }
    if skylineTris(wide, eye, range, CULL_MIN) != skylineTris(compact, eye, range, CULL_MIN) {
        print("out-of-range buildings were charged to the budget")
        ok = false
    }

    // An empty or unloaded city must not divide by anything or spin.
    let nothing = cityEmpty()
    if solveCullK(nothing, eye, range, budget) != CULL_MIN {
        print("an empty city should not tighten anything")
        ok = false
    }
    return ok
}

pub fn main(): i32 {
    if foldRoundTrip() {
        print("fold roundtrip ok")
    }
    if wrapChecks() {
        print("wrapPi ok")
    } else {
        print("wrapPi FAILED")
    }
    if ringWalkCovers() {
        print("ring walk ok")
    }
    if skylineBudget() {
        print("skyline budget ok")
    }

    let full = tinyCity()
    match cityParse(full) {
        Result.Ok(c) => {
            print("parsed " + c.name.clone() + " " + c.bCount.toString() + " building " + c.brCount.toString() + " bridge")
        }
        Result.Err(e) => {
            print("parse FAILED: " + e)
        }
    }

    // Every short read has to come back as Result.Err. This is the one untrusted
    // input the game has (`--city <file>`), and before the length checks a
    // truncated asset indexed straight past the end of the buffer and took the
    // process down — memory-safe, but a Result-returning parser that aborts is
    // lying about its own signature.
    var rejected = 0
    for n in 0..full.len {
        var prefix = ""
        for i in 0..n {
            prefix.push(full[i])
        }
        match cityParse(prefix) {
            Result.Ok(c) => {
                print("truncation at " + n.toString() + " parsed as " + c.bCount.toString() + " buildings")
            }
            Result.Err(_) => {
                rejected = rejected + 1
            }
        }
    }
    print("truncations rejected " + rejected.toString() + "/" + full.len.toString())

    // A file that is not one of ours, and one whose header claims a grid far
    // bigger than the bytes behind it.
    match cityParse("NOTACITYFILE-------------------------") {
        Result.Ok(_) => {
            print("magic check FAILED")
        }
        Result.Err(_) => {
            print("bad magic rejected")
        }
    }
    var lying = ""
    for i in 0..8 {
        lying.push(MAGIC[i])
    }
    putI32(lying, VERSION)
    putI32(lying, 0)
    putI32(lying, 0)
    putI32(lying, 0)
    putCm(lying, 500.0)
    putI32(lying, 30000) // 900 million terrain posts, in 40 bytes
    putCm(lying, 30.0)
    putCm(lying, 0.0)
    putCm(lying, 0.0)
    match cityParse(lying) {
        Result.Ok(_) => {
            print("huge grid FAILED")
        }
        Result.Err(_) => {
            print("huge grid rejected")
        }
    }
    return 0
}
// @expect: fold roundtrip ok
// @expect: wrapPi ok
// @expect: ring walk ok
// @expect: skyline budget ok
// @expect: parsed Town 1 building 1 bridge
// @expect: truncations rejected 141/141
// @expect: bad magic rejected
// @expect: huge grid rejected
