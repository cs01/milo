// Negative test: touching the pool after freeze must be a COMPILE error.
struct Pool {
    items: Vec<i64>
}

struct FrozenPool {
    items: Vec<i64>
}

fn freeze(p: Pool): FrozenPool {
    return FrozenPool {
        items: p.items
    }
}

pub fn main(): i32 {
    var pool = Pool {
        items: Vec.new()
    }
    pool.items.push(1)
    let frozen = freeze(pool) // pool moved
    pool.items.push(2) // must not compile
    return 0
}
