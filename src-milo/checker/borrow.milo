// Borrow-liveness tracking for views (&[T]/&string) — ports src/checker.ts's
// freeze/unfreeze/accessPath/frozenAgainst/errorIfFrozen machinery.
//
// The oracle mutates a live VarInfo object in place (freeze()/unfreeze() flip
// fields on the same JS object `lookup()` returned). This checker's scopes
// store VarInfo BY VALUE — `lookup` returns a copy, and mutation goes through
// explicit setVar*-and-reinsert helpers (see state.milo) — so borrow state
// lives in a name-keyed side table on the Checker (`borrowedPaths`) instead,
// which sidesteps threading two more fields through every VarInfo literal in
// the file. See state.milo's Checker struct for the field-level rationale.
from "src-milo/ast.milo" import {
    Expr, Span, cloneSpan
}
from "src-milo/checker/state.milo" import {
    Checker, error
}

// -- Field-collapsing access path -------------------------------------------
//
// root variable + chain of field names. An index/deref step taints the whole
// chain: once one appears anywhere, `fields` collapses to [] and `tainted`
// stays true for the rest of the walk. This matches the oracle's accessPath
// (a null path once any non-field step appears) — an empty Vec plays the same
// role as `null` there, because both mean "overlaps with everything" under
// pathsOverlap's prefix check, so there's no need for a separate sentinel.
pub struct AccessPath {
    root: string,
    fields: Vec<string>,
    tainted: bool,
}

pub fn accessPath(e: &Expr): Option<AccessPath> {
    match e {
        Expr.Ident(name, sp) => {
            return Option.Some(AccessPath {
                root: name.clone(), fields: Vec.new(), tainted: false
            }
            )
        }
        Expr.FieldAccess(obj, field, sp) => {
            match accessPath(*obj) {
                Option.Some(p) => {
                    if p.tainted {
                        return Option.Some(AccessPath {
                            root: p.root, fields: Vec.new(), tainted: true
                        }
                        )
                    }
                    var nf = p.fields.clone()
                    nf.push(field.clone())
                    return Option.Some(AccessPath {
                        root: p.root, fields: nf, tainted: false
                    }
                    )
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        Expr.IndexAccess(obj, idx, sp) => {
            match accessPath(*obj) {
                Option.Some(p) => {
                    return Option.Some(AccessPath {
                        root: p.root, fields: Vec.new(), tainted: true
                    }
                    )
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        _ => {
            return Option.None
        }
    }
}

// Root identifier of a chain, ignoring field/index steps — used where only the
// binding matters (e.g. checking a `&mut` argument's source is mutable).
pub fn rootIdentName(e: &Expr): Option<string> {
    match e {
        Expr.Ident(name, sp) => {
            return Option.Some(name.clone())
        }
        Expr.FieldAccess(obj, field, sp) => {
            return rootIdentName(*obj)
        }
        Expr.IndexAccess(obj, idx, sp) => {
            return rootIdentName(*obj)
        }
        _ => {
            return Option.None
        }
    }
}

// Two field-paths (from a common root) overlap when one is a prefix of the
// other — provable divergence at any position means provably-disjoint storage.
// An empty path is a prefix of everything, so a tainted/whole-variable path
// always overlaps, exactly matching the oracle's `mutFields === null` handling.
pub fn pathsOverlap(a: &Vec<string>, b: &Vec<string>): bool {
    var n = a.len
    if b.len < n {
        n = b.len
    }
    var i: i64 = 0
    while i < n {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// -- Freeze state -------------------------------------------------------------

// Presence with a non-empty path list means frozen; either absent or present-
// but-emptied (see unfreezeName) means not frozen. Deliberately not
// HashMap.remove — this checker (compiled by the oracle, not itself) has no
// prior caller of HashMap<_, Vec<_>>.remove, and it miscompiles the value's
// drop glue into a bogus void alloca; insert-empty is an equally sound and
// already-exercised HashMap operation.
pub fn isFrozen(ck: &Checker, name: &string): bool {
    match ck.borrowedPaths.get(name) {
        Option.Some(v) => {
            return v.len > 0
        }
        Option.None => {
            return false
        }
    }
}

// Record a borrow of `name` restricted to `fields` (empty = whole variable).
pub fn freezeName(ck: &mut Checker, name: &string, fields: Vec<string>) {
    var existing: Vec<Vec<string>> = Vec.new()
    match ck.borrowedPaths.get(name) {
        Option.Some(v) => {
            existing = v
        }
        Option.None => {
        }
    }
    existing.push(fields)
    ck.borrowedPaths.insert(name.clone(), existing)
}

// Full reset, matching the oracle's unfreeze(): a single call clears every
// path recorded for `name`, not just the most recent. Freezes on one name are
// expected to nest by SCOPE lifetime (never independently reference-counted),
// same simplification the oracle makes.
pub fn unfreezeName(ck: &mut Checker, name: &string) {
    ck.borrowedPaths.insert(name.clone(), Vec.new())
}

// Whether a mutation touching `fields` off `name` collides with a live borrow.
// An empty path list means "not frozen" here (see unfreezeName) — a real
// freeze always pushes at least one entry.
pub fn frozenAgainst(ck: &Checker, name: &string, fields: &Vec<string>): bool {
    match ck.borrowedPaths.get(name) {
        Option.Some(paths) => {
            if paths.len == 0 {
                return false
            }
            for i in 0..paths.len {
                if pathsOverlap(paths[i], fields) {
                    return true
                }
            }
            return false
        }
        Option.None => {
            return false
        }
    }
}

// Freeze whatever `place` names (root + field path via accessPath); a no-op
// when `place`'s root can't be determined (e.g. `v[a..b]` from `foo()[a..b]`,
// where nothing is bound long enough to matter — matches the oracle's plain
// `.slice()` freeze, which silently skips a non-Ident root without erroring).
pub fn freezePlace(ck: &mut Checker, place: &Expr) {
    match accessPath(place) {
        Option.Some(p) => {
            freezeName(ck, p.root, p.fields)
        }
        Option.None => {
        }
    }
}

// Freeze the receiver of a user-defined view-returning method (`lx.word(...)`).
// Unlike freezePlace, a receiver with no named root IS an error here: the
// caller has already committed to using the view (a struct method's result,
// not a raw slice expression), and a temporary's storage doesn't outlive the
// call that produced it — mirrors the oracle's freezeViewSource.
pub fn freezeViewMethodSource(ck: &mut Checker, obj: &Expr, sp: &Option<Span>) {
    match accessPath(obj) {
        Option.Some(p) => {
            freezeName(ck, p.root, p.fields)
        }
        Option.None => {
            error(ck, "cannot take a view of a temporary", cloneSpan(sp))
        }
    }
}

// Reject `action` on `obj` while a live borrow into it would be invalidated —
// e.g. a `push` that reallocates the buffer a slice or loop iteration points
// into. `action` reads as "cannot ACTION 'root' because it is borrowed", e.g.
// "call 'push' on" or "pass".
pub fn errorIfFrozenRoot(ck: &mut Checker, obj: &Expr, action: &string, sp: &Option<Span>) {
    match accessPath(obj) {
        Option.Some(p) => {
            if frozenAgainst(ck, p.root, p.fields) {
                error(ck, "cannot " + action.clone() + " '" + p.root.clone() + "' because it is borrowed", cloneSpan(sp))
            }
        }
        Option.None => {
        }
    }
}

// A short human-readable rendering of a place, for diagnostics ("h.data",
// "lb.buf"). Only needs to handle the shapes that appear as assignment
// targets/borrow sources in practice.
pub fn describePlace(e: &Expr): string {
    match e {
        Expr.Ident(name, sp) => {
            return name.clone()
        }
        Expr.FieldAccess(obj, field, sp) => {
            return describePlace(*obj) + "." + field.clone()
        }
        Expr.IndexAccess(obj, idx, sp) => {
            return describePlace(*obj) + "[...]"
        }
        _ => {
            return "<expr>"
        }
    }
}

// -- Assignment target: index-aware, index steps exempt in-place writes ------
//
// `v[i] = x` never reallocates, so it's legal even while a view into `v` is
// live (tests/fixtures/viewFreezeRelease.milo) — but `v = ...`/`h.data = ...`
// replace the whole place and free its old buffer, which a live view would
// then dangle into. `hasIndex` tracks whether ANY step in the chain was an
// index, regardless of position, matching the oracle's assignPath.steps.some(...).
pub struct AssignTarget {
    root: string,
    fields: Vec<string>,
    hasIndex: bool,
}

pub fn assignTargetPath(e: &Expr): Option<AssignTarget> {
    match e {
        Expr.Ident(name, sp) => {
            return Option.Some(AssignTarget {
                root: name.clone(), fields: Vec.new(), hasIndex: false
            }
            )
        }
        Expr.FieldAccess(obj, field, sp) => {
            match assignTargetPath(*obj) {
                Option.Some(p) => {
                    if p.hasIndex {
                        return Option.Some(AssignTarget {
                            root: p.root, fields: Vec.new(), hasIndex: true
                        }
                        )
                    }
                    var nf = p.fields.clone()
                    nf.push(field.clone())
                    return Option.Some(AssignTarget {
                        root: p.root, fields: nf, hasIndex: false
                    }
                    )
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        Expr.IndexAccess(obj, idx, sp) => {
            match assignTargetPath(*obj) {
                Option.Some(p) => {
                    return Option.Some(AssignTarget {
                        root: p.root, fields: Vec.new(), hasIndex: true
                    }
                    )
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        _ => {
            return Option.None
        }
    }
}

// Reject an assignment that would drop a place a live view still points into.
// No-op for an in-place element write (hasIndex) or a target with no named
// root. `target` is the full assignment target expression, used only to
// render the diagnostic's place text ("h.data" vs the bare root).
pub fn errorIfAssignFrozen(ck: &mut Checker, target: &Expr, sp: &Option<Span>) {
    match assignTargetPath(target) {
        Option.Some(p) => {
            if p.hasIndex {
                return
            }
            if frozenAgainst(ck, p.root, p.fields) {
                let place = describePlace(target)
                var why = "it is borrowed"
                if place != p.root {
                    why = "'" + p.root.clone() + "' is borrowed"
                }
                error(ck, "cannot assign to '" + place + "' because " + why, cloneSpan(sp))
            }
        }
        Option.None => {
        }
    }
}

// -- Callback receiver freeze (`.each`, `.map`, `.filter`, `.enumerate`) -----
//
// The callback receives elements by (shared) reference — mutating the
// receiver inside it (e.g. `items.push` inside `items.each(|x| items.push(x))`)
// can realloc the buffer those references point into. Freezes the receiver's
// root for the callback-checking call only; returns the name to release
// afterward, or None when there was no root to freeze (or it was already
// frozen by an outer context, which owns the eventual unfreeze).
pub fn borrowDuringCallback(ck: &mut Checker, obj: &Expr): Option<string> {
    match rootIdentName(obj) {
        Option.Some(name) => {
            if isFrozen(ck, name) {
                return Option.None
            }
            freezeName(ck, name, Vec.new())
            return Option.Some(name)
        }
        Option.None => {
            return Option.None
        }
    }
}

// -- Call-site exclusivity ----------------------------------------------------
//
// A variable must not appear at one call as both a mutable-borrow argument
// and the root of a shared-borrow argument (a mutation through the `&mut`
// could invalidate the `&`), nor as two overlapping mutable-borrow arguments
// (one a container, the other pointing into it). Pure argument-origin check —
// ports checkCallSiteExclusivity, without the literal-slice-range disjointness
// refinement (mutSliceOverlapArgs is out of this lane's fixture set).
pub struct BorrowArg {
    root: string,
    fields: Vec<string>,
    steps: Vec<Option<string>>, // None = index step, Some(name) = field step
}

pub fn borrowArgOf(e: &Expr): Option<BorrowArg> {
    match accessPath(e) {
        Option.Some(p) => {
            match accessSteps(e) {
                Option.Some(steps) => {
                    return Option.Some(BorrowArg {
                        root: p.root, fields: p.fields, steps: steps
                    }
                    )
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        Option.None => {
            return Option.None
        }
    }
}

fn accessSteps(e: &Expr): Option<Vec<Option<string>>> {
    match e {
        Expr.Ident(name, sp) => {
            return Option.Some(Vec.new())
        }
        Expr.FieldAccess(obj, field, sp) => {
            match accessSteps(*obj) {
                Option.Some(s) => {
                    var ns = s.clone()
                    ns.push(Option.Some(field.clone()))
                    return Option.Some(ns)
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        Expr.IndexAccess(obj, idx, sp) => {
            match accessSteps(*obj) {
                Option.Some(s) => {
                    var ns = s.clone()
                    ns.push(Option.None)
                    return Option.Some(ns)
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        _ => {
            return Option.None
        }
    }
}

fn stepsEqAt(a: &Option<string>, b: &Option<string>): bool {
    match a {
        Option.Some(an) => {
            match b {
                Option.Some(bn) => {
                    return an == bn
                }
                Option.None => {
                    return false
                }
            }
        }
        Option.None => {
            match b {
                Option.None => {
                    return true
                }
                Option.Some(bn) => {
                    return false
                }
            }
        }
    }
}

// True when two `&mut` step chains off the same root alias: one is a proper
// prefix of the other (container/descendant — `v` and `v[0]`), or they are
// identical with no index step (provably the same place). Equal-length
// chains that pass through an index are siblings (`v[i]`/`v[j]`) and are NOT
// flagged — may be distinct elements.
fn aliasesByContainment(a: &Vec<Option<string>>, b: &Vec<Option<string>>): bool {
    var n = a.len
    if b.len < n {
        n = b.len
    }
    var wi: i64 = 0
    while wi < n {
        if !stepsEqAt(a[wi], b[wi]) {
            return false
        }
        wi = wi + 1
    }
    if a.len != b.len {
        return true
    }
    for fi in 0..a.len {
        match a[fi] {
            Option.None => {
                return false
            }
            _ => {
            }
        }
    }
    return true
}

pub fn checkCallSiteExclusivity(ck: &mut Checker, muts: &Vec<BorrowArg>, shared: &Vec<BorrowArg>, sp: &Option<Span>) {
    for mi in 0..muts.len {
        for si in 0..shared.len {
            if muts[mi].root == shared[si].root && pathsOverlap(muts[mi].fields, shared[si].fields) {
                error(ck, "'" + muts[mi].root.clone() + "' is borrowed mutably and shared in the same call", cloneSpan(sp))
            }
        }
    }
    for i in 0..muts.len {
        var j: i64 = i + 1
        while j < muts.len {
            if muts[i].root == muts[j].root && aliasesByContainment(muts[i].steps, muts[j].steps) {
                error(ck, "'" + muts[i].root.clone() + "' is borrowed mutably twice in the same call", cloneSpan(sp))
            }
            j = j + 1
        }
    }
}
