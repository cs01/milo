// A small 3D pipeline on top of the 2D HDR canvas: perspective camera, near-plane
// clipping, and a depth-buffered triangle rasteriser with flat shading and fog.
//
// Everything is safe Milo — the z-buffer is a Vec<f32>, the vertex lists are
// Vec<f64>, and no raw pointer appears anywhere in this file.

from "std/math" import {
    Math
}
from "./gfx" import {
    Canvas
}

pub struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

pub struct Camera {
    x: f64,
    y: f64,
    z: f64,
    yaw: f64, // heading, radians
    pitch: f64,
    roll: f64,
    fov: f64, // vertical field of view, radians
    near: f64,
    far: f64,
}

pub struct Scene {
    zbuf: Vec<f32>,
    w: i64,
    h: i64,
    // sun direction, normalised, pointing FROM the surface TOWARD the light
    sunX: f64,
    sunY: f64,
    sunZ: f64,
    fogR: f64,
    fogG: f64,
    fogB: f64,
    fogStart: f64,
    fogEnd: f64,
    tris: i64, // triangles actually rasterised this frame
}

pub fn sceneNew(w: i64, h: i64): Scene {
    return Scene {
        zbuf: Vec.filled(w * h, 0.0),
        w: w,
        h: h,
        sunX: 0.44,
        sunY: 0.78,
        sunZ: 0.44,
        fogR: 0.30,
        fogG: 0.42,
        fogB: 0.62,
        fogStart: 420.0,
        fogEnd: 1500.0,
        tris: 0,
    }
}

pub fn sceneClear(s: &mut Scene) {
    let n = s.w * s.h
    for i in 0..n {
        s.zbuf[i] = 0.0 // storing 1/z, so 0 is infinitely far
    }
    s.tris = 0
}

// ── camera transform ──────────────────────────────────────────────────────────

pub struct View {
    // rows of the world→camera rotation, precomputed once per frame
    rx: f64,
    ry: f64,
    rz: f64,
    ux: f64,
    uy: f64,
    uz: f64,
    fx: f64,
    fy: f64,
    fz: f64,
    px: f64,
    py: f64,
    pz: f64,
    scale: f64, // vertical projection scale in pixels
    cx: f64,
    cy: f64,
}

pub fn viewOf(c: &Camera, w: i64, h: i64): View {
    let cy = Math.cos(c.yaw)
    let sy = Math.sin(c.yaw)
    let cp = Math.cos(c.pitch)
    let sp = Math.sin(c.pitch)
    let cr = Math.cos(c.roll)
    let sr = Math.sin(c.roll)

    // forward, then right and up derived from it, then roll about forward
    let fx = sy * cp
    let fy = sp
    let fz = cy * cp
    // right = normalise(cross(worldUp, forward))
    var rx = cy
    var ry = 0.0
    var rz = 0.0 - sy
    // up = cross(forward, right)
    var ux = fy * rz - fz * ry
    var uy = fz * rx - fx * rz
    var uz = fx * ry - fy * rx
    // apply roll: rotate right/up about forward
    let rx2 = rx * cr + ux * sr
    let ry2 = ry * cr + uy * sr
    let rz2 = rz * cr + uz * sr
    let ux2 = ux * cr - rx * sr
    let uy2 = uy * cr - ry * sr
    let uz2 = uz * cr - rz * sr

    let scale = (h as f64) * 0.5 / Math.tan(c.fov * 0.5)
    return View {
        rx: rx2, ry: ry2, rz: rz2,
        ux: ux2, uy: uy2, uz: uz2,
        fx: fx, fy: fy, fz: fz,
        px: c.x, py: c.y, pz: c.z,
        scale: scale,
        cx: (w as f64) * 0.5,
        cy: (h as f64) * 0.5,
    }
}

// World point → camera space. z is depth along the view direction.
pub fn toCamera(v: &View, x: f64, y: f64, z: f64): Vec3 {
    let dx = x - v.px
    let dy = y - v.py
    let dz = z - v.pz
    return Vec3 {
        x: dx * v.rx + dy * v.ry + dz * v.rz,
        y: dx * v.ux + dy * v.uy + dz * v.uz,
        z: dx * v.fx + dy * v.fy + dz * v.fz,
    }
}

// ── rasteriser ────────────────────────────────────────────────────────────────

// Depth-buffered flat-shaded triangle in CAMERA space. Depth-tests on 1/z, which
// interpolates linearly in screen space — the reason the buffer stores 1/z.
fn rasterCam(c: &mut Canvas, s: &mut Scene, v: &View, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, cx2: f64, cy2: f64, cz2: f64, r: f64, g: f64, b: f64) {
    // project
    let iaz = 1.0 / az
    let ibz = 1.0 / bz
    let icz = 1.0 / cz2
    let x0 = v.cx + ax * v.scale * iaz
    let y0 = v.cy - ay * v.scale * iaz
    let x1 = v.cx + bx * v.scale * ibz
    let y1 = v.cy - by * v.scale * ibz
    let x2 = v.cx + cx2 * v.scale * icz
    let y2 = v.cy - cy2 * v.scale * icz

    // backface / degenerate cull via signed area
    let area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
    if area <= 0.0 {
        return
    }

    var minX = Math.floor(Math.minF64(x0, Math.minF64(x1, x2))) as i64
    var maxX = Math.ceil(Math.maxF64(x0, Math.maxF64(x1, x2))) as i64
    var minY = Math.floor(Math.minF64(y0, Math.minF64(y1, y2))) as i64
    var maxY = Math.ceil(Math.maxF64(y0, Math.maxF64(y1, y2))) as i64
    if minX < 0 {
        minX = 0
    }
    if minY < 0 {
        minY = 0
    }
    if maxX > s.w {
        maxX = s.w
    }
    if maxY > s.h {
        maxY = s.h
    }
    if minX >= maxX || minY >= maxY {
        return
    }

    s.tris = s.tris + 1
    let invArea = 1.0 / area
    var py = minY
    while py < maxY {
        let fy = (py as f64) + 0.5
        var px = minX
        while px < maxX {
            let fx = (px as f64) + 0.5
            // edge functions; all non-negative means inside
            let w0 = (x2 - x1) * (fy - y1) - (y2 - y1) * (fx - x1)
            if w0 < 0.0 {
                px = px + 1
                continue
            }
            let w1 = (x0 - x2) * (fy - y2) - (y0 - y2) * (fx - x2)
            if w1 < 0.0 {
                px = px + 1
                continue
            }
            let w2 = (x1 - x0) * (fy - y0) - (y1 - y0) * (fx - x0)
            if w2 < 0.0 {
                px = px + 1
                continue
            }
            let l0 = w0 * invArea
            let l1 = w1 * invArea
            let l2 = w2 * invArea
            let invZ = l0 * iaz + l1 * ibz + l2 * icz
            let idx = py * s.w + px
            if (s.zbuf[idx] as f64) < invZ {
                s.zbuf[idx] = invZ as f32
                let depth = 1.0 / invZ
                // linear fog toward the sky colour
                var f = (depth - s.fogStart) / (s.fogEnd - s.fogStart)
                if f < 0.0 {
                    f = 0.0
                }
                if f > 1.0 {
                    f = 1.0
                }
                let o = idx * 3
                c.hdr[o] = (r * (1.0 - f) + s.fogR * f) as f32
                c.hdr[o + 1] = (g * (1.0 - f) + s.fogG * f) as f32
                c.hdr[o + 2] = (b * (1.0 - f) + s.fogB * f) as f32
            }
            px = px + 1
        }
        py = py + 1
    }
}

pub let NEAR: f64 = 0.6

// A world-space triangle, clipped against the near plane and then rasterised.
// Clipping matters: a triangle straddling the camera plane projects to garbage,
// and terrain directly under a low-flying plane does exactly that.
pub fn triangle(c: &mut Canvas, s: &mut Scene, v: &View, wax: f64, way: f64, waz: f64, wbx: f64, wby: f64, wbz: f64, wcx: f64, wcy: f64, wcz: f64, r: f64, g: f64, b: f64) {
    let a = toCamera(v, wax, way, waz)
    let bb = toCamera(v, wbx, wby, wbz)
    let cc = toCamera(v, wcx, wcy, wcz)

    let ina = a.z > NEAR
    let inb = bb.z > NEAR
    let inc = cc.z > NEAR
    var n = 0
    if ina {
        n = n + 1
    }
    if inb {
        n = n + 1
    }
    if inc {
        n = n + 1
    }
    if n == 0 {
        return
    }
    if n == 3 {
        rasterCam(c, s, v, a.x, a.y, a.z, bb.x, bb.y, bb.z, cc.x, cc.y, cc.z, r, g, b)
        return
    }
    // Sutherland–Hodgman against the single near plane, producing 3 or 4 points.
    var px: Vec<f64> = Vec.new()
    var py: Vec<f64> = Vec.new()
    var pz: Vec<f64> = Vec.new()
    clipEdge(px, py, pz, a, bb)
    clipEdge(px, py, pz, bb, cc)
    clipEdge(px, py, pz, cc, a)
    if px.len < 3 {
        return
    }
    for i in 1..px.len - 1 {
        rasterCam(c, s, v, px[0], py[0], pz[0], px[i], py[i], pz[i], px[i + 1], py[i + 1], pz[i + 1], r, g, b)
    }
}

fn clipEdge(px: &mut Vec<f64>, py: &mut Vec<f64>, pz: &mut Vec<f64>, a: &Vec3, b: &Vec3) {
    let ina = a.z > NEAR
    let inb = b.z > NEAR
    if ina {
        px.push(a.x)
        py.push(a.y)
        pz.push(a.z)
    }
    if ina != inb {
        let t = (NEAR - a.z) / (b.z - a.z)
        px.push(a.x + (b.x - a.x) * t)
        py.push(a.y + (b.y - a.y) * t)
        pz.push(NEAR)
    }
}

// Compatibility wrappers over the struct-based path, so call sites that pass
// loose coordinates keep working.
pub fn triangleTex(c: &mut Canvas, s: &mut Scene, view: &View, t: &Texture, wax: f64, way: f64, waz: f64, au: f64, av: f64, wbx: f64, wby: f64, wbz: f64, bu: f64, bv: f64, wcx: f64, wcy: f64, wcz: f64, cu: f64, cv: f64, tr: f64, tg: f64, tb: f64) {
    triangleV(c, s, view, t, vtx(wax, way, waz, au, av, 1.0), vtx(wbx, wby, wbz, bu, bv, 1.0), vtx(wcx, wcy, wcz, cu, cv, 1.0), tr, tg, tb)
}

pub fn triangleTexLit(c: &mut Canvas, s: &mut Scene, view: &View, t: &Texture, wax: f64, way: f64, waz: f64, au: f64, av: f64, asr: f64, wbx: f64, wby: f64, wbz: f64, bu: f64, bv: f64, bsr: f64, wcx: f64, wcy: f64, wcz: f64, cu: f64, cv: f64, csr: f64, tr: f64, tg: f64, tb: f64) {
    triangleV(c, s, view, t, vtx(wax, way, waz, au, av, asr), vtx(wbx, wby, wbz, bu, bv, bsr), vtx(wcx, wcy, wcz, cu, cv, csr), tr, tg, tb)
}

// Lambert term for a triangle whose world-space normal is (nx,ny,nz).
pub fn shade(s: &Scene, nx: f64, ny: f64, nz: f64, ambient: f64): f64 {
    var d = nx * s.sunX + ny * s.sunY + nz * s.sunZ
    if d < 0.0 {
        d = 0.0
    }
    return ambient + (1.0 - ambient) * d
}

// ── textures ──────────────────────────────────────────────────────────────────
//
// Power-of-two RGB textures sampled with wrap, generated procedurally at startup
// — there is no asset pipeline here, and none is needed for surface detail.

pub struct Texture {
    w: i64,
    h: i64,
    mask: i64, // w-1, w is a power of two
    shift: i64, // log2(w), for the row stride
    px: Vec<f32>, // 3 floats per texel
}

pub fn texNew(size: i64, shift: i64): Texture {
    return Texture {
        w: size,
        h: size,
        mask: size - 1,
        shift: shift,
        px: Vec.filled(size * size * 3, 0.0),
    }
}

pub fn texSet(t: &mut Texture, x: i64, y: i64, r: f64, g: f64, b: f64) {
    let i = ((y << t.shift) + x) * 3
    t.px[i] = r as f32
    t.px[i + 1] = g as f32
    t.px[i + 2] = b as f32
}

// Perspective-correct textured triangle. The extra work over the flat path is
// interpolating u/z and v/z alongside 1/z and dividing per pixel — which is what
// "perspective-correct" means: interpolating u,v directly in screen space slides
// the texture around as the surface tilts away.
// A vertex: position, texture coordinate, and its own light term. Passing these
// as 25 loose f64 parameters was a standing invitation to transpose two of them —
// which happened three times while this file was being written. A struct costs
// nothing at runtime (same registers, no indirection) and makes the mistake
// unrepresentable. A map keyed by name would also fix it, and would put a hash
// lookup in the innermost loop of the program.
pub struct Vtx {
    x: f64,
    y: f64,
    z: f64,
    u: f64,
    v: f64,
    light: f64,
}

pub fn vtx(x: f64, y: f64, z: f64, u: f64, v: f64, light: f64): Vtx {
    return Vtx {
        x: x, y: y, z: z, u: u, v: v, light: light
    }
}

// Perspective-correct textured triangle in CAMERA space. u/z, v/z and the light
// term interpolate linearly in screen space; dividing by the interpolated 1/z at
// each pixel recovers the true value. That division is what "perspective-correct"
// buys — interpolating u,v directly makes the texture slide as a surface tilts.
fn rasterCamTex(c: &mut Canvas, s: &mut Scene, view: &View, t: &Texture, a: &Vtx, b: &Vtx, d: &Vtx, tr: f64, tg: f64, tb: f64) {
    let iaz = 1.0 / a.z
    let ibz = 1.0 / b.z
    let icz = 1.0 / d.z
    let x0 = view.cx + a.x * view.scale * iaz
    let y0 = view.cy - a.y * view.scale * iaz
    let x1 = view.cx + b.x * view.scale * ibz
    let y1 = view.cy - b.y * view.scale * ibz
    let x2 = view.cx + d.x * view.scale * icz
    let y2 = view.cy - d.y * view.scale * icz

    let area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
    if area <= 0.0 {
        return
    }
    var minX = Math.floor(Math.minF64(x0, Math.minF64(x1, x2))) as i64
    var maxX = Math.ceil(Math.maxF64(x0, Math.maxF64(x1, x2))) as i64
    var minY = Math.floor(Math.minF64(y0, Math.minF64(y1, y2))) as i64
    var maxY = Math.ceil(Math.maxF64(y0, Math.maxF64(y1, y2))) as i64
    if minX < 0 {
        minX = 0
    }
    if minY < 0 {
        minY = 0
    }
    if maxX > s.w {
        maxX = s.w
    }
    if maxY > s.h {
        maxY = s.h
    }
    if minX >= maxX || minY >= maxY {
        return
    }
    s.tris = s.tris + 1
    let invArea = 1.0 / area
    let au = a.u * iaz
    let av = a.v * iaz
    let bu = b.u * ibz
    let bv = b.v * ibz
    let du = d.u * icz
    let dv = d.v * icz

    var py = minY
    while py < maxY {
        let fy = (py as f64) + 0.5
        var px = minX
        while px < maxX {
            let fx = (px as f64) + 0.5
            let w0 = (x2 - x1) * (fy - y1) - (y2 - y1) * (fx - x1)
            if w0 < 0.0 {
                px = px + 1
                continue
            }
            let w1 = (x0 - x2) * (fy - y2) - (y0 - y2) * (fx - x2)
            if w1 < 0.0 {
                px = px + 1
                continue
            }
            let w2 = (x1 - x0) * (fy - y0) - (y1 - y0) * (fx - x0)
            if w2 < 0.0 {
                px = px + 1
                continue
            }
            let l0 = w0 * invArea
            let l1 = w1 * invArea
            let l2 = w2 * invArea
            let invZ = l0 * iaz + l1 * ibz + l2 * icz
            let idx = py * s.w + px
            if (s.zbuf[idx] as f64) < invZ {
                s.zbuf[idx] = invZ as f32
                let zz = 1.0 / invZ
                let uu = (l0 * au + l1 * bu + l2 * du) * zz
                let vv = (l0 * av + l1 * bv + l2 * dv) * zz
                // Smooth shading: the light term is per vertex and interpolated,
                // so a curved surface stops looking like a stack of flat facets.
                let sh = l0 * a.light + l1 * b.light + l2 * d.light
                var tx2 = ((uu * (t.w as f64)) as i64) & t.mask
                var ty2 = ((vv * (t.h as f64)) as i64) & t.mask
                if tx2 < 0 {
                    tx2 = 0
                }
                if ty2 < 0 {
                    ty2 = 0
                }
                let ti = ((ty2 << t.shift) + tx2) * 3
                var f = (zz - s.fogStart) / (s.fogEnd - s.fogStart)
                if f < 0.0 {
                    f = 0.0
                }
                if f > 1.0 {
                    f = 1.0
                }
                let o = idx * 3
                let rr = tr * sh * (t.px[ti] as f64)
                let gg = tg * sh * (t.px[ti + 1] as f64)
                let bb = tb * sh * (t.px[ti + 2] as f64)
                c.hdr[o] = (rr * (1.0 - f) + s.fogR * f) as f32
                c.hdr[o + 1] = (gg * (1.0 - f) + s.fogG * f) as f32
                c.hdr[o + 2] = (bb * (1.0 - f) + s.fogB * f) as f32
            }
            px = px + 1
        }
        py = py + 1
    }
}

// World-space textured triangle, near-clipped. The clip carries every vertex
// attribute by the same parameter, which a struct makes automatic.
pub fn triangleV(c: &mut Canvas, s: &mut Scene, view: &View, t: &Texture, wa: &Vtx, wb: &Vtx, wd: &Vtx, tr: f64, tg: f64, tb: f64) {
    let ca = toCamera(view, wa.x, wa.y, wa.z)
    let cb = toCamera(view, wb.x, wb.y, wb.z)
    let cd = toCamera(view, wd.x, wd.y, wd.z)
    let a = vtx(ca.x, ca.y, ca.z, wa.u, wa.v, wa.light)
    let b = vtx(cb.x, cb.y, cb.z, wb.u, wb.v, wb.light)
    let d = vtx(cd.x, cd.y, cd.z, wd.u, wd.v, wd.light)
    if a.z > NEAR && b.z > NEAR && d.z > NEAR {
        rasterCamTex(c, s, view, t, a, b, d, tr, tg, tb)
        return
    }
    if a.z <= NEAR && b.z <= NEAR && d.z <= NEAR {
        return
    }
    var poly: Vec<Vtx> = Vec.new()
    clipV(poly, a, b)
    clipV(poly, b, d)
    clipV(poly, d, a)
    if poly.len < 3 {
        return
    }
    for i in 1..poly.len - 1 {
        rasterCamTex(c, s, view, t, poly[0], poly[i], poly[i + 1], tr, tg, tb)
    }
}

fn clipV(out: &mut Vec<Vtx>, a: &Vtx, b: &Vtx) {
    let ina = a.z > NEAR
    let inb = b.z > NEAR
    if ina {
        out.push(vtx(a.x, a.y, a.z, a.u, a.v, a.light))
    }
    if ina != inb {
        let t = (NEAR - a.z) / (b.z - a.z)
        out.push(vtx(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, NEAR, a.u + (b.u - a.u) * t, a.v + (b.v - a.v) * t, a.light + (b.light - a.light) * t))
    }
}

// Lambert term for a triangle whose world-space normal is (nx,ny,nz).
pub fn shade(s: &Scene, nx: f64, ny: f64, nz: f64, ambient: f64): f64 {
    var d = nx * s.sunX + ny * s.sunY + nz * s.sunZ
    if d < 0.0 {
        d = 0.0
    }
    return ambient + (1.0 - ambient) * d
}

// ── textures ──────────────────────────────────────────────────────────────────
//
// Power-of-two RGB textures sampled with wrap, generated procedurally at startup
// — there is no asset pipeline here, and none is needed for surface detail.

pub struct Texture {
    w: i64,
    h: i64,
    mask: i64, // w-1, w is a power of two
    shift: i64, // log2(w), for the row stride
    px: Vec<f32>, // 3 floats per texel
}

pub fn texNew(size: i64, shift: i64): Texture {
    return Texture {
        w: size,
        h: size,
        mask: size - 1,
        shift: shift,
        px: Vec.filled(size * size * 3, 0.0),
    }
}

pub fn texSet(t: &mut Texture, x: i64, y: i64, r: f64, g: f64, b: f64) {
    let i = ((y << t.shift) + x) * 3
    t.px[i] = r as f32
    t.px[i + 1] = g as f32
    t.px[i + 2] = b as f32
}

// Perspective-correct textured triangle. The extra work over the flat path is
// interpolating u/z and v/z alongside 1/z and dividing per pixel — which is what
// "perspective-correct" means: interpolating u,v directly in screen space slides
// the texture around as the surface tilts away.
