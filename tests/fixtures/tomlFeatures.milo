// TOML v1.0.0 surface coverage for std/toml: every construct the spec defines,
// read back through the accessor vocabulary std/json established.
// Conformance against a second implementation lives in scripts/toml-oracle.py.
from "std/toml" import {
    Toml,
    TomlKind
}

fn kindName(t: &Toml, path: string): string {
    let Option.Some(k) = t.curKind(t.curPath(path)) else {
        return "missing"
    }
    match k {
        TomlKind.Str => {
            return "Str"
        }
        TomlKind.Int => {
            return "Int"
        }
        TomlKind.Float => {
            return "Float"
        }
        TomlKind.Bool => {
            return "Bool"
        }
        TomlKind.DateTime => {
            return "DateTime"
        }
        TomlKind.Array => {
            return "Array"
        }
        TomlKind.Table => {
            return "Table"
        }
    }
}

fn strings(): i32 {
    let src = "basic = \"a\\tb\\nc \\\"q\\\" \\\\ \\u00e9 \\U0001F600\"\n"
    + "literal = 'C:\\Users\\raw'\n"
    + "ml = \"\"\"\nline one\nline two\"\"\"\n"
    + "cont = \"\"\"one \\\n     two\"\"\"\n"
    + "mlLit = '''\nraw \\n stays'''\n"
    + "quotes = \"\"\"two \"\" then three \"\"\\\".\"\"\"\n"
    let t = Toml.parse(src)!
    print(t.str("basic")!)
    print(t.str("literal")!)
    print(t.str("ml")!)
    print(t.str("cont")!)
    print(t.str("mlLit")!)
    print(t.str("quotes")!)
    return 0
}

fn numbers(): i32 {
    let src = "hex = 0xDEAD_beef\noct = 0o755\nbin = 0b1011\n"
    + "dec = 1_234_567\npos = +7\nneg = -7\n"
    + "min = -9223372036854775808\nmax = 9223372036854775807\n"
    + "pi = 3.141_59\nexp = 1e3\nnegExp = -2E-2\n"
    + "posInf = inf\nnegInf = -inf\nnotNum = nan\n"
    let t = Toml.parse(src)!
    print(t.i64("hex")!.toString())
    print(t.i64("oct")!.toString())
    print(t.i64("bin")!.toString())
    print(t.i64("dec")!.toString())
    print(t.i64("pos")!.toString())
    print(t.i64("neg")!.toString())
    print(t.i64("min")!.toString())
    print(t.i64("max")!.toString())
    print(t.f64("pi")!.toString())
    print(t.f64("exp")!.toString())
    print(t.f64("negExp")!.toString())
    print((t.f64("posInf")! > 0.0).toString())
    print((t.f64("negInf")! < 0.0).toString())
    // NaN is the only value not equal to itself.
    let n = t.f64("notNum")!
    print((n != n).toString())
    // An integer widens for a float read; a float never truncates to an integer.
    print(t.f64("dec")!.toString())
    print(t.i64("pi").isNone().toString())
    return 0
}

fn datetimes(): i32 {
    let src = "odt = 1979-05-27T07:32:00Z\nldt = 1979-05-27 07:32:00.999\n"
    + "ld = 1979-05-27\nlt = 07:32:00\n"
    let t = Toml.parse(src)!
    print(t.str("odt")!)
    print(t.str("ldt")!)
    print(t.str("ld")!)
    print(t.str("lt")!)
    print(kindName(t, "odt"))
    print(t.get("ld")!.isDateTime().toString())
    print(t.get("ld")!.isStr().toString())
    return 0
}

fn containers(): i32 {
    let src = "nums = [1, 2, 3]\nnested = [[1, 2], [\"a\"]]\n"
    + "multi = [\n  10,\n  20, # comment inside\n]\n"
    + "empty = []\ninline = { x = 1, y = { z = \"deep\" } }\n"
    + "dotted.a.b = 9\ndotted.a.c = 10\n"
    let t = Toml.parse(src)!
    print(t.get("nums")!.len().toString())
    print(t.get("nums")!.at(2)!.asI64()!.toString())
    print(t.i64Path("nested[1]").isNone().toString())
    print(t.strPath("nested[1][0]")!)
    print(t.i64Path("multi[1]")!.toString())
    print(t.get("empty")!.len().toString())
    print(t.i64Path("inline.x")!.toString())
    print(t.strPath("inline.y.z")!)
    print(t.i64Path("dotted.a.b")!.toString())
    print(t.i64Path("dotted.a.c")!.toString())
    print(kindName(t, "nums"))
    print(kindName(t, "inline"))
    print(t.get("nums")!.isArray().toString())
    return 0
}

fn tables(): i32 {
    let src = "[server]\nhost = \"localhost\"\nport = 8080\n"
    + "\n[server.tls]\nenabled = true\n"
    + "\n[[peer]]\nname = \"alpha\"\n"
    + "\n[[peer]]\nname = \"beta\"\n"
    + "\n[peer.meta]\nnote = \"attaches to the last element\"\n"
    + "\n[\"quoted.name\"]\nv = 1\n"
    let t = Toml.parse(src)!
    let server = t.table("server")!
    print(server.str("host")!)
    print(server.i64("port")!.toString())
    print(server.table("tls")!.bool("enabled")!.toString())
    print(t.boolPath("server.tls.enabled")!.toString())
    print(t.get("peer")!.len().toString())
    print(t.strPath("peer[0].name")!)
    print(t.strPath("peer[1].name")!)
    print(t.strPath("peer[1].meta.note")!)
    // A key holding a '.' is reachable through get(), not through a dotted path.
    print(t.get("quoted.name")!.i64("v")!.toString())
    print(t.i64Path("quoted.name.v").isNone().toString())
    let names = t.keys()
    print(names.len().toString())
    print(names[0].clone())
    print(t.table("server")!.isTable().toString())
    print(t.table("missing").isNone().toString())
    return 0
}

pub fn main(): i32 {
    strings()
    numbers()
    datetimes()
    containers()
    tables()
    return 0
}
