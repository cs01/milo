// @expect: count=4 len=16
// @expect: welded v0=3 v15=3
// @expect: short: a window is missing
// @expect: foreign: different shatter
// A Vec divided into disjoint owned windows, transformed in place on four real
// OS threads, and reassembled into the same allocation. No element is copied and
// no reference crosses a thread: what the workers receive is an owned window.
from "std/shard" import {
    Shard, Shards, WeldError, shatter
}
from "std/runtime" import {
    Promise
}

fn double(w: Shard<f64>): Shard<f64> {
    var s = w
    var j: i64 = 0
    while j < s.len() {
        s.set(j, s.get(j) * 2.0 + 1.0)
        j = j + 1
    }
    return s
}

pub fn main(): i32 {
    var data: Vec<f64> = Vec.new()
    var i: i64 = 0
    while i < 16 {
        data.push(1.0)
        i = i + 1
    }

    var owner = shatter(data, 4)
    print("count=" + owner.count().toString() + " len=" + owner.len().toString())

    var windows = owner.windows()
    var ps: Vec<Promise<Shard<f64>>> = Vec.new()
    while windows.len > 0 {
        let w = windows.pop()!
        ps.push(Promise<Shard<f64>>.blocking(move(): Shard<f64> => {
            return double(w)
        }
        ))
    }
    let back = Promise.all(ps).await()!
    match owner.weld(back) {
        Result.Ok(v) => {
            print("welded v0=" + v[0].toString() + " v15=" + v[15].toString())
        }
        Result.Err(_e) => {
            print("WRONG: weld failed")
        }
    }

    // A window that never came back means a worker may still hold a pointer into
    // the buffer, so handing the Vec back would be the use-after-free this module
    // exists to avoid. Caught, deterministically.
    var d2: Vec<i64> = Vec.new()
    var k: i64 = 0
    while k < 8 {
        d2.push(k)
        k = k + 1
    }
    var o2 = shatter(d2, 4)
    var w2 = o2.windows()
    let _dropped = w2.pop()!
    match o2.weld(w2) {
        Result.Ok(_v) => {
            print("WRONG: welded with a window missing")
        }
        Result.Err(_e) => {
            print("short: a window is missing")
        }
    }

    // Windows from another shatter are rejected on identity, not on shape.
    var d3: Vec<i64> = Vec.new()
    d3.push(1)
    d3.push(2)
    var o3 = shatter(d3, 2)
    var d4: Vec<i64> = Vec.new()
    d4.push(3)
    d4.push(4)
    var o4 = shatter(d4, 2)
    let foreign = o4.windows()
    match o3.weld(foreign) {
        Result.Ok(_v) => {
            print("WRONG: welded foreign windows")
        }
        Result.Err(_e) => {
            print("foreign: different shatter")
        }
    }

    // Note on the coverage branch: handing the SAME window back twice cannot be
    // reached through this API at all, because Shard is @noCopy and there is no way
    // to produce two shards naming one window. That branch stays as a defensive
    // check rather than a tested path, and this comment says so instead of a test
    // pretending to cover it.
    return 0
}
