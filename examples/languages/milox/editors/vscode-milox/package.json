{
  "name": "milox-lang",
  "displayName": "milox",
  "description": "Syntax highlighting for milox, the example scripting language in examples/languages/milox",
  "version": "0.1.0",
  "publisher": "milo-language",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "milox",
        "aliases": [
          "milox"
        ],
        "extensions": [
          ".milox"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "milox",
        "scopeName": "source.milox",
        "path": "./syntaxes/milox.tmLanguage.json"
      }
    ]
  }
}
