// milox value representation: every runtime value is exactly 8 bytes.
//
// A double is stored as itself. Everything else hides in the payload of a
// quiet NaN, which is the one f64 bit pattern nobody computes with. The
// enum equivalent
//
//     enum Value { Num(f64), Nil, Bool(bool), Obj(Handle<Obj>) }
//
// lowers to `{ i32, [2 x i64] }` = 24 bytes, because the tag has to be
// separate from the widest payload. Nan-boxing folds the tag into bits the
// payload was never using, so a value stack holds 3x more per cache line.
//
// The safety difference from every C implementation of this trick: C packs a
// raw pointer into the 48 payload bits, so a stale box is a use-after-free.
// We pack an arena Handle (index + generation). Unboxing goes through the
// arena's generation check, so a stale box is a caught None, and an entirely
// forged u64 is at worst a None. There is no bit pattern that dereferences
// freed memory.
from "std/binary" import {
    Bytes
}

// Bits 62..50 all set marks a non-double. Hardware NaN from 0.0/0.0 is
// 0x7ff8_0000_0000_0000, which clears bit 50, so real NaN and both infinities
// survive round-trip as numbers. Only this one quiet-NaN encoding is stolen.
pub let QNAN: u64 = 0x7ffc000000000000
// Sign bit distinguishes "heap object" from "singleton".
pub let SIGN: u64 = 0x8000000000000000

let TAG_NIL: u64 = 1
let TAG_FALSE: u64 = 2
let TAG_TRUE: u64 = 3

// 50 payload bits, split index/generation. Both limits are enforced at boxing
// time rather than masked away: a generation truncated to fit would let slot
// reuse alias an old handle back into validity, which is the exact hole the
// generation counter exists to close.
pub let INDEX_BITS: u64 = 24

pub let MAX_INDEX: i64 = 16777215

pub let MAX_GENERATION: i64 = 67108863

pub struct Value {
    bits: u64,
}

impl Value {
    fn num(d: f64): Value {
        return Value {
            bits: Bytes.f64ToBits(d)
        }
    }
    fn nil(): Value {
        return Value {
            bits: QNAN | TAG_NIL
        }
    }
    fn bool(b: bool): Value {
        if b {
            return Value {
                bits: QNAN | TAG_TRUE
            }
        }
        return Value {
            bits: QNAN | TAG_FALSE
        }
    }

    // Box an arena slot. Takes the handle's two fields rather than the handle
    // itself because a generic static method (`fn obj<T>(h: Handle<T>)`) cannot
    // infer T from its argument today. Keeping it as ints also decouples the
    // box from the heap's element type. Aborts rather than truncating: see
    // MAX_GENERATION above.
    fn obj(index: i32, generation: i32): Value {
        let idx = index as i64
        let gen = generation as i64
        assert(idx >= 0 && idx <= MAX_INDEX, "milox: heap index exceeds 24-bit nan-box payload")
        assert(gen >= 0 && gen <= MAX_GENERATION, "milox: slot generation exceeds 26-bit nan-box payload")
        let payload = ((gen as u64) << INDEX_BITS) | (idx as u64)
        return Value {
            bits: SIGN | QNAN | payload
        }
    }

    fn isNum(self: &Self): bool {
        return (self.bits & QNAN) != QNAN
    }
    fn isObj(self: &Self): bool {
        return (self.bits & (QNAN | SIGN)) == (QNAN | SIGN)
    }
    fn isNil(self: &Self): bool {
        return self.bits == (QNAN | TAG_NIL)
    }
    fn isBool(self: &Self): bool {
        return self.bits == (QNAN | TAG_TRUE) || self.bits == (QNAN | TAG_FALSE)
    }

    fn asNum(self: &Self): f64 {
        return Bytes.f64FromBits(self.bits)
    }
    fn asBool(self: &Self): bool {
        return self.bits == (QNAN | TAG_TRUE)
    }

    fn objIndex(self: &Self): i32 {
        return (self.bits & 0xffffff) as i32
    }
    fn objGeneration(self: &Self): i32 {
        return ((self.bits >> INDEX_BITS) & 0x3ffffff) as i32
    }

    // Everything but nil and false is truthy, as in Lua.
    fn truthy(self: &Self): bool {
        if self.isNil() {
            return false
        }
        if self.isBool() {
            return self.asBool()
        }
        return true
    }

    // Bitwise identity. Correct for numbers (except NaN, which is never equal
    // to itself, matching IEEE), singletons, and object identity. Structural
    // string equality is the VM's job, not the box's.
    fn sameBits(self: &Self, other: &Value): bool {
        return self.bits == other.bits
    }

    fn rawBits(self: &Self): u64 {
        return self.bits
    }
}
