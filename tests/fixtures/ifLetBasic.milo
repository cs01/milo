// @expect: got 42
// @expect: done

pub enum Maybe {
    Some(i32),
    None,
}

pub fn main(): i32 {
    let x = Maybe.Some(42)
    if let Maybe.Some(val) = x {
        print("got ", val)
    }

    let y = Maybe.None
    if let Maybe.Some(val) = y {
        print("should not print")
    }

    print("done")
    return 0
}
