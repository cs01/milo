// @run: fn examples/hello.milo
// rg — ripgrep-lite: regex-powered recursive search

from "std/argparse" import {
    ArgParser
}

from "std/fs" import {
    isDir, isFile, readDir, readFile
}
from "std/path" import {
    Path
}
from "std/regex" import {
    Regex, RegexMatch
}
from "std/color" import {
    Color
}
from "std/runtime" import {
    Promise
}
from "std/string" import {
    strContainsIgnoreCase, strIndexOfFromIgnoreCase
}

// ── helpers ──

pub fn shouldSkipDir(name: &string): bool {
    if name == ".git" {
        return true
    }
    if name == ".hg" {
        return true
    }
    if name == ".svn" {
        return true
    }
    if name == "node_modules" {
        return true
    }
    if name == "target" {
        return true
    }
    if name == "build" {
        return true
    }
    if name == "dist" {
        return true
    }
    if name == "__pycache__" {
        return true
    }
    if name == ".cache" {
        return true
    }
    return false
}

pub fn matchesType(path: &string, fileType: &string): bool {
    if fileType.len == 0 {
        return true
    }
    let ext = Path.ext(path)
    if ext.len == 0 {
        return false
    }
    return ext == "." + fileType
}

pub fn isWordChar(ch: u8): bool {
    return (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57) || ch == 95
}

// ── options ──

pub struct RgOpts {
    countOnly: bool,
    filesOnly: bool,
    invert: bool,
    wordBound: bool,
    noColor: bool,
    noLineNum: bool,
    noHeading: bool,
    searchHidden: bool,
    maxCount: i64,
    afterCtx: i64,
    beforeCtx: i64,
    fileType: string,
    totalMatches: i64,
    needsSeparator: bool,
    // The pattern, plus whether it is a plain substring. Kept on the options so
    // the whole-file reject below does not recompute it per file.
    pattern: string,
    literal: bool,
    // -i has to reach the literal matcher, not just the regex flags. It used to stop
    // at the flags, so `rg -i foo` prefiltered case-SENSITIVELY and silently dropped
    // every match that differed in case — a wrong answer, not a slow one.
    //
    // Folding happens inside the search (std/string's case-insensitive memchr
    // scan), not by lowercasing a copy of every file — that copy cost more than the
    // search it fed.
    ignoreCase: bool,
}

// Next occurrence of the literal at or after `from`, honouring -i.
pub fn literalFrom(content: &string, opts: &RgOpts, from: i64): Option<i64> {
    if opts.ignoreCase {
        let at = strIndexOfFromIgnoreCase(content, opts.pattern, from)
        if at < 0 {
            return Option.None
        }
        return Option.Some(at)
    }
    return content.indexOfFrom(opts.pattern, from)
}

pub fn literalIn(content: &string, needle: &string, ci: bool): bool {
    if ci {
        return strContainsIgnoreCase(content, needle)
    }
    return content.contains(needle)
}

// ── match helpers ──

pub fn filterWordBounds(line: &string, matches: Vec<RegexMatch>): Vec<RegexMatch> {
    var result: Vec<RegexMatch> = Vec.new()
    for i in 0..matches.len {
        var ok = true
        if matches[i].start > 0 {
            if isWordChar(line[matches[i].start - 1]) {
                ok = false
            }
        }
        if ok && matches[i].end < line.len {
            if isWordChar(line[matches[i].end]) {
                ok = false
            }
        }
        if ok {
            result.push(RegexMatch {
                start: matches[i].start, end: matches[i].end
            }
            )
        }
    }
    return result
}

// A pattern with no regex metacharacters is just a substring search, and
// `contains` bottoms out in memchr + memcmp. Running the regex engine over every
// line of every file to find "uint256" is most of what made a tree-wide search
// slow — ripgrep's equivalent is its literal prefilter.
pub fn isPlainLiteral(pat: &string): bool {
    if pat.len == 0 {
        return false
    }
    for byte in pat {
        // . * + ? [ ] ( ) { } | ^ $ \
        if byte == 46 || byte == 42 || byte == 43 || byte == 63 {
            return false
        }
        if byte == 91 || byte == 93 || byte == 40 || byte == 41 {
            return false
        }
        if byte == 123 || byte == 125 || byte == 124 || byte == 94 {
            return false
        }
        if byte == 36 || byte == 92 {
            return false
        }
        // A newline in the pattern would let a whole-buffer match straddle two lines,
        // which the literal path's "one match per line" bookkeeping cannot express.
        // The regex path cannot match it either — it searches line by line.
        if byte == 10 {
            return false
        }
    }
    return true
}

pub fn getMatches(re: &mut Regex, line: &string, wordBound: bool): Vec<RegexMatch> {
    if wordBound {
        return filterWordBounds(line, re.findAll(line))
    }
    return re.findAll(line)
}

pub fn highlightLine(line: &string, matches: &Vec<RegexMatch>, noColor: bool): string {
    if noColor || matches.len == 0 {
        return line.clone()
    }
    var result: string = ""
    var pos: i64 = 0
    for i in 0..matches.len {
        if matches[i].start > pos {
            result = result + line.substr(pos, matches[i].start)
        }
        let m = line.substr(matches[i].start, matches[i].end)
        result = result + Color.bold(Color.red(m))
        pos = matches[i].end
    }
    if pos < line.len {
        result = result + line.substr(pos, line.len)
    }
    return result
}

// ── output formatting ──

pub fn formatLine(content: &string, lineNum: i64, isMatch: bool, filePath: &string, multiFile: bool, opts: &RgOpts): string {
    var out: string = ""
    if multiFile && opts.noHeading {
        if opts.noColor {
            out = out + filePath
        } else {
            out = out + Color.magenta(filePath)
        }
        out = out + ":"
    }
    if !opts.noLineNum {
        let num = (lineNum + 1).toString()
        if opts.noColor {
            out = out + num
        } else {
            out = out + Color.green(num)
        }
        if isMatch {
            out = out + ":"
        } else {
            out = out + "-"
        }
    }
    out = out + content
    return out
}

// ── file search ──

pub fn searchFile(filePath: &string, re: &mut Regex, opts: &mut RgOpts, multiFile: bool): void {
    if !matchesType(filePath, opts.fileType) {
        return
    }

    let content = match readFile(filePath) {
        Result.Ok(data) => data
        Result.Err(_) => {
            return
        }
    }
    searchContent(content, filePath, re, opts, multiFile, false)
}

// `knownMatch` is set by the parallel path, which already proved the literal is in
// this buffer — re-running the whole-file reject there would scan every matching
// file twice for an answer it has.
pub fn searchContent(content: &string, filePath: &string, re: &mut Regex, opts: &mut RgOpts, multiFile: bool, knownMatch: bool): void {
    // Whole-file reject: if the pattern is a literal and the file does not contain
    // it anywhere, there is nothing to split, allocate or scan line by line. One
    // memchr pass over the buffer replaces N regex runs.
    if !knownMatch && opts.literal && !opts.invert && !literalIn(content, opts.pattern, opts.ignoreCase) {
        return
    }

    // Literal pattern, no context to print: search the file buffer, not its lines.
    //
    // Visiting every line to ask "does it match" costs a scan and a `Vec` per line —
    // 200k of each on this tree — to reject ~99% of them. Searching the whole buffer
    // instead means one memchr walk that lands directly on the next match and never
    // touches the bytes of a line that has none. Lines are only reconstructed around
    // the matches that survive, which is what makes this a scan of the ~1% rather
    // than a scan of everything.
    //
    // `isPlainLiteral` rejects a pattern containing a newline, so a match is always
    // contained in one line and `lineEnd` below is always past it.
    if opts.literal && !opts.invert && opts.beforeCtx == 0 && opts.afterCtx == 0 && !opts.filesOnly {
        var matchCountF: i64 = 0
        var headerPrintedF: bool = false
        // The newline walk is what locates the start of the matching line, so it is
        // needed by anything that prints the line — but -c prints only a tally, and
        // skips it entirely.
        let needLineNo = !opts.countOnly
        var lineNo: i64 = 0
        var lineStart: i64 = 0
        var pos: i64 = 0
        let plen = opts.pattern.len
        while true {
            let Option.Some(at) = literalFrom(content, opts, pos) else {
                break
            }
            // Walk forward to the line holding this match. lineStart never moves
            // backwards, so across the whole file this visits each newline once.
            if needLineNo {
                while true {
                    let Option.Some(nl) = content.indexOfFrom("\n", lineStart) else {
                        break
                    }
                    if nl >= at {
                        break
                    }
                    lineStart = nl + 1
                    lineNo = lineNo + 1
                }
            }
            var lineEnd = content.len
            if let Option.Some(nl) = content.indexOfFrom("\n", at) {
                lineEnd = nl
            }

            matchCountF = matchCountF + 1
            if !opts.countOnly {
                if !headerPrintedF && multiFile && !opts.noHeading {
                    if opts.needsSeparator {
                        print("")
                    }
                    if opts.noColor {
                        print(filePath)
                    } else {
                        print(Color.magenta(filePath))
                    }
                    headerPrintedF = true
                    opts.needsSeparator = true
                }
                // Every occurrence on this line, as offsets within the line.
                var lineMatches: Vec<RegexMatch> = Vec.new()
                var m = at
                while m + plen <= lineEnd {
                    let Option.Some(mm) = literalFrom(content, opts, m) else {
                        break
                    }
                    if mm + plen > lineEnd {
                        break
                    }
                    lineMatches.push(RegexMatch {
                        start: mm - lineStart, end: mm + plen - lineStart
                    }
                    )
                    m = mm + plen
                }
                let lineText = content.substr(lineStart, lineEnd)
                let hlF = highlightLine(lineText, lineMatches, opts.noColor || opts.invert)
                print(formatLine(hlF, lineNo, true, filePath, multiFile, opts))
            }
            if opts.maxCount > 0 && matchCountF >= opts.maxCount {
                break
            }
            // One match per line: resume past this line entirely.
            pos = lineEnd + 1
            if pos > content.len {
                break
            }
        }
        if opts.countOnly && matchCountF > 0 {
            if multiFile {
                print(filePath + ":" + matchCountF.toString())
            } else {
                print(matchCountF.toString())
            }
        }
        opts.totalMatches = opts.totalMatches + matchCountF
        return
    }

    let lines = content.split("\n")
    var numLines = lines.len
    if numLines > 0 && lines[numLines - 1].len == 0 {
        numLines = numLines - 1
    }

    var matchCount: i64 = 0
    var lastPrinted: i64 = -1 as i64
    var afterRemaining: i64 = 0
    var headerPrinted: bool = false

    for i in 0..numLines {
        let matches = getMatches(re, lines[i], opts.wordBound)
        var isMatch = matches.len > 0
        if opts.invert {
            isMatch = matches.len == 0
        }

        if isMatch {
            matchCount = matchCount + 1

            if !opts.countOnly && !opts.filesOnly {
                // file header for grouped output
                if !headerPrinted && multiFile && !opts.noHeading {
                    if opts.needsSeparator {
                        print("")
                    }
                    if opts.noColor {
                        print(filePath)
                    } else {
                        print(Color.magenta(filePath))
                    }
                    headerPrinted = true
                    opts.needsSeparator = true
                }

                // before-context lines
                var ctxStart: i64 = i - opts.beforeCtx
                if ctxStart < 0 {
                    ctxStart = 0
                }
                if ctxStart <= lastPrinted {
                    ctxStart = lastPrinted + 1
                }

                if lastPrinted >= 0 && ctxStart > lastPrinted + 1 {
                    print("--")
                }

                for j in ctxStart..i {
                    print(formatLine(lines[j], j, false, filePath, multiFile, opts))
                }

                // match line with highlighting
                let hl = highlightLine(lines[i], matches, opts.noColor || opts.invert)
                print(formatLine(hl, i, true, filePath, multiFile, opts))
                lastPrinted = i
                afterRemaining = opts.afterCtx
            }

            if opts.maxCount > 0 && matchCount >= opts.maxCount {
                break
            }
        } else if afterRemaining > 0 {
            print(formatLine(lines[i], i, false, filePath, multiFile, opts))
            lastPrinted = i
            afterRemaining = afterRemaining - 1
        }
    }

    if opts.countOnly && matchCount > 0 {
        if multiFile {
            print($"{filePath}:{matchCount}")
        } else {
            print(matchCount)
        }
    }

    if opts.filesOnly && matchCount > 0 {
        print(filePath)
    }

    opts.totalMatches = opts.totalMatches + matchCount
}

// ── directory search ──

// Walk the tree once, collecting file paths. Same skip rules as searchDir.
pub fn collectFiles(dirPath: &string, opts: &RgOpts, out: &mut Vec<string>): void {
    let entries = readDir(dirPath)!
    for i in 0..entries.len {
        let name = entries[i].name.clone()
        let entryIsDir = entries[i].isDir
        let entryIsFile = entries[i].isFile
        if !opts.searchHidden && name.len > 0 && name[0] == 46 {
            continue
        }
        let fullPath = Path.join(dirPath, name)
        if entryIsDir {
            if !shouldSkipDir(name) {
                collectFiles(fullPath, opts, out)
            }
        } else if entryIsFile {
            // Apply -t here, not in searchFile: a file the type filter rejects must
            // never reach the prescan, or the threads read it for nothing.
            if matchesType(fullPath, opts.fileType) {
                out.push(fullPath)
            }
        }
    }
}

// A file that survived the prescan, carrying the bytes the prescan already read.
pub struct Hit {
    path: string,
    content: string,
}

// Which of these files contain the literal at all? Read-only, no output, no shared
// state — which is what makes it safe to run on a pool of OS threads.
//
// The surviving file's buffer comes back with it. Answering the boolean requires
// reading the whole file anyway, and dropping the buffer only to have the printing
// pass open and read the same file a second time was pure waste — on a tree where
// ~15% of files match, that second read is the entire serial tail.
// The prescan and the matcher must agree on case, or the prescan silently drops
// files the matcher would have printed — so both go through literalIn/literalFrom.
pub fn scanChunk(paths: Vec<string>, needle: string, ci: bool): Vec<Hit> {
    var hits: Vec<Hit> = Vec.new()
    for i in 0..paths.len {
        match readFile(paths[i]) {
            Result.Ok(data) => {
                if literalIn(data, needle, ci) {
                    hits.push(Hit {
                        path: paths[i].clone(), content: data
                    }
                    )
                }
            }
            Result.Err(_) => {
            }
        }
    }
    return hits
}

// Literal search over a directory, in parallel.
//
// Only the "which files contain this at all" pass is parallel — it is the whole
// cost on a tree (most files do not match) and it produces no output, so there is
// nothing to order. Printing then happens sequentially over the surviving files,
// in walk order, so the output is byte-identical to the serial path. Threads that
// print interleave; threads that answer a boolean do not.
pub fn searchDirParallel(dirPath: &string, re: &mut Regex, opts: &mut RgOpts): void {
    var files: Vec<string> = Vec.new()
    collectFiles(dirPath, opts, files)

    let workers: i64 = 8
    if files.len < workers * 4 {
        // too few files to be worth the threads
        for i in 0..files.len {
            searchFile(files[i], re, opts, true)
        }
        return
    }

    // Round-robin, not contiguous blocks. Big files cluster in a tree (one deep
    // subdirectory of generated headers), and a contiguous split hands that whole
    // subdirectory to one worker while the rest finish early. Striding interleaves
    // any such run across all of them. Order is still recoverable — see below.
    var ps: Vec<Promise<Vec<Hit>>> = Vec.new()
    for w in 0..workers {
        var chunk: Vec<string> = Vec.new()
        var i = w
        while i < files.len {
            chunk.push(files[i].clone())
            i = i + workers
        }
        // Even an empty chunk is submitted: the merge below indexes parts by
        // `idx % workers`, so the list must stay exactly `workers` long.
        let needle = opts.pattern.clone()
        let ci = opts.ignoreCase
        ps.push(Promise<Vec<Hit>>.blocking(move(): Vec<Hit> => {
            return scanChunk(chunk, needle, ci)
        }
        ))
    }
    let parts = Promise.all(ps).await()!
    // Each worker's hits are in walk order among themselves, and worker w held
    // indices w, w+8, w+16… — so a merge across the 8 lists by original index
    // reproduces exact walk order. Tracking the index explicitly would need a field
    // on Hit; instead, walk the file list and pop from the worker that owned each
    // index, which is the same merge without the bookkeeping.
    var cursors: Vec<i64> = Vec.new()
    for _ in 0..parts.len {
        cursors.push(0)
    }
    for idx in 0..files.len {
        let w = idx % parts.len
        let c = cursors[w]
        if c >= parts[w].len {
            continue
        }
        // Its owner skipped this index (no match, or unreadable) if the head of that
        // worker's hit list is some later file.
        if parts[w][c].path != files[idx] {
            continue
        }
        cursors[w] = c + 1
        searchContent(parts[w][c].content, files[idx], re, opts, true, true)
    }
}

pub fn searchDir(dirPath: &string, re: &mut Regex, opts: &mut RgOpts): void {
    let entries = readDir(dirPath)!
    for i in 0..entries.len {
        let name = entries[i].name.clone()
        let entryIsDir = entries[i].isDir
        let entryIsFile = entries[i].isFile

        if !opts.searchHidden && name.len > 0 && name[0] == 46 {
            continue
        }

        let fullPath = Path.join(dirPath, name)
        if entryIsDir {
            if !shouldSkipDir(name) {
                searchDir(fullPath, re, opts)
            }
        } else if entryIsFile {
            searchFile(fullPath, re, opts, true)
        }
    }
}

pub fn searchPath(path: &string, re: &mut Regex, opts: &mut RgOpts): void {
    if isDir(path) {
        if opts.literal && !opts.invert {
            searchDirParallel(path, re, opts)
        } else {
            searchDir(path, re, opts)
        }
    } else if isFile(path) {
        searchFile(path, re, opts, false)
    } else {
        print($"rg: {path}: no such file or directory")
    }
}

// ── main ──

pub fn main(): i32 {
    var parser = ArgParser.new("rg", "ripgrep-lite: regex-powered recursive search")
    parser.addPositional("pattern", "regex pattern to search for")
    parser.addOptionalPositional("path", "file or directory (default: .)")
    parser.addBool("ignore-case", "i", "case-insensitive search")
    parser.addBool("count", "c", "only print count of matches per file")
    parser.addBool("files-with-matches", "l", "only print filenames that match")
    parser.addBool("invert-match", "v", "select non-matching lines")
    parser.addBool("word-regexp", "w", "match whole words only")
    parser.addBool("no-color", "p", "disable colored output")
    parser.addBool("no-line-number", "N", "hide line numbers")
    parser.addBool("no-heading", "g", "grep-style output (no file grouping)")
    parser.addBool("hidden", "H", "search hidden files and directories")
    parser.addI64("after-context", "A", "lines to show after match", 0)
    parser.addI64("before-context", "B", "lines to show before match", 0)
    parser.addI64("context", "C", "lines to show before and after match", 0)
    parser.addI64("max-count", "m", "max matches per file", 0)
    parser.addString("type", "t", "filter by file extension (e.g. milo)", "")
    let args = parser.parse()

    let pattern = args.getString("pattern")
    let ignoreCase = args.getBool("ignore-case")

    // REG_EXTENDED=1, REG_ICASE=2
    var flags: i32 = 1
    if ignoreCase {
        flags = 3
    }

    // let-else binds directly, so there's no placeholder to pre-size. The old form built
    // a dummy `Regex { _preg: [0; 128] }` just to satisfy definite-initialization, which
    // hardcoded the darwin regex_t size into an app — glibc's is 64, so this file could
    // not compile on Linux at all.
    let Result.Ok(compiled) = Regex.compileFlags(pattern.clone(), flags) else {
        print($"rg: invalid regex: {pattern}")
        return 2
    }
    var re = compiled // the search chain takes &mut Regex

    // -C sets both; -A/-B override if non-zero
    let ctxVal = args.getI64("context")
    let afterVal = args.getI64("after-context")
    let beforeVal = args.getI64("before-context")
    var afterCtx: i64 = ctxVal
    var beforeCtx: i64 = ctxVal
    if afterVal > 0 {
        afterCtx = afterVal
    }
    if beforeVal > 0 {
        beforeCtx = beforeVal
    }

    var opts = RgOpts {
        countOnly: args.getBool("count"),
        filesOnly: args.getBool("files-with-matches"),
        invert: args.getBool("invert-match"),
        wordBound: args.getBool("word-regexp"),
        noColor: args.getBool("no-color"),
        noLineNum: args.getBool("no-line-number"),
        noHeading: args.getBool("no-heading"),
        searchHidden: args.getBool("hidden"),
        maxCount: args.getI64("max-count"),
        afterCtx: afterCtx,
        beforeCtx: beforeCtx,
        fileType: args.getString("type"),
        totalMatches: 0,
        needsSeparator: false,
        pattern: pattern.clone(),
        literal: isPlainLiteral(pattern) && !args.getBool("word-regexp"),
        ignoreCase: ignoreCase,
    }

    var target = args.getString("path")
    if target.len == 0 {
        target = "."
    }

    searchPath(target, re, opts)

    if opts.totalMatches == 0 {
        return 1
    }
    return 0
}
