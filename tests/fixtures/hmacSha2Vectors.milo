from "std/hmac" import {
    Hmac
}
from "std/hex" import {
    Hex
}

fn rep(byte: i64, n: i64): string {
    var s = ""
    for _i in 0..n {
        s.push(byte as u8)
    }
    return s
}

// RFC 4231 HMAC-SHA-384 / HMAC-SHA-512 test cases 1, 2, 4, 6 and 7. Cases 6 and 7
// use a 131-byte key, which is the only path that exercises the "key longer than
// the block, hash it first" branch — and the SHA-2/512 family's block is 128 bytes,
// not 64, so a copy-paste from the SHA-256 code would pass every other vector here
// and fail these two.
pub fn main(): i32 {
    let k1 = rep(0x0b, 20)
    print(Hex.encode(Hmac.sha384Bytes(k1, "Hi There")))
    print(Hmac.sha512(k1, "Hi There"))

    print(Hex.encode(Hmac.sha384Bytes("Jefe", "what do ya want for nothing?")))
    print(Hmac.sha512("Jefe", "what do ya want for nothing?"))

    var k4 = ""
    for i in 1..26 {
        k4.push(i as u8)
    }
    let d4 = rep(0xcd, 50)
    print(Hex.encode(Hmac.sha384Bytes(k4, d4)))
    print(Hmac.sha512(k4, d4))

    let bigKey = rep(0xaa, 131)
    print(Hex.encode(Hmac.sha384Bytes(bigKey, "Test Using Larger Than Block-Size Key - Hash Key First")))
    print(Hmac.sha512(bigKey, "Test Using Larger Than Block-Size Key - Hash Key First"))

    let d7 = "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."
    print(Hex.encode(Hmac.sha384Bytes(bigKey, d7)))
    print(Hmac.sha512(bigKey, d7))
    return 0
}
