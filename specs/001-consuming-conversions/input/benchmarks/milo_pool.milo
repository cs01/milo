// Residue #1 prototype: generational Pool vs FrozenPool.
// Pool.get must generation-check every access (staleness is possible).
// freeze() consumes the pool; FrozenPool has no remove, so no handle can
// ever be stale — get is infallible and checkless by TYPE.
from "std/time" import {
    epochMillis
}

struct Handle {
    slot: i64,
    gen: i64,
}

struct Pool {
    items: Vec<i64>,
    gens: Vec<i64>,
    live: Vec<bool>,
}

struct FrozenPool {
    items: Vec<i64>,
}

impl Pool {
    fn alloc(self: &mut Self, v: i64): Handle {
        self.items.push(v)
        self.gens.push(1)
        self.live.push(true)
        return Handle {
            slot: self.items.len - 1, gen: 1
        }
    }
    fn remove(self: &mut Self, h: &Handle): void {
        if h.slot < self.gens.len {
            if self.gens[h.slot] == h.gen {
                self.live[h.slot] = false
                self.gens[h.slot] = self.gens[h.slot] + 1 // stale-ify old handles
            }
        }
    }
    // today's world: EVERY access pays slot + generation + liveness checks
    fn get(self: &Self, h: &Handle): Option<i64> {
        if h.slot >= self.items.len {
            return Option.None
        }
        if self.gens[h.slot] != h.gen {
            return Option.None
        }
        if !self.live[h.slot] {
            return Option.None
        }
        return Option.Some(self.items[h.slot])
    }
}

// consume the pool: remove no longer exists, staleness is unrepresentable
fn freeze(p: Pool): FrozenPool {
    return FrozenPool {
        items: p.items
    }
}

impl FrozenPool {
    // infallible: no Option, no generation, no liveness — just the bounds check
    fn get(self: &Self, h: &Handle): i64 {
        return self.items[h.slot]
    }
}

pub fn main(): i32 {
    let n: i64 = 1000000
    let lookups: i64 = 10

    // build
    var pool = Pool {
        items: Vec.withCapacity(n), gens: Vec.withCapacity(n), live: Vec.withCapacity(n)
    }
    var hs: Vec<Handle> = Vec.withCapacity(n)
    var i: i64 = 0
    while i < n {
        hs.push(pool.alloc(i * 3))
        i = i + 1
    }

    // demo: staleness caught at RUNTIME in the mutable world
    pool.remove(hs[0])
    match pool.get(hs[0]) {
        Option.Some(v) => {
            print("BUG: stale handle read " + v.toString())
        }
        Option.None => {
            print("mutable pool: stale handle -> None (runtime check)")
        }
    }

    // checked lookups: 10M gets through the generation gauntlet
    let t0 = epochMillis()
    var sum1: i64 = 0
    var r: i64 = 0
    while r < lookups {
        var j: i64 = 1
        while j < n {
            match pool.get(hs[j]) {
                Option.Some(v) => {
                    sum1 = sum1 + v
                }
                Option.None => {
                }
            }
            j = j + 1
        }
        r = r + 1
    }
    let t1 = epochMillis()

    // freeze: pool is consumed; handles are now valid forever
    let frozen = freeze(pool)
    let t2 = epochMillis()
    var sum2: i64 = 0
    r = 0
    while r < lookups {
        var j: i64 = 1
        while j < n {
            sum2 = sum2 + frozen.get(hs[j])
            j = j + 1
        }
        r = r + 1
    }
    let t3 = epochMillis()

    print("checked ms=" + (t1 - t0).toString() + " sum=" + sum1.toString())
    print("frozen  ms=" + (t3 - t2).toString() + " sum=" + sum2.toString())
    return 0
}
