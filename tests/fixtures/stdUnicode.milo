from "std/unicode" import {
    isAlphaStr, isNumeric
}

pub fn boolStr(b: bool): string {
    if b {
        return "true"
    }
    return "false"
}

pub fn main(): i32 {
    print(boolStr(asciiIsDigit(48)))
    print(boolStr(asciiIsDigit(65)))
    print(boolStr(asciiIsAlpha(65)))
    print(boolStr(asciiIsAlpha(48)))
    print(boolStr(asciiIsWhitespace(32)))
    print(boolStr(asciiIsPunctuation(33)))
    print(boolStr(asciiIsHexDigit(102)))
    print(boolStr(asciiIsHexDigit(103)))
    print(asciiToLower(65).toString())
    print(asciiToUpper(97).toString())
    print(boolStr(isNumeric("12345")))
    print(boolStr(isNumeric("123a5")))
    print(boolStr(isAlphaStr("hello")))
    print(boolStr(isAlphaStr("hello1")))
    return 0
}
