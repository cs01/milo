// Drawing the flight world: sky, terrain, coins, the aircraft, and the HUD.

from "std/math" import {
    Math
}
from "./gfx" import {
    Canvas, fillRect, spot, line, text, textCentered, textWidth
}
// Small by-value carriers. Returning Vec<f64>/Vec<i64> from these allocated once
// per terrain quad per frame — a few thousand mallocs a frame, and most of the
// frame time.
pub struct Rgb {
    r: f64,
    g: f64,
    b: f64,
}

pub struct Off {
    x: i64,
    z: i64,
}

from "./gfx3d" import {
    Scene, View, Camera, viewOf, sceneClear, triangle, triangleTex, Texture, shade, toCamera
}
from "./textures" import {
    groundTexture, planeTexture
}
from "./world3d" import {
    World, Trail, heightAt, TILE, VIEW_TILES
}

// Sky gradient plus a sun disc, painted before anything else. There is no depth
// test here — the terrain simply draws over it.
fn drawSky(c: &mut Canvas, s: &Scene, w: &World, v: &View) {
    for y in 0..c.h {
        let t = (y as f64) / (c.h as f64)
        let k = 1.0 - t
        let r = 0.10 + 0.34 * k * k + s.fogR * t * 0.55
        let g = 0.22 + 0.36 * k * k + s.fogG * t * 0.55
        let b = 0.52 + 0.34 * k * k + s.fogB * t * 0.40
        fillRect(c, 0.0, y as f64, c.w as f64, (y + 1) as f64, r * 0.42, g * 0.42, b * 0.45)
    }
    // sun projected from its direction, so it sits correctly as you turn
    let far = 6000.0
    let sp = toCamera(v, w.cam.x + s.sunX * far, w.cam.y + s.sunY * far, w.cam.z + s.sunZ * far)
    if sp.z > 1.0 {
        let sx = v.cx + sp.x * v.scale / sp.z
        let sy = v.cy - sp.y * v.scale / sp.z
        spot(c, sx, sy, 190.0, 0.16, 0.13, 0.07)
        spot(c, sx, sy, 62.0, 0.9, 0.78, 0.42)
        spot(c, sx, sy, 30.0, 1.9, 1.7, 1.2)
    }
}

pub fn themeName(t: i64): string {
    if t == 0 {
        return "COASTLINE"
    }
    if t == 1 {
        return "DESERT"
    }
    if t == 2 {
        return "FOREST"
    }
    return "CITY"
}

// Sky and fog per theme, so a new stretch of country reads instantly.
fn themeFog(t: i64): Rgb {
    if t == 1 {
        return Rgb {
            r: 0.60, g: 0.46, b: 0.30
        }
    }
    if t == 2 {
        return Rgb {
            r: 0.26, g: 0.38, b: 0.40
        }
    }
    if t == 3 {
        return Rgb {
            r: 0.38, g: 0.40, b: 0.46
        }
    }
    return Rgb {
        r: 0.30, g: 0.42, b: 0.62
    }
}

// Crossfade the atmosphere between the outgoing and incoming region.
// Fog distance per region — this is the weather. The coast is hazy, the desert is
// glass-clear, the forest sits in the middle, the city is smogged in.
fn themeFogRange(t: i64): Rgb {
    if t == 1 {
        return Rgb {
            r: 800.0, g: 2600.0, b: 0.0
        } // desert: see forever
    }
    if t == 2 {
        return Rgb {
            r: 380.0, g: 1400.0, b: 2.0
        } // forest: some haze
    }
    if t == 3 {
        return Rgb {
            r: 220.0, g: 900.0, b: 5.0
        } // city: smog
    }
    return Rgb {
        r: 300.0, g: 1150.0, b: 4.0
    } // coast: sea haze
}

pub fn themeSkyMix(s: &mut Scene, a: i64, b: i64, mix: f64) {
    let ra = themeFogRange(a)
    let rb = themeFogRange(b)
    s.fogStart = rb.r + (ra.r - rb.r) * mix
    s.fogEnd = rb.g + (ra.g - rb.g) * mix
    let ca = themeFog(a)
    let cb = themeFog(b)
    s.fogR = cb.r + (ca.r - cb.r) * mix
    s.fogG = cb.g + (ca.g - cb.g) * mix
    s.fogB = cb.b + (ca.b - cb.b) * mix
}

pub fn themeSky(s: &mut Scene, t: i64) {
    if t == 1 {
        s.fogR = 0.60
        s.fogG = 0.46
        s.fogB = 0.30
        s.sunX = 0.30
        s.sunY = 0.90
        s.sunZ = 0.30
    } else if t == 2 {
        s.fogR = 0.26
        s.fogG = 0.38
        s.fogB = 0.40
        s.sunX = 0.50
        s.sunY = 0.72
        s.sunZ = 0.48
    } else if t == 3 {
        s.fogR = 0.38
        s.fogG = 0.40
        s.fogB = 0.46
        s.sunX = 0.40
        s.sunY = 0.84
        s.sunZ = 0.36
    } else {
        s.fogR = 0.30
        s.fogG = 0.42
        s.fogB = 0.62
        s.sunX = 0.44
        s.sunY = 0.78
        s.sunZ = 0.44
    }
}

fn terrainColor(h: f64, slope: f64): Rgb {
    // water, sand, grass, rock, snow by height, with rock taking over on slopes
    if h < 0.0 {
        return Rgb {
            r: 0.06, g: 0.26, b: 0.46
        }
    }
    if h < 16.0 {
        return Rgb {
            r: 0.62, g: 0.55, b: 0.34
        }
    }
    if h > 168.0 {
        return Rgb {
            r: 0.82, g: 0.86, b: 0.92
        }
    }
    if slope > 0.62 || h > 130.0 {
        return Rgb {
            r: 0.34, g: 0.31, b: 0.30
        }
    }
    return Rgb {
        r: 0.16, g: 0.36, b: 0.14
    }
}

// How many tiles are on the perimeter of ring `r` (ring 0 is the single centre).
fn ringCount(r: i64): i64 {
    if r == 0 {
        return 1
    }
    return 8 * r
}

// The `i`th tile offset around ring `r`, walking the square perimeter.
fn ringOffset(r: i64, i: i64): Off {
    if r == 0 {
        return Off {
            x: 0, z: 0
        }
    }
    let side = 2 * r
    let seg = i / side
    let k = i % side
    if seg == 0 {
        return Off {
            x: 0 - r + k, z: 0 - r
        }
    }
    if seg == 1 {
        return Off {
            x: r, z: 0 - r + k
        }
    }
    if seg == 2 {
        return Off {
            x: r - k, z: r
        }
    }
    return Off {
        x: 0 - r, z: r - k
    }
}

fn themedColor(theme: i64, h: f64, slope: f64): Rgb {
    if h < 0.0 {
        // water everywhere except the city, which gets tarmac
        if theme == 3 {
            return Rgb {
                r: 0.16, g: 0.16, b: 0.18
            }
        }
        return Rgb {
            r: 0.06, g: 0.26, b: 0.46
        }
    }
    if theme == 1 {
        // desert: sand, with red rock on the steep faces
        if slope > 0.55 {
            return Rgb {
                r: 0.46, g: 0.24, b: 0.14
            }
        }
        return Rgb {
            r: 0.72, g: 0.58, b: 0.32
        }
    }
    if theme == 2 {
        // forest: deep greens, rock on the steep parts, no snow
        if slope > 0.60 {
            return Rgb {
                r: 0.26, g: 0.24, b: 0.22
            }
        }
        if h > 150.0 {
            return Rgb {
                r: 0.16, g: 0.30, b: 0.16
            }
        }
        return Rgb {
            r: 0.09, g: 0.26, b: 0.10
        }
    }
    if theme == 3 {
        // city: concrete, grey-green parks
        if slope > 0.5 {
            return Rgb {
                r: 0.24, g: 0.24, b: 0.26
            }
        }
        if h > 90.0 {
            return Rgb {
                r: 0.34, g: 0.34, b: 0.36
            }
        }
        return Rgb {
            r: 0.22, g: 0.26, b: 0.22
        }
    }
    return terrainColor(h, slope)
}

pub fn drawWorld(c: &mut Canvas, s: &mut Scene, w: &World, ground: &Texture, skin: &Texture) {
    themeSky(s, w.theme)
    themeSkyMix(s, w.prevTheme, w.theme, w.themeMix)
    let v = viewOf(w.cam, c.w, c.h)
    sceneClear(s)
    drawSky(c, s, w, v)

    // Walk a grid of quads centred on the aircraft. Anything behind the camera is
    // rejected before any per-vertex work.
    let baseX = Math.floor(w.cam.x / TILE) as i64
    let baseZ = Math.floor(w.cam.z / TILE) as i64
    let fwdX = Math.sin(w.cam.yaw)
    let fwdZ = Math.cos(w.cam.yaw)

    // Front to back, in rings out from the camera tile. The z-buffer then rejects
    // hidden pixels with a single compare instead of shading them — near terrain
    // covers the screen several times over, so this is most of the frame budget.
    for ring in 0..VIEW_TILES {
        for step in 0..ringCount(ring) {
            let off = ringOffset(ring, step)
            let tx = baseX + off.x
            let tz = baseZ + off.z
            let x0 = (tx as f64) * TILE
            let z0 = (tz as f64) * TILE
            let x1 = x0 + TILE
            let z1 = z0 + TILE
            // cheap frustum reject: quad centre must be in front of the camera
            let mx = x0 + TILE * 0.5 - w.cam.x
            let mz = z0 + TILE * 0.5 - w.cam.z
            if mx * fwdX + mz * fwdZ < 0.0 - TILE {
                continue
            }
            let d2 = mx * mx + mz * mz
            let reach = (VIEW_TILES as f64) * TILE
            if d2 > reach * reach {
                continue
            }

            let h00 = heightAt(x0, z0)
            let h10 = heightAt(x1, z0)
            let h01 = heightAt(x0, z1)
            let h11 = heightAt(x1, z1)

            // face normal from the diagonal, good enough for flat shading
            let nx = (h00 - h10) * TILE
            let nz = (h00 - h01) * TILE
            let ny = TILE * TILE
            let nl = Math.sqrt(nx * nx + ny * ny + nz * nz)
            let ux = nx / nl
            let uy = ny / nl
            let uz = nz / nl
            let slope = 1.0 - uy
            let hAvg = (h00 + h10 + h01 + h11) * 0.25
            var col = themedColor(w.theme, hAvg, slope)
            if w.themeMix > 0.0 {
                let old = themedColor(w.prevTheme, hAvg, slope)
                col.r = col.r + (old.r - col.r) * w.themeMix
                col.g = col.g + (old.g - col.g) * w.themeMix
                col.b = col.b + (old.b - col.b) * w.themeMix
            }
            // A second, finer noise field breaks up the flat facets — the single
            // cheapest thing that stops terrain reading as coloured cardboard.
            let det = 0.88 + 0.24 * propHash(tx * 3 + 11, tz * 3 + 7)
            let lit = shade(s, ux, uy, uz, 0.34)
            // a little banding by height so ridges read
            let band = 0.94 + 0.12 * Math.sin(hAvg * 0.09)
            var r = col.r * lit * band * det
            var g = col.g * lit * band * det
            var b = col.b * lit * band * det
            // Water catches the sun: a broad specular lobe off the flat surface,
            // which is most of what makes water look wet.
            if hAvg < 0.0 {
                // Weak and blue-biased: a flat-shaded surface has no view vector
                // to work with, so a strong lobe just turns the sea into ice.
                let spec = Math.pow(Math.maxF64(uy, 0.0), 26.0) * 0.20
                r = r + spec * 0.55
                g = g + spec * 0.80
                b = b + spec * 1.0
            }

            // UVs are world position over a fixed period, so the detail texture
            // tiles across the terrain with no per-quad seams.
            let uvs = 1.0 / 34.0
            let u0 = x0 * uvs
            let v0 = z0 * uvs
            let u1 = x1 * uvs
            let v1 = z1 * uvs
            // Texture only what is close enough to see. Distant quads are many,
            // small, and deep in fog — they take the cheap flat path.
            if ring < 11 {
                triangleTex(c, s, v, ground, x0, h00, z0, u0, v0, x0, h01, z1, u0, v1, x1, h10, z0, u1, v0, r, g, b)
                triangleTex(c, s, v, ground, x1, h10, z0, u1, v0, x0, h01, z1, u0, v1, x1, h11, z1, u1, v1, r, g, b)
            } else {
                triangle(c, s, v, x0, h00, z0, x0, h01, z1, x1, h10, z0, r, g, b)
                triangle(c, s, v, x1, h10, z0, x0, h01, z1, x1, h11, z1, r, g, b)
            }
        }
    }

    drawProps(c, s, w, v, baseX, baseZ)
    drawTrails(c, w, v)
    drawRings(c, s, w, v)
    drawPlane(c, s, w, v, skin)
    drawSparks(c, s, w, v)
}

// Ground detail. Each terrain tile near the aircraft may carry one prop, placed
// and sized from a stable hash so the scenery does not crawl as you fly. The kind
// follows the theme: palms on the coast, cactus in the desert, conifers in the
// forest, towers in the city.
fn propHash(x: i64, z: i64): f64 {
    let v = Math.sin((x as f64) * 271.9 + (z as f64) * 133.7) * 27183.1234
    return v - Math.floor(v)
}

fn box3(c: &mut Canvas, s: &mut Scene, v: &View, cx: f64, y0: f64, y1: f64, cz: f64, hw: f64, r: f64, g: f64, b: f64) {
    let x0 = cx - hw
    let x1 = cx + hw
    let z0 = cz - hw
    let z1 = cz + hw
    // four walls, brighter on the sunward pair, plus a cap
    triangle(c, s, v, x0, y0, z0, x0, y1, z0, x1, y1, z0, r, g, b)
    triangle(c, s, v, x0, y0, z0, x1, y1, z0, x1, y0, z0, r, g, b)
    triangle(c, s, v, x1, y0, z1, x1, y1, z1, x0, y1, z1, r * 0.7, g * 0.7, b * 0.7)
    triangle(c, s, v, x1, y0, z1, x0, y1, z1, x0, y0, z1, r * 0.7, g * 0.7, b * 0.7)
    triangle(c, s, v, x1, y0, z0, x1, y1, z0, x1, y1, z1, r * 0.85, g * 0.85, b * 0.85)
    triangle(c, s, v, x1, y0, z0, x1, y1, z1, x1, y0, z1, r * 0.85, g * 0.85, b * 0.85)
    triangle(c, s, v, x0, y0, z1, x0, y1, z1, x0, y1, z0, r * 0.55, g * 0.55, b * 0.55)
    triangle(c, s, v, x0, y0, z1, x0, y1, z0, x0, y0, z0, r * 0.55, g * 0.55, b * 0.55)
    triangle(c, s, v, x0, y1, z0, x0, y1, z1, x1, y1, z1, r * 1.15, g * 1.15, b * 1.15)
    triangle(c, s, v, x0, y1, z0, x1, y1, z1, x1, y1, z0, r * 1.15, g * 1.15, b * 1.15)
}

fn cone3(c: &mut Canvas, s: &mut Scene, v: &View, cx: f64, y0: f64, y1: f64, cz: f64, rad: f64, r: f64, g: f64, b: f64) {
    let segs = 6
    let step = 6.283185307179586 / (segs as f64)
    for k in 0..segs {
        let a0 = (k as f64) * step
        let a1 = ((k + 1) as f64) * step
        let p0x = cx + Math.cos(a0) * rad
        let p0z = cz + Math.sin(a0) * rad
        let p1x = cx + Math.cos(a1) * rad
        let p1z = cz + Math.sin(a1) * rad
        let sh = 0.65 + 0.35 * Math.cos(a0)
        triangle(c, s, v, p0x, y0, p0z, cx, y1, cz, p1x, y0, p1z, r * sh, g * sh, b * sh)
        triangle(c, s, v, p1x, y0, p1z, cx, y1, cz, p0x, y0, p0z, r * sh * 0.7, g * sh * 0.7, b * sh * 0.7)
    }
}

pub let PROP_TILES: i64 = 9

fn drawProps(c: &mut Canvas, s: &mut Scene, w: &World, v: &View, baseX: i64, baseZ: i64) {
    for gz in 0 - PROP_TILES..PROP_TILES {
        for gx in 0 - PROP_TILES..PROP_TILES {
            let tx = baseX + gx
            let tz = baseZ + gz
            let h = propHash(tx, tz)
            if h > 0.30 {
                continue // most tiles are empty
            }
            let jx = propHash(tx + 7919, tz) - 0.5
            let jz = propHash(tx, tz + 6271) - 0.5
            let x = (tx as f64) * TILE + TILE * (0.5 + jx * 0.7)
            let z = (tz as f64) * TILE + TILE * (0.5 + jz * 0.7)
            let g0 = heightAt(x, z)
            if g0 < 4.0 {
                continue // nothing grows in the water
            }
            let scale = 0.7 + h * 3.0
            if w.theme == 1 {
                // cactus: a trunk and one arm
                box3(c, s, v, x, g0, g0 + 16.0 * scale, z, 2.2, 0.16, 0.34, 0.14)
                box3(c, s, v, x + 3.0, g0 + 7.0 * scale, g0 + 13.0 * scale, z, 1.4, 0.14, 0.30, 0.12)
            } else if w.theme == 2 {
                // conifer
                box3(c, s, v, x, g0, g0 + 7.0 * scale, z, 1.4, 0.20, 0.12, 0.06)
                cone3(c, s, v, x, g0 + 5.0 * scale, g0 + 30.0 * scale, z, 7.0 * scale, 0.07, 0.26, 0.10)
            } else if w.theme == 3 {
                // tower block, height keyed off the same hash so a district varies
                let tall = 22.0 + propHash(tz, tx) * 90.0
                box3(c, s, v, x, g0, g0 + tall, z, 6.0 + h * 12.0, 0.30, 0.31, 0.34)
            } else {
                // palm: bare trunk, splayed fronds
                box3(c, s, v, x, g0, g0 + 15.0 * scale, z, 1.2, 0.26, 0.18, 0.09)
                // A palm canopy droops: the apex sits just above the trunk and the
                // rim spreads out BELOW it. Apex-up gives a fir; rim-up gives a
                // funnel. Both were wrong.
                cone3(c, s, v, x, g0 + 13.0 * scale, g0 + 18.0 * scale, z, 10.0 * scale, 0.11, 0.34, 0.13)
                cone3(c, s, v, x, g0 + 16.5 * scale, g0 + 19.5 * scale, z, 6.0 * scale, 0.13, 0.38, 0.15)
            }
        }
    }
}

// A ring: a tube of quads swept around a circle, standing across the course so
// you can see which way to be pointing when you reach it. Cleared rings expand
// and fade instead of vanishing.
fn drawRings(c: &mut Canvas, s: &mut Scene, w: &World, v: &View) {
    let segs = 14
    let tube = 5.0
    for i in 0..w.rings.len {
        var rad = w.rings[i].r
        var br = 1.0
        var cr = 1.5
        var cg = 1.15
        var cb = 0.25
        if !w.rings[i].alive {
            rad = w.rings[i].r * (1.0 + (1.0 - w.rings[i].pop) * 1.2)
            br = w.rings[i].pop
            cr = 0.5
            cg = 1.7
            cb = 0.7
            if br <= 0.03 {
                continue
            }
        }
        let cx = w.rings[i].x
        let cy = w.rings[i].y
        let cz = w.rings[i].z
        // ring plane: normal along `face`, so the hoop stands across the course
        let nx = Math.sin(w.rings[i].face)
        let nz = Math.cos(w.rings[i].face)
        let tx = nz
        let tz = 0.0 - nx
        let step = 6.283185307179586 / (segs as f64)
        for k in 0..segs {
            let a0 = (k as f64) * step
            let a1 = ((k + 1) as f64) * step
            let c0 = Math.cos(a0)
            let s0 = Math.sin(a0)
            let c1 = Math.cos(a1)
            let s1 = Math.sin(a1)
            // inner and outer edge of the tube at both ends of this segment
            let o0x = cx + tx * c0 * (rad + tube)
            let o0y = cy + s0 * (rad + tube)
            let o0z = cz + tz * c0 * (rad + tube)
            let i0x = cx + tx * c0 * (rad - tube)
            let i0y = cy + s0 * (rad - tube)
            let i0z = cz + tz * c0 * (rad - tube)
            let o1x = cx + tx * c1 * (rad + tube)
            let o1y = cy + s1 * (rad + tube)
            let o1z = cz + tz * c1 * (rad + tube)
            let i1x = cx + tx * c1 * (rad - tube)
            let i1y = cy + s1 * (rad - tube)
            let i1z = cz + tz * c1 * (rad - tube)
            // banded colour so the hoop reads as a solid object, not a circle
            var band = 1.0
            if k % 2 == 0 {
                band = 0.72
            }
            let r = cr * band * br
            let g = cg * band * br
            let b = cb * band * br
            // both faces, so the ring is solid from either side
            triangle(c, s, v, o0x, o0y, o0z, o1x, o1y, o1z, i0x, i0y, i0z, r, g, b)
            triangle(c, s, v, i0x, i0y, i0z, o1x, o1y, o1z, i1x, i1y, i1z, r, g, b)
            triangle(c, s, v, o1x, o1y, o1z, o0x, o0y, o0z, i0x, i0y, i0z, r * 0.6, g * 0.6, b * 0.6)
            triangle(c, s, v, o1x, o1y, o1z, i0x, i0y, i0z, i1x, i1y, i1z, r * 0.6, g * 0.6, b * 0.6)
        }
    }
}

// Contrails: project each stored point and join consecutive ones. Drawn without
// depth test, which is fine — they are thin, bright, and always near the camera.
fn drawTrails(c: &mut Canvas, w: &World, v: &View) {
    drawOneTrail(c, w.trailL, v)
    drawOneTrail(c, w.trailR, v)
}

fn drawOneTrail(c: &mut Canvas, t: &Vec<Trail>, v: &View) {
    if t.len < 2 {
        return
    }
    for i in 0..t.len - 1 {
        let a = toCamera(v, t[i].x, t[i].y, t[i].z)
        let b = toCamera(v, t[i + 1].x, t[i + 1].y, t[i + 1].z)
        if a.z < 1.0 || b.z < 1.0 {
            continue
        }
        let ax = v.cx + a.x * v.scale / a.z
        let ay = v.cy - a.y * v.scale / a.z
        let bx = v.cx + b.x * v.scale / b.z
        let by = v.cy - b.y * v.scale / b.z
        let f = Math.minF64(t[i].life, 1.0) * 0.55
        line(c, ax, ay, bx, by, f, f * 1.05, f * 1.15)
    }
}

// Sparks are camera-facing quads, so they stay visible whatever angle you clear
// the ring at.
fn drawSparks(c: &mut Canvas, _s: &mut Scene, w: &World, v: &View) {
    for i in 0..w.sparks.len {
        let p = toCamera(v, w.sparks[i].x, w.sparks[i].y, w.sparks[i].z)
        if p.z < 1.0 {
            continue
        }
        let sx = v.cx + p.x * v.scale / p.z
        let sy = v.cy - p.y * v.scale / p.z
        let t = w.sparks[i].life / w.sparks[i].maxLife
        let size = Math.clampF64(v.scale * 1.6 / p.z, 1.2, 14.0) * (0.4 + t)
        let f = t * t
        spot(c, sx, sy, size, w.sparks[i].cr * f, w.sparks[i].cg * f, w.sparks[i].cb * f)
    }
}

// The aircraft: a fighter with real volume — a faceted nose, a raised spine, a
// belly, LERX strakes into swept wings, twin tailfins and two engine nozzles.
// Body-space points are (forward, right, up) offsets, transformed once.
fn drawPlane(c: &mut Canvas, s: &mut Scene, w: &World, v: &View, skin: &Texture) {
    let yaw = w.plane.yaw
    let pitch = w.plane.pitch
    let roll = w.plane.roll
    let cy = Math.cos(yaw)
    let sy = Math.sin(yaw)
    let cp = Math.cos(pitch)
    let sp = Math.sin(pitch)
    let cr = Math.cos(roll)
    let sr = Math.sin(roll)
    let fx = sy * cp
    let fy = sp
    let fz = cy * cp
    let rx = cy * cr
    let ry = 0.0 - sr
    let rz = 0.0 - sy * cr
    let ux = fy * rz - fz * ry
    let uy = fz * rx - fx * rz
    let uz = fx * ry - fy * rx

    var px: Vec<f64> = Vec.new()
    var py: Vec<f64> = Vec.new()
    var pz: Vec<f64> = Vec.new()
    // 0 nose tip
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 30.0, 0.0, 0.0)
    // 1..4 forward fuselage ring (top, right, bottom, left)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 14.0, 0.0, 3.6)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 14.0, 3.4, 0.4)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 14.0, 0.0, 0.0 - 3.0)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 14.0, 0.0 - 3.4, 0.4)
    // 5..8 mid fuselage ring, fatter
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 2.0, 0.0, 5.2)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 2.0, 5.0, 0.6)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 2.0, 0.0, 0.0 - 4.4)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 2.0, 0.0 - 5.0, 0.6)
    // 9..12 tail ring
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 20.0, 0.0, 3.6)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 20.0, 4.0, 0.4)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 20.0, 0.0, 0.0 - 3.4)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 20.0, 0.0 - 4.0, 0.4)
    // 13,14 wing tips  15,16 strake roots  17,18 wing trailing roots
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 12.0, 26.0, 0.6)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 12.0, 0.0 - 26.0, 0.6)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 12.0, 3.6, 0.6)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 12.0, 0.0 - 3.6, 0.6)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 18.0, 4.4, 0.6)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 18.0, 0.0 - 4.4, 0.6)
    // 19,20 canted fin tips   21,22 tailplane tips
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 22.0, 7.0, 13.0)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 22.0, 0.0 - 7.0, 13.0)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 24.0, 13.0, 0.0)
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 24.0, 0.0 - 13.0, 0.0)
    // 23 canopy apex
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 9.0, 0.0, 6.4)

    // nose cone — four facets
    triT(c, s, v, skin, px, py, pz, 0, 1, 2, 0.5, 0.05, 0.5, 0.30, 0.9, 0.30, 1.02, 1.04, 1.08)
    triT(c, s, v, skin, px, py, pz, 0, 2, 3, 0.5, 0.05, 0.9, 0.30, 0.5, 0.30, 0.88, 0.90, 0.95)
    triT(c, s, v, skin, px, py, pz, 0, 3, 4, 0.5, 0.05, 0.5, 0.30, 0.1, 0.30, 0.72, 0.74, 0.80)
    triT(c, s, v, skin, px, py, pz, 0, 4, 1, 0.5, 0.05, 0.1, 0.30, 0.5, 0.30, 0.95, 0.97, 1.01)
    // forward → mid, four quads
    quadT(c, s, v, skin, px, py, pz, 1, 2, 6, 5, 0.50, 0.30, 0.90, 0.30, 0.90, 0.55, 0.50, 0.55, 1.00, 1.02, 1.06)
    quadT(c, s, v, skin, px, py, pz, 2, 3, 7, 6, 0.90, 0.30, 0.50, 0.30, 0.50, 0.55, 0.90, 0.55, 0.80, 0.82, 0.88)
    quadT(c, s, v, skin, px, py, pz, 3, 4, 8, 7, 0.50, 0.30, 0.10, 0.30, 0.10, 0.55, 0.50, 0.55, 0.66, 0.68, 0.74)
    quadT(c, s, v, skin, px, py, pz, 4, 1, 5, 8, 0.10, 0.30, 0.50, 0.30, 0.50, 0.55, 0.10, 0.55, 0.90, 0.92, 0.96)
    // mid → tail
    quadT(c, s, v, skin, px, py, pz, 5, 6, 10, 9, 0.50, 0.55, 0.90, 0.55, 0.90, 0.95, 0.50, 0.95, 0.96, 0.98, 1.02)
    quadT(c, s, v, skin, px, py, pz, 6, 7, 11, 10, 0.90, 0.55, 0.50, 0.55, 0.50, 0.95, 0.90, 0.95, 0.78, 0.80, 0.86)
    quadT(c, s, v, skin, px, py, pz, 7, 8, 12, 11, 0.50, 0.55, 0.10, 0.55, 0.10, 0.95, 0.50, 0.95, 0.64, 0.66, 0.72)
    quadT(c, s, v, skin, px, py, pz, 8, 5, 9, 12, 0.10, 0.55, 0.50, 0.55, 0.50, 0.95, 0.10, 0.95, 0.88, 0.90, 0.94)
    // strake + wing, upper then lower
    quadT(c, s, v, skin, px, py, pz, 15, 13, 17, 6, 0.12, 0.12, 0.95, 0.12, 0.95, 0.45, 0.12, 0.45, 1.00, 1.02, 1.06)
    quadT(c, s, v, skin, px, py, pz, 6, 17, 13, 15, 0.12, 0.45, 0.95, 0.45, 0.95, 0.12, 0.12, 0.12, 0.60, 0.62, 0.70)
    quadT(c, s, v, skin, px, py, pz, 16, 8, 18, 14, 0.12, 0.55, 0.12, 0.88, 0.95, 0.88, 0.95, 0.55, 1.00, 1.02, 1.06)
    quadT(c, s, v, skin, px, py, pz, 14, 18, 8, 16, 0.95, 0.55, 0.95, 0.88, 0.12, 0.88, 0.12, 0.55, 0.60, 0.62, 0.70)
    // close the wing tip edges so the aerofoil is not a hollow sheet
    triT(c, s, v, skin, px, py, pz, 13, 17, 6, 0.95, 0.12, 0.95, 0.45, 0.12, 0.45, 0.70, 0.72, 0.78)
    triT(c, s, v, skin, px, py, pz, 6, 17, 13, 0.12, 0.45, 0.95, 0.45, 0.95, 0.12, 0.70, 0.72, 0.78)
    triT(c, s, v, skin, px, py, pz, 14, 8, 18, 0.95, 0.55, 0.12, 0.55, 0.95, 0.88, 0.70, 0.72, 0.78)
    triT(c, s, v, skin, px, py, pz, 18, 8, 14, 0.95, 0.88, 0.12, 0.55, 0.95, 0.55, 0.70, 0.72, 0.78)

    // tailplanes
    triT(c, s, v, skin, px, py, pz, 10, 21, 9, 0.20, 0.20, 0.95, 0.20, 0.20, 0.45, 0.92, 0.94, 0.98)
    triT(c, s, v, skin, px, py, pz, 9, 21, 10, 0.20, 0.45, 0.95, 0.20, 0.20, 0.20, 0.58, 0.60, 0.66)
    triT(c, s, v, skin, px, py, pz, 12, 9, 22, 0.20, 0.20, 0.20, 0.45, 0.95, 0.20, 0.92, 0.94, 0.98)
    triT(c, s, v, skin, px, py, pz, 22, 9, 12, 0.95, 0.20, 0.20, 0.45, 0.20, 0.20, 0.58, 0.60, 0.66)
    // canted twin fins, in the accent stripe band of the sheet
    triT(c, s, v, skin, px, py, pz, 9, 19, 10, 0.30, 0.50, 0.80, 0.50, 0.30, 0.66, 1.15, 0.48, 0.26)
    triT(c, s, v, skin, px, py, pz, 10, 19, 9, 0.30, 0.66, 0.80, 0.50, 0.30, 0.50, 0.85, 0.34, 0.18)
    triT(c, s, v, skin, px, py, pz, 12, 20, 9, 0.30, 0.50, 0.80, 0.50, 0.30, 0.66, 1.15, 0.48, 0.26)
    triT(c, s, v, skin, px, py, pz, 9, 20, 12, 0.30, 0.66, 0.80, 0.50, 0.30, 0.50, 0.85, 0.34, 0.18)
    // canopy: dark glass over the spine
    triT(c, s, v, skin, px, py, pz, 1, 23, 2, 0.5, 0.30, 0.5, 0.45, 0.9, 0.40, 0.22, 0.40, 0.58)
    triT(c, s, v, skin, px, py, pz, 1, 4, 23, 0.5, 0.30, 0.1, 0.40, 0.5, 0.45, 0.26, 0.46, 0.66)
    triT(c, s, v, skin, px, py, pz, 23, 5, 2, 0.5, 0.45, 0.5, 0.60, 0.9, 0.40, 0.18, 0.34, 0.50)
    triT(c, s, v, skin, px, py, pz, 23, 4, 5, 0.5, 0.45, 0.1, 0.40, 0.5, 0.60, 0.20, 0.38, 0.54)

    // Cap the tail ring. Without this you look straight down the inside of the
    // fuselage from behind — the rings were built but never closed.
    quadT(c, s, v, skin, px, py, pz, 12, 11, 10, 9, 0.10, 0.10, 0.10, 0.30, 0.30, 0.30, 0.30, 0.10, 0.26, 0.27, 0.30)
    // recessed engine bay ring inside the cap
    let bayF = 0.0 - 19.0
    for k in 0..2 {
        var off2 = 4.0
        if k == 1 {
            off2 = 0.0 - 4.0
        }
        var qx: Vec<f64> = Vec.new()
        var qy: Vec<f64> = Vec.new()
        var qz: Vec<f64> = Vec.new()
        let segs2 = 8
        let stepA = 6.283185307179586 / (segs2 as f64)
        for j in 0..segs2 {
            let a0 = (j as f64) * stepA
            addPt(qx, qy, qz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, bayF, off2 + Math.cos(a0) * 3.0, Math.sin(a0) * 3.0)
        }
        addPt(qx, qy, qz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, bayF - 3.0, off2, 0.0)
        for j in 0..segs2 {
            let j2 = (j + 1) % segs2
            triangle(c, s, v, qx[j], qy[j], qz[j], qx[segs2], qy[segs2], qz[segs2], qx[j2], qy[j2], qz[j2], 0.14, 0.10, 0.09)
        }
    }

    // twin nozzles, glowing with throttle
    let k = (w.plane.speed - 170.0) / 170.0
    for side in 0..2 {
        var off = 4.0
        if side == 1 {
            off = 0.0 - 4.0
        }
        let ex = w.plane.x - fx * 21.0 + rx * off
        let ey = w.plane.y - fy * 21.0 + ry * off
        let ez = w.plane.z - fz * 21.0 + rz * off
        let ep = toCamera(v, ex, ey, ez)
        if ep.z > 1.0 {
            let sx = v.cx + ep.x * v.scale / ep.z
            let sy2 = v.cy - ep.y * v.scale / ep.z
            let px2 = Math.clampF64(v.scale * 3.2 / ep.z, 2.0, 26.0)
            let ab = w.boostBlend
            spot(c, sx, sy2, px2 * (1.4 + k + ab * 3.4), 0.9 + k * 1.2 + ab * 1.6, 0.32 + k * 0.5 + ab * 0.5, 0.10)
            spot(c, sx, sy2, px2 * (0.55 + ab * 1.1), 1.8 + k + ab * 1.5, 1.2 + k + ab, 0.7 + ab * 0.6)
        }
    }
}

// Two triangles from four corner indices, sharing the diagonal.
fn quadT(c: &mut Canvas, s: &mut Scene, v: &View, t: &Texture, px: &Vec<f64>, py: &Vec<f64>, pz: &Vec<f64>, a: i64, b: i64, d: i64, e: i64, ua: f64, va: f64, ub: f64, vb: f64, ud: f64, vd: f64, ue: f64, ve: f64, r: f64, g: f64, bl: f64) {
    triT(c, s, v, t, px, py, pz, a, b, d, ua, va, ub, vb, ud, vd, r, g, bl)
    triT(c, s, v, t, px, py, pz, a, d, e, ua, va, ud, vd, ue, ve, r, g, bl)
}

fn addPt(px: &mut Vec<f64>, py: &mut Vec<f64>, pz: &mut Vec<f64>, w: &World, fx: f64, fy: f64, fz: f64, rx: f64, ry: f64, rz: f64, ux: f64, uy: f64, uz: f64, f: f64, r: f64, u: f64) {
    px.push(w.plane.x + fx * f + rx * r + ux * u)
    py.push(w.plane.y + fy * f + ry * r + uy * u)
    pz.push(w.plane.z + fz * f + rz * r + uz * u)
}

// Textured variant: the three UVs pick which patch of the skin sheet this facet
// wears, so panel lines and the spine stripe land where they should.
fn triT(c: &mut Canvas, s: &mut Scene, v: &View, t: &Texture, px: &Vec<f64>, py: &Vec<f64>, pz: &Vec<f64>, a: i64, b: i64, d: i64, ua: f64, va: f64, ub: f64, vb: f64, ud: f64, vd: f64, r: f64, g: f64, bl: f64) {
    triangleTex(c, s, v, t, px[a], py[a], pz[a], ua, va, px[b], py[b], pz[b], ub, vb, px[d], py[d], pz[d], ud, vd, r, g, bl)
}

fn tri(c: &mut Canvas, s: &mut Scene, v: &View, px: &Vec<f64>, py: &Vec<f64>, pz: &Vec<f64>, a: i64, b: i64, d: i64, r: f64, g: f64, bl: f64) {
    triangle(c, s, v, px[a], py[a], pz[a], px[b], py[b], pz[b], px[d], py[d], pz[d], r, g, bl)
}

// A reticle on the next coin, and an edge arrow when it is off screen. Without
// this the trail is easy to lose the moment you overshoot one.
pub fn drawGuide(c: &mut Canvas, w: &World, _s: &Scene) {
    let v = viewOf(w.cam, c.w, c.h)
    // nearest live coin ahead
    var bi = 0 - 1
    var bd = 1.0e18
    let fwdX = Math.sin(w.plane.yaw)
    let fwdZ = Math.cos(w.plane.yaw)
    for i in 0..w.rings.len {
        if w.rings[i].alive {
            let dx = w.rings[i].x - w.plane.x
            let dy = w.rings[i].y - w.plane.y
            let dz = w.rings[i].z - w.plane.z
            // Only rings still in front. Nearest-by-distance alone will happily
            // pick one you have already flown past and point you backwards.
            if dx * fwdX + dz * fwdZ < 0.0 - 40.0 {
                continue
            }
            let d = dx * dx + dy * dy + dz * dz
            if d < bd {
                bd = d
                bi = i
            }
        }
    }
    if bi < 0 {
        return
    }
    let p = toCamera(v, w.rings[bi].x, w.rings[bi].y, w.rings[bi].z)
    let pulse = 0.65 + 0.35 * Math.sin(w.time * 6.0)
    if p.z > 1.0 {
        let sx = v.cx + p.x * v.scale / p.z
        let sy = v.cy - p.y * v.scale / p.z
        if sx > 8.0 && sx < (c.w as f64) - 8.0 && sy > 8.0 && sy < (c.h as f64) - 8.0 {
            let r = Math.clampF64(900.0 / p.z, 16.0, 90.0)
            let a = 0.30 * r
            // four corner brackets
            line(c, sx - r, sy - r + a, sx - r, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx - r, sy - r, sx - r + a, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx + r, sy - r + a, sx + r, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx + r, sy - r, sx + r - a, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx - r, sy + r - a, sx - r, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx - r, sy + r, sx - r + a, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx + r, sy + r - a, sx + r, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx + r, sy + r, sx + r - a, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            return
        }
    }
    // off screen (or behind): pin an arrow on the edge pointing the way to turn
    var dirX = p.x
    var dirY = 0.0 - p.y
    if p.z <= 1.0 {
        dirY = 0.0
    }
    let l = Math.sqrt(dirX * dirX + dirY * dirY) + 0.001
    dirX = dirX / l
    dirY = dirY / l
    let rad = Math.minF64((c.w as f64), (c.h as f64)) * 0.36
    let ax = v.cx + dirX * rad
    let ay = v.cy + dirY * rad
    let px2 = 0.0 - dirY
    let py2 = dirX
    line(c, ax + dirX * 20.0, ay + dirY * 20.0, ax + px2 * 12.0, ay + py2 * 12.0, 0.5 * pulse, 1.3 * pulse, 0.6 * pulse)
    line(c, ax + dirX * 20.0, ay + dirY * 20.0, ax - px2 * 12.0, ay - py2 * 12.0, 0.5 * pulse, 1.3 * pulse, 0.6 * pulse)
    line(c, ax - px2 * 12.0, ay - py2 * 12.0, ax + px2 * 12.0, ay + py2 * 12.0, 0.4 * pulse, 1.0 * pulse, 0.5 * pulse)
}

// Speed lines: short streaks flying outward from the centre of the screen. The
// single most legible "you are going fast" cue there is, and it costs nothing.
pub fn drawSpeedLines(c: &mut Canvas, w: &World) {
    if w.boostBlend < 0.02 {
        return
    }
    let k = w.boostBlend
    let cx = (c.w as f64) * 0.5
    let cy = (c.h as f64) * 0.5
    let n = (46.0 * k) as i64
    for i in 0..n {
        let fi = i as f64
        // each streak keeps a stable angle and radius, animated outward by time
        let a = fi * 2.399963
        let phase = Math.mod(w.time * (1.6 + Math.mod(fi, 5.0) * 0.35) + fi * 0.137, 1.0)
        let r0 = 90.0 + phase * 760.0
        let len = (26.0 + phase * 150.0) * k
        let dx = Math.cos(a)
        let dy = Math.sin(a)
        // fade in from the centre, out at the edge
        var f = phase * 2.4
        if f > 1.0 {
            f = 1.0 - (phase - 0.42) * 1.2
        }
        if f < 0.0 {
            continue
        }
        let b = f * k * 0.5
        line(c, cx + dx * r0, cy + dy * r0, cx + dx * (r0 + len), cy + dy * (r0 + len), b * 0.8, b * 0.9, b)
    }
}

pub fn drawHud(c: &mut Canvas, w: &World, s: &Scene, fps: i64) {
    text(c, 24, 22, "SCORE " + w.score.toString(), 3, 0.95, 0.80, 0.30)
    let alt = ((w.plane.y - heightAt(w.plane.x, w.plane.z)) as i64)
    text(c, 24, 58, "ALT " + alt.toString() + "   SPD " + (w.plane.speed as i64).toString(), 2, 0.35, 0.45, 0.55)
    // afterburner budget
    let bx = 24.0
    let by = (c.h as f64) - 92.0
    fillRect(c, bx, by, bx + 220.0, by + 9.0, 0.05, 0.05, 0.06)
    var brr = 0.35
    var bgg = 0.85
    var label = "AFTERBURNER"
    if w.abLocked {
        // recharging: red, and named as such, so the lockout is not a mystery
        let pulse = 0.6 + 0.4 * Math.sin(w.time * 7.0)
        brr = 0.95 * pulse
        bgg = 0.30 * pulse
        label = "RECHARGING"
    } else if w.afterburner < 0.35 {
        brr = 0.9
        bgg = 0.45
    }
    fillRect(c, bx, by, bx + 220.0 * w.afterburner, by + 9.0, brr, bgg, 0.25)
    text(c, 24, (by as i64) - 22, label, 2, brr * 0.5 + 0.15, bgg * 0.5 + 0.15, 0.34)

    let ts = "TRIS " + s.tris.toString() + "   " + fps.toString() + " FPS"
    text(c, c.w - 24 - textWidth(ts, 2), 22, ts, 2, 0.28, 0.36, 0.44)

    if w.combo > 1 {
        let f = Math.minF64(1.8, 0.7 + (w.combo as f64) * 0.07)
        textCentered(c, c.w / 2, 64, "x" + w.combo.toString(), 4, 1.5 * f, 1.1 * f, 0.25 * f)
    }

    // Where you are, and how far to the next region.
    text(c, 24, c.h - 58, themeName(w.theme), 3, 0.75, 0.72, 0.55)
    let rem = "NEXT REGION IN " + w.toNext.toString()
    text(c, 24, c.h - 26, rem, 2, 0.32, 0.34, 0.38)

    // Telegraph: name the country you are about to enter, louder as it nears.
    if w.toNext <= 3 && w.banner <= 0.0 {
        let next = themeName((w.theme + 1) % 4)
        let urgency = (4.0 - (w.toNext as f64)) / 3.0
        let pulse = 0.55 + 0.45 * Math.sin(w.time * (4.0 + urgency * 6.0))
        let k = (0.35 + urgency * 0.85) * pulse
        textCentered(c, c.w / 2, 116, "APPROACHING", 2, k * 0.8, k * 0.8, k * 0.6)
        textCentered(c, c.w / 2, 142, next, 5, k * 1.5, k * 1.2, k * 0.4)
    }

    if w.banner > 0.0 {
        var f = 1.0
        if w.banner < 1.2 {
            f = w.banner / 1.2
        }
        if w.level > 1 {
            // arriving somewhere new
            textCentered(c, c.w / 2, 130, "ENTERING", 3, 0.7 * f, 0.7 * f, 0.55 * f)
            textCentered(c, c.w / 2, 176, themeName(w.theme), 9, 1.4 * f, 1.15 * f, 0.45 * f)
            textCentered(c, c.w / 2, 268, "REGION " + w.level.toString(), 2, 0.5 * f, 0.55 * f, 0.6 * f)
        } else {
            textCentered(c, c.w / 2, 150, "FLYBY", 9, 1.3 * f, 1.0 * f, 0.35 * f)
            textCentered(c, c.w / 2, 240, "FLY THROUGH THE RINGS", 2, 0.5 * f, 0.6 * f, 0.7 * f)
        }
    }
    if w.hint > 0.0 {
        var f = 1.0
        if w.hint < 1.0 {
            f = w.hint
        }
        textCentered(c, c.w / 2, c.h - 130, "LEFT RIGHT TO BANK    UP DOWN TO CLIMB AND DIVE", 2, 0.45 * f, 0.5 * f, 0.6 * f)
        textCentered(c, c.w / 2, c.h - 106, "FOLLOW THE GREEN BRACKETS — YOU CANNOT CRASH", 2, 0.4 * f, 0.44 * f, 0.5 * f)
    }
}
