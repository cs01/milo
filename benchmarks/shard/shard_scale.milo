// Worker scaling on a COMPUTE-bound kernel.
//
//   shard_scale <workers> [innerIters]
//
// The other two programs here transform each element once, which is bound by memory
// bandwidth: four workers cannot beat the memory bus, so they measure the absence of
// a copy rather than parallel speedup. This one does `inner` rounds of arithmetic per
// element, so the work per byte is high enough that adding cores actually shows.
from "std/shard" import {
    Shard, shatter
}
from "std/runtime" import {
    Promise
}
from "std/time" import {
    epochMillis
}
from "std/args" import {
    args
}
from "std/strconv" import {
    parseInt
}

fn grind(w: Shard<f64>, inner: i64): Shard<f64> {
    var s = w
    var i: i64 = 0
    while i < s.len() {
        var x = s.get(i)
        var k: i64 = 0
        while k < inner {
            x = x * 1.0000001 + 0.5
            k = k + 1
        }
        s.set(i, x)
        i = i + 1
    }
    return s
}

pub fn main(): i32 {
    let argv = args()
    var workers: i64 = 4
    if argv.len > 1 {
        workers = parseInt(argv[1].clone()) ?? 4
    }
    var inner: i64 = 200
    if argv.len > 2 {
        inner = parseInt(argv[2].clone()) ?? 200
    }
    let n: i64 = 2000000

    var v: Vec<f64> = Vec.withCapacity(n)
    var i: i64 = 0
    while i < n {
        v.push(1.0)
        i = i + 1
    }

    let t0 = epochMillis()
    var owner = shatter(v, workers)
    var windows = owner.windows()
    var ps: Vec<Promise<Shard<f64>>> = Vec.new()
    while windows.len > 0 {
        let w = windows.pop()!
        ps.push(Promise<Shard<f64>>.blocking(move(): Shard<f64> => {
            return grind(w, inner)
        }
        ))
    }
    let back = Promise.all(ps).await()!
    let out = owner.weld(back)!
    let t1 = epochMillis()
    print("workers=" + workers.toString() + " ms=" + (t1 - t0).toString() + " check=" + out[0].toString())
    return 0
}
