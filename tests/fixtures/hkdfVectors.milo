// @expect: 077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5
// @expect: 3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865
// @expect: 06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244
// @expect: b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87
// @expect: 19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04
// @expect: 8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8
// @expect: 9b6c18c432a7bf8f0e71c8eb88f4b30baa2ba243
// @expect: 085a01ea1b10f36933068b56efa5ad81a4f14b822f5b091568a9cdd4f155fda2c22e422478d305f3f896
// @expect: 2adccada18779e7c2077ad2eb19d3f3e731385dd
// @expect: 2c91117204d745f3500d636a62f64f0ab3bae548aa53d423b0d1f27ebba6f5e5673a081d70cce7acfc48
// @expect: over-long output rejected
from "std/hkdf" import {
    Hkdf
}
from "std/hex" import {
    Hex
}

fn bytesFrom(start: i64, count: i64): string {
    var s = ""
    for i in 0..count {
        s.push((start + i) as u8)
    }
    return s
}

fn rep(byte: i64, n: i64): string {
    var s = ""
    for _i in 0..n {
        s.push(byte as u8)
    }
    return s
}

fn showOkm(r: Result<string>): void {
    match r {
        Result.Ok(okm) => {
            print(Hex.encode(okm))
        }
        Result.Err(e) => {
            print("ERR " + e)
        }
    }
}

// RFC 5869 test cases 1, 2, 3 (SHA-256) and 4, 7 (SHA-1), printing both the PRK
// from Extract and the OKM from Expand — the split matters, because an
// implementation can get the final bytes right by accident only if both halves are
// right. Case 3 has a zero-length salt and info, which is the branch where the
// RFC's "default to HashLen zeros" rule lives.
pub fn main(): i32 {
    let ikm1 = rep(0x0b, 22)
    let salt1 = bytesFrom(0, 13)
    let info1 = bytesFrom(0xf0, 10)
    print(Hex.encode(Hkdf.extractSha256(salt1, ikm1)))
    showOkm(Hkdf.sha256(salt1, ikm1, info1, 42))

    let ikm2 = bytesFrom(0, 80)
    let salt2 = bytesFrom(0x60, 80)
    let info2 = bytesFrom(0xb0, 80)
    print(Hex.encode(Hkdf.extractSha256(salt2, ikm2)))
    showOkm(Hkdf.sha256(salt2, ikm2, info2, 82))

    print(Hex.encode(Hkdf.extractSha256("", ikm1)))
    showOkm(Hkdf.sha256("", ikm1, "", 42))

    let ikm4 = rep(0x0b, 11)
    print(Hex.encode(Hkdf.extractSha1(salt1, ikm4)))
    showOkm(Hkdf.sha1(salt1, ikm4, info1, 42))

    let ikm7 = rep(0x0c, 22)
    print(Hex.encode(Hkdf.extractSha1("", ikm7)))
    showOkm(Hkdf.sha1("", ikm7, "", 42))

    // RFC 5869 §2.3: the counter is one byte, so 255*HashLen is the hard ceiling.
    match Hkdf.sha256(salt1, ikm1, info1, 255 * 32 + 1) {
        Result.Ok(_okm) => {
            print("over-long output ACCEPTED")
        }
        Result.Err(_e) => {
            print("over-long output rejected")
        }
    }
    return 0
}
