// The sunset the race runs under, tabulated once at startup.
//
// There is no atmospheric model here. What the reflection lookup and the ambient
// term need is the radiance of a *city at dusk* in every direction: a violet
// zenith, a bank of cloud lit orange along its underside, a low sun sitting just
// above the skyline, and a hot band of haze all the way round the horizon. It is
// stored lat-long (u = azimuth, v = zenith angle), the same layout the shader
// already samples.
//
// Two things come out of it and both decide how the game looks:
//
//   - the lat-long radiance table, drawn as the backdrop and sampled for rough
//     reflections. Asphalt is most of this scene by area and a good deal of what
//     you see in it is this table.
//   - the irradiance it delivers to an up-facing and a down-facing surface,
//     which IS the ambient term. Ambient picked by eye is what makes a render
//     look like a render.
//
// The sky is bright and saturated on purpose: this is an arcade racer, and the
// neon keeps its job by being *coloured* rather than by being the only thing
// with any light in it. Every emissive tint in the game is above the bloom
// threshold, so the tubes still glow against a lit sky.
//
// The table is sampled with v clamped half a texel off each pole (`skyLookup` in
// the shader), because the wrap mode has to be REPEAT for the azimuth seam and
// REPEAT at the poles would blend the zenith into the nadir.

from "std/math" import {
    Math
}
from "./vec3" import {
    Vec3, v3
}

pub let SKY_W: i64 = 256

pub let SKY_H: i64 = 128

pub struct Sky {
    // SKY_W * SKY_H * 3 floats of linear radiance, u = azimuth, v = zenith angle.
    table: Vec<f32>,
    sun: Vec3,
    // The one directional source. Low and warm: it is what puts a long shadow
    // under every car and a hot edge down one flank, and the direction it comes
    // from is the direction the sun is drawn in, or the shading and the backdrop
    // disagree about where the light is.
    sunColor: Vec3,
    // Irradiance from the sky alone, on an up-facing and a down-facing surface.
    // `ambientIrradiance(n)` in the shader interpolates between them.
    skyUp: Vec3,
    skyDown: Vec3,
}

// Where the sun sits, as a bearing and a height above the horizon. The bearing
// is the whole reason the sky is not radially symmetric: the hot half and the
// cold half are what tell you which way down the circuit you are pointing.
let SUN_AZ: f64 = -1.05

let SUN_Y: f64 = 0.135

// Smooth pulse, 1 at `c` and 0 more than `w` away.
fn lobe(x: f64, c: f64, w: f64): f64 {
    let d = Math.abs(x - c) / w
    if d >= 1.0 {
        return 0.0
    }
    let t = 1.0 - d
    return t * t * (3.0 - 2.0 * t)
}

// Same, wrapped in azimuth so a lobe centred on the seam does not tear.
fn lobeAz(a: f64, c: f64, w: f64): f64 {
    var d = a - c
    while d > Math.pi() {
        d = d - 2.0 * Math.pi()
    }
    while d < -Math.pi() {
        d = d + 2.0 * Math.pi()
    }
    return lobe(Math.abs(d), 0.0, w)
}

fn sstep(e0: f64, e1: f64, x: f64): f64 {
    let t = Math.clampF64((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
}

pub fn sunDirection(): Vec3 {
    let h = Math.sqrt(Math.maxF64(0.0, 1.0 - SUN_Y * SUN_Y))
    return v3(h * Math.sin(SUN_AZ), SUN_Y, h * Math.cos(SUN_AZ)).norm()
}

// Torn cloud, as a sum of bands in elevation whose height wobbles with bearing.
// Bands rather than noise because what a sunset actually shows is layers: the
// deck breaks into strips that all run parallel to the horizon, and a lump of
// isotropic noise up there reads as smoke.
fn cloudMask(up: f64, az: f64): f64 {
    if up < -0.02 {
        return 0.0
    }
    let w1 = 0.5 + 0.5 * Math.sin(az * 2.3 + 0.6)
    let w2 = 0.5 + 0.5 * Math.sin(az * 3.7 - 1.9)
    let w3 = 0.5 + 0.5 * Math.sin(az * 1.6 + 2.7)
    var m = 0.0
    m = m + 0.85 * lobe(up, 0.085 + 0.030 * w1, 0.055) * (0.35 + 0.65 * w1)
    m = m + 0.75 * lobe(up, 0.175 + 0.045 * w2, 0.070) * (0.30 + 0.70 * w2)
    m = m + 0.70 * lobe(up, 0.320 + 0.070 * w3, 0.110) * (0.25 + 0.75 * w3)
    m = m + 0.55 * lobe(up, 0.520 + 0.090 * w1, 0.160) * (0.20 + 0.80 * w2)
    m = m + 0.40 * lobe(up, 0.760 + 0.080 * w2, 0.200) * (0.20 + 0.80 * w3)
    return Math.clampF64(m, 0.0, 1.0)
}

// The radiance of the dusk in one direction.
fn skyRadiance(dir: &Vec3): Vec3 {
    let up = Math.clampF64(dir.y, -1.0, 1.0)
    let az = Math.atan2(dir.x, dir.z)
    let sd = sunDirection()
    let cosSun = Math.clampF64(dir.dot(sd), -1.0, 1.0)
    // How much of the sun's half of the world this bearing is in. Everything
    // warm is scaled by it and everything cool by its complement.
    let toward = lobeAz(az, SUN_AZ, 2.5)

    // Below the horizon there is no sky, only the haze standing over the city.
    // Warm, so a surface facing down is not the same colour as one facing up,
    // which is most of what keeps a car from looking like it is lit by one lamp.
    if up < 0.0 {
        let d = -up
        var g = v3(0.115, 0.075, 0.115).scale(1.0 - 0.6 * d)
        g = g + v3(0.30, 0.13, 0.06).scale(toward * (1.0 - sstep(0.0, 0.35, d)))
        return g
    }

    // The vertical ramp: violet overhead, magenta through the middle, hot at the
    // horizon. Three stops rather than two, because a two-stop gradient behind a
    // skyline is the tell that the backdrop is a ramp.
    let zenith = v3(0.055, 0.075, 0.295)
    let middle = v3(0.42, 0.145, 0.44)
    let horizon = v3(0.95, 0.30, 0.30)
    var col = middle.lerp(zenith, sstep(0.20, 0.85, up))
    col = horizon.lerp(col, sstep(0.0, 0.24, up))

    // The sun's half of the sky runs orange, the far half stays magenta. This is
    // one multiply and it is what makes the horizon read as a sunset rather than
    // as a pink fog bank.
    col = col + v3(0.62, 0.24, 0.02).scale(toward * (1.0 - sstep(0.0, 0.45, up)))

    // Cloud. Lit hot along its underside near the sun and left violet away from
    // it, and thinning with height so the deck opens up overhead.
    let cl = cloudMask(up, az)
    let lit = v3(1.55, 0.62, 0.30).lerp(v3(0.26, 0.13, 0.34), 1.0 - toward)
    let hi = v3(0.30, 0.20, 0.42)
    let cloud = lit.lerp(hi, sstep(0.15, 0.75, up))
    col = col.lerp(cloud, cl * 0.82)

    // The disc, and the glow around it. The disc is far above the bloom
    // threshold on purpose: the halo the bloom pass builds around it is the
    // cheapest sunset in graphics.
    let glow = Math.pow(Math.maxF64(cosSun, 0.0), 14.0)
    let disc = Math.pow(Math.maxF64(cosSun, 0.0), 900.0)
    col = col + v3(1.30, 0.52, 0.16).scale(glow)
    col = col + v3(9.0, 5.4, 2.4).scale(disc)

    // The skyline haze: a bright band right at the horizon all the way round,
    // because the circuit is a loop and there is city on every side of it.
    let band = lobe(up, 0.012, 0.075)
    col = col + v3(0.55, 0.26, 0.30).scale(band * (0.5 + 0.5 * toward))

    return col
}

fn dirFromLatLong(u: f64, v: f64): Vec3 {
    let theta = v * Math.pi()
    let phi = (u - 0.25) * 2.0 * Math.pi()
    let st = Math.sin(theta)
    return v3(st * Math.cos(phi), Math.cos(theta), st * Math.sin(phi))
}

// `intensity` scales the whole sky. It is the one knob worth having, because the
// bloom threshold is fixed: brightening the sky and brightening the neon are not
// the same operation and only one of them changes what glows.
pub fn buildSky(intensity: f64): Sky {
    let sun = sunDirection()

    var table: Vec<f32> = Vec.filled(SKY_W * SKY_H * 3, 0.0)
    // Cosine-weighted sums over the whole sphere, split by which side of the
    // horizon the direction is on, so one pass yields both hemispheres.
    var upR = 0.0
    var upG = 0.0
    var upB = 0.0
    var downR = 0.0
    var downG = 0.0
    var downB = 0.0
    var upW = 0.0
    var downW = 0.0
    for j in 0..SKY_H {
        let v = ((j as f64) + 0.5) / (SKY_H as f64)
        let theta = v * Math.pi()
        // Solid angle of this ring, for the irradiance sums.
        let dOmega = Math.sin(theta) * (Math.pi() / (SKY_H as f64)) * (2.0 * Math.pi() / (SKY_W as f64))
        for i in 0..SKY_W {
            let u = ((i as f64) + 0.5) / (SKY_W as f64)
            let dir = dirFromLatLong(u, v)
            let rad = skyRadiance(dir).scale(intensity)
            let o = (j * SKY_W + i) * 3
            table[o] = rad.x as f32
            table[o + 1] = rad.y as f32
            table[o + 2] = rad.z as f32
            let cosT = dir.y
            if cosT > 0.0 {
                let w = cosT * dOmega
                upR = upR + rad.x * w
                upG = upG + rad.y * w
                upB = upB + rad.z * w
                upW = upW + w
            } else {
                let w = -cosT * dOmega
                downR = downR + rad.x * w
                downG = downG + rad.y * w
                downB = downB + rad.z * w
                downW = downW + w
            }
        }
    }
    if upW <= 0.0 {
        upW = 1.0
    }
    if downW <= 0.0 {
        downW = 1.0
    }
    // Irradiance, not average radiance: the pi is the integral of the cosine
    // over the hemisphere, and dropping it is the classic way a render comes out
    // three times too dark in shadow.
    let skyUp = v3(upR, upG, upB).scale(Math.pi() / upW)
    let below = v3(downR, downG, downB).scale(Math.pi() / downW)
    // The sun, warm and strong. It has to beat the sky's own fill or the cars
    // come out shadowless and flat, which is the one thing a bright sky costs
    // you over a dark one.
    let sunC = v3(1.95, 1.24, 0.74).scale(intensity)
    // What the road throws back up. Warm asphalt under a low sun bounces amber,
    // and a car's underside picking that up is most of what says the race is
    // happening on a street rather than in a void.
    let bounce = below.scale(0.80) + v3(0.055, 0.030, 0.028).scale(intensity)
    return Sky {
        table: table, sun: sun, sunColor: sunC, skyUp: skyUp, skyDown: bounce,
    }
}
