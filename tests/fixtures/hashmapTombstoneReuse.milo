// @expect: maps=24
// @expect: wrong=0
// A removed slot becomes a tombstone, and `insert` used to stop at the first one it met
// rather than probing on to see whether the key already lived further down the chain.
// That wrote a SECOND copy of a key already in the table: len over-counted, keys() listed
// it twice, and remove() deleted only one of the two. It needs a collision chain with a
// hole in it, so it depends on the hash seed.
//
// The seed is drawn per MAP, not per process, so building many maps in one run gives many
// independent seeds. One map reproduced the old bug about three runs in four; twenty-four
// of them makes a miss vanishingly unlikely, and the assertion is seed-independent: a map
// must end up holding exactly the keys the program put in it, once each.
fn churn(keys: i64, rounds: i64): i64 {
    var m: HashMap<string, i64> = HashMap.new()
    var round = 0
    while round < rounds {
        var i = 0
        while i < keys {
            m.insert("k" + i.toString(), i)
            i = i + 1
        }
        // Delete the first half and re-insert only the SECOND half: the tombstones stay
        // put while every surviving key is probed over them. Re-inserting a key right
        // after removing it just reclaims its own slot and hides the bug.
        var d = 0
        while d < keys / 2 {
            m.remove("k" + d.toString())
            d = d + 1
        }
        var r = keys / 2
        while r < keys {
            m.insert("k" + r.toString(), r)
            r = r + 1
        }
        var b = 0
        while b < keys / 2 {
            m.insert("k" + b.toString(), b)
            b = b + 1
        }
        round = round + 1
    }
    return m.len
}

pub fn main(): i32 {
    var maps = 0
    var wrong = 0
    while maps < 24 {
        if churn(40, 6) != 40 {
            wrong = wrong + 1
        }
        maps = maps + 1
    }
    print("maps=" + maps.toString())
    print("wrong=" + wrong.toString())
    return 0
}
