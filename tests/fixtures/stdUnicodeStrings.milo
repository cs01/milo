// @expect: HELLO WORLD
// @expect: hello world
// @expect: hello
// @expect: hello
// @expect: hello
// @expect: 0
// @expect: true

from "std/string" import {
    strContains, strToLower, strToUpper, strTrim, strTrimEnd, strTrimStart
}

pub fn main(): i32 {
    print("hello world".toUpper())
    print("HELLO WORLD".toLower())
    print("  hello  ".trim())
    print("  hello  ".trimStart())
    print("  hello".trimEnd())
    print("   ".trim().len)
    print("hello world".contains("world"))
    return 0
}
