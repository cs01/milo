// Flies the whole Earth-to-Mars mission through the real integrator and prints
// what it cost. This is the game's physics claim, executable:
//
//   milo run examples/games/apsis/tools/checkphysics.milo
//
// A trans-Mars injection of ~3.6 km/s from a 300 km parking orbit and a total
// mission cost near 5.7 km/s are the numbers real Mars missions quote, and the
// capture orbit is re-checked thirty days later to prove it is actually stable
// under every body's gravity rather than merely closed at the instant of the
// burn.

from "std/math" import {
    Math
}
from "std/strconv" import {
    formatFloat
}
from "std/time" import {
    epochMillis
}
from "../vec3" import {
    Vec3, v3
}
from "../ephem" import {
    bodyTable, timeOf, dateOf, SEC_PER_DAY, EARTH, MARS, SUN
}
from "../nbody" import {
    Ship, ephemBuild, ephemPos, ephemVel, propagate, advance, orbitAbout, dominantBody
}
from "../lambert" import {
    lambert
}
from "../plan" import {
    ejection, ejectionState, planeContaining, aimPoint, captureBurn, solveArrival
}

fn km(x: f64): string {
    return formatFloat(x / 1000.0, 1)
}

pub fn main(): i32 {
    let bodies = bodyTable()
    let e = ephemBuild(bodies, timeOf(2029, 1, 1), timeOf(2036, 1, 1), 21600.0)
    let dep = timeOf(2033, 4, 20)
    let tof = 280.0 * SEC_PER_DAY
    let arr = dep + tof
    let park = bodies[EARTH].radius + 300.0e3
    let wantPeri = bodies[MARS].radius + 500.0e3
    let wantApo = bodies[MARS].radius + 20000.0e3
    var budget = 0.0

    print("APSIS mission check: Earth 300 km parking orbit -> Mars capture orbit")
    print("depart " + formatFloat(dateOf(dep) as f64, 0) + "  arrive " + formatFloat(dateOf(arr) as f64, 0))
    print("")

    let sol = lambert(ephemPos(e, EARTH, dep), ephemPos(e, MARS, arr), tof, e.mu[SUN], true)
    let vinf = sol.v1 - ephemVel(e, EARTH, dep)
    let vinfArr = sol.v2 - ephemVel(e, MARS, arr)
    let normal = planeContaining(vinf)
    let ej = ejection(e.mu[EARTH], park, vinf, normal)
    budget = budget + ej.dvMag
    print("1. trans-Mars injection   " + formatFloat(ej.dvMag, 1) + " m/s   (v-inf " + formatFloat(vinf.len(), 1) + " m/s)")

    let post = ejectionState(e, EARTH, dep, park, vinf, normal)
    let mcT = dep + 20.0 * SEC_PER_DAY
    let coast = advance(e, post, dep, 20.0 * SEC_PER_DAY)
    let t0 = epochMillis()
    let fix = solveArrival(e, coast, mcT, arr, MARS, wantPeri, vinfArr, 4)
    let t1 = epochMillis()
    budget = budget + fix.len()
    print("2. course correction      " + formatFloat(fix.len(), 1) + " m/s   (solved in " + formatFloat((t1 - t0) as f64, 0) + " ms)")

    let cruise = Ship {
        pos: coast.pos, vel: coast.vel + fix
    }
    let tr = propagate(e, cruise, mcT, arr - mcT + 10.0 * SEC_PER_DAY, 400, MARS)
    print("   closest approach       " + km(tr.caDist) + " km from Mars centre  (" + km(tr.caDist - bodies[MARS].radius) + " km altitude)")
    print("   wanted                 " + km(wantPeri) + " km")
    if tr.hit >= 0 {
        print("   IMPACT on body " + formatFloat(tr.hit as f64, 0))
    }

    let atPeri = advance(e, cruise, mcT, tr.caTime - mcT)
    let cap = captureBurn(e, atPeri, tr.caTime, MARS, wantApo)
    budget = budget + cap.dv
    print("3. Mars orbit insertion   " + formatFloat(cap.dv, 1) + " m/s at periapsis " + km(cap.periRad) + " km")

    let relV = atPeri.vel - ephemVel(e, MARS, tr.caTime)
    let captured = Ship {
        pos: atPeri.pos, vel: atPeri.vel - relV.norm().scale(cap.dv)
    }
    let ob = orbitAbout(e, captured, tr.caTime, MARS)
    print("")
    print("resulting orbit about Mars:")
    print("   periapsis altitude     " + km(ob.periapsis - bodies[MARS].radius) + " km")
    print("   apoapsis altitude      " + km(ob.apoapsis - bodies[MARS].radius) + " km")
    print("   eccentricity           " + formatFloat(ob.ecc, 4))
    print("   period                 " + formatFloat(ob.period / 3600.0, 2) + " h")
    print("   closed                 " + formatFloat(ob.closed as i64 as f64, 0))

    // Does it stay captured? Fly thirty days and look again.
    let later = advance(e, captured, tr.caTime, 30.0 * SEC_PER_DAY)
    let ob2 = orbitAbout(e, later, tr.caTime + 30.0 * SEC_PER_DAY, MARS)
    print("   after 30 days: peri " + km(ob2.periapsis - bodies[MARS].radius) + " km, apo " + km(ob2.apoapsis - bodies[MARS].radius) + " km, still closed " + formatFloat(ob2.closed as i64 as f64, 0) + ", dominant body " + formatFloat(dominantBody(e, later.pos, tr.caTime + 30.0 * SEC_PER_DAY) as f64, 0))
    print("")
    print("total mission cost        " + formatFloat(budget, 1) + " m/s")
    return 0
}
