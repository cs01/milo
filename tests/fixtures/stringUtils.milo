// @expect: contains: true false true
// @expect: indexOf: 6 -1 0
// @expect: indexOfFrom: 14 -1
// @expect: lastIndexOf: 12 -1
// @expect: startsWith: true false
// @expect: endsWith: true false
// @expect: toLower: hello world
// @expect: toUpper: HELLO WORLD
// @expect: trim: [hello]
// @expect: trimStart: [hello   ]
// @expect: trimEnd: [   hello]
// @expect: split: [hello] [world] [foo] 3
// @expect: splitChar: [a] [b] [c] 3
// @expect: repeat: ababab
// @expect: replace: hello universe
// @expect: isFuncs: true true false true
from "std/string" import {
    asciiIsAlpha, asciiIsAlphanumeric, asciiIsDigit, asciiIsWhitespace, strContains, strEndsWith, strIndexOf, strIndexOfFrom, strRepeat, strReplace, strSplit, strStartsWith, strToLower, strToUpper, strTrim, strTrimEnd, strTrimStart, trim
}

pub fn boolStr(b: bool): string {
    if b {
        return "true"
    }
    return "false"
}

pub fn main(): i32 {
    let s = "hello world"

    // contains
    print("contains: ", boolStr(s.contains("world")), " ", boolStr(s.contains("xyz")), " ", boolStr(s.contains("")))

    // indexOf
    print("indexOf: ", s.indexOf("world") ?? -1, " ", s.indexOf("xyz") ?? -1, " ", s.indexOf("hello") ?? -1)

    // indexOfFrom
    let s2 = "hello world hello"
    print("indexOfFrom: ", s2.indexOfFrom("llo", 5 as i64) ?? -1, " ", s2.indexOfFrom("xyz", 0 as i64) ?? -1)
    print("lastIndexOf: ", s2.lastIndexOf("hello") ?? -1, " ", s2.lastIndexOf("xyz") ?? -1)

    // startsWith
    print("startsWith: ", boolStr(s.startsWith("hello")), " ", boolStr(s.startsWith("world")))

    // endsWith
    print("endsWith: ", boolStr(s.endsWith("world")), " ", boolStr(s.endsWith("hello")))

    // toLower / toUpper
    let lower = "HELLO WORLD".toLower()
    print("toLower: ", lower)
    let up = "hello world".toUpper()
    print("toUpper: ", up)

    // trim
    let padded = "   hello   "
    print("trim: [", padded.trim(), "]")
    print("trimStart: [", padded.trimStart(), "]")
    print("trimEnd: [", padded.trimEnd(), "]")

    // split
    let csv = "hello,world,foo"
    let parts = csv.split(",")
    print("split: [", parts[0], "] [", parts[1], "] [", parts[2], "] ", parts.len)

    // split by char
    let abc = "a:b:c"
    let abcParts = abc.split(":")
    print("splitChar: [", abcParts[0], "] [", abcParts[1], "] [", abcParts[2], "] ", abcParts.len)

    // repeat
    print("repeat: ", "ab".repeat(3))

    // replace
    print("replace: ", s.replace("world", "universe"))

    // is_* functions
    print("isFuncs: ", boolStr(asciiIsDigit(48)), " ", boolStr(asciiIsAlpha(65)), " ", boolStr(asciiIsWhitespace(65)), " ", boolStr(asciiIsAlphanumeric(57)))

    return 0
}
