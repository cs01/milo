// @skip-os: win32
// Not a Windows port gap in this module: std/shard reaches std/sync, which imports
// std/os for malloc, and std/os also declares 22 OpenSSL externs. At -O2 they are
// dead-stripped; these are runtime-error fixtures, built --debug, so they are not,
// and the xwin sysroot has no OpenSSL to resolve them. Every other shard fixture is
// -O2, which is why this class stayed invisible until these two landed. The fix is
// backlog L1 (move the OpenSSL externs out of std/os); delete this skip with it.
// A second `windows()` call is a program bug with no recovery: the first set is out
// in the world and handing out a second would alias it. It used to return an empty
// Vec, so the report surfaced two steps later at `weld` as "expected 4 windows, got
// 0", which blames the weld for what the divider did. Abort where the mistake is.
// @runtime-error: windows() called twice
from "std/shard" import {
    shatter
}

pub fn main(): i32 {
    var data: Vec<i64> = Vec.new()
    for i in 0..8 {
        data.push(i)
    }
    var owner = shatter(data, 4)
    let first = owner.windows()
    print("first: " + first.len.toString())
    let second = owner.windows()
    print("WRONG: second: " + second.len.toString())
    return 0
}
