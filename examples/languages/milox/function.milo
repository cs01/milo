// A compiled milox function. Functions are compile-time entities held in a
// flat table on the VM; a Value referring to one is a heap Obj.Fn carrying its
// table index, so the collector never has to trace bytecode.
from "./chunk" import {
    Chunk
}

pub struct Function {
    name: string,
    arity: i64,
    chunk: Chunk,
}

impl Function {
    fn new(name: string, arity: i64): Function {
        return Function {
            name: name, arity: arity, chunk: Chunk.new()
        }
    }
}
