// std/gl — raw OpenGL 3.3 core bindings.
//
// This is the unsafe floor: one `extern fn` per GL entry point, one `let` per
// constant, and nothing else. Use `std/gpu` unless you need a call this does not
// wrap — that module owns the shader/buffer/texture/framebuffer lifecycles and
// keeps the raw pointers out of your program.
//
// The link flag is added by the compiler when it sees a `gl*` symbol in the IR:
// `-framework OpenGL` on darwin, `-lGL` on linux. Windows is NOT supported here —
// `opengl32.dll` only exports GL 1.1, so every 3.3 entry point below is an
// undefined symbol at link time, by design and by name (see docs/roadmap.md,
// Windows is a partial target).
//
// A current GL context is a precondition of every call. Creating one is the
// window system's job, not this module's: with SDL2 that is
// `SDL_GL_SetAttribute` + `SDL_WINDOW_OPENGL` + `SDL_GL_CreateContext`. Calling
// into GL with no context bound is undefined behaviour, not an error return.
//
// Pointer parameters are declared `*u8` throughout, the same convention
// std/sqlite uses: every pointer is one machine word, so the ABI does not care,
// and a single spelling means call sites cast once instead of guessing which of
// six pointer types a given out-param wanted. The comment on each declaration
// gives the real C type.

// ── state ─────────────────────────────────────────────────────────────────────

pub extern fn glClearColor(r: f32, g: f32, b: f32, a: f32)

pub extern fn glClear(mask: u32)

pub extern fn glViewport(x: i32, y: i32, w: i32, h: i32)

pub extern fn glScissor(x: i32, y: i32, w: i32, h: i32)

pub extern fn glEnable(cap: u32)

pub extern fn glDisable(cap: u32)

pub extern fn glBlendFunc(src: u32, dst: u32)

pub extern fn glDepthFunc(func: u32)

// GLboolean, so 0 or 1 — anything else is out of contract.
pub extern fn glDepthMask(flag: u8)

pub extern fn glCullFace(mode: u32)

pub extern fn glFrontFace(mode: u32)

pub extern fn glPixelStorei(pname: u32, param: i32)

pub extern fn glFinish()

pub extern fn glGetError(): u32

// Returns a static NUL-terminated string owned by the driver — read it with
// std/cstr, never free it.
pub extern fn glGetString(name: u32): *u8

// ── shaders ───────────────────────────────────────────────────────────────────

pub extern fn glCreateShader(kind: u32): u32

// `strings` is a `const char* const*`, `lengths` a `const GLint*` or NULL.
pub extern fn glShaderSource(shader: u32, count: i32, strings: *u8, lengths: *u8)

pub extern fn glCompileShader(shader: u32)

// `out` is a `GLint*`.
pub extern fn glGetShaderiv(shader: u32, pname: u32, out: *u8)

// `length` is a `GLsizei*` or NULL; `log` a `GLchar*` buffer of `bufSize`.
pub extern fn glGetShaderInfoLog(shader: u32, bufSize: i32, length: *u8, log: *u8)

pub extern fn glDeleteShader(shader: u32)

pub extern fn glCreateProgram(): u32

pub extern fn glAttachShader(program: u32, shader: u32)

pub extern fn glLinkProgram(program: u32)

pub extern fn glGetProgramiv(program: u32, pname: u32, out: *u8)

pub extern fn glGetProgramInfoLog(program: u32, bufSize: i32, length: *u8, log: *u8)

pub extern fn glUseProgram(program: u32)

pub extern fn glDeleteProgram(program: u32)

// `name` is a NUL-terminated `const GLchar*`; returns -1 if the uniform is not
// active, which includes "the linker optimised it away because nothing read it".
pub extern fn glGetUniformLocation(program: u32, name: *u8): i32

pub extern fn glUniform1i(loc: i32, v0: i32)

pub extern fn glUniform1f(loc: i32, v0: f32)

pub extern fn glUniform2f(loc: i32, v0: f32, v1: f32)

pub extern fn glUniform3f(loc: i32, v0: f32, v1: f32, v2: f32)

pub extern fn glUniform4f(loc: i32, v0: f32, v1: f32, v2: f32, v3: f32)

// `value` is a `const GLfloat*` holding count*16 floats.
pub extern fn glUniformMatrix4fv(loc: i32, count: i32, transpose: u8, value: *u8)

// ── buffers ───────────────────────────────────────────────────────────────────

// `ids` is a `GLuint*` array of `n` entries, written by the driver.
pub extern fn glGenBuffers(n: i32, ids: *u8)

pub extern fn glBindBuffer(target: u32, id: u32)

// `size` is a GLsizeiptr — pointer-sized, so i64. `data` may be NULL to allocate
// without uploading.
pub extern fn glBufferData(target: u32, size: i64, data: *u8, usage: u32)

pub extern fn glBufferSubData(target: u32, offset: i64, size: i64, data: *u8)

pub extern fn glDeleteBuffers(n: i32, ids: *u8)

pub extern fn glGenVertexArrays(n: i32, ids: *u8)

pub extern fn glBindVertexArray(id: u32)

pub extern fn glDeleteVertexArrays(n: i32, ids: *u8)

pub extern fn glEnableVertexAttribArray(index: u32)

pub extern fn glDisableVertexAttribArray(index: u32)

// `offset` is a `const void*` that GL reads as a byte offset into the bound
// buffer, not as an address — pass `n as *u8`.
pub extern fn glVertexAttribPointer(index: u32, size: i32, kind: u32, normalized: u8, stride: i32, offset: *u8)

// ── textures ──────────────────────────────────────────────────────────────────

pub extern fn glGenTextures(n: i32, ids: *u8)

pub extern fn glBindTexture(target: u32, id: u32)

pub extern fn glActiveTexture(unit: u32)

pub extern fn glTexImage2D(target: u32, level: i32, internalFormat: i32, w: i32, h: i32, border: i32, format: u32, kind: u32, pixels: *u8)

pub extern fn glTexSubImage2D(target: u32, level: i32, x: i32, y: i32, w: i32, h: i32, format: u32, kind: u32, pixels: *u8)

pub extern fn glTexParameteri(target: u32, pname: u32, param: i32)

pub extern fn glGenerateMipmap(target: u32)

pub extern fn glDeleteTextures(n: i32, ids: *u8)

// ── framebuffers ──────────────────────────────────────────────────────────────

pub extern fn glGenFramebuffers(n: i32, ids: *u8)

pub extern fn glBindFramebuffer(target: u32, id: u32)

pub extern fn glFramebufferTexture2D(target: u32, attachment: u32, texTarget: u32, tex: u32, level: i32)

pub extern fn glCheckFramebufferStatus(target: u32): u32

pub extern fn glDeleteFramebuffers(n: i32, ids: *u8)

pub extern fn glGenRenderbuffers(n: i32, ids: *u8)

pub extern fn glBindRenderbuffer(target: u32, id: u32)

pub extern fn glRenderbufferStorage(target: u32, format: u32, w: i32, h: i32)

pub extern fn glFramebufferRenderbuffer(target: u32, attachment: u32, rbTarget: u32, rb: u32)

pub extern fn glDeleteRenderbuffers(n: i32, ids: *u8)

pub extern fn glReadPixels(x: i32, y: i32, w: i32, h: i32, format: u32, kind: u32, pixels: *u8)

// ── draw ──────────────────────────────────────────────────────────────────────

pub extern fn glDrawArrays(mode: u32, first: i32, count: i32)

// `offset` is a byte offset into the bound element buffer, cast from an integer.
pub extern fn glDrawElements(mode: u32, count: i32, kind: u32, offset: *u8)

// ── constants ─────────────────────────────────────────────────────────────────

pub let GL_FALSE: u8 = 0

pub let GL_TRUE: u8 = 1

pub let GL_NO_ERROR: u32 = 0

pub let GL_POINTS: u32 = 0x0000

pub let GL_LINES: u32 = 0x0001

pub let GL_TRIANGLES: u32 = 0x0004

pub let GL_TRIANGLE_STRIP: u32 = 0x0005

pub let GL_DEPTH_BUFFER_BIT: u32 = 0x00000100

pub let GL_COLOR_BUFFER_BIT: u32 = 0x00004000

pub let GL_LESS: u32 = 0x0201

pub let GL_LEQUAL: u32 = 0x0203

pub let GL_ALWAYS: u32 = 0x0207

pub let GL_SRC_ALPHA: u32 = 0x0302

pub let GL_ONE_MINUS_SRC_ALPHA: u32 = 0x0303

