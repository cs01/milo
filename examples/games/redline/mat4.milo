// 4x4 matrices, column-major — the layout GLSL reads a `mat4` in, so a matrix
// built here goes to `Shader.uniformMat4` with no transpose.
//
// Every matrix is a `Vec<f32>` of 16 rather than a struct: it is what the uniform
// setter takes, and a struct would only be converted back at every call site.

from "std/math" import {
    Math
}
from "./vec3" import {
    Vec3, v3
}

pub fn identity(): Vec<f32> {
    var m: Vec<f32> = Vec.filled(16, 0.0)
    m[0] = 1.0
    m[5] = 1.0
    m[10] = 1.0
    m[15] = 1.0
    return m
}

pub fn multiply(a: &Vec<f32>, b: &Vec<f32>): Vec<f32> {
    var m: Vec<f32> = Vec.filled(16, 0.0)
    for col in 0..4 {
        for row in 0..4 {
            var s: f32 = 0.0
            for k in 0..4 {
                s = s + a[k * 4 + row] * b[col * 4 + k]
            }
            m[col * 4 + row] = s
        }
    }
    return m
}

pub fn perspective(fovY: f64, aspect: f64, near: f64, far: f64): Vec<f32> {
    var m: Vec<f32> = Vec.filled(16, 0.0)
    let f = 1.0 / Math.tan(fovY * 0.5)
    m[0] = (f / aspect) as f32
    m[5] = f as f32
    m[10] = ((far + near) / (near - far)) as f32
    m[11] = -1.0
    m[14] = ((2.0 * far * near) / (near - far)) as f32
    return m
}

// A box in light space. The shadow pass needs this and nothing else does.
pub fn ortho(l: f64, r: f64, b: f64, t: f64, near: f64, far: f64): Vec<f32> {
    var m = identity()
    m[0] = (2.0 / (r - l)) as f32
    m[5] = (2.0 / (t - b)) as f32
    m[10] = (-2.0 / (far - near)) as f32
    m[12] = (-(r + l) / (r - l)) as f32
    m[13] = (-(t + b) / (t - b)) as f32
    m[14] = (-(far + near) / (far - near)) as f32
    return m
}

pub fn lookAt(eye: &Vec3, at: &Vec3, up: &Vec3): Vec<f32> {
    let f = (at - eye).norm()
    let s = f.cross(up).norm()
    let u = s.cross(f)
    var m = identity()
    m[0] = s.x as f32
    m[4] = s.y as f32
    m[8] = s.z as f32
    m[1] = u.x as f32
    m[5] = u.y as f32
    m[9] = u.z as f32
    m[2] = (-f.x) as f32
    m[6] = (-f.y) as f32
    m[10] = (-f.z) as f32
    m[12] = (-s.dot(eye)) as f32
    m[13] = (-u.dot(eye)) as f32
    m[14] = f.dot(eye) as f32
    return m
}

// A uniform scale. Non-uniform is deliberately not offered: the scene shader
// uses the model matrix as its own normal matrix, which only holds while the
// three axes scale together.
pub fn scaling(s: f64): Vec<f32> {
    var m = identity()
    m[0] = s as f32
    m[5] = s as f32
    m[10] = s as f32
    return m
}

pub fn translation(p: &Vec3): Vec<f32> {
    var m = identity()
    m[12] = p.x as f32
    m[13] = p.y as f32
    m[14] = p.z as f32
    return m
}

pub fn scaleXyz(sx: f64, sy: f64, sz: f64): Vec<f32> {
    var m = identity()
    m[0] = sx as f32
    m[5] = sy as f32
    m[10] = sz as f32
    return m
}

pub fn rotationX(a: f64): Vec<f32> {
    var m = identity()
    let c = Math.cos(a)
    let s = Math.sin(a)
    m[5] = c as f32
    m[6] = s as f32
    m[9] = (-s) as f32
    m[10] = c as f32
    return m
}

pub fn rotationY(a: f64): Vec<f32> {
    var m = identity()
    let c = Math.cos(a)
    let s = Math.sin(a)
    m[0] = c as f32
    m[2] = (-s) as f32
    m[8] = s as f32
    m[10] = c as f32
    return m
}

pub fn rotationZ(a: f64): Vec<f32> {
    var m = identity()
    let c = Math.cos(a)
    let s = Math.sin(a)
    m[0] = c as f32
    m[1] = s as f32
    m[4] = (-s) as f32
    m[5] = c as f32
    return m
}

// A rotation that takes +Y onto `axis`, built from an orthonormal frame around it.
// Used to stand a cylinder up along an arbitrary direction.
pub fn basisFromY(axis: &Vec3): Vec<f32> {
    let y = axis.norm()
    let x = y.anyPerp()
    let z = x.cross(y)
    var m = identity()
    m[0] = x.x as f32
    m[1] = x.y as f32
    m[2] = x.z as f32
    m[4] = y.x as f32
    m[5] = y.y as f32
    m[6] = y.z as f32
    m[8] = z.x as f32
    m[9] = z.y as f32
    m[10] = z.z as f32
    return m
}

pub fn transformPoint(m: &Vec<f32>, p: &Vec3): Vec3 {
    let x = (m[0] as f64) * p.x + (m[4] as f64) * p.y + (m[8] as f64) * p.z + (m[12] as f64)
    let y = (m[1] as f64) * p.x + (m[5] as f64) * p.y + (m[9] as f64) * p.z + (m[13] as f64)
    let z = (m[2] as f64) * p.x + (m[6] as f64) * p.y + (m[10] as f64) * p.z + (m[14] as f64)
    return v3(x, y, z)
}

// The rotation part only — what a surface normal or a spin axis wants.
pub fn transformDir(m: &Vec<f32>, p: &Vec3): Vec3 {
    let x = (m[0] as f64) * p.x + (m[4] as f64) * p.y + (m[8] as f64) * p.z
    let y = (m[1] as f64) * p.x + (m[5] as f64) * p.y + (m[9] as f64) * p.z
    let z = (m[2] as f64) * p.x + (m[6] as f64) * p.y + (m[10] as f64) * p.z
    return v3(x, y, z)
}

// A general 4x4 inverse, by cofactors. The sky pass needs the camera's inverse
// view-projection to turn a screen corner back into a world ray, and the view
// matrix is not a pure rotation once the projection is folded in, so the
// transpose shortcut does not apply here.
pub fn invert(m: &Vec<f32>): Vec<f32> {
    var a: Vec<f64> = Vec.filled(16, 0.0)
    for i in 0..16 {
        a[i] = m[i] as f64
    }
    var inv: Vec<f64> = Vec.filled(16, 0.0)
    inv[0] = a[5] * a[10] * a[15] - a[5] * a[11] * a[14] - a[9] * a[6] * a[15] + a[9] * a[7] * a[14] + a[13] * a[6] * a[11] - a[13] * a[7] * a[10]
    inv[4] = -a[4] * a[10] * a[15] + a[4] * a[11] * a[14] + a[8] * a[6] * a[15] - a[8] * a[7] * a[14] - a[12] * a[6] * a[11] + a[12] * a[7] * a[10]
    inv[8] = a[4] * a[9] * a[15] - a[4] * a[11] * a[13] - a[8] * a[5] * a[15] + a[8] * a[7] * a[13] + a[12] * a[5] * a[11] - a[12] * a[7] * a[9]
    inv[12] = -a[4] * a[9] * a[14] + a[4] * a[10] * a[13] + a[8] * a[5] * a[14] - a[8] * a[6] * a[13] - a[12] * a[5] * a[10] + a[12] * a[6] * a[9]
    inv[1] = -a[1] * a[10] * a[15] + a[1] * a[11] * a[14] + a[9] * a[2] * a[15] - a[9] * a[3] * a[14] - a[13] * a[2] * a[11] + a[13] * a[3] * a[10]
    inv[5] = a[0] * a[10] * a[15] - a[0] * a[11] * a[14] - a[8] * a[2] * a[15] + a[8] * a[3] * a[14] + a[12] * a[2] * a[11] - a[12] * a[3] * a[10]
    inv[9] = -a[0] * a[9] * a[15] + a[0] * a[11] * a[13] + a[8] * a[1] * a[15] - a[8] * a[3] * a[13] - a[12] * a[1] * a[11] + a[12] * a[3] * a[9]
    inv[13] = a[0] * a[9] * a[14] - a[0] * a[10] * a[13] - a[8] * a[1] * a[14] + a[8] * a[2] * a[13] + a[12] * a[1] * a[10] - a[12] * a[2] * a[9]
    inv[2] = a[1] * a[6] * a[15] - a[1] * a[7] * a[14] - a[5] * a[2] * a[15] + a[5] * a[3] * a[14] + a[13] * a[2] * a[7] - a[13] * a[3] * a[6]
    inv[6] = -a[0] * a[6] * a[15] + a[0] * a[7] * a[14] + a[4] * a[2] * a[15] - a[4] * a[3] * a[14] - a[12] * a[2] * a[7] + a[12] * a[3] * a[6]
    inv[10] = a[0] * a[5] * a[15] - a[0] * a[7] * a[13] - a[4] * a[1] * a[15] + a[4] * a[3] * a[13] + a[12] * a[1] * a[7] - a[12] * a[3] * a[5]
    inv[14] = -a[0] * a[5] * a[14] + a[0] * a[6] * a[13] + a[4] * a[1] * a[14] - a[4] * a[2] * a[13] - a[12] * a[1] * a[6] + a[12] * a[2] * a[5]
    inv[3] = -a[1] * a[6] * a[11] + a[1] * a[7] * a[10] + a[5] * a[2] * a[11] - a[5] * a[3] * a[10] - a[9] * a[2] * a[7] + a[9] * a[3] * a[6]
    inv[7] = a[0] * a[6] * a[11] - a[0] * a[7] * a[10] - a[4] * a[2] * a[11] + a[4] * a[3] * a[10] + a[8] * a[2] * a[7] - a[8] * a[3] * a[6]
    inv[11] = -a[0] * a[5] * a[11] + a[0] * a[7] * a[9] + a[4] * a[1] * a[11] - a[4] * a[3] * a[9] - a[8] * a[1] * a[7] + a[8] * a[3] * a[5]
    inv[15] = a[0] * a[5] * a[10] - a[0] * a[6] * a[9] - a[4] * a[1] * a[10] + a[4] * a[2] * a[9] + a[8] * a[1] * a[6] - a[8] * a[2] * a[5]
    var det = a[0] * inv[0] + a[1] * inv[4] + a[2] * inv[8] + a[3] * inv[12]
    if det == 0.0 {
        return identity()
    }
    det = 1.0 / det
    var out: Vec<f32> = Vec.filled(16, 0.0)
    for i in 0..16 {
        out[i] = (inv[i] * det) as f32
    }
    return out
}

pub fn invertViewProj(m: &Vec<f32>): Vec<f32> {
    return invert(m)
}
