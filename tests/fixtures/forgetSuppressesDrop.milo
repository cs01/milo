// @expect: done

// `forget(x)` ends x's ownership WITHOUT running its drop — the one operation the move
// checker could not otherwise express, since every other way of consuming a value either
// drops it or hands it to something that will. It exists for the seams where ownership
// leaves through a raw pointer the checker cannot see (a closure environment memcpy'd
// into a scheduler task, a buffer handed to C), where the alternative is a double free or
// a leak dressed up as safety.
//
// Deliberately NOT on tests/leak-clean.txt: this program leaks 50 buffers on purpose, and
// that is the assertion. Fifty rather than one because a single forgotten pointer can
// still be sitting in a stack slot at exit, which conservative leak scanning reads as
// reachable — the one-value version of this test reported clean while leaking.
fn mk(i: i64): string {
    var s = "buffer-"
    s.pushStr(i.toString())
    return s
}

pub fn main(): i32 {
    var i = 0
    while i < 50 {
        let s = mk(i)
        forget(s)
        i = i + 1
    }
    print("done")
    return 0
}
