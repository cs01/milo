// One frame of input, snapshotted out of SDL so the rest of the game never touches
// a pointer. The SDL declarations live in the `sdl` package, header-verified and
// written once; the control scheme is what belongs to this game.

from "sdl" import {
    SDL_GetKeyboardState, SDL_PollEvent,
    SDL_QUIT
}
from "sdl/keys" import {
    SC_0, SC_A, SC_COMMA, SC_D, SC_DOWN, SC_E, SC_ESCAPE, SC_F, SC_LEFT, SC_M,
    SC_PERIOD, SC_Q, SC_RETURN, SC_RIGHT, SC_S, SC_SPACE, SC_UP, SC_W, SC_X, SC_Z
}

// One frame of input, snapshotted out of SDL so the rest of the game never
// touches a pointer.
pub struct Input {
    moveX: f64, // bank: -1 left, +1 right
    moveY: f64, // climb rate: +1 climb, -1 dive
    // Rudder, -1 left +1 right. A small direct yaw for lining up on a landmark;
    // the bank axis is still how you turn.
    rudder: f64,
    // Throttle LEVER movement, not a throttle setting: the model integrates it,
    // so a tap is a nudge and a hold winds the lever open or shut.
    throttle: f64,
    boost: bool,
    // The scene clock. -1 back, +1 forward, held rather than edge-triggered: a
    // scrub is a sweep, not a step, and the band under the clock is there to be
    // dragged along until the sky looks like something.
    clock: f64,
    // Back to now, edge-triggered.
    clockNow: bool,
    clockNowHeld: bool,
    quit: bool,
    mute: bool, // edge-triggered: true only on the frame M goes down
    muteHeld: bool,
    // Step to the next place, edge-triggered. On ENTER rather than LEFT/RIGHT:
    // those are the bank axis under `--pro`, and even in one-axis mode a player
    // reaches for them to steer and got the whole world swapped instead.
    placeStep: i64,
    placeHeld: bool,
    fullscreen: bool, // edge-triggered: true only on the frame F goes down
    fullHeld: bool,
    // Menu navigation: the pitch axis read as discrete steps, edge-triggered,
    // and BEFORE --natural flips it. A menu cursor that runs the wrong way
    // because of a flight-control preference is a bug nobody would guess at.
    menuStep: i64,
    menuHeld: bool,
    // Stick, not camera: the key you press is where you push the nose, so UP
    // dives and DOWN climbs. This is how every flight sim maps a stick and it
    // is the default here; `--natural` flips it back to UP-climbs.
    invert: bool,
}

pub fn inputNew(invert: bool): Input {
    return Input {
        moveX: 0.0, moveY: 0.0, rudder: 0.0, throttle: 0.0,
        clock: 0.0, clockNow: false, clockNowHeld: false,
        boost: false, quit: false, mute: false, muteHeld: false,
        placeStep: 0, placeHeld: false,
        fullscreen: false, fullHeld: false,
        menuStep: 0, menuHeld: false,
        invert: invert,
    }
}

// Poll SDL and fill `inp`.
pub fn pollInput(inp: &mut Input, ev: &mut [u8; 64]) {
    inp.moveX = 0.0
    inp.moveY = 0.0
    inp.rudder = 0.0
    inp.throttle = 0.0
    inp.clock = 0.0
    inp.clockNow = false
    inp.boost = false
    inp.mute = false
    inp.placeStep = 0
    inp.menuStep = 0
    inp.fullscreen = false

    unsafe {
        while SDL_PollEvent(ev) != 0 {
            let evType: u32 = (ev[0] as u32) | ((ev[1] as u32) << 8) | ((ev[2] as u32) << 16) | ((ev[3] as u32) << 24)
            if evType == SDL_QUIT {
                inp.quit = true
            }
        }
        let ks = SDL_GetKeyboardState(0 as *i32)
        if ks[SC_ESCAPE] != 0 {
            inp.quit = true
        }
        // Edge-triggered, or holding M would toggle the music every frame.
        let mDown = ks[SC_M] != 0
        if mDown && !inp.muteHeld {
            inp.mute = true
        }
        inp.muteHeld = mDown
        if ks[SC_A] != 0 {
            inp.moveX = inp.moveX - 1.0
        }
        if ks[SC_D] != 0 {
            inp.moveX = inp.moveX + 1.0
        }
        // `moveY` is a pitch rate, +1 climb: the sign flips once, at the end,
        // rather than in four places.
        if ks[SC_W] != 0 {
            inp.moveY = inp.moveY + 1.0
        }
        if ks[SC_S] != 0 {
            inp.moveY = inp.moveY - 1.0
        }
        // Arrows do the same thing as WASD.
        if ks[SC_LEFT] != 0 {
            inp.moveX = inp.moveX - 1.0
        }
        if ks[SC_RIGHT] != 0 {
            inp.moveX = inp.moveX + 1.0
        }
        if ks[SC_UP] != 0 {
            inp.moveY = inp.moveY + 1.0
        }
        if ks[SC_DOWN] != 0 {
            inp.moveY = inp.moveY - 1.0
        }
        var raw = 0
        if ks[SC_UP] != 0 || ks[SC_W] != 0 {
            raw = 0 - 1
        }
        if ks[SC_DOWN] != 0 || ks[SC_S] != 0 {
            raw = 1
        }
        if raw != 0 && !inp.menuHeld {
            inp.menuStep = raw
        }
        inp.menuHeld = raw != 0
        if inp.invert {
            inp.moveY = 0.0 - inp.moveY
        }
        // Edge-triggered like M: held down, this would rip through every place
        // in the rotation in a fraction of a second.
        let stepDown = ks[SC_RETURN] != 0
        if stepDown && !inp.placeHeld {
            inp.placeStep = 1
        }
        inp.placeHeld = stepDown
        let fDown = ks[SC_F] != 0
        if fDown && !inp.fullHeld {
            inp.fullscreen = true
        }
        inp.fullHeld = fDown
        // Rudder and throttle sit off the flight axes on purpose: Q/E and Z/X are
        // where a hand already is, and rebinding W/S — which every player of this
        // has used to climb since it had a pitch axis — to a throttle would be a
        // worse trade than an extra pair of keys.
        if ks[SC_Q] != 0 {
            inp.rudder = inp.rudder - 1.0
        }
        if ks[SC_E] != 0 {
            inp.rudder = inp.rudder + 1.0
        }
        if ks[SC_X] != 0 {
            inp.throttle = inp.throttle + 1.0
        }
        if ks[SC_Z] != 0 {
            inp.throttle = inp.throttle - 1.0
        }
        // The scene clock, on the two keys that already look like arrows on a
        // transport control.
        if ks[SC_COMMA] != 0 {
            inp.clock = inp.clock - 1.0
        }
        if ks[SC_PERIOD] != 0 {
            inp.clock = inp.clock + 1.0
        }
        let zeroDown = ks[SC_0] != 0
        if zeroDown && !inp.clockNowHeld {
            inp.clockNow = true
        }
        inp.clockNowHeld = zeroDown
        if ks[SC_SPACE] != 0 {
            inp.boost = true
        }
    }
}
