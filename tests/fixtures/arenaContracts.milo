// @expect: 1024
// @expect: true
// @expect: 1024

from "std/mem" import {
    Bump
}

pub fn main(): i32 {
    var bump = Bump.new(1024)!

    let remaining = bump.remaining()
    print(remaining)

    let ptr = bump.alloc(64)!
    print(ptr > 0)

    bump.reset()
    print(bump.remaining())

    return 0
}
