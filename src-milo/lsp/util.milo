// Shared helpers for the LSP feature modules (hover, definition).
//
// findStdlibRoot deliberately does NOT live here as a duplicate of
// main.milo's: Milo compiles every reachable module into one flat namespace,
// so two `pub fn findStdlibRoot` bodies anywhere in the graph is a hard
// compile error, not a shadowing warning — hover.milo/definition.milo should
// import it straight from "src-milo/main.milo" when they need it (the
// resolver already tolerates import cycles via a visited set, the same way
// std/os <-> std/runtime does).

// Strip a file:// prefix down to a plain filesystem path. Not full URI
// decoding (no %XX unescape) — editors send plain paths with no special
// characters in practice, same simplification the TS oracle makes by only
// handling the file:// case through Node's fileURLToPath.
pub fn uriToPath(uri: &string): string {
    if uri.startsWith("file://") {
        return uri.substr(7, uri.len)
    }
    return uri.clone()
}

// The identifier touching (line, character) in `source` — 0-based like every
// LSP position. Mirrors src/lsp.ts's getWordAt: expand left and right from
// the cursor over word characters (`\w` — letters, digits, underscore).
pub fn getWordAt(source: &string, line: i64, character: i64): string {
    let lines = source.split("\n")
    if line < 0 || line >= lines.len {
        return ""
    }
    let text = lines[line]
    var start = character
    if start > text.len {
        start = text.len
    }
    var end = start
    while start > 0 && isWordByte(text[start - 1]) {
        start = start - 1
    }
    while end < text.len && isWordByte(text[end]) {
        end = end + 1
    }
    return text.substr(start, end)
}

pub fn isWordByte(b: u8): bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_'
}

// Line index of the first `fn NAME(` / `fn NAME<` declaration head — the
// def-site users cmd-click to and the boundary hover.milo's findEnclosingFn
// scans against. Manual word-boundary scan, not regex: the self-hosted
// stdlib has no regex module, and the shape (`\bfn\s+NAME\s*[<(]`) is simple
// enough that hand-scanning it is clearer than building or importing one.
pub fn findFnDeclLine(source: &string, name: string): Option<i64> {
    let lines = source.split("\n")
    var i: i64 = 0
    while i < lines.len {
        if fnDeclHere(lines[i], name.clone()) {
            return Option.Some(i)
        }
        i = i + 1
    }
    return Option.None
}

fn fnDeclHere(lineText: string, name: string): bool {
    let needle = "fn " + name.clone()
    var searchFrom: i64 = 0
    while searchFrom <= lineText.len {
        match lineText.indexOfFrom(needle.clone(), searchFrom) {
            Option.Some(idx) => {
                let boundaryBefore = idx == 0 || !isWordByte(lineText[idx - 1])
                let after = idx + needle.len
                let boundaryAfter = after < lineText.len && !isWordByte(lineText[after])
                if boundaryBefore && boundaryAfter {
                    var j = after
                    while j < lineText.len && lineText[j] == ' ' {
                        j = j + 1
                    }
                    if j < lineText.len && (lineText[j] == '(' || lineText[j] == '<') {
                        return true
                    }
                }
                searchFrom = idx + 1
            }
            Option.None => {
                return false
            }
        }
    }
    return false
}

// Line index of `keyword NAME` as a whole-word match anywhere on the line —
// covers `struct NAME`, `enum NAME`, `type NAME` declaration heads (none of
// which need the `(`/`<` check `fn` does).
pub fn findKeywordDeclLine(source: &string, keyword: string, name: string): Option<i64> {
    let lines = source.split("\n")
    var i: i64 = 0
    while i < lines.len {
        if keywordDeclHere(lines[i], keyword.clone(), name.clone()) {
            return Option.Some(i)
        }
        i = i + 1
    }
    return Option.None
}

fn keywordDeclHere(lineText: string, keyword: string, name: string): bool {
    let needle = keyword.clone() + " " + name.clone()
    var searchFrom: i64 = 0
    while searchFrom <= lineText.len {
        match lineText.indexOfFrom(needle.clone(), searchFrom) {
            Option.Some(idx) => {
                let boundaryBefore = idx == 0 || !isWordByte(lineText[idx - 1])
                let after = idx + needle.len
                let boundaryAfter = after >= lineText.len || !isWordByte(lineText[after])
                if boundaryBefore && boundaryAfter {
                    return true
                }
                searchFrom = idx + 1
            }
            Option.None => {
                return false
            }
        }
    }
    return false
}
