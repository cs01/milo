// The same transform over four workers, in place, via shatter/weld. No element is
// copied: each worker owns a disjoint window of the one buffer.
from "std/shard" import {
    Shard, shatter
}
from "std/runtime" import {
    Promise
}
from "std/time" import {
    epochMillis
}

fn work(w: Shard<f64>): Shard<f64> {
    var s = w
    var j: i64 = 0
    while j < s.len() {
        s.set(j, s.get(j) * 1.0000001 + 0.5)
        j = j + 1
    }
    return s
}

pub fn main(): i32 {
    let n: i64 = 20000000
    let workers: i64 = 4
    var v: Vec<f64> = Vec.withCapacity(n)
    var i: i64 = 0
    while i < n {
        v.push(1.0)
        i = i + 1
    }
    let t0 = epochMillis()
    var owner = shatter(v, workers)
    var windows = owner.windows()
    var ps: Vec<Promise<Shard<f64>>> = Vec.new()
    while windows.len > 0 {
        let w = windows.pop()!
        ps.push(Promise<Shard<f64>>.blocking(move(): Shard<f64> => {
            return work(w)
        }
        ))
    }
    let back = Promise.all(ps).await()!
    let out = owner.weld(back)!
    let t1 = epochMillis()
    print("par ms=" + (t1 - t0).toString() + " check=" + (out[0] + out[n - 1]).toString())
    return 0
}
