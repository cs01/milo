// Statement codegen: let/var, assign, if, while, for, match, break/continue
from "src-milo/ast.milo" import {
    Expr, Stmt, Pattern, MatchArm, Param, MiloType, StructLitField, LiteralKind, Span,
    cloneOptType, cloneSpan, cloneParams, cloneStmts
}
from "src-milo/codegen/types.milo" import {
    astTypeStr,
    Cgen, Val, Local, CgFnSig, RangeAnno, noRange, rangeOfAnnotation, rangeOfOptAnnotation,
    nextTemp, nextLabel, emit, emitG, emitLabel, llType, stripPercent, resolveTyStr, ensureMalloc,
    findLocal, hasLocal, genLoad, isVecTy, unwrapVec,
    isHashMapTy, hashMapKeyTy, hashMapValTy, hmEntryTy,
    lookupFieldIndex, lookupFieldType, lookupFieldRange, lookupVariantTag, lookupVariantPayload, lookupFnRet,
    isInlineArrTy, inlineArrElem, addrWasMoved, ensureStringTy
}
from "src-milo/codegen/expr.milo" import {
    genExpr, genLvalue, variantStructTy, genOptionWrapIfNeeded, genInterfaceCoerceIfNeeded, genOwnedArg,
    constFoldBool, emitRangeCheck
}
from "src-milo/codegen/drops.milo" import {
    emitDropValue, cgNeedsDrop
}
from "src-milo/codegen/strings.milo" import {
    genStringAppendInPlace, genStringEq, genStringLit, emitStringLit, ensureStrFind
}

// -- Assignment --

// Two lvalue exprs denote the same storage location (used to detect self-assign
// and the `place = place + rhs` append pattern). Conservative: only Ident and
// FieldAccess chains; anything else (index, deref) returns false.
pub fn lvalueMatches(a: &Expr, b: &Expr): bool {
    match a {
        Expr.Ident(an, aspan) => {
            match b {
                Expr.Ident(bn, bspan) => {
                    return an == bn
                }
                _ => {
                    return false
                }
            }
        }
        Expr.FieldAccess(aobj, afield, aspan) => {
            match b {
                Expr.FieldAccess(bobj, bfield, bspan) => {
                    if afield != bfield {
                        return false
                    }
                    return lvalueMatches(*aobj, *bobj)
                }
                _ => {
                    return false
                }
            }
        }
        _ => {
            return false
        }
    }
}

// Resolve an lvalue's declared type WITHOUT emitting IR (so the append-opt can
// gate on `string` before committing to the fast path).
pub fn lvalueTypeStr(cg: &mut Cgen, e: &Expr, locs: &Vec<Local>): string {
    match e {
        Expr.Ident(name, span) => {
            // a module global isn't in `locs`; findLocal would hit its locs[0]
            // fallback (out-of-bounds when locs is empty, e.g. in a global-only fn)
            if !hasLocal(locs, name) && cg.globalVars.contains(name) {
                return cg.globalVars.get(name)!
            }
            return findLocal(locs, name).ty.clone()
        }
        Expr.FieldAccess(object, field, span) => {
            let ot = lvalueTypeStr(cg, *object, locs)
            let rawName = stripPercent(ot)
            let idx = lookupFieldIndex(cg, rawName, field)
            return lookupFieldType(cg, rawName, idx)
        }
        _ => {
            return ""
        }
    }
}

pub fn genAssign(cg: &mut Cgen, target: &Expr, value: &Expr, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, stmtSpan: &Option<Span>) {
    // Fast path: `place = place + rhs` for strings → amortized in-place append.
    // The naive store path re-concats (fresh alloc + leaked old buffer) every
    // time, making an accumulator like `cg.body = cg.body + s` O(n^2) in time
    // AND memory. Bail on `x = x + x` (overlapping copy — let the slow path own).
    match value {
        Expr.BinOp(op, left, right, bspan) => {
            if op == "+" && lvalueMatches(target, *left) && !lvalueMatches(target, *right) {
                if llType(lvalueTypeStr(cg, target, locs)) == "%String" {
                    let bv = genExpr(cg, *right, locs, sigs, "%String")
                    let lv = genLvalue(cg, target, locs, sigs)
                    genStringAppendInPlace(cg, lv.v, bv.v)
                    return
                }
            }
        }
        _ => {
        }
    }
    match target {
        Expr.Ident(name, span) => {
            // a module global (not shadowed by a local) stores through @name
            if !hasLocal(locs, name) && cg.globalVars.contains(name) {
                let gty = cg.globalVars.get(name)!
                // eval + move RHS, THEN drop the old value (order matters: the RHS
                // may read the slot), THEN overwrite. Zeroed-on-move slots drop to
                // no-ops, so a moved-out or reassigned global never double-frees.
                let v0 = genOwnedArg(cg, value, gty.clone(), locs, sigs)
                let v = genOptionWrapIfNeeded(cg, v0, gty)
                if cgNeedsDrop(cg, gty) && !lvalueMatches(target, value) {
                    emitDropValue(cg, "@" + name.clone(), gty)
                }
                emit(cg, "  store " + llType(v.ty) + " " + v.v + ", ptr @" + name.clone() + "\n")
            } else {
                let local = findLocal(locs, name)
                let lty = local.ty.clone()
                let v0 = genOwnedArg(cg, value, lty.clone(), locs, sigs)
                let v = genOptionWrapIfNeeded(cg, v0, lty)
                emitRangeCheck(cg, v, local.range, stmtSpan)
                if !local.isRef && cgNeedsDrop(cg, lty) && !lvalueMatches(target, value) {
                    emitDropValue(cg, local.addr, lty)
                }
                emit(cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + local.addr + "\n")
            }
        }
        Expr.FieldAccess(object, field, span) => {
            let lv = genLvalue(cg, *object, locs, sigs)
            // `p.x = …` through a raw pointer: load the pointer to reach the struct,
            // gep the pointee field; otherwise gep the struct lvalue directly.
            var structAddr = lv.v.clone()
            var rawName = stripPercent(lv.ty)
            if lv.ty.len > 0 && lv.ty[0] == 42 {
                let pointee = lv.ty[1..lv.ty.len].clone()
                rawName = stripPercent(resolveTyStr(cg, pointee))
                let sa = nextTemp(cg)
                emit(cg, "  " + sa + " = load ptr, ptr " + lv.v + "\n")
                structAddr = sa
            }
            let idx = lookupFieldIndex(cg, rawName, field)
            let fty = lookupFieldType(cg, rawName, idx)
            let structTy = "%" + rawName
            let fp = nextTemp(cg)
            emit(cg, "  " + fp + " = getelementptr " + structTy + ", ptr " + structAddr + ", i32 0, i32 " + idx.toString() + "\n")
            // field takes ownership of the RHS → move it (zero the source place).
            // The old field value is not dropped yet (slice 2) — a leak, not a UAF.
            // Hint with the SURFACE field type ("Vec<f64>"), not its LLVM spelling
            // ("%Vec", which throws the element type away): `c.dem = Vec.filled(n,
            // 0.0)` needs the real element type to reach genVecFilled's fill-value
            // hint, or it silently fell back to Vec<i64> and stored a float literal
            // into an i64 slot ("store i64 0.0" — invalid IR).
            let v = genOwnedArg(cg, value, fty.clone(), locs, sigs)
            let frange = lookupFieldRange(cg, rawName, idx)
            emitRangeCheck(cg, v, frange, stmtSpan)
            emit(cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + fp + "\n")
        }
        // A capitalized *variable* followed by `.field = value` parses identically
        // to a static enum-literal (mirrors genLvalue's own EnumLit case and the
        // checker's isRootMutable fallback) — `STORE.name = "milo"` (single dot,
        // no further FieldAccess wrapper around it) landed here as a bare EnumLit
        // and this arm was MISSING entirely, so the assignment silently matched
        // the `_` no-op below and did nothing: the field never changed and no
        // diagnostic said why. Guarded the same way as genLvalue's EnumLit case —
        // a GENUINE enum literal is never a legal assignment target (isRootMutable
        // already rejects it), so this should only ever see the variable case in a
        // program that type-checked, but the guard keeps that an invariant rather
        // than a hope: without it, a real enum name resolves as a local via
        // findLocal's "should not happen" fallback (locs[0], something unrelated)
        // and writes through whatever garbage field index that finds.
        Expr.EnumLit(enumName, variant, args, espan) => {
            let isVar = !cg.enums.contains(enumName) && (hasLocal(locs, enumName) || cg.globalVars.contains(enumName))
            if isVar {
                // Plain string vars, not a reassigned Val — see genLvalue's EnumLit
                // arm for why (milo-self's own borrow checker over-rejects the
                // struct-reassignment shape; separately owned, not fixed here).
                var lvV = "0"
                var lvTy = ""
                if !hasLocal(locs, enumName) && cg.globalVars.contains(enumName) {
                    let surf = cg.globalVars.get(enumName)!
                    lvV = "@" + enumName.clone()
                    lvTy = surf
                } else {
                    let local = findLocal(locs, enumName)
                    lvV = local.addr.clone()
                    lvTy = local.ty.clone()
                }
                var structAddr = lvV.clone()
                var rawName = stripPercent(lvTy)
                if lvTy.len > 0 && lvTy[0] == 42 {
                    let pointee = lvTy[1..lvTy.len].clone()
                    rawName = stripPercent(resolveTyStr(cg, pointee))
                    let sa = nextTemp(cg)
                    emit(cg, "  " + sa + " = load ptr, ptr " + lvV + "\n")
                    structAddr = sa
                }
                let idx = lookupFieldIndex(cg, rawName, variant)
                let fty = lookupFieldType(cg, rawName, idx)
                let structTy = "%" + rawName
                let fp = nextTemp(cg)
                emit(cg, "  " + fp + " = getelementptr " + structTy + ", ptr " + structAddr + ", i32 0, i32 " + idx.toString() + "\n")
                let v = genOwnedArg(cg, value, fty.clone(), locs, sigs)
                emit(cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + fp + "\n")
            }
        }
        Expr.IndexAccess(obj, idx, span) => {
            // M3e: v[i] = x for Vec receivers (fixed arrays still pending)
            let lv = genLvalue(cg, *obj, locs, sigs)
            if isVecTy(lv.ty) {
                let elemTy = unwrapVec(lv.ty)
                let elemLl = llType(elemTy)
                let dPtr = nextTemp(cg)
                emit(cg, "  " + dPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 0\n")
                let d = nextTemp(cg)
                emit(cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
                let iv = genExpr(cg, *idx, locs, sigs, "i64")
                let i64v = widenToI64(cg, iv)
                let slot = nextTemp(cg)
                emit(cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i64v + "\n")
                let v = genOwnedArg(cg, value, elemTy, locs, sigs)
                emit(cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + slot + "\n")
            } else if lv.ty.len > 0 && lv.ty[0] == 42 {
                // Raw pointer `*T` (unsafe): lv.v is the alloca holding the
                // pointer, so load the pointer value before indexing.
                let elemTy = lv.ty[1..lv.ty.len].clone()
                let elemLl = llType(elemTy)
                let base = nextTemp(cg)
                emit(cg, "  " + base + " = load ptr, ptr " + lv.v + "\n")
                let iv = genExpr(cg, *idx, locs, sigs, "i64")
                let i64v = widenToI64(cg, iv)
                let slot = nextTemp(cg)
                emit(cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + base + ", i64 " + i64v + "\n")
                let v = genExpr(cg, value, locs, sigs, elemTy)
                emit(cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + slot + "\n")
            } else if isInlineArrTy(lv.ty) {
                // Inline struct-field array: lv.v is already the field's
                // address (genLvalue GEP'd into the enclosing struct) — index
                // it directly, no %Vec data ptr to extract.
                let elemTy = inlineArrElem(lv.ty)
                let elemLl = llType(elemTy)
                let arrLl = llType(lv.ty)
                let iv = genExpr(cg, *idx, locs, sigs, "i64")
                let i64v = widenToI64(cg, iv)
                let slot = nextTemp(cg)
                emit(cg, "  " + slot + " = getelementptr " + arrLl + ", ptr " + lv.v + ", i32 0, i64 " + i64v + "\n")
                let v = genOwnedArg(cg, value, elemTy, locs, sigs)
                emit(cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + slot + "\n")
            } else {
                eprint("codegen: cannot index-assign type " + lv.ty.clone())
                exit(1)
            }
        }
        // `*p = v` through a raw `*T` or a Heap<T> box. genLvalue already knows
        // this shape (it serves `(*p).field` and `&a[i]`), but genAssign had no
        // arm for it, so every deref store matched the `_` below and emitted
        // NOTHING — std/ws built an entire frame header that never reached the
        // buffer, and the reader blocked forever on bytes the writer never sent.
        Expr.UnaryOp(op, operand, uspan) => {
            if op != "*" {
                eprint("codegen: cannot assign through unary '" + op.clone() + "'")
                exit(1)
            }
            let lv = genLvalue(cg, target, locs, sigs)
            let v = genOwnedArg(cg, value, lv.ty.clone(), locs, sigs)
            emit(cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + lv.v + "\n")
        }
        // Fail loudly. A place the checker accepted but codegen cannot lower is a
        // missing arm, not a no-op — silently dropping the store is the worst
        // possible outcome (see the UnaryOp arm above, which was exactly that).
        _ => {
            eprint("codegen: unsupported assignment target")
            exit(1)
        }
    }
}

// -- While loop --

pub fn genWhile(cg: &mut Cgen, cond: &Expr, body: &Vec<Heap<Stmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string) {
    let condLbl = nextLabel(cg, "wcond")
    let bodyLbl = nextLabel(cg, "wbody")
    let endLbl = nextLabel(cg, "wend")
    let savedBreak = cg.curBreakLbl.clone()
    let savedCont = cg.curContLbl.clone()
    let savedLoopScopeLen = cg.curLoopScopeLen
    cg.curBreakLbl = endLbl.clone()
    cg.curContLbl = condLbl.clone()
    emit(cg, "  br label %" + condLbl + "\n")
    emit(cg, condLbl + ":\n")
    let cv = genExpr(cg, cond, locs, sigs, "bool")
    emit(cg, "  br i1 " + cv.v + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emit(cg, bodyLbl + ":\n")
    var bodyTerm = false
    // Same block scope as an if-branch, and doubly important in a loop: without it a
    // value declared in the body accumulates one un-dropped alloca per iteration.
    let bodyPreLen = locs.len
    cg.curLoopScopeLen = bodyPreLen
    for bi in 0..body.len {
        if genStmt(cg, *body[bi], locs, sigs, retTy) {
            bodyTerm = true
        }
    }
    if !bodyTerm {
        emitScopeDrops(cg, locs, bodyPreLen, "")
    }
    while locs.len > bodyPreLen {
        let _ = locs.pop()
    }
    if !bodyTerm {
        emit(cg, "  br label %" + condLbl + "\n")
    }
    emit(cg, endLbl + ":\n")
    cg.curBreakLbl = savedBreak
    cg.curContLbl = savedCont
    cg.curLoopScopeLen = savedLoopScopeLen
}

// -- For-in loops (M3a): range, Vec, string bytes --

// Widen an integer Val to i64 so range bounds of any width share one compare.
pub fn widenToI64(cg: &mut Cgen, v: &Val): string {
    let ll = llType(v.ty)
    if ll == "i64" {
        return v.v.clone()
    }
    let w = nextTemp(cg)
    emit(cg, "  " + w + " = sext " + ll + " " + v.v + " to i64\n")
    return w
}

// `for key, value in map`: walk the flat entry array; body sees copies bound
// through hoisted allocas. Emits everything up to (not including) stepLbl.
pub fn genForInHashMap(cg: &mut Cgen, varName: &string, varName2: &Option<string>, obj: &Val, body: &Vec<Heap<Stmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, condLbl: &string, bodyLbl: &string, stepLbl: &string, endLbl: &string, idxAddr: &string) {
    let keyTy = hashMapKeyTy(obj.ty)
    let valTy = hashMapValTy(obj.ty)
    let entryTy = hmEntryTy(keyTy, valTy)
    let keyLl = llType(keyTy)
    let valLl = llType(valTy)
    let data = nextTemp(cg)
    emit(cg, "  " + data + " = extractvalue %HashMap " + obj.v + ", 0\n")
    let count = nextTemp(cg)
    emit(cg, "  " + count + " = extractvalue %HashMap " + obj.v + ", 1\n")
    let keyAddr = nextTemp(cg)
    emit(cg, "  " + keyAddr + " = alloca " + keyLl + "\n")
    let valAddr = nextTemp(cg)
    emit(cg, "  " + valAddr + " = alloca " + valLl + "\n")
    emit(cg, "  store i64 0, ptr " + idxAddr.clone() + "\n")
    emit(cg, "  br label %" + condLbl.clone() + "\n")
    emit(cg, condLbl.clone() + ":\n")
    let cur = nextTemp(cg)
    emit(cg, "  " + cur + " = load i64, ptr " + idxAddr.clone() + "\n")
    let lt = nextTemp(cg)
    emit(cg, "  " + lt + " = icmp slt i64 " + cur + ", " + count + "\n")
    emit(cg, "  br i1 " + lt + ", label %" + bodyLbl.clone() + ", label %" + endLbl.clone() + "\n")
    emit(cg, bodyLbl.clone() + ":\n")
    let slot = nextTemp(cg)
    emit(cg, "  " + slot + " = getelementptr " + entryTy + ", ptr " + data + ", i64 " + cur + "\n")
    let kp = nextTemp(cg)
    emit(cg, "  " + kp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 0\n")
    let k = nextTemp(cg)
    emit(cg, "  " + k + " = load " + keyLl + ", ptr " + kp + "\n")
    emit(cg, "  store " + keyLl + " " + k + ", ptr " + keyAddr + "\n")
    let vp = nextTemp(cg)
    emit(cg, "  " + vp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 1\n")
    let v = nextTemp(cg)
    emit(cg, "  " + v + " = load " + valLl + ", ptr " + vp + "\n")
    emit(cg, "  store " + valLl + " " + v + ", ptr " + valAddr + "\n")
    let locsPreLen = locs.len
    locs.push(Local {
        name: varName.clone(), ty: keyTy.clone(), addr: keyAddr.clone(), isRef: false, isArr: false, range: noRange()
    }
    )
    match varName2 {
        Option.Some(valName) => {
            locs.push(Local {
                name: valName.clone(), ty: valTy.clone(), addr: valAddr.clone(), isRef: false, isArr: false, range: noRange()
            }
            )
        }
        Option.None => {
        }
    }
    var bodyTerm = false
    for bi in 0..body.len {
        if genStmt(cg, *body[bi], locs, sigs, retTy) {
            bodyTerm = true
        }
    }
    while locs.len > locsPreLen {
        let _ = locs.pop()
    }
    if !bodyTerm {
        emit(cg, "  br label %" + stepLbl.clone() + "\n")
    }
}

// `for line in text.lines()` / `for f in text.splitView(sep)`. Each iteration stores
// a non-owning %String (cap 0, so drop glue skips it) pointing straight into the
// receiver's own buffer — the checker has frozen it for the whole loop (checked in
// checker/stmt.milo checkStringViewForIn, though this codegen doesn't itself enforce
// that; there is no freeze/unfreeze mechanism in this checker yet, so a program that
// mutates the receiver mid-loop is not rejected the way the TS oracle rejects it).
// Reuses the caller's (genForIn's) own labels — this is a full self-contained loop
// body, like the channel-drain and iterator-protocol branches above, because its
// step is "jump to the next found separator", not a plain index +1.
pub fn genForStrView(cg: &mut Cgen, varName: &string, varName2: &Option<string>, recvExpr: &Expr, mode: &string, sepArgs: &Vec<Heap<Expr>>, body: &Vec<Heap<Stmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, condLbl: &string, bodyLbl: &string, stepLbl: &string, endLbl: &string) {
    ensureStringTy(cg)
    let isSplit = mode == "splitView"

    let srcVal = genExpr(cg, recvExpr, locs, sigs, "")
    let dataP = nextTemp(cg)
    emit(cg, "  " + dataP + " = extractvalue %String " + srcVal.v + ", 0\n")
    let lenV = nextTemp(cg)
    emit(cg, "  " + lenV + " = extractvalue %String " + srcVal.v + ", 1\n")

    // the separator: an explicit argument for splitView, a literal newline for lines
    var sepPtr = ""
    var sepLen = "1"
    if isSplit {
        let sepVal = genExpr(cg, *sepArgs[0], locs, sigs, "")
        let sp = nextTemp(cg)
        emit(cg, "  " + sp + " = extractvalue %String " + sepVal.v + ", 0\n")
        sepPtr = sp
        let sl = nextTemp(cg)
        emit(cg, "  " + sl + " = extractvalue %String " + sepVal.v + ", 1\n")
        sepLen = sl
    } else {
        let nlLabel = emitStringLit(cg, "\n")
        let sp = nextTemp(cg)
        emit(cg, "  " + sp + " = getelementptr [2 x i8], ptr " + nlLabel + ", i32 0, i32 0\n")
        sepPtr = sp
        sepLen = "1"
    }
    ensureStrFind(cg)

    let posAddr = nextTemp(cg)
    emit(cg, "  " + posAddr + " = alloca i64\n")
    emit(cg, "  store i64 0, ptr " + posAddr + "\n")
    let nextAddr = nextTemp(cg)
    emit(cg, "  " + nextAddr + " = alloca i64\n")
    let viewAddr = nextTemp(cg)
    emit(cg, "  " + viewAddr + " = alloca %String\n")

    // enumerate form: `for i, line in text.lines()` binds the piece to the second name
    var idxAddr = ""
    match varName2 {
        Option.Some(viewName) => {
            let ia = nextTemp(cg)
            emit(cg, "  " + ia + " = alloca i64\n")
            emit(cg, "  store i64 0, ptr " + ia + "\n")
            idxAddr = ia
        }
        Option.None => {
        }
    }

    emit(cg, "  br label %" + condLbl.clone() + "\n")
    emitLabel(cg, condLbl)
    let pos = nextTemp(cg)
    emit(cg, "  " + pos + " = load i64, ptr " + posAddr + "\n")
    var more = ""
    if !isSplit {
        // a trailing newline ends the last line, it does not start an empty one
        let m = nextTemp(cg)
        emit(cg, "  " + m + " = icmp slt i64 " + pos + ", " + lenV + "\n")
        more = m
    } else {
        // `pos == len` still yields the piece after a trailing separator ("a," -> "a", "")
        let inRange = nextTemp(cg)
        emit(cg, "  " + inRange + " = icmp sle i64 " + pos + ", " + lenV + "\n")
        // an empty separator splits into single bytes, which run out one step earlier
        let sepEmpty = nextTemp(cg)
        emit(cg, "  " + sepEmpty + " = icmp eq i64 " + sepLen + ", 0\n")
        let emptyDone = nextTemp(cg)
        emit(cg, "  " + emptyDone + " = icmp sge i64 " + pos + ", " + lenV + "\n")
        let notEmptyDone = nextTemp(cg)
        emit(cg, "  " + notEmptyDone + " = xor i1 " + emptyDone + ", true\n")
        let okEmpty = nextTemp(cg)
        emit(cg, "  " + okEmpty + " = select i1 " + sepEmpty + ", i1 " + notEmptyDone + ", i1 true\n")
        let m = nextTemp(cg)
        emit(cg, "  " + m + " = and i1 " + inRange + ", " + okEmpty + "\n")
        more = m
    }
    emit(cg, "  br i1 " + more + ", label %" + bodyLbl.clone() + ", label %" + endLbl.clone() + "\n")

    emitLabel(cg, bodyLbl)
    let found = nextTemp(cg)
    emit(cg, "  " + found + " = call i64 @milo.strfind(ptr " + dataP + ", i64 " + lenV + ", ptr " + sepPtr + ", i64 " + sepLen + ", i64 " + pos + ")\n")
    var sepIdx = found.clone()
    if isSplit {
        // an empty needle matches at `pos` and would never advance; treat the next byte
        // boundary as the separator instead, which is what strSplit("") yields
        let sepEmpty2 = nextTemp(cg)
        emit(cg, "  " + sepEmpty2 + " = icmp eq i64 " + sepLen + ", 0\n")
        let posPlus1 = nextTemp(cg)
        emit(cg, "  " + posPlus1 + " = add i64 " + pos + ", 1\n")
        let chosen = nextTemp(cg)
        emit(cg, "  " + chosen + " = select i1 " + sepEmpty2 + ", i64 " + posPlus1 + ", i64 " + found + "\n")
        sepIdx = chosen
    }
    let hasSep = nextTemp(cg)
    emit(cg, "  " + hasSep + " = icmp sge i64 " + sepIdx + ", 0\n")
    let pieceEnd = nextTemp(cg)
    emit(cg, "  " + pieceEnd + " = select i1 " + hasSep + ", i64 " + sepIdx + ", i64 " + lenV + "\n")

    var viewEnd = pieceEnd.clone()
    if !isSplit {
        // CRLF: the '\r' belongs to the line ending, not to the line
        let nonEmpty = nextTemp(cg)
        emit(cg, "  " + nonEmpty + " = icmp sgt i64 " + pieceEnd + ", " + pos + "\n")
        let prevIdx = nextTemp(cg)
        emit(cg, "  " + prevIdx + " = sub i64 " + pieceEnd + ", 1\n")
        // clamped so the load stays inside the buffer when the line is empty
        let probeIdx = nextTemp(cg)
        emit(cg, "  " + probeIdx + " = select i1 " + nonEmpty + ", i64 " + prevIdx + ", i64 " + pos + "\n")
        let probePtr = nextTemp(cg)
        emit(cg, "  " + probePtr + " = getelementptr i8, ptr " + dataP + ", i64 " + probeIdx + "\n")
        let probe = nextTemp(cg)
        emit(cg, "  " + probe + " = load i8, ptr " + probePtr + "\n")
        let isCR = nextTemp(cg)
        emit(cg, "  " + isCR + " = icmp eq i8 " + probe + ", 13\n")
        let strip = nextTemp(cg)
        emit(cg, "  " + strip + " = and i1 " + nonEmpty + ", " + isCR + "\n")
        let stripped = nextTemp(cg)
        emit(cg, "  " + stripped + " = select i1 " + strip + ", i64 " + prevIdx + ", i64 " + pieceEnd + "\n")
        viewEnd = stripped
    }

    // A real zero-copy view (bare pointer into `data`, no NUL at its own end) would
    // match the TS oracle exactly, but this codegen's `print` always emits a plain
    // libc "%s" for a %String argument (codegen/expr.milo genCall) — printf then
    // reads past the view's end to the SOURCE buffer's own terminator, printing every
    // remaining line instead of just this piece. Until print is made length-aware,
    // each piece has to be its own NUL-terminated copy, same as genStringSlice.
    // cap=0 (not sz): nothing takes ownership of a for-in loop var beyond the body,
    // and for-in doesn't scope-drop its locals yet (a separate, pre-existing gap —
    // see genForIn) — so this leaks per iteration either way. cap=0 at least keeps
    // it from ever being double-freed if that gap is closed later.
    ensureMalloc(cg)
    ensureMemcpy(cg)
    let viewLen = nextTemp(cg)
    emit(cg, "  " + viewLen + " = sub i64 " + viewEnd + ", " + pos + "\n")
    let sz = nextTemp(cg)
    emit(cg, "  " + sz + " = add i64 " + viewLen + ", 1\n")
    let buf = nextTemp(cg)
    emit(cg, "  " + buf + " = call ptr @malloc(i64 " + sz + ")\n")
    let srcP = nextTemp(cg)
    emit(cg, "  " + srcP + " = getelementptr i8, ptr " + dataP + ", i64 " + pos + "\n")
    emit(cg, "  call ptr @memcpy(ptr " + buf + ", ptr " + srcP + ", i64 " + viewLen + ")\n")
    let np = nextTemp(cg)
    emit(cg, "  " + np + " = getelementptr i8, ptr " + buf + ", i64 " + viewLen + "\n")
    emit(cg, "  store i8 0, ptr " + np + "\n")
    let v0 = nextTemp(cg)
    emit(cg, "  " + v0 + " = insertvalue %String undef, ptr " + buf + ", 0\n")
    let v1 = nextTemp(cg)
    emit(cg, "  " + v1 + " = insertvalue %String " + v0 + ", i64 " + viewLen + ", 1\n")
    let v2 = nextTemp(cg)
    emit(cg, "  " + v2 + " = insertvalue %String " + v1 + ", i64 0, 2\n")
    emit(cg, "  store %String " + v2 + ", ptr " + viewAddr + "\n")

    // Computed here, where the search result is live, and read back in the increment
    // block — which `continue` can also reach, from blocks that do not see these values.
    let afterSep = nextTemp(cg)
    emit(cg, "  " + afterSep + " = add i64 " + pieceEnd + ", " + sepLen + "\n")
    let past = nextTemp(cg)
    emit(cg, "  " + past + " = add i64 " + lenV + ", 1\n")
    let nextPos = nextTemp(cg)
    emit(cg, "  " + nextPos + " = select i1 " + hasSep + ", i64 " + afterSep + ", i64 " + past + "\n")
    emit(cg, "  store i64 " + nextPos + ", ptr " + nextAddr + "\n")

    let locsPreLen = locs.len
    match varName2 {
        Option.Some(viewName) => {
            locs.push(Local {
                name: varName.clone(), ty: "i64", addr: idxAddr.clone(), isRef: false, isArr: false, range: noRange()
            }
            )
            locs.push(Local {
                name: viewName.clone(), ty: "string", addr: viewAddr.clone(), isRef: false, isArr: false, range: noRange()
            }
            )
        }
        Option.None => {
            locs.push(Local {
                name: varName.clone(), ty: "string", addr: viewAddr.clone(), isRef: false, isArr: false, range: noRange()
            }
            )
        }
    }

    var bodyTerm = false
    for bi in 0..body.len {
        if genStmt(cg, *body[bi], locs, sigs, retTy) {
            bodyTerm = true
        }
    }
    while locs.len > locsPreLen {
        let _ = locs.pop()
    }
    if !bodyTerm {
        emit(cg, "  br label %" + stepLbl.clone() + "\n")
    }

    emitLabel(cg, stepLbl)
    let advanced = nextTemp(cg)
    emit(cg, "  " + advanced + " = load i64, ptr " + nextAddr + "\n")
    emit(cg, "  store i64 " + advanced + ", ptr " + posAddr + "\n")
    if idxAddr != "" {
        let curIdx = nextTemp(cg)
        emit(cg, "  " + curIdx + " = load i64, ptr " + idxAddr + "\n")
        let nextIdx = nextTemp(cg)
        emit(cg, "  " + nextIdx + " = add i64 " + curIdx + ", 1\n")
        emit(cg, "  store i64 " + nextIdx + ", ptr " + idxAddr + "\n")
    }
    emit(cg, "  br label %" + condLbl.clone() + "\n")

    emitLabel(cg, endLbl)
}

pub fn genForIn(cg: &mut Cgen, varName: &string, varName2: &Option<string>, iterable: &Expr, body: &Vec<Heap<Stmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string) {
    let condLbl = nextLabel(cg, "fcond")
    let bodyLbl = nextLabel(cg, "fbody")
    let stepLbl = nextLabel(cg, "fstep")
    let endLbl = nextLabel(cg, "fend")
    let savedBreak = cg.curBreakLbl.clone()
    let savedCont = cg.curContLbl.clone()
    let savedLoopScopeLen = cg.curLoopScopeLen
    // for-in doesn't scope-drop its body at all yet (a separate, pre-existing
    // gap — the loop-bound var is a borrow/copy, but a body-declared droppable
    // local still leaks here every iteration). -1 keeps break/continue from
    // guessing at a scope length this loop kind doesn't track, rather than
    // reusing a stale value from an enclosing while and dropping the wrong
    // locals on a nested break.
    cg.curLoopScopeLen = -1
    cg.curBreakLbl = endLbl.clone()
    // continue must run the increment, unlike while where it re-tests directly
    cg.curContLbl = stepLbl.clone()

    let idxAddr = nextTemp(cg)
    emit(cg, "  " + idxAddr + " = alloca i64\n")

    match iterable {
        Expr.RangeExpr(startE, endE, span) => {
            let sv = genExpr(cg, *startE, locs, sigs, "i64")
            let ev = genExpr(cg, *endE, locs, sigs, "i64")
            let s64 = widenToI64(cg, sv)
            let e64 = widenToI64(cg, ev)
            emit(cg, "  store i64 " + s64 + ", ptr " + idxAddr + "\n")
            emit(cg, "  br label %" + condLbl + "\n")
            emit(cg, condLbl + ":\n")
            let cur = nextTemp(cg)
            emit(cg, "  " + cur + " = load i64, ptr " + idxAddr + "\n")
            let lt = nextTemp(cg)
            emit(cg, "  " + lt + " = icmp slt i64 " + cur + ", " + e64 + "\n")
            emit(cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
            emit(cg, bodyLbl + ":\n")
            let locsPreLen = locs.len
            locs.push(Local {
                name: varName.clone(), ty: "i64", addr: idxAddr.clone(), isRef: false, isArr: false, range: noRange()
            }
            )
            var bodyTerm = false
            for bi in 0..body.len {
                if genStmt(cg, *body[bi], locs, sigs, retTy) {
                    bodyTerm = true
                }
            }
            while locs.len > locsPreLen {
                let _ = locs.pop()
            }
            if !bodyTerm {
                emit(cg, "  br label %" + stepLbl + "\n")
            }
        }
        _ => {
            // `for line in text.lines()` / `for f in text.splitView(sep)` — checked
            // and typed specially (checker/stmt.milo checkStringViewForIn), so it has
            // to be recognized here too rather than falling into the generic
            // genExpr(iterable) below, which would try (and fail) to codegen
            // "lines"/"splitView" as an ordinary method call.
            match iterable {
                Expr.MethodCall(mObj, mMethod, mArgs, mSpan) => {
                    if mMethod == "lines" || mMethod == "splitView" {
                        genForStrView(cg, varName, varName2, *mObj, mMethod, mArgs, body, locs, sigs, retTy, condLbl, bodyLbl, stepLbl, endLbl)
                        cg.curBreakLbl = savedBreak
                        cg.curContLbl = savedCont
                        cg.curLoopScopeLen = savedLoopScopeLen
                        return
                    }
                }
                _ => {
                }
            }
            // Vec, string, or HashMap: copy the 3-word header, walk by index.
            var obj = genExpr(cg, iterable, locs, sigs, "")
            // `@iter` on a field redirects the loop to that field's runtime value —
            // re-derived here from the struct's own field table (lookupIterDelegateField),
            // same as the checker does from its own copy. A newtype over a container
            // (HashSet over HashMap) then falls straight into the ordinary Vec/HashMap/
            // string dispatch below, unaware a struct was ever involved.
            let iterStructName = stripPercent(resolveTyStr(cg, obj.ty))
            match lookupIterDelegateField(cg, iterStructName) {
                Option.Some(delegateField) => {
                    let fidx = lookupFieldIndex(cg, iterStructName, delegateField)
                    let fty = lookupFieldType(cg, iterStructName, fidx)
                    let ftyLl = llType(fty)
                    let fv = nextTemp(cg)
                    emit(cg, "  " + fv + " = extractvalue %" + iterStructName + " " + obj.v + ", " + fidx.toString() + "\n")
                    obj = Val {
                        v: fv, ty: fty
                    }
                }
                Option.None => {
                }
            }
            let objLl = llType(obj.ty)
            // `for x in channel` — drain via recv() until it returns Err (closed).
            if obj.ty.len > 8 && obj.ty[0] == 67 && obj.ty[1] == 104 && obj.ty[2] == 97 && obj.ty[3] == 110 && obj.ty[4] == 110 && obj.ty[5] == 101 && obj.ty[6] == 108 && obj.ty[7] == 95 {
                let elemLl = llType(obj.ty[8..obj.ty.len].clone())
                let recvName = obj.ty.clone() + "$recv"
                let resultTy = stripPercent(resolveTyStr(cg, lookupFnRet(cg, recvName)))
                let resultLl = "%" + resultTy.clone()
                let okTag = lookupVariantTag(cg, resultTy, "Ok")
                let chSlot = nextTemp(cg)
                emit(cg, "  " + chSlot + " = alloca " + objLl + "\n")
                emit(cg, "  store " + objLl + " " + obj.v + ", ptr " + chSlot + "\n")
                let valAddr = nextTemp(cg)
                emit(cg, "  " + valAddr + " = alloca " + elemLl + "\n")
                emit(cg, "  br label %" + condLbl + "\n")
                emitLabel(cg, condLbl)
                let r = nextTemp(cg)
                emit(cg, "  " + r + " = call " + resultLl + " @" + recvName + "(ptr " + chSlot + ")\n")
                let rslot = nextTemp(cg)
                emit(cg, "  " + rslot + " = alloca " + resultLl + "\n")
                emit(cg, "  store " + resultLl + " " + r + ", ptr " + rslot + "\n")
                let tagP = nextTemp(cg)
                emit(cg, "  " + tagP + " = getelementptr " + resultLl + ", ptr " + rslot + ", i32 0, i32 0\n")
                let tag = nextTemp(cg)
                emit(cg, "  " + tag + " = load i32, ptr " + tagP + "\n")
                let isOk = nextTemp(cg)
                emit(cg, "  " + isOk + " = icmp eq i32 " + tag + ", " + okTag.toString() + "\n")
                emit(cg, "  br i1 " + isOk + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
                emitLabel(cg, bodyLbl)
                let payP = nextTemp(cg)
                emit(cg, "  " + payP + " = getelementptr " + resultLl + ", ptr " + rslot + ", i32 0, i32 1\n")
                let fp = nextTemp(cg)
                emit(cg, "  " + fp + " = getelementptr { " + elemLl + " }, ptr " + payP + ", i32 0, i32 0\n")
                let pv = nextTemp(cg)
                emit(cg, "  " + pv + " = load " + elemLl + ", ptr " + fp + "\n")
                emit(cg, "  store " + elemLl + " " + pv + ", ptr " + valAddr + "\n")
                let locsPre = locs.len
                locs.push(Local {
                    name: varName.clone(), ty: obj.ty[8..obj.ty.len].clone(), addr: valAddr.clone(), isRef: false, isArr: false, range: noRange()
                }
                )
                var chTerm = false
                for bi in 0..body.len {
                    if genStmt(cg, *body[bi], locs, sigs, retTy) {
                        chTerm = true
                    }
                }
                while locs.len > locsPre {
                    let _ = locs.pop()
                }
                if !chTerm {
                    emit(cg, "  br label %" + stepLbl + "\n")
                }
                emitLabel(cg, stepLbl)
                emit(cg, "  br label %" + condLbl + "\n")
                emitLabel(cg, endLbl)
                cg.curBreakLbl = savedBreak
                cg.curContLbl = savedCont
                cg.curLoopScopeLen = savedLoopScopeLen
                return
            }
            // iterator protocol: a struct with `Type$next(&mut Self): Option<T>` —
            // drive next() until it yields None, binding the loop var to each Some(v).
            let itRaw = stripPercent(resolveTyStr(cg, obj.ty))
            let itNext = itRaw + "$next"
            if cg.structs.contains(itRaw) && cg.fnRets.contains(itNext) {
                let optTy = stripPercent(resolveTyStr(cg, lookupFnRet(cg, itNext)))
                let optLl = "%" + optTy.clone()
                let someTag = lookupVariantTag(cg, optTy, "Some")
                let payTypes = lookupVariantPayload(cg, optTy, "Some")
                let itElemTy = payTypes[0].clone()
                let itElemLl = llType(itElemTy)
                let itSlot = nextTemp(cg)
                emit(cg, "  " + itSlot + " = alloca " + objLl + "\n")
                emit(cg, "  store " + objLl + " " + obj.v + ", ptr " + itSlot + "\n")
                let valAddr = nextTemp(cg)
                emit(cg, "  " + valAddr + " = alloca " + itElemLl + "\n")
                emit(cg, "  br label %" + condLbl + "\n")
                emitLabel(cg, condLbl)
                let r = nextTemp(cg)
                emit(cg, "  " + r + " = call " + optLl + " @" + itNext + "(ptr " + itSlot + ")\n")
                let rslot = nextTemp(cg)
                emit(cg, "  " + rslot + " = alloca " + optLl + "\n")
                emit(cg, "  store " + optLl + " " + r + ", ptr " + rslot + "\n")
                let tagP = nextTemp(cg)
                emit(cg, "  " + tagP + " = getelementptr " + optLl + ", ptr " + rslot + ", i32 0, i32 0\n")
                let tag = nextTemp(cg)
                emit(cg, "  " + tag + " = load i32, ptr " + tagP + "\n")
                let isSome = nextTemp(cg)
                emit(cg, "  " + isSome + " = icmp eq i32 " + tag + ", " + someTag.toString() + "\n")
                emit(cg, "  br i1 " + isSome + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
                emitLabel(cg, bodyLbl)
                let payP = nextTemp(cg)
                emit(cg, "  " + payP + " = getelementptr " + optLl + ", ptr " + rslot + ", i32 0, i32 1\n")
                let fp = nextTemp(cg)
                emit(cg, "  " + fp + " = getelementptr { " + itElemLl + " }, ptr " + payP + ", i32 0, i32 0\n")
                let pv = nextTemp(cg)
                emit(cg, "  " + pv + " = load " + itElemLl + ", ptr " + fp + "\n")
                emit(cg, "  store " + itElemLl + " " + pv + ", ptr " + valAddr + "\n")
                let locsPre = locs.len
                locs.push(Local {
                    name: varName.clone(), ty: itElemTy.clone(), addr: valAddr.clone(), isRef: false, isArr: false, range: noRange()
                }
                )
                var itTerm = false
                for bi in 0..body.len {
                    if genStmt(cg, *body[bi], locs, sigs, retTy) {
                        itTerm = true
                    }
                }
                while locs.len > locsPre {
                    let _ = locs.pop()
                }
                if !itTerm {
                    emit(cg, "  br label %" + stepLbl + "\n")
                }
                emitLabel(cg, stepLbl)
                emit(cg, "  br label %" + condLbl + "\n")
                emitLabel(cg, endLbl)
                cg.curBreakLbl = savedBreak
                cg.curContLbl = savedCont
                cg.curLoopScopeLen = savedLoopScopeLen
                return
            }
            if isHashMapTy(obj.ty) {
                genForInHashMap(cg, varName, varName2, obj, body, locs, sigs, retTy, condLbl, bodyLbl, stepLbl, endLbl, idxAddr)
                emit(cg, stepLbl + ":\n")
                let hCur = nextTemp(cg)
                emit(cg, "  " + hCur + " = load i64, ptr " + idxAddr + "\n")
                let hInc = nextTemp(cg)
                emit(cg, "  " + hInc + " = add i64 " + hCur + ", 1\n")
                emit(cg, "  store i64 " + hInc + ", ptr " + idxAddr + "\n")
                emit(cg, "  br label %" + condLbl + "\n")
                emit(cg, endLbl + ":\n")
                cg.curBreakLbl = savedBreak
                cg.curContLbl = savedCont
                cg.curLoopScopeLen = savedLoopScopeLen
                return
            }
            var elemTy = "u8"
            var container = "%String"
            if isVecTy(obj.ty) {
                // resolveTyStr collapses Heap<Interface> → Interface, so the element
                // is the %Iface fat pointer (16 bytes), not a plain ptr.
                elemTy = unwrapVec(resolveTyStr(cg, obj.ty))
                container = "%Vec"
            } else if objLl == "%String" {
                elemTy = "u8"
                container = "%String"
            } else {
                eprint("codegen: cannot iterate type " + obj.ty.clone())
                exit(1)
            }
            let elemLl = llType(elemTy)
            let data = nextTemp(cg)
            emit(cg, "  " + data + " = extractvalue " + container + " " + obj.v + ", 0\n")
            let count = nextTemp(cg)
            emit(cg, "  " + count + " = extractvalue " + container + " " + obj.v + ", 1\n")
            // element slot, hoisted out of the loop so the body can rebind it
            let elemAddr = nextTemp(cg)
            emit(cg, "  " + elemAddr + " = alloca " + elemLl + "\n")
            emit(cg, "  store i64 0, ptr " + idxAddr + "\n")
            emit(cg, "  br label %" + condLbl + "\n")
            emit(cg, condLbl + ":\n")
            let cur = nextTemp(cg)
            emit(cg, "  " + cur + " = load i64, ptr " + idxAddr + "\n")
            let lt = nextTemp(cg)
            emit(cg, "  " + lt + " = icmp slt i64 " + cur + ", " + count + "\n")
            emit(cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
            emit(cg, bodyLbl + ":\n")
            let slot = nextTemp(cg)
            emit(cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + cur + "\n")
            let elem = nextTemp(cg)
            emit(cg, "  " + elem + " = load " + elemLl + ", ptr " + slot + "\n")
            emit(cg, "  store " + elemLl + " " + elem + ", ptr " + elemAddr + "\n")
            let locsPreLen = locs.len
            // two-var form is `for index, value in vec` (index first), matching the
            // checker's binding order; single-var binds the element.
            match varName2 {
                Option.Some(valName) => {
                    locs.push(Local {
                        name: varName.clone(), ty: "i64", addr: idxAddr.clone(), isRef: false, isArr: false, range: noRange()
                    }
                    )
                    locs.push(Local {
                        name: valName.clone(), ty: elemTy.clone(), addr: elemAddr.clone(), isRef: false, isArr: false, range: noRange()
                    }
                    )
                }
                Option.None => {
                    locs.push(Local {
                        name: varName.clone(), ty: elemTy.clone(), addr: elemAddr.clone(), isRef: false, isArr: false, range: noRange()
                    }
                    )
                }
            }
            var bodyTerm = false
            for bi in 0..body.len {
                if genStmt(cg, *body[bi], locs, sigs, retTy) {
                    bodyTerm = true
                }
            }
            while locs.len > locsPreLen {
                let _ = locs.pop()
            }
            if !bodyTerm {
                emit(cg, "  br label %" + stepLbl + "\n")
            }
        }
    }

    emit(cg, stepLbl + ":\n")
    let stepCur = nextTemp(cg)
    emit(cg, "  " + stepCur + " = load i64, ptr " + idxAddr + "\n")
    let inc = nextTemp(cg)
    emit(cg, "  " + inc + " = add i64 " + stepCur + ", 1\n")
    emit(cg, "  store i64 " + inc + ", ptr " + idxAddr + "\n")
    emit(cg, "  br label %" + condLbl + "\n")
    emit(cg, endLbl + ":\n")
    cg.curBreakLbl = savedBreak
    cg.curContLbl = savedCont
    cg.curLoopScopeLen = savedLoopScopeLen
}

// -- If statement --

pub fn genIf(cg: &mut Cgen, cond: &Expr, thenBody: &Vec<Heap<Stmt>>, elseBody: &Option<Vec<Heap<Stmt>>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string): bool {
    // A statically-known condition (`@targetOs() == "…"`) emits ONLY the taken
    // arm. Load-bearing, not an optimization: the dead arm may call a symbol
    // that exists on no other target, and it must never reach the linker even
    // though it type-checked.
    let folded = constFoldBool(cg, cond)
    match folded {
        Option.Some(taken) => {
            var foldTerm = false
            let foldPreLen = locs.len
            if taken {
                for ti in 0..thenBody.len {
                    if genStmt(cg, *thenBody[ti], locs, sigs, retTy) {
                        foldTerm = true
                    }
                }
            } else {
                match elseBody {
                    Option.Some(stmts) => {
                        for ei in 0..stmts.len {
                            if genStmt(cg, *stmts[ei], locs, sigs, retTy) {
                                foldTerm = true
                            }
                        }
                    }
                    Option.None => {
                    }
                }
            }
            if !foldTerm {
                emitScopeDrops(cg, locs, foldPreLen, "")
            }
            while locs.len > foldPreLen {
                let _ = locs.pop()
            }
            return foldTerm
        }
        Option.None => {
        }
    }
    let cv = genExpr(cg, cond, locs, sigs, "bool")
    let thenLbl = nextLabel(cg, "then")
    let elseLbl = nextLabel(cg, "else")
    let endLbl = nextLabel(cg, "endif")
    emit(cg, "  br i1 " + cv.v + ", label %" + thenLbl + ", label %" + elseLbl + "\n")
    emit(cg, thenLbl + ":\n")
    var thenTerm = false
    // Block scope: a value declared inside the branch dies at the branch's end, not at
    // the function epilogue. Dropping it at the epilogue was also invalid IR — its alloca
    // lives in a conditional block, which does not dominate the epilogue.
    let thenPreLen = locs.len
    for ti in 0..thenBody.len {
        if genStmt(cg, *thenBody[ti], locs, sigs, retTy) {
            thenTerm = true
        }
    }
    if !thenTerm {
        emitScopeDrops(cg, locs, thenPreLen, "")
        emit(cg, "  br label %" + endLbl + "\n")
    }
    while locs.len > thenPreLen {
        let _ = locs.pop()
    }
    emit(cg, elseLbl + ":\n")
    var elseTerm = false
    let elsePreLen = locs.len
    match elseBody {
        Option.Some(stmts) => {
            for ei in 0..stmts.len {
                if genStmt(cg, *stmts[ei], locs, sigs, retTy) {
                    elseTerm = true
                }
            }
        }
        Option.None => {
        }
    }
    if !elseTerm {
        emitScopeDrops(cg, locs, elsePreLen, "")
        emit(cg, "  br label %" + endLbl + "\n")
    }
    while locs.len > elsePreLen {
        let _ = locs.pop()
    }
    emit(cg, endLbl + ":\n")
    if thenTerm && elseTerm {
        emit(cg, "  unreachable\n")
    }
    return thenTerm && elseTerm
}

// -- Match statement --

// -- If-let (M3b): a one-pattern match with an else path --

pub fn genIfLet(cg: &mut Cgen, pattern: &Pattern, subject: &Expr, thenBody: &Vec<Heap<Stmt>>, elseBody: &Option<Vec<Heap<Stmt>>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string): bool {
    let subjLv = genLvalue(cg, subject, locs, sigs)
    let rawName = stripPercent(subjLv.ty)
    let structTy = "%" + rawName
    let tagPtr = nextTemp(cg)
    emit(cg, "  " + tagPtr + " = getelementptr " + structTy + ", ptr " + subjLv.v + ", i32 0, i32 0\n")
    let tag = nextTemp(cg)
    emit(cg, "  " + tag + " = load i32, ptr " + tagPtr + "\n")
    let thenLbl = nextLabel(cg, "iflet.then")
    let elseLbl = nextLabel(cg, "iflet.else")
    let endLbl = nextLabel(cg, "iflet.end")

    var thenTerm = false
    match pattern {
        Pattern.EnumPattern(enumName, variant, bindings, span) => {
            // variant tables are keyed by the subject's (mangled) enum name,
            // not the pattern's base name
            let tg = lookupVariantTag(cg, rawName, variant)
            let eq = nextTemp(cg)
            emit(cg, "  " + eq + " = icmp eq i32 " + tag + ", " + tg.toString() + "\n")
            emit(cg, "  br i1 " + eq + ", label %" + thenLbl + ", label %" + elseLbl + "\n")
            emit(cg, thenLbl + ":\n")
            let locsPreLen = locs.len
            if bindings.len > 0 {
                let payloadTypes = lookupVariantPayload(cg, rawName, variant)
                if payloadTypes.len > 0 {
                    let payPtr = nextTemp(cg)
                    emit(cg, "  " + payPtr + " = getelementptr " + structTy + ", ptr " + subjLv.v + ", i32 0, i32 1\n")
                    let vstructTy = variantStructTy(payloadTypes)
                    for bi in 0..bindings.len {
                        let ftyLl = llType(payloadTypes[bi])
                        let fp = nextTemp(cg)
                        emit(cg, "  " + fp + " = getelementptr " + vstructTy + ", ptr " + payPtr + ", i32 0, i32 " + bi.toString() + "\n")
                        let loaded = nextTemp(cg)
                        emit(cg, "  " + loaded + " = load " + ftyLl + ", ptr " + fp + "\n")
                        let bindAddr = nextTemp(cg)
                        emit(cg, "  " + bindAddr + " = alloca " + ftyLl + "\n")
                        emit(cg, "  store " + ftyLl + " " + loaded + ", ptr " + bindAddr + "\n")
                        locs.push(Local {
                            name: bindings[bi].clone(), ty: payloadTypes[bi].clone(), addr: bindAddr, isRef: false, isArr: false, range: noRange()
                        }
                        )
                    }
                }
            }
            for si in 0..thenBody.len {
                if genStmt(cg, *thenBody[si], locs, sigs, retTy) {
                    thenTerm = true
                }
            }
            while locs.len > locsPreLen {
                let _ = locs.pop()
            }
        }
        _ => {
            // non-enum pattern: checker should have rejected; take the then path
            emit(cg, "  br label %" + thenLbl + "\n")
            emit(cg, thenLbl + ":\n")
            for si in 0..thenBody.len {
                if genStmt(cg, *thenBody[si], locs, sigs, retTy) {
                    thenTerm = true
                }
            }
        }
    }
    if !thenTerm {
        emit(cg, "  br label %" + endLbl + "\n")
    }

    emit(cg, elseLbl + ":\n")
    var elseTerm = false
    var hasElse = false
    match elseBody {
        Option.Some(stmts) => {
            hasElse = true
            for ei in 0..stmts.len {
                if genStmt(cg, *stmts[ei], locs, sigs, retTy) {
                    elseTerm = true
                }
            }
        }
        Option.None => {
        }
    }
    if !elseTerm {
        emit(cg, "  br label %" + endLbl + "\n")
    }
    emit(cg, endLbl + ":\n")
    if thenTerm && elseTerm && hasElse {
        emit(cg, "  unreachable\n")
        return true
    }
    return false
}

// Match-expression codegen result: a value-producing match (Expr.MatchExpr)
// needs the arm's Val alongside the usual "did this block terminate" bool;
// statement-mode match (Stmt.MatchStmt, wantValue=false) only ever reads
// `.terminated` and leaves `.val` at its zero value.
pub struct MatchGen {
    terminated: bool,
    val: Val,
}

// Runs one arm's body. In value mode (wantValue) the LAST statement supplies
// the arm's value: a bare ExprStmt is evaluated for its Val instead of run as
// a statement (the checker guarantees the only other legal tail is a
// diverging return/break/continue, which runs as an ordinary statement and
// contributes no value — never silently coerced to a zero/void Val).
pub fn genArmBody(cg: &mut Cgen, body: &Vec<Heap<Stmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, wantValue: bool, hintTy: string): MatchGen {
    var terminated = false
    var produced = false
    var val = Val {
        v: "0", ty: "void"
    }
    var i: i64 = 0
    while i < body.len {
        let isLast = i == body.len - 1
        if wantValue && isLast {
            match *body[i] {
                Stmt.ExprStmt(e, espan) => {
                    val = genExpr(cg, *e, locs, sigs, hintTy.clone())
                    produced = true
                }
                _ => {
                    if genStmt(cg, *body[i], locs, sigs, retTy) {
                        terminated = true
                    }
                }
            }
        } else {
            if genStmt(cg, *body[i], locs, sigs, retTy) {
                terminated = true
            }
        }
        i = i + 1
    }
    if wantValue && !terminated && !produced {
        // Should be unreachable — the checker rejects an arm whose tail is
        // neither a value nor a diverging statement. Fail loudly rather than
        // synthesize a plausible-looking value if that guarantee ever slips.
        eprint("codegen: match-expression arm produced no value and did not diverge")
        exit(1)
    }
    return MatchGen {
        terminated: terminated, val: val
    }
}

// `match s { "a" => …, _ => … }` on a string subject: a chain of string-eq
// tests (literals are exclusive so a non-final wildcard is still the default).
pub fn genStringMatch(cg: &mut Cgen, subjValV: &string, arms: &Vec<MatchArm>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, wantValue: bool, hintTy: string): MatchGen {
    let endLbl = nextLabel(cg, "smatch.end")
    var allTerminated = true
    var wildIdx: i64 = -1
    var phiVals: Vec<string> = Vec.new()
    var phiPreds: Vec<string> = Vec.new()
    var resultTy = hintTy.clone()
    for ai in 0..arms.len {
        match arms[ai].pattern {
            Pattern.LiteralPattern(val, kind, span) => {
                let litV = genStringLit(cg, val.clone())
                let eq = genStringEq(cg, subjValV.clone(), litV.v, true)
                let armLbl = nextLabel(cg, "smatch.arm")
                let nextLbl = nextLabel(cg, "smatch.next")
                emit(cg, "  br i1 " + eq.v + ", label %" + armLbl + ", label %" + nextLbl + "\n")
                emitLabel(cg, armLbl)
                let res = genArmBody(cg, arms[ai].body, locs, sigs, retTy, wantValue, resultTy.clone())
                if !res.terminated {
                    if wantValue {
                        if resultTy.len == 0 {
                            resultTy = res.val.ty.clone()
                        }
                        phiVals.push(res.val.v.clone())
                        phiPreds.push(cg.curBlock.clone())
                    }
                    emit(cg, "  br label %" + endLbl + "\n")
                    allTerminated = false
                }
                emitLabel(cg, nextLbl)
            }
            _ => {
                wildIdx = ai
            }
        }
    }
    if wildIdx >= 0 {
        let res = genArmBody(cg, arms[wildIdx].body, locs, sigs, retTy, wantValue, resultTy.clone())
        if !res.terminated {
            if wantValue {
                if resultTy.len == 0 {
                    resultTy = res.val.ty.clone()
                }
                phiVals.push(res.val.v.clone())
                phiPreds.push(cg.curBlock.clone())
            }
            emit(cg, "  br label %" + endLbl + "\n")
            allTerminated = false
        }
    } else {
        // exhaustive per the checker → no-match is unreachable (see genIntMatch)
        emit(cg, "  unreachable\n")
    }
    emitLabel(cg, endLbl)
    if allTerminated {
        emit(cg, "  unreachable\n")
        return MatchGen {
            terminated: true, val: Val {
                v: "0", ty: "void"
            }
        }
    }
    return finishMatchPhi(cg, wantValue, phiVals, phiPreds, resultTy)
}

// Shared phi emission for the value-producing forms of genStringMatch/genIntMatch/
// genMatch: one incoming pair per arm that reached the join block (a diverging arm
// never does, so it never appears here — same rule as if-expression branches).
pub fn finishMatchPhi(cg: &mut Cgen, wantValue: bool, phiVals: &Vec<string>, phiPreds: &Vec<string>, resultTy: &string): MatchGen {
    if !wantValue || phiVals.len == 0 {
        return MatchGen {
            terminated: false, val: Val {
                v: "0", ty: "void"
            }
        }
    }
    let r = nextTemp(cg)
    let ll = llType(resultTy)
    var parts = ""
    var pi: i64 = 0
    while pi < phiVals.len {
        parts = parts + "[" + phiVals[pi] + ", %" + phiPreds[pi] + "]"
        if pi < phiVals.len - 1 {
            parts = parts + ", "
        }
        pi = pi + 1
    }
    emit(cg, "  " + r + " = phi " + ll + " " + parts + "\n")
    return MatchGen {
        terminated: false, val: Val {
            v: r, ty: resultTy.clone()
        }
    }
}

// The integer constant for a literal pattern (char code / int / bool → 0/1).
pub fn litIntConst(val: &string, kind: &LiteralKind): string {
    match kind {
        LiteralKind.LitBool => {
            if val == "true" {
                return "1"
            }
            return "0"
        }
        _ => {
            return val.clone()
        }
    }
}

// match on an integer/char/bool subject: compare the value against each literal
// pattern (a switch would also work, but a compare chain handles any width).
pub fn genIntMatch(cg: &mut Cgen, subjV: &string, subjLl: &string, arms: &Vec<MatchArm>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, wantValue: bool, hintTy: string): MatchGen {
    let endLbl = nextLabel(cg, "imatch.end")
    var allTerminated = true
    var wildIdx: i64 = -1
    var phiVals: Vec<string> = Vec.new()
    var phiPreds: Vec<string> = Vec.new()
    var resultTy = hintTy.clone()
    for ai in 0..arms.len {
        match arms[ai].pattern {
            Pattern.LiteralPattern(val, kind, span) => {
                let eq = nextTemp(cg)
                emit(cg, "  " + eq + " = icmp eq " + subjLl.clone() + " " + subjV.clone() + ", " + litIntConst(val, kind) + "\n")
                let armLbl = nextLabel(cg, "imatch.arm")
                let nextLbl = nextLabel(cg, "imatch.next")
                emit(cg, "  br i1 " + eq + ", label %" + armLbl + ", label %" + nextLbl + "\n")
                emitLabel(cg, armLbl)
                let res = genArmBody(cg, arms[ai].body, locs, sigs, retTy, wantValue, resultTy.clone())
                if !res.terminated {
                    if wantValue {
                        if resultTy.len == 0 {
                            resultTy = res.val.ty.clone()
                        }
                        phiVals.push(res.val.v.clone())
                        phiPreds.push(cg.curBlock.clone())
                    }
                    emit(cg, "  br label %" + endLbl + "\n")
                    allTerminated = false
                }
                emitLabel(cg, nextLbl)
            }
            _ => {
                wildIdx = ai
            }
        }
    }
    if wildIdx >= 0 {
        let res = genArmBody(cg, arms[wildIdx].body, locs, sigs, retTy, wantValue, resultTy.clone())
        if !res.terminated {
            if wantValue {
                if resultTy.len == 0 {
                    resultTy = res.val.ty.clone()
                }
                phiVals.push(res.val.v.clone())
                phiPreds.push(cg.curBlock.clone())
            }
            emit(cg, "  br label %" + endLbl + "\n")
            allTerminated = false
        }
    } else {
        // no wildcard: the checker proved the match exhaustive (e.g. bool true/false),
        // so the fall-off-the-end path is unreachable — don't force a fallthrough that
        // would hit the function's default `ret <T> 0` (invalid for aggregate returns).
        emit(cg, "  unreachable\n")
    }
    emitLabel(cg, endLbl)
    if allTerminated {
        emit(cg, "  unreachable\n")
        return MatchGen {
            terminated: true, val: Val {
                v: "0", ty: "void"
            }
        }
    }
    return finishMatchPhi(cg, wantValue, phiVals, phiPreds, resultTy)
}

pub fn genMatch(cg: &mut Cgen, subject: &Expr, arms: &Vec<MatchArm>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, wantValue: bool, hintTy: string): MatchGen {
    let subjLv = genLvalue(cg, subject, locs, sigs)
    if llType(subjLv.ty) == "%String" {
        let sv = nextTemp(cg)
        emit(cg, "  " + sv + " = load %String, ptr " + subjLv.v + "\n")
        return genStringMatch(cg, sv, arms, locs, sigs, retTy, wantValue, hintTy)
    }
    // integer/char/bool subject → compare against literal patterns
    let subjLl0 = llType(subjLv.ty)
    if subjLl0.len > 0 && subjLl0[0] == 105 {
        let iv = nextTemp(cg)
        emit(cg, "  " + iv + " = load " + subjLl0 + ", ptr " + subjLv.v + "\n")
        return genIntMatch(cg, iv, subjLl0, arms, locs, sigs, retTy, wantValue, hintTy)
    }
    let rawName = stripPercent(subjLv.ty)
    let structTy = "%" + rawName
    let tagPtr = nextTemp(cg)
    emit(cg, "  " + tagPtr + " = getelementptr " + structTy + ", ptr " + subjLv.v + ", i32 0, i32 0\n")
    let tag = nextTemp(cg)
    emit(cg, "  " + tag + " = load i32, ptr " + tagPtr + "\n")
    let endLbl = nextLabel(cg, "match.end")
    var switchCases = ""
    var armLabels: Vec<string> = Vec.new()
    // A wildcard/binding arm (`_ => …`) is the switch DEFAULT, not a numbered case
    // — numbering it collides with a real variant tag (duplicate switch case).
    var wildcardLbl = ""
    for i in 0..arms.len {
        let armLbl = nextLabel(cg, "match.arm")
        match arms[i].pattern {
            Pattern.EnumPattern(enumName, variant, bindings, span) => {
                // keyed by the subject's mangled name, not the pattern's base name
                let tg = lookupVariantTag(cg, rawName, variant)
                switchCases = switchCases + "i32 " + tg.toString() + ", label %" + armLbl + " "
            }
            _ => {
                if wildcardLbl.len == 0 {
                    wildcardLbl = armLbl.clone()
                }
            }
        }
        armLabels.push(armLbl)
    }
    var defaultLbl = nextLabel(cg, "match.default")
    var emitUnreachableDefault = true
    if wildcardLbl.len > 0 {
        defaultLbl = wildcardLbl.clone()
        emitUnreachableDefault = false
    }
    emit(cg, "  switch i32 " + tag + ", label %" + defaultLbl + " [" + switchCases + "]\n")
    var allTerminated = true
    var phiVals: Vec<string> = Vec.new()
    var phiPreds: Vec<string> = Vec.new()
    var resultTy = hintTy.clone()
    for ai in 0..arms.len {
        emitLabel(cg, armLabels[ai])
        let locsPreLen = locs.len
        // Extract payload bindings
        match arms[ai].pattern {
            Pattern.EnumPattern(enumName, variant, bindings, span) => {
                if bindings.len > 0 {
                    let payloadTypes = lookupVariantPayload(cg, rawName, variant)
                    if payloadTypes.len > 0 {
                        let payPtr = nextTemp(cg)
                        emit(cg, "  " + payPtr + " = getelementptr " + structTy + ", ptr " + subjLv.v + ", i32 0, i32 1\n")
                        let vstructTy = variantStructTy(payloadTypes)
                        for bi in 0..bindings.len {
                            let ftyLl = llType(payloadTypes[bi])
                            let fp = nextTemp(cg)
                            emit(cg, "  " + fp + " = getelementptr " + vstructTy + ", ptr " + payPtr + ", i32 0, i32 " + bi.toString() + "\n")
                            let loaded = nextTemp(cg)
                            emit(cg, "  " + loaded + " = load " + ftyLl + ", ptr " + fp + "\n")
                            let bindAddr = nextTemp(cg)
                            emit(cg, "  " + bindAddr + " = alloca " + ftyLl + "\n")
                            emit(cg, "  store " + ftyLl + " " + loaded + ", ptr " + bindAddr + "\n")
                            locs.push(Local {
                                name: bindings[bi].clone(), ty: payloadTypes[bi].clone(), addr: bindAddr, isRef: false, isArr: false, range: noRange()
                            }
                            )
                        }
                    }
                }
            }
            _ => {
            }
        }
        let res = genArmBody(cg, arms[ai].body, locs, sigs, retTy, wantValue, resultTy.clone())
        // A payload binding (`Result.Ok(t) => { … }`) is ARM-SCOPED: it dies at the arm's
        // end like any other block. locsPreLen is captured BEFORE the bindings are pushed,
        // which is why the drop belongs here and not inside genArmBody. A terminated arm
        // (return/break) already dropped its scope on the way out — dropping again would
        // double-count.
        if !res.terminated {
            emitScopeDrops(cg, locs, locsPreLen, "")
        }
        // Pop bindings
        while locs.len > locsPreLen {
            let _ = locs.pop()
        }
        if !res.terminated {
            if wantValue {
                if resultTy.len == 0 {
                    resultTy = res.val.ty.clone()
                }
                phiVals.push(res.val.v.clone())
                phiPreds.push(cg.curBlock.clone())
            }
            emit(cg, "  br label %" + endLbl + "\n")
            allTerminated = false
        }
    }
    // Only emit a synthetic unreachable default when there was no wildcard arm
    // (a wildcard arm already serves as the default and emits its own body).
    if emitUnreachableDefault {
        emitLabel(cg, defaultLbl)
        emit(cg, "  unreachable\n")
    }
    emitLabel(cg, endLbl)
    if allTerminated && arms.len > 0 {
        emit(cg, "  unreachable\n")
        return MatchGen {
            terminated: true, val: Val {
                v: "0", ty: "void"
            }
        }
    }
    return finishMatchPhi(cg, wantValue, phiVals, phiPreds, resultTy)
}

// User Drop hooks: a local whose struct type has an `impl Drop` runs
// `Ty$Drop$drop(&mut self)` when it leaves scope. Declaration order matches
// the oracle's observable behavior. skipName: a returned local is moved out
// of the scope, not dropped.
pub fn emitScopeDrops(cg: &mut Cgen, locs: &Vec<Local>, fromLen: i64, skipName: &string) {
    for i in fromLen..locs.len {
        if locs[i].isRef {
            continue
        }
        if locs[i].name == skipName {
            continue
        }
        // Already moved out (push/call/reassign zeroed this slot) — the user's
        // drop() must not run twice on a value that no longer lives here. Plain
        // structs have no null/cap sentinel of their own to catch this, unlike
        // Vec/String/Heap.
        if addrWasMoved(cg, locs[i].addr) {
            continue
        }
        let dropFn = stripPercent(locs[i].ty) + "$Drop$drop"
        if cg.fnRets.contains(dropFn) {
            // Drop$drop takes `&mut self` → a `ptr` param, so pass the local's
            // address directly (mutation-through-ref is now honored).
            emit(cg, "  call void @" + dropFn + "(ptr " + locs[i].addr + ")\n")
        }
    }
}

// -- Main statement dispatch. Returns true if stmt terminates block. --

pub fn genStmt(cg: &mut Cgen, s: &Stmt, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string): bool {
    match s {
        Stmt.LetDecl(name, ty, value, span) => {
            var hintTy = ""
            // Fixed-size array annotation (`let raw: [u8;4] = …`) — see the Local.isArr
            // doc comment: this is the only place codegen can recover "was this
            // declared as an array" once it's lowered onto %Vec's runtime shape.
            var isArrAnno = false
            match ty {
                Option.Some(t) => {
                    // resolveTyStr, not bare astTypeStr: an alias-typed annotation
                    // (`let c: Count = 21`) must hint the ALIASED type (i64), or an
                    // untyped literal RHS defaults to i32 and silently mis-sizes.
                    hintTy = resolveTyStr(cg, astTypeStr(t))
                    isArrAnno = t.isArray
                }
                Option.None => {
                    hintTy = vecNewHint(cg, name, *value)
                    isArrAnno = exprWrapsFixedArrayReturn(*value, sigs)
                }
            }
            // RHS is moved into the new binding → zero a source place (var→var move)
            let forcedValue = forceMoveIfEscaping(cg, name, *value)
            let v0 = genOwnedArg(cg, forcedValue, hintTy.clone(), locs, sigs)
            let v1 = genOptionWrapIfNeeded(cg, v0, hintTy.clone())
            let v = genInterfaceCoerceIfNeeded(cg, v1, hintTy)
            let lrange = rangeOfOptAnnotation(cg, ty)
            emitRangeCheck(cg, v, lrange, span)
            let vtyLl = llType(v.ty)
            let addr = nextTemp(cg)
            emit(cg, "  " + addr + " = alloca " + vtyLl + "\n")
            emit(cg, "  store " + vtyLl + " " + v.v + ", ptr " + addr + "\n")
            locs.push(Local {
                name: name.clone(), ty: v.ty.clone(), addr: addr, isRef: false, isArr: isArrAnno, range: lrange
            }
            )
            return false
        }
        Stmt.VarDecl(name, ty, value, span) => {
            var hintTy = ""
            var isArrAnno = false
            match ty {
                Option.Some(t) => {
                    // see the LetDecl arm above: alias annotations must hint their
                    // resolved base type, not the bare alias name.
                    hintTy = resolveTyStr(cg, astTypeStr(t))
                    isArrAnno = t.isArray
                }
                Option.None => {
                    hintTy = vecNewHint(cg, name, *value)
                    isArrAnno = exprWrapsFixedArrayReturn(*value, sigs)
                }
            }
            // RHS is moved into the new binding → zero a source place (var→var move)
            let forcedValue = forceMoveIfEscaping(cg, name, *value)
            let v0 = genOwnedArg(cg, forcedValue, hintTy.clone(), locs, sigs)
            let v1 = genOptionWrapIfNeeded(cg, v0, hintTy.clone())
            let v = genInterfaceCoerceIfNeeded(cg, v1, hintTy)
            let lrange = rangeOfOptAnnotation(cg, ty)
            emitRangeCheck(cg, v, lrange, span)
            let vtyLl = llType(v.ty)
            let addr = nextTemp(cg)
            emit(cg, "  " + addr + " = alloca " + vtyLl + "\n")
            emit(cg, "  store " + vtyLl + " " + v.v + ", ptr " + addr + "\n")
            locs.push(Local {
                name: name.clone(), ty: v.ty.clone(), addr: addr, isRef: false, isArr: isArrAnno, range: lrange
            }
            )
            return false
        }
        Stmt.Assign(target, value, span) => {
            genAssign(cg, *target, *value, locs, sigs, span)
            return false
        }
        Stmt.Return(value, span) => {
            // a returned local is moved out — everything else in scope drops
            var skipName = ""
            match value {
                Option.Some(expr) => {
                    match *expr {
                        Expr.Ident(n, ispan) => {
                            skipName = n.clone()
                        }
                        _ => {
                        }
                    }
                }
                Option.None => {
                }
            }
            match value {
                Option.Some(expr) => {
                    // A directly-returned closure literal escapes this frame right here —
                    // force it to `move` so its captures are heap-owned, not aliased into
                    // the frame that's about to unwind (see forcedMoveClosure).
                    let forcedRet = forcedMoveClosure(*expr)
                    let v00 = genExpr(cg, forcedRet, locs, sigs, retTy.clone())
                    let v = genInterfaceCoerceIfNeeded(cg, v00, retTy)
                    let retRange = cg.curRetRange.clone()
                    emitRangeCheck(cg, v, retRange, span)
                    emitScopeDrops(cg, locs, 0, skipName)
                    // unannotated closure body: the return type IS the value's type;
                    // record it (genClosure reads it for the define header) and emit
                    // the ret with no coercion.
                    if retTy == "__closureinfer__" {
                        let vll = llType(v.ty)
                        cg.closureRetTy = v.ty.clone()
                        emit(cg, "  ret " + vll + " " + v.v + "\n")
                        return true
                    }
                    let fnRetLl = llType(retTy)
                    let valLl = llType(v.ty)
                    if valLl == fnRetLl {
                        emit(cg, "  ret " + valLl + " " + v.v + "\n")
                    } else {
                        let cast = nextTemp(cg)
                        emit(cg, "  " + cast + " = trunc " + valLl + " " + v.v + " to " + fnRetLl + "\n")
                        emit(cg, "  ret " + fnRetLl + " " + cast + "\n")
                    }
                }
                Option.None => {
                    emitScopeDrops(cg, locs, 0, skipName)
                    let fnRetLl = llType(retTy)
                    if fnRetLl == "void" {
                        emit(cg, "  ret void\n")
                    } else {
                        // bare `return` in a non-void fn (main is forced to i32)
                        emit(cg, "  ret " + fnRetLl + " 0\n")
                    }
                }
            }
            return true
        }
        Stmt.ExprStmt(e, span) => {
            genExpr(cg, *e, locs, sigs, "")
            return false
        }
        Stmt.IfStmt(cond, thenBody, elseBody, span) => {
            return genIf(cg, *cond, thenBody, elseBody, locs, sigs, retTy)
        }
        Stmt.WhileStmt(cond, body, span) => {
            genWhile(cg, *cond, body, locs, sigs, retTy)
            return false
        }
        Stmt.ForInStmt(varName, varName2, iterable, body, span) => {
            genForIn(cg, varName, varName2, *iterable, body, locs, sigs, retTy)
            return false
        }
        Stmt.MatchStmt(subject, arms, span) => {
            return genMatch(cg, *subject, arms, locs, sigs, retTy, false, "").terminated
        }
        Stmt.BreakStmt(span) => {
            if cg.curBreakLbl.len > 0 {
                // Leaving the loop body early still owns whatever it declared —
                // same locals a normal iteration-end would drop (loopBreak in
                // dropAccounting: the live `t` at the break point was leaking).
                if cg.curLoopScopeLen >= 0 {
                    emitScopeDrops(cg, locs, cg.curLoopScopeLen, "")
                }
                emit(cg, "  br label %" + cg.curBreakLbl + "\n")
                let after = nextLabel(cg, "afterBreak")
                emit(cg, after + ":\n")
            }
            return false
        }
        Stmt.ContinueStmt(span) => {
            if cg.curContLbl.len > 0 {
                // Same as break above: ending this iteration early still drops
                // whatever it declared, same as reaching the bottom would.
                if cg.curLoopScopeLen >= 0 {
                    emitScopeDrops(cg, locs, cg.curLoopScopeLen, "")
                }
                emit(cg, "  br label %" + cg.curContLbl + "\n")
                let after = nextLabel(cg, "afterCont")
                emit(cg, after + ":\n")
            }
            return false
        }
        Stmt.UnsafeBlock(body, span) => {
            var term = false
            for i in 0..body.len {
                if genStmt(cg, *body[i], locs, sigs, retTy) {
                    term = true
                }
            }
            return term
        }
        Stmt.IfLetStmt(pattern, subject, thenBody, elseBody, span) => {
            return genIfLet(cg, *pattern, *subject, thenBody, elseBody, locs, sigs, retTy)
        }
    }
}

// -- Closures --

// Collect every identifier name referenced in an expression (over-approximate:
// the caller filters against the enclosing scope to find true captures).
pub fn collectIdentsExpr(e: &Expr, out: &mut Vec<string>) {
    match e {
        Expr.Ident(name, span) => {
            out.push(name.clone())
        }
        Expr.BinOp(op, l, r, span) => {
            collectIdentsExpr(*l, out)
            collectIdentsExpr(*r, out)
        }
        Expr.UnaryOp(op, x, span) => {
            collectIdentsExpr(*x, out)
        }
        Expr.Call(name, args, targs, span) => {
            out.push(name.clone())
            for i in 0..args.len {
                collectIdentsExpr(*args[i], out)
            }
        }
        Expr.StructLit(name, fields, span) => {
            for i in 0..fields.len {
                collectIdentsExpr(*fields[i].value, out)
            }
        }
        // Same shape as StructLit — its field values are arbitrary expressions, so a
        // closure whose body builds a JSON object out of an enclosing local captured
        // nothing and read a garbage frame slot.
        Expr.JsonObject(fields, span) => {
            for i in 0..fields.len {
                collectIdentsExpr(*fields[i].value, out)
            }
        }
        Expr.FieldAccess(obj, field, span) => {
            collectIdentsExpr(*obj, out)
        }
        Expr.ArrayLit(elems, span) => {
            for i in 0..elems.len {
                collectIdentsExpr(*elems[i], out)
            }
        }
        Expr.ArrayRepeat(x, n, span) => {
            collectIdentsExpr(*x, out)
        }
        Expr.IndexAccess(obj, idx, span) => {
            collectIdentsExpr(*obj, out)
            collectIdentsExpr(*idx, out)
        }
        Expr.EnumLit(en, va, args, span) => {
            for i in 0..args.len {
                collectIdentsExpr(*args[i], out)
            }
        }
        Expr.Unwrap(x, span) => {
            collectIdentsExpr(*x, out)
        }
        Expr.Propagate(x, span) => {
            collectIdentsExpr(*x, out)
        }
        Expr.DefaultValue(x, d, span) => {
            collectIdentsExpr(*x, out)
            collectIdentsExpr(*d, out)
        }
        Expr.CastExpr(x, ty, span) => {
            collectIdentsExpr(*x, out)
        }
        Expr.MethodCall(obj, m, args, span) => {
            collectIdentsExpr(*obj, out)
            for i in 0..args.len {
                collectIdentsExpr(*args[i], out)
            }
        }
        Expr.Closure(params, rt, body, isMove, span) => {
            for i in 0..body.len {
                collectIdentsStmt(*body[i], out)
            }
        }
        Expr.RangeExpr(a, b, span) => {
            collectIdentsExpr(*a, out)
            collectIdentsExpr(*b, out)
        }
        Expr.IsExpr(x, pat, span) => {
            collectIdentsExpr(*x, out)
        }
        Expr.IfExpr(c, thenBody, elseBody, span) => {
            collectIdentsExpr(*c, out)
            for i in 0..thenBody.len {
                collectIdentsStmt(*thenBody[i], out)
            }
            for i in 0..elseBody.len {
                collectIdentsStmt(*elseBody[i], out)
            }
        }
        Expr.MatchExpr(subject, arms, span) => {
            collectIdentsExpr(*subject, out)
            for i in 0..arms.len {
                for j in 0..arms[i].body.len {
                    collectIdentsStmt(*arms[i].body[j], out)
                }
            }
        }
        // Literals hold no identifiers. Spelled out rather than left to a `_` arm:
        // a capture walker that silently skips a new Expr variant produces a closure
        // reading an uncaptured frame slot, with nothing to point at. Exhaustive here
        // means adding a variant to the AST fails to compile until it is traversed.
        Expr.IntLit(n, span) => {
        }
        Expr.FloatLit(f, span) => {
        }
        Expr.BoolLit(b, span) => {
        }
        Expr.StringLit(s, span) => {
        }
        Expr.CharLit(c, span) => {
        }
    }
}

pub fn collectIdentsStmt(s: &Stmt, out: &mut Vec<string>) {
    match s {
        Stmt.LetDecl(name, ty, val, span) => {
            collectIdentsExpr(*val, out)
        }
        Stmt.VarDecl(name, ty, val, span) => {
            collectIdentsExpr(*val, out)
        }
        Stmt.Assign(target, val, span) => {
            collectIdentsExpr(*target, out)
            collectIdentsExpr(*val, out)
        }
        Stmt.Return(value, span) => {
            match value {
                Option.Some(e) => {
                    collectIdentsExpr(*e, out)
                }
                Option.None => {
                }
            }
        }
        Stmt.IfStmt(cond, thenB, elseB, span) => {
            collectIdentsExpr(*cond, out)
            for i in 0..thenB.len {
                collectIdentsStmt(*thenB[i], out)
            }
            match elseB {
                Option.Some(eb) => {
                    for i in 0..eb.len {
                        collectIdentsStmt(*eb[i], out)
                    }
                }
                Option.None => {
                }
            }
        }
        Stmt.WhileStmt(cond, body, span) => {
            collectIdentsExpr(*cond, out)
            for i in 0..body.len {
                collectIdentsStmt(*body[i], out)
            }
        }
        Stmt.ExprStmt(e, span) => {
            collectIdentsExpr(*e, out)
        }
        Stmt.MatchStmt(subj, arms, span) => {
            collectIdentsExpr(*subj, out)
            for i in 0..arms.len {
                for j in 0..arms[i].body.len {
                    collectIdentsStmt(*arms[i].body[j], out)
                }
            }
        }
        Stmt.IfLetStmt(pat, val, thenB, elseB, span) => {
            collectIdentsExpr(*val, out)
            for i in 0..thenB.len {
                collectIdentsStmt(*thenB[i], out)
            }
            match elseB {
                Option.Some(eb) => {
                    for i in 0..eb.len {
                        collectIdentsStmt(*eb[i], out)
                    }
                }
                Option.None => {
                }
            }
        }
        Stmt.UnsafeBlock(body, span) => {
            for i in 0..body.len {
                collectIdentsStmt(*body[i], out)
            }
        }
        Stmt.ForInStmt(v, idx, iter, body, span) => {
            collectIdentsExpr(*iter, out)
            for i in 0..body.len {
                collectIdentsStmt(*body[i], out)
            }
        }
        // No idents to collect — exhaustive on purpose, same reason as
        // collectIdentsExpr's literal arms.
        Stmt.BreakStmt(span) => {
        }
        Stmt.ContinueStmt(span) => {
        }
    }
}

// Free variables of a closure body: referenced idents that live in the enclosing
// scope and aren't the closure's own params. By-reference capture (env holds the
// address of each), which is sound because these closures don't escape their call.
pub fn closureCaptures(params: &Vec<Param>, body: &Vec<Heap<Stmt>>, locs: &Vec<Local>): Vec<Local> {
    var idents: Vec<string> = Vec.new()
    for i in 0..body.len {
        collectIdentsStmt(*body[i], idents)
    }
    var caps: Vec<Local> = Vec.new()
    var seen: Vec<string> = Vec.new()
    for i in 0..idents.len {
        let nm = idents[i].clone()
        var skip = false
        for pj in 0..params.len {
            if params[pj].name == nm {
                skip = true
            }
        }
        if skip {
            continue
        }
        if !hasLocal(locs, nm) {
            continue
        }
        var dup = false
        for sj in 0..seen.len {
            if seen[sj] == nm {
                dup = true
            }
        }
        if dup {
            continue
        }
        seen.push(nm.clone())
        caps.push(findLocal(locs, nm))
    }
    return caps
}

pub fn closureEnvTy(caps: &Vec<Local>): string {
    if caps.len == 0 {
        return "{}"
    }
    var ty = "{ "
    for i in 0..caps.len {
        if i > 0 {
            ty = ty + ", "
        }
        ty = ty + "ptr"
    }
    return ty + " }"
}

// A move closure's env holds COPIES of the captured values (by-value), so it can
// outlive the spawning frame (e.g. run on another thread). By-ref env holds ptrs.
pub fn closureMoveEnvTy(caps: &Vec<Local>): string {
    if caps.len == 0 {
        return "{}"
    }
    var ty = "{ "
    for i in 0..caps.len {
        if i > 0 {
            ty = ty + ", "
        }
        ty = ty + llType(caps[i].ty)
    }
    return ty + " }"
}

// `return <name>` escapes whatever closure literal `name` was bound to earlier in
// this same body — that closure must own its captures (heap, not a pointer into
// this frame) same as a directly-returned closure literal. Recurses into every
// nested block a Return can hide in; codegen is a single forward pass over a
// function's statements, so this pre-scan is what lets the EARLIER `let f = ...`
// see the promotion before it emits the closure's env.
pub fn collectReturnEscapedIdentsInto(body: &Vec<Heap<Stmt>>, out: &mut Vec<string>) {
    for i in 0..body.len {
        match *body[i] {
            Stmt.Return(value, span) => {
                match value {
                    Option.Some(expr) => {
                        match *expr {
                            Expr.Ident(n, ispan) => {
                                out.push(n.clone())
                            }
                            _ => {
                            }
                        }
                    }
                    Option.None => {
                    }
                }
            }
            Stmt.IfStmt(cond, thenBody, elseBody, span) => {
                collectReturnEscapedIdentsInto(thenBody, out)
                match elseBody {
                    Option.Some(eb) => {
                        collectReturnEscapedIdentsInto(eb, out)
                    }
                    Option.None => {
                    }
                }
            }
            Stmt.WhileStmt(cond, wbody, span) => {
                collectReturnEscapedIdentsInto(wbody, out)
            }
            Stmt.MatchStmt(subject, arms, span) => {
                for ai in 0..arms.len {
                    collectReturnEscapedIdentsInto(arms[ai].body, out)
                }
            }
            Stmt.IfLetStmt(pattern, subject, thenBody, elseBody, span) => {
                collectReturnEscapedIdentsInto(thenBody, out)
                match elseBody {
                    Option.Some(eb) => {
                        collectReturnEscapedIdentsInto(eb, out)
                    }
                    Option.None => {
                    }
                }
            }
            Stmt.UnsafeBlock(ubody, span) => {
                collectReturnEscapedIdentsInto(ubody, out)
            }
            Stmt.ForInStmt(vname, vname2, iterable, fbody, span) => {
                collectReturnEscapedIdentsInto(fbody, out)
            }
            _ => {
            }
        }
    }
}

pub fn returnEscapedIdents(body: &Vec<Heap<Stmt>>): Vec<string> {
    var out: Vec<string> = Vec.new()
    collectReturnEscapedIdentsInto(body, out)
    return out
}

// The Milo source-syntax type name of a push argument, when it's cheap to read off
// the AST without evaluating anything (a literal, or a concrete struct literal's own
// name). Anything else (an Ident, a call, ...) returns "" — the pre-scan below just
// skips that push and leaves the Vec's element type to the existing i64 default,
// which is always safe: it never disagrees with what the checker already accepted
// (checker/expr.milo's push-on-unknown inference has this exact same blind spot).
pub fn pushArgStaticTy(e: &Expr): string {
    match e {
        Expr.IntLit(n, s) => {
            return "i64"
        }
        Expr.FloatLit(f, s) => {
            return "f64"
        }
        Expr.BoolLit(b, s) => {
            return "bool"
        }
        Expr.StringLit(v, s) => {
            return "string"
        }
        Expr.StructLit(name, fields, s) => {
            return name.clone()
        }
        // `v.push(-1)` is a negation applied to a literal, not a literal — and a
        // sentinel-fill loop (`for _ in 0..n { v.push(-1) }`) is the single most
        // common way an un-annotated Vec gets its element type in std. Missing it
        // left the Vec <unknown> and broke four std/deflate consumers. Whatever
        // shapes this accepts, checker/expr.milo's push-on-unknown gate must
        // accept exactly the same set — see the comment there.
        Expr.UnaryOp(op, operand, s) => {
            if op == "-" {
                return pushArgStaticTy(*operand)
            }
            return ""
        }
        _ => {
            return ""
        }
    }
}

// `var v = Vec.new()` / `Vec.withCapacity(n)` with no type annotation carries no
// element type yet — take it from the first `v.push(x)` found anywhere later in this
// body, same rule the checker already applies (checker/expr.milo checkMethodCall's
// push-on-unknown branch). Recurses into every nested block a push could hide in,
// same shape as collectReturnEscapedIdentsInto above and for the same reason: this
// is a single forward pass, so the LetDecl/VarDecl needs the answer before it's seen
// the push that supplies it.
pub fn collectVecPushHintsInto(body: &Vec<Heap<Stmt>>, out: &mut HashMap<string, string>) {
    for i in 0..body.len {
        match *body[i] {
            Stmt.ExprStmt(expr, span) => {
                match *expr {
                    Expr.MethodCall(object, method, args, mspan) => {
                        if method == "push" && args.len == 1 {
                            match *object {
                                Expr.Ident(vname, ispan) => {
                                    if !out.contains(vname) {
                                        let et = pushArgStaticTy(*args[0])
                                        if et.len > 0 {
                                            out.insert(vname.clone(), et)
                                        }
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            Stmt.IfStmt(cond, thenBody, elseBody, span) => {
                collectVecPushHintsInto(thenBody, out)
                match elseBody {
                    Option.Some(eb) => {
                        collectVecPushHintsInto(eb, out)
                    }
                    Option.None => {
                    }
                }
            }
            Stmt.WhileStmt(cond, wbody, span) => {
                collectVecPushHintsInto(wbody, out)
            }
            Stmt.MatchStmt(subject, arms, span) => {
                for ai in 0..arms.len {
                    collectVecPushHintsInto(arms[ai].body, out)
                }
            }
            Stmt.IfLetStmt(pattern, subject, thenBody, elseBody, span) => {
                collectVecPushHintsInto(thenBody, out)
                match elseBody {
                    Option.Some(eb) => {
                        collectVecPushHintsInto(eb, out)
                    }
                    Option.None => {
                    }
                }
            }
            Stmt.UnsafeBlock(ubody, span) => {
                collectVecPushHintsInto(ubody, out)
            }
            Stmt.ForInStmt(vname, vname2, iterable, fbody, span) => {
                collectVecPushHintsInto(fbody, out)
            }
            _ => {
            }
        }
    }
}

pub fn inferVecPushHints(body: &Vec<Heap<Stmt>>): HashMap<string, string> {
    var out: HashMap<string, string> = HashMap.new()
    collectVecPushHintsInto(body, out)
    return out
}

// A manual key/value rebuild rather than `.clone()` — mirrors snapshotMoves/
// restoreMoves in checker/state.milo, the existing convention for saving a
// HashMap<string, _> across a nested codegen scope in this codebase.
pub fn cloneStrMap(m: &HashMap<string, string>): HashMap<string, string> {
    var out: HashMap<string, string> = HashMap.new()
    for k, v in m {
        out.insert(k.clone(), v.clone())
    }
    return out
}

// isArrAnno for an UNANNOTATED `let`/`var` (`let loopback = ip6("::1")!`, no `: [u8;16]`).
// Local.isArr is normally recovered only from an explicit array type annotation (see the
// LetDecl/VarDecl doc comment right below), because a fixed Copy array and a real growable
// Vec share the same "Vec<T>" runtime type string once evaluated — nothing in `ty` tells
// them apart. Without an annotation there is nothing to read UNLESS the RHS is (through any
// number of `!`/`?' unwraps) a call to a known function whose declared return type carries
// a fixed array as a generic payload (`Option<[u8;16]>`): astTypeStr mangles that array
// arg to "arr_<elem>_<N>" (mirroring the checker's own mangleTypeName), a marker this can
// detect in the callee's registered return-type string. Missing this made a second use of
// such a binding read a MOVED-ZEROED value: genOwnedArg only deep-clones (instead of
// move-zeroing) a %Vec-shaped local when Local.isArr says so, so `TcpListener.bind6(loopback,
// 0)` correctly consumed it, but with isArr wrongly false the receiver's move-zero fired
// anyway, and the LATER `TcpStream.connect6(loopback, ...)` indexed a zero-length array
// ("array index out of bounds: 0/0").
pub fn exprWrapsFixedArrayReturn(e: &Expr, sigs: &Vec<CgFnSig>): bool {
    match e {
        Expr.Unwrap(inner, span) => {
            return exprWrapsFixedArrayReturn(*inner, sigs)
        }
        Expr.Call(name, args, typeArgs, span) => {
            for si in 0..sigs.len {
                if sigs[si].name == name {
                    return sigs[si].retTy.contains("arr_")
                }
            }
            return false
        }
        _ => {
            return false
        }
    }
}

// hintTy for an unannotated `let`/`var` whose value is `Vec.new()`/`Vec.withCapacity`:
// the pre-scanned element type if one was found, else "" (existing i64 default).
pub fn vecNewHint(cg: &Cgen, name: &string, value: &Expr): string {
    match value {
        Expr.EnumLit(enumName, variant, args, span) => {
            if enumName == "Vec" && (variant == "new" || variant == "withCapacity") {
                if cg.vecPushHints.contains(name) {
                    return "Vec<" + cg.vecPushHints.get(name)! + ">"
                }
            }
        }
        _ => {
        }
    }
    return ""
}

// A non-move closure literal, forced to `move` so genClosure heap-owns its
// captures instead of pointing them at a frame about to be torn down. Anything
// else (including an already-move closure) is returned unchanged.
pub fn forcedMoveClosure(value: &Expr): Expr {
    match value {
        Expr.Closure(params, retType, body, isMove, span) => {
            if isMove {
                return value.clone()
            }
            return Expr.Closure(cloneParams(params), cloneOptType(retType), cloneStmts(body), true, cloneSpan(span))
        }
        _ => {
            return value.clone()
        }
    }
}

// If `name` is a local this body's pre-scan found escaping via `return name`, and
// `value` is a non-move closure literal, force it to `move` so genClosure heap-owns
// the captures. Otherwise returns `value` unchanged (cheap: only clones on the hit).
pub fn forceMoveIfEscaping(cg: &Cgen, name: &string, value: &Expr): Expr {
    if !cg.forceMoveClosures.contains(name) {
        return value.clone()
    }
    return forcedMoveClosure(value)
}

// Lift a closure to a top-level `@__closure_N(ptr %__env, <ptr params>)` and return
// a %Closure { fnptr, env }. Uniform ABI: params AND captures arrive by pointer.
pub fn genClosure(cg: &mut Cgen, params: &Vec<Param>, retType: &Option<MiloType>, body: &Vec<Heap<Stmt>>, isMove: bool, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let cname = "__closure_" + cg.closureId.toString()
    cg.closureId = cg.closureId + 1

    // Snapshot + clear the caller's param-type hint (if any) right away: it's
    // meant for THIS closure's own unannotated params only, and must not leak
    // into a closure literal nested in this one's body.
    let paramHints = cg.closureParamHint.clone()
    cg.closureParamHint = Vec.new()
    let retHint = cg.closureRetHint.clone()
    cg.closureRetHint = ""

    var annotated = false
    var retTyStr = "void"
    match retType {
        Option.Some(rt) => {
            retTyStr = resolveAstTy(cg, rt)
            annotated = true
        }
        Option.None => {
        }
    }
    // No AST annotation, but the caller knows the exact expected type (e.g.
    // Option<T>.orElse's callback must return the SAME Option<T>) — treat it as
    // if annotated so the body walks against a real type, not the unresolvable
    // "__closureinfer__" sentinel.
    if !annotated && retHint.len > 0 {
        retTyStr = resolveTyStr(cg, retHint)
        annotated = true
    }

    let caps = closureCaptures(params, body, locs)
    // move closures heap-copy their captures (survive an escaping/threaded call);
    // by-ref closures point into the enclosing frame.
    var envTy = closureEnvTy(caps)
    if isMove {
        envTy = closureMoveEnvTy(caps)
    }

    // swap the emit buffer so the lifted define lands at module scope, not spliced
    // into the enclosing function we're mid-emitting. The `define` header needs the
    // return type up front, but an unannotated closure only learns it from its
    // `return` — so emit the body first, then prepend the header.
    let savedBody = cg.body.clone()
    let savedTemp = cg.temp
    let savedLabel = cg.label
    let savedRet = cg.curRetTy.clone()
    let savedRetRange = cg.curRetRange.clone()
    let savedClosRet = cg.closureRetTy.clone()
    let savedForceMove = cg.forceMoveClosures.clone()
    let savedVecPushHints = cloneStrMap(cg.vecPushHints)
    // A closure is lifted to its OWN top-level function, so it must not land in the
    // enclosing function's buffer. Save and clear both, or `emit` writes the closure body
    // into the caller's fnBuf and the lifted function comes out with an empty body.
    let savedFnBuf = cg.fnBuf.clone()
    let savedInFn = cg.inFn
    cg.inFn = false
    cg.fnBuf = ""
    cg.body = ""
    cg.temp = 0
    cg.label = 0
    cg.curRetTy = retTyStr.clone()
    // a closure body is not the enclosing fn: its returns answer to no declared bound
    cg.curRetRange = noRange()
    cg.closureRetTy = "void"
    // this closure's OWN body gets its own escape pre-scan — a closure that itself
    // returns a locally-bound closure needs the same treatment, and it must not see
    // the enclosing function's set (a same-named local would be a false hit).
    cg.forceMoveClosures = returnEscapedIdents(body)
    cg.vecPushHints = inferVecPushHints(body)

    emit(cg, "entry.bb:\n")
    var clocs: Vec<Local> = Vec.new()
    for ci in 0..caps.len {
        let gp = nextTemp(cg)
        emit(cg, "  " + gp + " = getelementptr " + envTy + ", ptr %__env, i32 0, i32 " + ci.toString() + "\n")
        if isMove {
            // env slot holds the value directly — gp IS the local's storage
            clocs.push(Local {
                name: caps[ci].name.clone(), ty: caps[ci].ty.clone(), addr: gp, isRef: true, isArr: false, range: noRange()
            }
            )
        } else {
            // env slot holds a pointer to the original variable
            let ca = nextTemp(cg)
            emit(cg, "  " + ca + " = load ptr, ptr " + gp + "\n")
            clocs.push(Local {
                name: caps[ci].name.clone(), ty: caps[ci].ty.clone(), addr: ca, isRef: true, isArr: false, range: noRange()
            }
            )
        }
    }
    for pj in 0..params.len {
        var pty = resolveAstTy(cg, params[pj].ty)
        // Unannotated param, no inferred type from the AST (empty string) — fall
        // back to the caller's hint (see closureParamHint's doc comment).
        if pty.len == 0 && pj < paramHints.len && paramHints[pj].len > 0 {
            pty = resolveTyStr(cg, paramHints[pj].clone())
        }
        clocs.push(Local {
            name: params[pj].name.clone(), ty: pty, addr: "%" + params[pj].name.clone(), isRef: true, isArr: false, range: noRange()
        }
        )
    }

    // annotated → gen against the annotation; unannotated → sentinel so `return`
    // uses (and records) the value's own type.
    var walkRet = retTyStr.clone()
    if !annotated {
        walkRet = "__closureinfer__"
    }
    var term = false
    for si in 0..body.len {
        if genStmt(cg, *body[si], clocs, sigs, walkRet) {
            term = true
        }
    }
    if !annotated {
        retTyStr = cg.closureRetTy.clone()
    }
    let retLl = llType(retTyStr)
    if !term {
        if retLl == "void" {
            emit(cg, "  ret void\n")
        } 
        else {
            emit(cg, "  ret " + retLl + " zeroinitializer\n")
        }
    }

    // now that retTyStr is settled, prepend the define header to the emitted body.
    var hdr = "define " + retLl + " @" + cname + "(ptr %__env"
    for pi in 0..params.len {
        hdr = hdr + ", ptr %" + params[pi].name.clone()
    }
    hdr = hdr + ") {\n"
    let closureIR = hdr + cg.body.clone() + "}\n\n"
    cg.body = savedBody
    cg.fnBuf = savedFnBuf
    cg.inFn = savedInFn
    cg.temp = savedTemp
    cg.label = savedLabel
    cg.curRetTy = savedRet
    cg.curRetRange = savedRetRange
    cg.closureRetTy = savedClosRet
    cg.forceMoveClosures = savedForceMove
    cg.vecPushHints = savedVecPushHints
    cg.globals = cg.globals + closureIR

    // build the env at the call site, then the { fnptr, env } pair
    var envVal = "null"
    if caps.len > 0 {
        var ea = ""
        if isMove {
            // heap-allocate and COPY each captured value in (outlives this frame)
            ensureMalloc(cg)
            let szp = nextTemp(cg)
            emit(cg, "  " + szp + " = getelementptr " + envTy + ", ptr null, i32 1\n")
            let szi = nextTemp(cg)
            emit(cg, "  " + szi + " = ptrtoint ptr " + szp + " to i64\n")
            ea = nextTemp(cg)
            emit(cg, "  " + ea + " = call ptr @malloc(i64 " + szi + ")\n")
            for ci in 0..caps.len {
                let cll = llType(caps[ci].ty)
                let cv = nextTemp(cg)
                emit(cg, "  " + cv + " = load " + cll + ", ptr " + caps[ci].addr.clone() + "\n")
                let gp = nextTemp(cg)
                emit(cg, "  " + gp + " = getelementptr " + envTy + ", ptr " + ea + ", i32 0, i32 " + ci.toString() + "\n")
                emit(cg, "  store " + cll + " " + cv + ", ptr " + gp + "\n")
                // The bits now live in TWO places (this local's slot and the env
                // slot just stored above) but ownership was only ever meant to
                // transfer once — same move genOwnedArg performs for a by-value
                // call arg. Without zeroing+recording the source here, whatever
                // later drops this scope's locals (a loop-body end, a fn return)
                // finds the slot still looking "alive" and drops it AGAIN: for a
                // refcounted handle (AtomicI64, Channel, ...) that is an extra
                // decrement/free racing the thread this closure was just handed
                // to, which is exactly what turned battleConcurrency's atomic
                // counter into a silent lost-update generator. A ref capture
                // (isRef) borrows someone else's storage and must not be zeroed.
                if !caps[ci].isRef && cgNeedsDrop(cg, caps[ci].ty) {
                    zeroStore(cg, caps[ci].addr, caps[ci].ty)
                    cg.movedLocalAddrs.push(caps[ci].addr.clone())
                }
            }
        } else {
            ea = nextTemp(cg)
            emit(cg, "  " + ea + " = alloca " + envTy + "\n")
            for ci in 0..caps.len {
                let gp = nextTemp(cg)
                emit(cg, "  " + gp + " = getelementptr " + envTy + ", ptr " + ea + ", i32 0, i32 " + ci.toString() + "\n")
                emit(cg, "  store ptr " + caps[ci].addr.clone() + ", ptr " + gp + "\n")
            }
        }
        envVal = ea
    }
    let c0 = nextTemp(cg)
    emit(cg, "  " + c0 + " = insertvalue %Closure undef, ptr @" + cname + ", 0\n")
    let c1 = nextTemp(cg)
    emit(cg, "  " + c1 + " = insertvalue %Closure " + c0 + ", ptr " + envVal + ", 1\n")
    // carry the return type in the surface ty ("Closure:R") so a generic call site
    // can disambiguate which monomorphization to invoke (arenaWith_T_R).
    return Val {
        v: c1, ty: "Closure:" + retTyStr.clone()
    }
}

// Indirect call of a %Closure-typed local: load { fnptr, env }, pass every arg BY
// POINTER (uniform ABI). retHint supplies R since "fn" drops the return type.
pub fn genClosureCall(cg: &mut Cgen, lc: &Local, args: &Vec<Heap<Expr>>, locs: &Vec<Local>, sigs: &Vec<CgFnSig>, retHint: &string): Val {
    let clv = nextTemp(cg)
    emit(cg, "  " + clv + " = load %Closure, ptr " + lc.addr.clone() + "\n")
    let fp = nextTemp(cg)
    emit(cg, "  " + fp + " = extractvalue %Closure " + clv + ", 0\n")
    let env = nextTemp(cg)
    emit(cg, "  " + env + " = extractvalue %Closure " + clv + ", 1\n")

    var argStr = "ptr " + env
    for i in 0..args.len {
        let alv = genLvalue(cg, *args[i], locs, sigs)
        argStr = argStr + ", ptr " + alv.v
    }
    // the closure param's own type carries R ("fn:Response" / "Closure:Response");
    // it's the declared return type, so prefer it over the (often empty) call hint.
    var retTyStr = ""
    if lc.ty.len > 3 && lc.ty[0] == 102 && lc.ty[1] == 110 && lc.ty[2] == 58 {
        retTyStr = lc.ty[3..lc.ty.len].clone()
    } else if lc.ty.len > 8 && lc.ty[0] == 67 && lc.ty[7] == 58 {
        retTyStr = lc.ty[8..lc.ty.len].clone()
    }
    if retTyStr.len == 0 {
        retTyStr = retHint.clone()
    }
    if retTyStr.len == 0 {
        retTyStr = "i64"
    }
    let retLl = llType(resolveTyStr(cg, retTyStr))
    let retTyResolved = resolveTyStr(cg, retTyStr)
    if retLl == "void" {
        emit(cg, "  call void " + fp + "(" + argStr + ")\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    let t = nextTemp(cg)
    emit(cg, "  " + t + " = call " + retLl + " " + fp + "(" + argStr + ")\n")
    return Val {
        v: t, ty: retTyResolved
    }
}
