// Zero-copy iteration over a custom container: the container hands out a `&[T]` view
// of its backing store (a non-owning fat pointer, no clone), and the caller iterates
// that directly. The Milo idiom for "iterate a custom collection" — a slice view, not a
// by-value copy of each element.
struct IntSet {
    data: Vec<i64>
}

impl IntSet {
    fn add(self: &mut Self, x: i64): void {
        self.data.push(x)
    }
    fn view(self: &Self): &[i64] {
        return self.data[0..self.data.len]
    }
}

fn main() {
    var set = IntSet {
        data: Vec.new()
    }
    set.add(10)
    set.add(20)
    set.add(30)

    // iterate the returned view directly (rvalue slice)
    var s = 0
    for x in set.view() {
        s = s + x
    }
    // @expect: 60
    print(s)

    // sub-view via a let binding, then iterate
    let sub = set.data[1..3]
    var s2 = 0
    for x in sub {
        s2 = s2 + x
    }
    // @expect: 50
    print(s2)
}
