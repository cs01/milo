// Headless capture: flies a scripted path and dumps PPM frames. Also a
// deterministic smoke test for the whole 3D pipeline.

from "std/math" import {
    Math
}
from "std/args" import {
    args
}
from "std/strconv" import {
    parseFloat
}
from "std/time" import {
    epochMillis
}
from "./gfx" import {
    Canvas, canvasNew, present
}
from "./gfx3d" import {
    Scene, sceneNew, viewOf
}
from "./sound" import {
    Sound, soundNew, playRing, playRingBonus, playRegion, playBoost, playMiss
}
from "./textures" import {
    groundTexture, planeTexture, facadeTexture
}
from "./world3d" import {
    World, worldIn, worldUpdate, wrapPi, heightAt, SEED
}
from "./city" import {
    City, cityLoad, cityEmpty, cityAttachOrtho
}
from "std/fs" import {
    readFile, isFile
}
from "./render3d" import {
    drawWorld, drawHud, drawGuide, drawMarkGuide, drawMarkBeam, drawSpeedLines,
    drawChecklist, drawFound, drawFence
}

pub extern fn fopen(path: *u8, mode: *u8): *u8

pub extern fn fwrite(ptr: *u8, size: i64, count: i64, stream: *u8): i64

pub extern fn fclose(stream: *u8): i32

pub let W: i64 = 1280

pub let H: i64 = 720

fn writePpm(path: &string, c: &Canvas) {
    var rgb: Vec<u8> = Vec.filled(W * H * 3, 0)
    for i in 0..W * H {
        let px = c.fb[i]
        rgb[i * 3] = (px & 0xFF) as u8
        rgb[i * 3 + 1] = ((px >> 8) & 0xFF) as u8
        rgb[i * 3 + 2] = ((px >> 16) & 0xFF) as u8
    }
    let header = "P6\n" + W.toString() + " " + H.toString() + "\n255\n"
    unsafe {
        let f = fopen(path.cstr(), "wb".cstr())
        if (f as i64) == 0 {
            print("cannot open " + path)
            return
        }
        let _ = fwrite(header.cstr(), 1, header.len, f)
        let _ = fwrite(rgb.ptr() as *u8, 1, W * H * 3, f)
        let _ = fclose(f)
    }
}

fn parseF(s: &string): f64 {
    match parseFloat(s.clone()) {
        Option.Some(v) => {
            return v
        }
        Option.None => {
            return 0.0
        }
    }
}

pub fn main(): i32 {
    let argv = args()
    var prefix = "/tmp/flyby"
    if argv.len > 1 {
        prefix = argv[1]
    }
    var city = cityEmpty()
    var easy = false
    // The opening survey freezes the aircraft, so a capture would otherwise
    // spend its first nine seconds of frames parked at the spawn point.
    var intro = false
    var atX = 0.0
    var atZ = 0.0
    var atAlt = 0.0
    var atYaw = 0.0
    var atSet = false
    var shots: Vec<i64> = Vec.new()
    var i = 2
    while i < argv.len {
        if argv[i] == "--city" && i + 1 < argv.len {
            match cityLoad(argv[i + 1]) {
                Result.Ok(loaded) => {
                    print("flying " + loaded.name.clone() + " — " + loaded.bCount.toString() + " buildings, " + loaded.brCount.toString() + " bridges")
                    city = loaded
                    // The game always drapes an aerial photograph over the terrain
                    // (main.milo embeds one per place), and the drape is what makes
                    // the textured raster path dominant. A benchmark run without it
                    // measures a pipeline nobody plays.
                    let orthoPath = argv[i + 1].replace(".city", ".ortho.png")
                    if isFile(orthoPath) {
                        match readFile(orthoPath) {
                            Result.Ok(png) => {
                                match cityAttachOrtho(city, png) {
                                    Result.Ok(_) => {
                                        print("draped " + orthoPath)
                                    }
                                    Result.Err(e) => {
                                        print("bad ortho: " + e)
                                    }
                                }
                            }
                            Result.Err(e) => {
                                print("cannot read ortho")
                            }
                        }
                    }
                }
                Result.Err(e) => {
                    print("could not load city: " + e)
                }
            }
            i = i + 2
            continue
        }
        // Point the camera at a fixed spot instead of wherever the scripted
        // flight ended up. Reviewing one landmark should not mean flying to it.
        if argv[i] == "--at" && i + 4 < argv.len {
            atX = parseF(argv[i + 1])
            atZ = parseF(argv[i + 2])
            atAlt = parseF(argv[i + 3])
            atYaw = parseF(argv[i + 4])
            atSet = true
            i = i + 5
            continue
        }
        if argv[i] == "--intro" {
            intro = true
            i = i + 1
            continue
        }
        if argv[i] == "--easy" {
            easy = true
            i = i + 1
            continue
        }
        shots.push(argv[i].parseInt())
        i = i + 1
    }
    if shots.len == 0 {
        shots.push(120)
        shots.push(600)
    }
    var maxFrame: i64 = 0
    for si in 0..shots.len {
        maxFrame = Math.maxI64(maxFrame, shots[si])
    }

    var c = canvasNew(W, H)
    var s = sceneNew(W, H)
    var places: Vec<City> = Vec.new()
    places.push(city)
    var w = worldIn(SEED, places, easy)
    if !intro {
        w.intro = 0.0
    }
    let groundTex = groundTexture()
    let skinTex = planeTexture()
    let facadeTex = facadeTexture()
    let snd = soundNew()
    let dt = 1.0 / 60.0
    var renderMs: i64 = 0
    var worldMs: i64 = 0
    var presentMs: i64 = 0
    var flushMs: i64 = 0
    var rendered: i64 = 0

    for frame in 0..maxFrame + 1 {
        // steer toward the nearest live coin, so the capture flies the trail
        var roll = 0.0
        var pitch = 0.0
        if w.rings.len > 0 {
            var bi = 0 - 1
            var bd = 1.0e18
            for ri in 0..w.rings.len {
                if w.rings[ri].alive {
                    let dx = w.rings[ri].x - w.plane.x
                    let dz = w.rings[ri].z - w.plane.z
                    let d = dx * dx + dz * dz
                    if d < bd {
                        bd = d
                        bi = ri
                    }
                }
            }
            if bi >= 0 {
                let dx = w.rings[bi].x - w.plane.x
                let dy = w.rings[bi].y - w.plane.y
                let dz = w.rings[bi].z - w.plane.z
                let want = Math.atan2(dx, dz)
                let diff = wrapPi(want - w.plane.yaw)
                roll = Math.clampF64(diff * 2.2, 0.0 - 1.0, 1.0)
                pitch = Math.clampF64(dy * 0.03, 0.0 - 1.0, 1.0)
            }
        }
        // Any stick input skips the opening survey, which is right in the game
        // and wrong here: the scripted autopilot is always pushing something.
        if w.intro > 0.0 {
            roll = 0.0
            pitch = 0.0
        }
        worldUpdate(w, dt, roll, pitch, false)

        var want = false
        for si in 0..shots.len {
            if shots[si] == frame {
                want = true
            }
        }
        if want {
            if atSet {
                // Park the aircraft behind the camera. It is drawn in world
                // space like everything else, and a capture of a landmark should
                // not be half fuselage.
                let yawRad = atYaw * 3.14159265358979 / 180.0
                let camY = heightAt(w.city, atX, atZ) + atAlt
                w.plane.x = atX - Math.sin(yawRad) * 500.0
                w.plane.z = atZ - Math.cos(yawRad) * 500.0
                w.plane.y = camY
                w.plane.yaw = yawRad
                w.plane.pitch = 0.0
                w.plane.roll = 0.0
                w.cam.x = atX
                w.cam.z = atZ
                w.cam.y = camY
                w.cam.yaw = yawRad
                w.cam.pitch = 0.0 - 0.10
                w.cam.roll = 0.0
            }
            if atSet {
                print("  camera " + (w.cam.x as i64).toString() + "," + (w.cam.y as i64).toString() + "," + (w.cam.z as i64).toString() + " yaw " + ((w.cam.yaw * 180.0 / 3.14159265358979) as i64).toString())
            }
            let t0 = epochMillis()
            let view = viewOf(w.cam, c.w, c.h)
            drawWorld(c, s, w, groundTex, skinTex, facadeTex, view)
            worldMs = worldMs + (epochMillis() - t0)
            flushMs = flushMs + s.flushMs
            let tp = epochMillis()
            if w.evRing {
                playRing(snd)
            }
            if w.evBonus {
                playRingBonus(snd)
            }
            if w.evRegion {
                playRegion(snd)
            }
            if w.evBoost {
                playBoost(snd)
            }
            if w.evMiss {
                playMiss(snd)
            }
            drawSpeedLines(c, w)
            drawGuide(c, w, view)
            drawFence(c, w, view)
            drawMarkBeam(c, w, view)
            drawMarkGuide(c, w, view)
            drawChecklist(c, w)
            drawFound(c, w)
            drawHud(c, w, s, 60)
            present(c, 0.35, 1.0)
            presentMs = presentMs + (epochMillis() - tp)
            renderMs = renderMs + (epochMillis() - t0)
            rendered = rendered + 1
            writePpm(prefix + "-" + frame.toString() + ".ppm", c)
            print("wrote " + prefix + "-" + frame.toString() + ".ppm  tris=" + s.tris.toString())
        }
    }
    if rendered > 0 {
        print("render ms/frame: " + (renderMs / rendered).toString() + "  (world " + (worldMs / rendered).toString() + ", present " + (presentMs / rendered).toString() + ", flush " + (flushMs / rendered).toString() + ")")
    }
    print("score " + w.score.toString() + " rings " + w.rings.len.toString() + " level " + w.level.toString())
    return 0
}
