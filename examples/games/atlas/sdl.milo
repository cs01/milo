// The window, the GL 3.3 core context, and one frame of input.
//
// Nothing above this file touches a pointer or an SDL constant: `pollInput`
// snapshots the keyboard and the mouse into a plain struct once per frame, and
// every key the game reads is edge-triggered unless holding it down is the point.

from "gl" import {
    Gpu
}

@link("SDL2")
pub extern fn SDL_Init(flags: u32): i32

pub extern fn SDL_CreateWindow(title: *u8, x: i32, y: i32, w: i32, h: i32, flags: u32): *u8

pub extern fn SDL_SetWindowFullscreen(win: *u8, flags: u32): i32

pub extern fn SDL_GL_SetAttribute(attr: i32, value: i32): i32

pub extern fn SDL_GL_CreateContext(win: *u8): *u8

pub extern fn SDL_GL_DeleteContext(ctx: *u8)

pub extern fn SDL_GL_SwapWindow(win: *u8)

pub extern fn SDL_GL_SetSwapInterval(interval: i32): i32

pub extern fn SDL_GL_GetDrawableSize(win: *u8, w: *u8, h: *u8)

pub extern fn SDL_GetWindowSize(win: *u8, w: *u8, h: *u8)

pub extern fn SDL_PollEvent(event: *u8): i32

pub extern fn SDL_GetKeyboardState(numkeys: *i32): *u8

pub extern fn SDL_GetMouseState(x: *i32, y: *i32): u32

pub extern fn SDL_GetTicks(): u32

pub extern fn SDL_Delay(ms: u32)

pub extern fn SDL_GetError(): *u8

pub extern fn SDL_DestroyWindow(win: *u8)

pub extern fn SDL_Quit()

pub let SDL_INIT_VIDEO: u32 = 0x20

pub let SDL_WINDOWPOS_CENTERED: i32 = 0x2FFF0000

pub let SDL_WINDOW_SHOWN: u32 = 0x4

pub let SDL_WINDOW_OPENGL: u32 = 0x2

pub let SDL_WINDOW_RESIZABLE: u32 = 0x20

pub let SDL_WINDOW_ALLOW_HIGHDPI: u32 = 0x2000

pub let SDL_WINDOW_FULLSCREEN_DESKTOP: u32 = 0x1001

pub let SDL_QUIT: u32 = 0x100

pub let SDL_MOUSEWHEEL: u32 = 0x403

pub let SDL_BUTTON_LMASK: u32 = 1

pub let SDL_GL_CONTEXT_MAJOR_VERSION: i32 = 17

pub let SDL_GL_CONTEXT_MINOR_VERSION: i32 = 18

pub let SDL_GL_MULTISAMPLEBUFFERS: i32 = 13

pub let SDL_GL_MULTISAMPLESAMPLES: i32 = 14

pub let SDL_GL_CONTEXT_PROFILE_MASK: i32 = 21

pub let SDL_GL_CONTEXT_PROFILE_CORE: i32 = 1

pub let SC_A: i64 = 4

pub let SC_D: i64 = 7

pub let SC_F: i64 = 9

pub let SC_H: i64 = 11

pub let SC_L: i64 = 15

pub let SC_Q: i64 = 20

pub let SC_R: i64 = 21

pub let SC_S: i64 = 22

pub let SC_W: i64 = 26

pub let SC_1: i64 = 30

pub let SC_0: i64 = 39

pub let SC_RETURN: i64 = 40

pub let SC_ESC: i64 = 41

pub let SC_TAB: i64 = 43

pub let SC_SPACE: i64 = 44

pub let SC_LBRACKET: i64 = 47

pub let SC_RBRACKET: i64 = 48

pub let SC_RIGHT: i64 = 79

pub let SC_LEFT: i64 = 80

pub let SC_DOWN: i64 = 81

pub let SC_UP: i64 = 82

// One frame of input, in window pixels. The 3D scene is projected with the live
// drawable size and the HUD is laid out in the same space, so unlike a
// letterboxed fixed-resolution game there is no second coordinate system here.
pub struct Input {
    quit: bool,
    mx: f64,
    my: f64,
    dragX: f64,
    dragY: f64,
    down: bool,
    clicked: bool, // edge: the frame the button is released without a drag
    dragged: bool, // the pointer moved far enough that this is a drag, not a click
    wheel: f64,
    orbitX: f64, // held arrow keys, for players without a mouse
    orbitY: f64,
    zoom: f64,
    prevWorld: bool,
    nextWorld: bool,
    toggleLevel: bool,
    toggleHelp: bool,
    toggleSpin: bool,
    fullscreen: bool,
    deselect: bool,
    digit: i64, // 1..9 pressed this frame, or 0
    prevHeld: bool,
    nextHeld: bool,
    levelHeld: bool,
    helpHeld: bool,
    spinHeld: bool,
    fullHeld: bool,
    escHeld: bool,
    digitHeld: bool,
    pressX: f64,
    pressY: f64,
}

pub fn inputNew(): Input {
    return Input {
        quit: false, mx: 0.0, my: 0.0, dragX: 0.0, dragY: 0.0,
        down: false, clicked: false, dragged: false, wheel: 0.0,
        orbitX: 0.0, orbitY: 0.0, zoom: 0.0,
        prevWorld: false, nextWorld: false, toggleLevel: false,
        toggleHelp: false, toggleSpin: false, fullscreen: false,
        deselect: false, digit: 0,
        prevHeld: false, nextHeld: false, levelHeld: false, helpHeld: false,
        spinHeld: false, fullHeld: false, escHeld: false, digitHeld: false,
        pressX: 0.0, pressY: 0.0,
    }
}

fn edge(now: bool, held: &mut bool): bool {
    let fired = now && !held
    held = now
    return fired
}

// A press that travels further than this is a camera drag, and releasing it must
// not also count as a click on whatever landmark happens to be under the pointer.
pub let DRAG_SLOP: f64 = 5.0

// `scale` converts SDL's window-space mouse position into drawable pixels; it is
// 2.0 on a Retina display and 1.0 everywhere else. Getting it wrong puts every
// click at half the distance from the top-left that the player aimed at.
pub fn pollInput(inp: &mut Input, ev: &mut [u8; 64], scale: f64) {
    inp.wheel = 0.0
    inp.clicked = false
    inp.dragX = 0.0
    inp.dragY = 0.0
    unsafe {
        while SDL_PollEvent(ev) != 0 {
            let evType: u32 = (ev[0] as u32) | ((ev[1] as u32) << 8) | ((ev[2] as u32) << 16) | ((ev[3] as u32) << 24)
            if evType == SDL_QUIT {
                inp.quit = true
            }
            if evType == SDL_MOUSEWHEEL {
                // SDL_MouseWheelEvent's signed y delta sits at byte offset 20;
                // the event union arrives here as raw little-endian storage.
                let raw: u32 = (ev[20] as u32) | ((ev[21] as u32) << 8) | ((ev[22] as u32) << 16) | ((ev[23] as u32) << 24)
                inp.wheel = inp.wheel + (raw as i32 as f64)
            }
        }
        var wx: i32 = 0
        var wy: i32 = 0
        let buttons = SDL_GetMouseState(wx.addrOf(), wy.addrOf())
        let nx = (wx as f64) * scale
        let ny = (wy as f64) * scale
        let downNow = (buttons & SDL_BUTTON_LMASK) != 0
        if downNow && !inp.down {
            inp.pressX = nx
            inp.pressY = ny
            inp.dragged = false
        }
        if downNow && inp.down {
            inp.dragX = nx - inp.mx
            inp.dragY = ny - inp.my
            let tx = nx - inp.pressX
            let ty = ny - inp.pressY
            if tx * tx + ty * ty > DRAG_SLOP * DRAG_SLOP {
                inp.dragged = true
            }
        }
        if !downNow && inp.down && !inp.dragged {
            inp.clicked = true
        }
        inp.down = downNow
        inp.mx = nx
        inp.my = ny

        let ks = SDL_GetKeyboardState(0 as *i32)
        inp.deselect = edge(ks[SC_ESC] != 0, inp.escHeld)
        if ks[SC_Q] != 0 {
            inp.quit = true
        }
        inp.prevWorld = edge(ks[SC_LBRACKET] != 0, inp.prevHeld)
        inp.nextWorld = edge(ks[SC_RBRACKET] != 0, inp.nextHeld)
        inp.toggleLevel = edge(ks[SC_L] != 0, inp.levelHeld)
        inp.toggleHelp = edge(ks[SC_H] != 0, inp.helpHeld)
        inp.toggleSpin = edge(ks[SC_SPACE] != 0, inp.spinHeld)
        inp.fullscreen = edge(ks[SC_F] != 0, inp.fullHeld)

        inp.orbitX = 0.0
        inp.orbitY = 0.0
        inp.zoom = 0.0
        if ks[SC_LEFT] != 0 || ks[SC_A] != 0 {
            inp.orbitX = inp.orbitX - 1.0
        }
        if ks[SC_RIGHT] != 0 || ks[SC_D] != 0 {
            inp.orbitX = inp.orbitX + 1.0
        }
        if ks[SC_UP] != 0 {
            inp.orbitY = inp.orbitY - 1.0
        }
        if ks[SC_DOWN] != 0 {
            inp.orbitY = inp.orbitY + 1.0
        }
        if ks[SC_W] != 0 {
            inp.zoom = inp.zoom - 1.0
        }
        if ks[SC_S] != 0 {
            inp.zoom = inp.zoom + 1.0
        }

        // The number row picks a world directly. One `digitHeld` for all ten
        // keys is deliberate: pressing two at once should pick one world, not
        // race between them.
        var pressed = 0
        var i = 0
        while i < 9 {
            if ks[SC_1 + i] != 0 {
                pressed = i + 1
            }
            i = i + 1
        }
        if ks[SC_0] != 0 {
            pressed = 10
        }
        inp.digit = 0
        if edge(pressed != 0, inp.digitHeld) {
            inp.digit = pressed
        }
    }
}

// Create the window and the context. Returns (window, context); either being
// null means the machine cannot run this and the caller should say so and stop.
pub struct Host {
    win: *u8,
    ctx: *u8,
    ok: bool,
    err: string,
}

pub fn hostNew(title: &string, w: i64, h: i64): Host {
    if SDL_Init(SDL_INIT_VIDEO) != 0 {
        return Host {
            win: 0 as *u8, ctx: 0 as *u8, ok: false, err: "SDL_Init failed"
        }
    }
    unsafe {
        // Set before the window exists — SDL reads these when it picks the pixel
        // format and ignores them afterwards.
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3)
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3)
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE)
        let win = SDL_CreateWindow(title.cstr(), SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, w as i32, h as i32, SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE | SDL_WINDOW_OPENGL | SDL_WINDOW_ALLOW_HIGHDPI)
        if (win as i64) == 0 {
            return Host {
                win: 0 as *u8, ctx: 0 as *u8, ok: false, err: "window: " + _cstrToString(SDL_GetError())
            }
        }
        let ctx = SDL_GL_CreateContext(win)
        if (ctx as i64) == 0 {
            return Host {
                win: win, ctx: 0 as *u8, ok: false, err: "no GL 3.3 core context: " + _cstrToString(SDL_GetError())
            }
        }
        let _ = SDL_GL_SetSwapInterval(1)
        return Host {
            win: win, ctx: ctx, ok: true, err: Gpu.version()
        }
    }
}

pub struct Size {
    w: i64,
    h: i64,
}

// The drawable size in real pixels, which on a Retina display is twice the
// window size the user dragged. Every layout in the game is expressed in these
// pixels, so the HUD is crisp instead of upscaled — which is also why
// `pollInput` has to be told the window-to-drawable ratio.
pub fn drawableSize(win: *u8): Size {
    var dw: i32 = 0
    var dh: i32 = 0
    unsafe {
        SDL_GL_GetDrawableSize(win, (dw.addrOf()) as *u8, (dh.addrOf()) as *u8)
    }
    return Size {
        w: dw as i64, h: dh as i64
    }
}

// Drawable pixels per window point. Asked of SDL rather than assumed to be 2.0,
// because it is 1.0 on most Linux setups and 1.5 or 3.0 on some displays.
pub fn pixelScale(win: *u8): f64 {
    var ww: i32 = 0
    var wh: i32 = 0
    unsafe {
        SDL_GetWindowSize(win, (ww.addrOf()) as *u8, (wh.addrOf()) as *u8)
    }
    if ww <= 0 {
        return 1.0
    }
    let d = drawableSize(win)
    return (d.w as f64) / (ww as f64)
}
