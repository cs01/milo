// Statement type checking
from "src-milo/ast.milo" import {
    Stmt, Expr, MiloType, Span, MatchArm, Pattern, Param, Function, Program,
    EnumDecl, EnumVariant, TypeParam, simpleType,
}
from "src-milo/checker/types.milo" import {
    TypeKind, typeEq, typeName, typeFromAst, typeFromName,
    tyI32, tyI64, tyU8, tyBool, tyVoid, tyString, tyUnknown,
    isNumeric, isInteger, isFloat, isCopy, needsDrop, containsUnknown, isViewReturnType,
}
from "src-milo/checker/state.milo" import {
    Checker, VarInfo, FnSig, FnParam, StructInfo, EnumInfo, VariantInfo,
    Diagnostic, error, errorHint, warn, pushScope, popScope, declare, lookup, setVarMoved, setVarRead, hasErrors,
    normalizeEnumNames, stmtTerminates, snapshotMoves, restoreMoves, orMoves, nestedRef, hasAttr, MoveSnapshot,
}
from "src-milo/checker/expr.milo" import {
    intCoercible, floatLitCoercible, arrayIntCoercible, arrayToVecCoercible, checkExpr, tryMove, isRootMutable, deref,
    errorIfMovingBorrowedNonCopy,
}
from "src-milo/checker/traits.milo" import {
    registerBuiltinTraits, registerAllImpls, synthesizeDefaultMethods, processDerives, typeImplementsTrait, resolveMethod
}
from "src-milo/checker/mono.milo" import {
    registerGenericFn, registerGenericStruct, registerGenericEnum, monomorphizeFn, monomorphizeStruct, monomorphizeEnum
}
from "src-milo/checker/borrow.milo" import {
    accessPath, rootIdentName, freezeName, unfreezeName, isFrozen, frozenAgainst,
    freezePlace, freezeViewMethodSource, errorIfFrozenRoot, describePlace,
    assignTargetPath, errorIfAssignFrozen, borrowDuringCallback, BorrowArg,
    borrowArgOf, checkCallSiteExclusivity, snapshotFrozenNames, releaseOrRetainFreezes,
}
from "src-milo/checker/moves.milo" import {
    staticFieldPlace, clearMovedFields, fieldPathString,
}

// -- Statement checker --

pub fn checkStmt(ck: &mut Checker, stmt: &Stmt, fnRetType: &TypeKind) {
    match stmt {
        Stmt.LetDecl(name, typeAnno, value, span) => {
            checkLetDecl(ck, name, typeAnno, *value, false, span)
        }
        Stmt.VarDecl(name, typeAnno, value, span) => {
            checkLetDecl(ck, name, typeAnno, *value, true, span)
        }
        Stmt.Assign(target, value, span) => {
            checkAssign(ck, *target, *value, span)
        }
        Stmt.Return(value, span) => {
            checkReturn(ck, value, fnRetType, span)
        }
        Stmt.IfStmt(cond, thenBody, elseBody, span) => {
            checkIf(ck, *cond, thenBody, elseBody, fnRetType, span)
        }
        Stmt.WhileStmt(cond, body, span) => {
            checkWhile(ck, *cond, body, fnRetType, span)
        }
        Stmt.ExprStmt(expr, span) => {
            // A view produced by a discarded expression (`print(lx.word(0, 5))`)
            // has no binding to outlive the statement, so its freeze must not
            // survive it either — same reasoning as the RHS snapshot in
            // checkAssign/checkLetDecl, which this mirrors.
            let frozenBefore = snapshotFrozenNames(ck)
            checkExpr(ck, *expr)
            releaseOrRetainFreezes(ck, frozenBefore, false)
        }
        Stmt.MatchStmt(subject, arms, span) => {
            checkMatch(ck, *subject, arms, fnRetType)
        }
        Stmt.BreakStmt(span) => {
            if ck.loopDepth == 0 {
                error(ck, "'break' outside of loop", cloneSpan(span))
            }
        }
        Stmt.ContinueStmt(span) => {
            if ck.loopDepth == 0 {
                error(ck, "'continue' outside of loop", cloneSpan(span))
            }
        }
        Stmt.IfLetStmt(pattern, expr, thenBody, elseBody, span) => {
            checkIfLet(ck, *pattern, *expr, thenBody, elseBody, fnRetType)
        }
        Stmt.UnsafeBlock(body, span) => {
            ck.unsafeDepth = ck.unsafeDepth + 1
            pushScope(ck)
            for i in 0..body.len {
                checkStmt(ck, *body[i], fnRetType)
            }
            popScope(ck)
            ck.unsafeDepth = ck.unsafeDepth - 1
        }
        Stmt.ForInStmt(varName, varName2, iterable, body, span) => {
            checkForIn(ck, varName, varName2, *iterable, body, fnRetType, span)
        }
    }
}

// -- Let/Var declarations --

pub fn checkLetDecl(ck: &mut Checker, name: &string, typeAnno: &Option<MiloType>, value: &Expr, mutable: bool, span: &Option<Span>) {
    // Resolve the annotation first and expose it as the expected type, so a
    // generic call whose type params aren't determined by args can infer from it
    // (`let a: Arena<X> = arenaNew()`).
    var hasHint = false
    var hint = tyUnknown()
    match typeAnno {
        Option.Some(ty) => {
            hint = resolveAstType(ck, ty)
            hasHint = true
        }
        Option.None => {
        }
    }
    // A reference stored inside a local collection (Vec<&T> etc) outlives
    // whatever freeze the call site took for it — a bare `&T` local is fine
    // (second-class, can't escape the function), but nothing marks a
    // CONTAINER as borrowed the way a plain reference binding is.
    if hasHint && nestedRef(ck, hint) {
        error(ck, "'" + name.clone() + "': references cannot be stored in a collection", cloneSpan(span))
    }
    if hasHint {
        ck.expectedType = Option.Some(hint.clone())
    }
    // A borrow taken to compute the RHS (`s[0..n]`, `lx.word(...)`) is eager —
    // freezePlace/freezeViewMethodSource fire on every slice/view-method check,
    // not just ones that land in a binding. Snapshot what's already frozen so
    // only what THIS statement newly froze is in scope for the keep/release
    // decision below.
    let frozenBefore = snapshotFrozenNames(ck)
    var valType = checkExpr(ck, value)
    ck.expectedType = Option.None

    if hasHint {
        if !typeEq(hint, valType) && !typeEq(valType, tyUnknown()) && !intCoercible(hint, valType, value) &&
        !floatLitCoercible(hint, valType, value) &&
        !arrayIntCoercible(hint, valType) && !arrayToVecCoercible(hint, valType) &&
        !optionIntWrapCoercible(ck, hint, valType) && !interfaceCoercible(ck, hint, valType) {
            error(ck, "type mismatch: '" + name.clone() + "' declared as " + typeName(hint) + " but got " + typeName(valType), cloneSpan(span))
        }
        valType = hint
    }

    // A view-typed binding (`let view = s[0..5]`) keeps whatever it froze
    // alive for its own scope's life; anything else (the borrow was fully
    // consumed within this statement, e.g. `s[0..n].len`) releases now.
    var isRefBinding = false
    match valType.clone() {
        TypeKind.TRef(vinner, vmut) => {
            isRefBinding = true
        }
        _ => {
        }
    }
    releaseOrRetainFreezes(ck, frozenBefore, isRefBinding)

    declare(ck, name.clone(), VarInfo {
        ty: valType,
        mutable: mutable,
        moved: false,
        borrowed: false,
        read: false,
        span: cloneSpan(span),
    }
    )
    tryMove(ck, value)
}

// -- Assignment --

pub fn checkAssign(ck: &mut Checker, target: &Expr, value: &Expr, span: &Option<Span>) {
    if !isRootMutable(ck, target) {
        error(ck, "cannot assign to immutable variable", cloneSpan(span))
        return
    }
    // Whole-place assignment (`x = ...`, `x.f = ...`) drops the old value and
    // frees its buffer, so a live view into it would dangle. An in-place
    // element write (`v[i] = x`) is exempt — see errorIfAssignFrozen.
    errorIfAssignFrozen(ck, target, span)

    // A plain `x = ...` target is written, not read. Routing it through checkExpr
    // would hit checkIdent's use-after-move check and report "use of moved
    // variable 'x'" for the very statement that un-moves it.
    // Two views of the target's type. `targetType` is dereferenced so writing
    // *through* a `&mut T` param compares against T. `targetDeclType` keeps the
    // wrapper, because a var can also legitimately HOLD a `&T` — a string/slice
    // view (`var v = s[0..5]`) is rebindable to another view of the same type, and
    // deref alone would report "cannot assign &string to string" on `v = s[6..11]`.
    var targetType = tyUnknown()
    var targetDeclType = tyUnknown()
    match target {
        Expr.Ident(name, tspan) => {
            match lookup(ck, name) {
                Option.Some(v) => {
                    targetType = deref(v.ty)
                    targetDeclType = v.ty.clone()
                }
                Option.None => {
                    error(ck, "undefined variable '" + name.clone() + "'", cloneSpan(span))
                }
            }
        }
        _ => {
            // A field target (`p.a = ...`) is written, not read, same reasoning as
            // the Ident case above — the field about to be overwritten doesn't care
            // whether it was already moved. checkFieldMoveState reads this depth to
            // suppress its "use of moved value" check for exactly this walk.
            ck.inAssignTargetDepth = ck.inAssignTargetDepth + 1
            targetType = checkExpr(ck, target)
            ck.inAssignTargetDepth = ck.inAssignTargetDepth - 1
            targetDeclType = targetType.clone()
        }
    }
    // Expose the target's type as the hint so an array literal RHS (`v = [a, b]`)
    // coerces to Vec<T> when the target is one, same as let/var and struct fields.
    ck.expectedType = Option.Some(targetType.clone())
    // A borrow the RHS takes to compute its value (`s[0..n].clone()`) is
    // consumed within this statement — no binding outlives it — so it must
    // not leak a freeze onto the next statement.
    let frozenBeforeRhs = snapshotFrozenNames(ck)
    let valType = checkExpr(ck, value)
    ck.expectedType = Option.None
    releaseOrRetainFreezes(ck, frozenBeforeRhs, false)
    if !typeEq(targetDeclType, valType) &&
    !typeEq(targetType, valType) && !typeEq(valType, tyUnknown()) && !intCoercible(targetType, valType, value) &&
    !arrayToVecCoercible(targetType, valType) && !floatLitCoercible(targetType, valType, value) &&
    !optionIntWrapCoercible(ck, targetType, valType) {
        error(ck, "type mismatch: cannot assign " + typeName(valType) + " to " + typeName(targetType), cloneSpan(span))
    }

    // Re-assigning un-moves the variable — or, for a field target, un-moves just
    // that place and anything nested under it (a different field was never
    // touched by this write).
    match target {
        Expr.Ident(name, tspan) => {
            setVarMoved(ck, name, false)
        }
        _ => {
            match staticFieldPlace(target) {
                Option.Some(p) => {
                    clearMovedFields(ck, p.root, Option.Some(fieldPathString(p.fields)))
                }
                Option.None => {
                }
            }
        }
    }
    tryMove(ck, value)
}

// -- Return --

pub fn checkReturn(ck: &mut Checker, value: &Option<Heap<Expr>>, fnRetType: &TypeKind, span: &Option<Span>) {
    match value {
        Option.Some(expr) => {
            ck.inReturn = true
            // expose the declared return type so a bare generic struct/enum literal
            // (`return HashSet { … }` in setNew<T>) resolves to the right instance
            if !typeEq(fnRetType, tyUnknown()) {
                ck.expectedType = Option.Some(fnRetType.clone())
            }
            let valType = checkExpr(ck, *expr)
            ck.expectedType = Option.None
            ck.inReturn = false
            // inside an unannotated closure (fnRetType unknown) this Return's type
            // is the inferred closure return type.
            if typeEq(fnRetType, tyUnknown()) {
                ck.pendingClosureRet = Option.Some(valType.clone())
            }
            if !typeEq(fnRetType, valType) && !typeEq(valType, tyUnknown()) && !typeEq(fnRetType, tyUnknown())
            && !intCoercible(fnRetType, valType, *expr) && !floatLitCoercible(fnRetType, valType, *expr) && !interfaceCoercible(ck, fnRetType, valType) {
                error(ck, "return type mismatch: expected " + typeName(fnRetType) + ", got " + typeName(valType), cloneSpan(span))
            }
            // Deliberately no tryMove here: this checker is flow-insensitive, so
            // marking the returned variable moved poisons every later use of it
            // (`if cond { return result }` ... `result.push(x)`), which is exactly
            // what the TS checker's returnOnlyMoves bookkeeping exists to avoid.
            // The function exits, so nothing after can observe the move.
            // The borrowed-value-escape check is still needed though — a `&T` loop
            // variable (e.g. `for line in s.lines()`) is second-class and lives only
            // inside the loop that borrowed it; unlike ordinary move tracking this
            // only reports, it never marks anything moved, so it can't poison later
            // reads the same way.
            errorIfMovingBorrowedNonCopy(ck, *expr, span)
        }
        Option.None => {
            if !typeEq(fnRetType, tyVoid()) {
                error(ck, "return without value in function returning " + typeName(fnRetType), cloneSpan(span))
            }
        }
    }
}

// -- If statement --

pub fn checkIf(ck: &mut Checker, cond: &Expr, thenBody: &Vec<Heap<Stmt>>, elseBody: &Option<Vec<Heap<Stmt>>>, fnRetType: &TypeKind, span: &Option<Span>) {
    let condType = checkExpr(ck, cond)
    if !typeEq(condType, tyBool()) && !typeEq(condType, tyUnknown()) {
        error(ck, "if condition must be bool, got " + typeName(condType), cloneSpan(span))
    }

    // Branches are checked in isolation from the pre-state (a sibling arm
    // must not see this arm's moves), then joined: any-path moves survive,
    // except from branches that terminate (break/continue/return).
    let preSnap = snapshotMoves(ck)
    pushScope(ck)
    for i in 0..thenBody.len {
        checkStmt(ck, *thenBody[i], fnRetType)
    }
    popScope(ck)
    var thenTerm = false
    if thenBody.len > 0 {
        thenTerm = stmtTerminates(*thenBody[thenBody.len - 1])
    }
    let afterThen = snapshotMoves(ck)
    restoreMoves(ck, preSnap)

    match elseBody {
        Option.Some(body) => {
            pushScope(ck)
            for j in 0..body.len {
                checkStmt(ck, *body[j], fnRetType)
            }
            popScope(ck)
            var elseTerm = false
            if body.len > 0 {
                elseTerm = stmtTerminates(*body[body.len - 1])
            }
            if elseTerm {
                restoreMoves(ck, preSnap)
            }
        }
        Option.None => {
        }
    }
    if !thenTerm {
        orMoves(ck, afterThen)
    }
}

// -- While statement --

pub fn checkWhile(ck: &mut Checker, cond: &Expr, body: &Vec<Heap<Stmt>>, fnRetType: &TypeKind, span: &Option<Span>) {
    let condType = checkExpr(ck, cond)
    if !typeEq(condType, tyBool()) && !typeEq(condType, tyUnknown()) {
        error(ck, "while condition must be bool, got " + typeName(condType), cloneSpan(span))
    }

    pushScope(ck)
    ck.loopDepth = ck.loopDepth + 1
    for i in 0..body.len {
        checkStmt(ck, *body[i], fnRetType)
    }
    ck.loopDepth = ck.loopDepth - 1
    popScope(ck)
}

// -- Match statement --

pub fn checkMatch(ck: &mut Checker, subject: &Expr, arms: &Vec<MatchArm>, fnRetType: &TypeKind) {
    let subjType = checkExpr(ck, subject)

    // Arms are mutually exclusive: each checks from the pre-state, then the
    // join keeps any-path moves (terminated arms drop out) — same rules as
    // if/else branches.
    let preSnap = snapshotMoves(ck)
    var armSnaps: Vec<MoveSnapshot> = Vec.new()
    var armTerms: Vec<bool> = Vec.new()
    for i in 0..arms.len {
        restoreMoves(ck, preSnap)
        checkMatchArm(ck, arms[i], subjType, fnRetType)
        armSnaps.push(snapshotMoves(ck))
        var term = false
        if arms[i].body.len > 0 {
            term = stmtTerminates(*arms[i].body[arms[i].body.len - 1])
        }
        armTerms.push(term)
    }
    restoreMoves(ck, preSnap)
    for i in 0..armSnaps.len {
        if !armTerms[i] {
            orMoves(ck, armSnaps[i])
        }
    }
}

pub fn checkMatchArm(ck: &mut Checker, arm: &MatchArm, subjType: &TypeKind, fnRetType: &TypeKind) {
    pushScope(ck)

    // Bind pattern variables into scope
    match arm.pattern {
        Pattern.EnumPattern(enumName, variant, bindings, pspan) => {
            match subjType {
                TypeKind.TEnum(name) => {
                    if ck.enums.contains(name) {
                        let enumInfo = ck.enums.get(name)!
                        if enumInfo.variants.contains(variant) {
                            let variantInfo = enumInfo.variants.get(variant)!
                            var k: i64 = 0
                            while k < bindings.len && k < variantInfo.fields.len {
                                if bindings[k] != "_" {
                                    declare(ck, bindings[k].clone(), VarInfo {
                                        ty: variantInfo.fields[k].clone(),
                                        mutable: false,
                                        moved: false,
                                        borrowed: false,
                                        read: false,
                                        span: cloneSpan(pspan),
                                    }
                                    )
                                }
                                k = k + 1
                            }
                        } else {
                            error(ck, "enum '" + name.clone() + "' has no variant '" + variant.clone() + "'", cloneSpan(pspan))
                        }
                    }
                }
                _ => {
                    error(ck, "cannot use enum pattern when matching on " + typeName(subjType), cloneSpan(pspan))
                }
            }
        }
        Pattern.LiteralPattern(value, kind, pspan) => {
        }
        Pattern.WildcardPattern(pspan) => {
        }
    }

    // Check arm body
    for j in 0..arm.body.len {
        checkStmt(ck, *arm.body[j], fnRetType)
    }

    popScope(ck)
}

// -- Match expression --

pub struct MatchArmCheck {
    produced: bool,
    ty: TypeKind,
}

// Like checkMatchArm, but the arm's LAST statement is the arm's value rather
// than an ordinary statement: a bare ExprStmt supplies it, a diverging stmt
// (return/break/continue) supplies none (the arm never reaches the join), and
// anything else is a real error — no silent "treat as void" fallback.
pub fn checkMatchArmValue(ck: &mut Checker, arm: &MatchArm, subjType: &TypeKind, fnRetType: &TypeKind, span: &Option<Span>): MatchArmCheck {
    pushScope(ck)

    match arm.pattern {
        Pattern.EnumPattern(enumName, variant, bindings, pspan) => {
            match subjType {
                TypeKind.TEnum(name) => {
                    if ck.enums.contains(name) {
                        let enumInfo = ck.enums.get(name)!
                        if enumInfo.variants.contains(variant) {
                            let variantInfo = enumInfo.variants.get(variant)!
                            var k: i64 = 0
                            while k < bindings.len && k < variantInfo.fields.len {
                                if bindings[k] != "_" {
                                    declare(ck, bindings[k].clone(), VarInfo {
                                        ty: variantInfo.fields[k].clone(),
                                        mutable: false,
                                        moved: false,
                                        borrowed: false,
                                        read: false,
                                        span: cloneSpan(pspan),
                                    }
                                    )
                                }
                                k = k + 1
                            }
                        } else {
                            error(ck, "enum '" + name.clone() + "' has no variant '" + variant.clone() + "'", cloneSpan(pspan))
                        }
                    }
                }
                _ => {
                    error(ck, "cannot use enum pattern when matching on " + typeName(subjType), cloneSpan(pspan))
                }
            }
        }
        Pattern.LiteralPattern(value, kind, pspan) => {
        }
        Pattern.WildcardPattern(pspan) => {
        }
    }

    var result = MatchArmCheck {
        produced: false, ty: tyUnknown()
    }
    var i: i64 = 0
    while i < arm.body.len {
        let isLast = i == arm.body.len - 1
        if isLast {
            match *arm.body[i] {
                Stmt.ExprStmt(e, espan) => {
                    result = MatchArmCheck {
                        produced: true, ty: checkExpr(ck, *e)
                    }
                }
                _ => {
                    if stmtTerminates(*arm.body[i]) {
                        checkStmt(ck, *arm.body[i], fnRetType)
                    } else {
                        error(ck, "match-expression arm must end in a value or return/break/continue", cloneSpan(span))
                        checkStmt(ck, *arm.body[i], fnRetType)
                    }
                }
            }
        } else {
            checkStmt(ck, *arm.body[i], fnRetType)
        }
        i = i + 1
    }

    popScope(ck)
    return result
}

// match in expression position. Reuses statement-match's per-arm move
// snapshot/join (an arm that diverges must not poison post-match moves), but
// additionally unifies each producing arm's value type — same rule as
// if-expression branches, with the same const-int coercion.
pub fn checkMatchExpr(ck: &mut Checker, subject: &Expr, arms: &Vec<MatchArm>, fnRetType: &TypeKind, span: &Option<Span>): TypeKind {
    let subjType = checkExpr(ck, subject)

    let preSnap = snapshotMoves(ck)
    var armSnaps: Vec<MoveSnapshot> = Vec.new()
    var armTerms: Vec<bool> = Vec.new()
    var resultTy = tyUnknown()
    var haveResult = false
    for i in 0..arms.len {
        restoreMoves(ck, preSnap)
        let res = checkMatchArmValue(ck, arms[i], subjType, fnRetType, span)
        armSnaps.push(snapshotMoves(ck))
        var term = false
        if arms[i].body.len > 0 {
            term = stmtTerminates(*arms[i].body[arms[i].body.len - 1])
        }
        armTerms.push(term)
        if res.produced {
            if !haveResult {
                resultTy = res.ty
                haveResult = true
            } else if !typeEq(resultTy, res.ty) && !containsUnknown(resultTy) && !containsUnknown(res.ty) {
                error(ck, "match-expression arms disagree: " + typeName(resultTy) + " vs " + typeName(res.ty), cloneSpan(span))
            }
        }
    }
    restoreMoves(ck, preSnap)
    for i in 0..armSnaps.len {
        if !armTerms[i] {
            orMoves(ck, armSnaps[i])
        }
    }
    return resultTy
}

// -- If-let statement --

pub fn checkIfLet(ck: &mut Checker, pattern: &Pattern, expr: &Expr, thenBody: &Vec<Heap<Stmt>>, elseBody: &Option<Vec<Heap<Stmt>>>, fnRetType: &TypeKind) {
    let exprType = checkExpr(ck, expr)

    pushScope(ck)

    // Bind pattern variables
    match pattern {
        Pattern.EnumPattern(enumName, variant, bindings, pspan) => {
            match exprType {
                TypeKind.TEnum(name) => {
                    if ck.enums.contains(name) {
                        let enumInfo = ck.enums.get(name)!
                        if enumInfo.variants.contains(variant) {
                            let variantInfo = enumInfo.variants.get(variant)!
                            var k: i64 = 0
                            while k < bindings.len && k < variantInfo.fields.len {
                                if bindings[k] != "_" {
                                    declare(ck, bindings[k].clone(), VarInfo {
                                        ty: variantInfo.fields[k].clone(),
                                        mutable: false,
                                        moved: false,
                                        borrowed: false,
                                        read: false,
                                        span: cloneSpan(pspan),
                                    }
                                    )
                                }
                                k = k + 1
                            }
                        }
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }

    for s in thenBody {
        checkStmt(ck, *s, fnRetType)
    }
    popScope(ck)

    match elseBody {
        Option.Some(body) => {
            pushScope(ck)
            for s in body {
                checkStmt(ck, *s, fnRetType)
            }
            popScope(ck)
        }
        Option.None => {
        }
    }
}

// -- For-in statement --

// One TRef unwrap. Kept separate from checker/expr.milo's `deref` so this file's
// side-effect-free peek below never accidentally inherits a change made there for
// some other caller's contract.
fn peekDeref(t: TypeKind): TypeKind {
    match t {
        TypeKind.TRef(inner, mutable) => {
            return (*inner).clone()
        }
        _ => {
            return t
        }
    }
}

// Side-effect-free type of a variable/field/index path — used only to decide
// whether `for x in EXPR` is the string-view loop form (`text.lines()` /
// `text.splitView(sep)`) before EXPR is checked as an ordinary call, which would
// report the wrong error. Deliberately partial: a None answer means "ask the real
// checker", never "not a string".
pub fn peekPathType(ck: &Checker, e: &Expr): Option<TypeKind> {
    match e {
        // a literal's bytes are a module constant, so views into it outlive any loop
        Expr.StringLit(v, s) => {
            return Option.Some(tyString())
        }
        Expr.Ident(name, s) => {
            match lookup(ck, name) {
                Option.Some(info) => {
                    return Option.Some(info.ty)
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        Expr.FieldAccess(obj, field, s) => {
            match peekPathType(ck, *obj) {
                Option.Some(baseTy) => {
                    match peekDeref(baseTy) {
                        TypeKind.TStruct(sname) => {
                            if ck.structs.contains(sname) {
                                let info = ck.structs.get(sname)!
                                for i in 0..info.fields.len {
                                    if info.fields[i].name == field {
                                        return Option.Some(info.fields[i].ty.clone())
                                    }
                                }
                            }
                            return Option.None
                        }
                        _ => {
                            return Option.None
                        }
                    }
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        // `rows[i].lines()` — an element read, so the freeze on the root container
        // still covers the storage the pieces point into
        Expr.IndexAccess(obj, idx, s) => {
            match peekPathType(ck, *obj) {
                Option.Some(baseTy) => {
                    match peekDeref(baseTy) {
                        TypeKind.TVec(elem) => {
                            return Option.Some((*elem).clone())
                        }
                        TypeKind.TArray(elem, size) => {
                            return Option.Some((*elem).clone())
                        }
                        TypeKind.THashMap(key, val) => {
                            return Option.Some((*val).clone())
                        }
                        _ => {
                            return Option.None
                        }
                    }
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        _ => {
            return Option.None
        }
    }
}

// `for line in text.lines()` / `for f in text.splitView(sep)`. Each piece is a
// `&string` view into the receiver's own buffer — loop-only, matching the
// second-class reference rule: a view can't travel through the `next(): Option<T>`
// iterator protocol, since a reference inside an enum payload is a rejected return.
pub fn checkStringViewForIn(ck: &mut Checker, varName: &string, varName2: &Option<string>, recv: &Expr, mode: &string, args: &Vec<Heap<Expr>>, body: &Vec<Heap<Stmt>>, fnRetType: &TypeKind, span: &Option<Span>) {
    checkExpr(ck, recv)
    if mode == "splitView" {
        if args.len != 1 {
            error(ck, "'splitView' expects 1 argument, got " + args.len.toString(), cloneSpan(span))
        } else {
            let sepType = checkExpr(ck, *args[0])
            if !typeEq(sepType, tyString()) && !typeEq(sepType, tyUnknown()) {
                error(ck, "'splitView': expected string, got " + typeName(sepType), cloneSpan(span))
            }
        }
    } else if args.len != 0 {
        error(ck, "'lines' takes no arguments", cloneSpan(span))
    }

    let viewType = TypeKind.TRef(Heap(tyString()), false)
    // Every piece points into the receiver's buffer, so it must not be
    // mutated, moved or reallocated for the whole loop — same freeze a
    // `s[a..b]` slice takes, held for the loop body's life instead of one
    // statement's.
    var frozenRoot: Option<string> = Option.None
    match accessPath(recv) {
        Option.Some(p) => {
            freezeName(ck, p.root, p.fields)
            frozenRoot = Option.Some(p.root)
        }
        Option.None => {
        }
    }
    pushScope(ck)
    match varName2 {
        Option.Some(name2) => {
            declare(ck, varName.clone(), VarInfo {
                ty: tyI64(), mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
            }
            )
            declare(ck, name2.clone(), VarInfo {
                ty: viewType, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
            }
            )
        }
        Option.None => {
            declare(ck, varName.clone(), VarInfo {
                ty: viewType, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
            }
            )
        }
    }
    ck.loopDepth = ck.loopDepth + 1
    for s in body {
        checkStmt(ck, *s, fnRetType)
    }
    ck.loopDepth = ck.loopDepth - 1
    popScope(ck)
    match frozenRoot {
        Option.Some(r) => {
            unfreezeName(ck, r)
        }
        Option.None => {
        }
    }
}

pub fn checkForIn(ck: &mut Checker, varName: &string, varName2: &Option<string>, iterable: &Expr, body: &Vec<Heap<Stmt>>, fnRetType: &TypeKind, span: &Option<Span>) {
    // Range expression handled specially
    match iterable {
        Expr.RangeExpr(start, end, rspan) => {
            let startType = checkExpr(ck, *start)
            let endType = checkExpr(ck, *end)
            if !isInteger(startType) && !typeEq(startType, tyUnknown()) {
                error(ck, "for range start must be integer, got " + typeName(startType), cloneSpan(span))
            }
            if !isInteger(endType) && !typeEq(endType, tyUnknown()) {
                error(ck, "for range end must be integer, got " + typeName(endType), cloneSpan(span))
            }

            // Use wider of start/end types
            var varType = startType.clone()
            match startType {
                TypeKind.TInt(bitsA, signedA) => {
                    match endType {
                        TypeKind.TInt(bitsB, signedB) => {
                            if bitsB > bitsA {
                                varType = endType.clone()
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }

            pushScope(ck)
            declare(ck, varName.clone(), VarInfo {
                ty: varType,
                mutable: false,
                moved: false,
                borrowed: false,
                read: false,
                span: cloneSpan(span),
            }
            )
            ck.loopDepth = ck.loopDepth + 1
            for s in body {
                checkStmt(ck, *s, fnRetType)
            }
            ck.loopDepth = ck.loopDepth - 1
            popScope(ck)
            return
        }
        _ => {
        }
    }

    // `for line in text.lines()` / `for f in text.splitView(sep)` — a text pass that
    // allocates nothing. The receiver type has to be known BEFORE the call is checked
    // as an ordinary expression: checking the whole MethodCall generically would hit
    // checkStringMethod and report "no method 'lines' on string" (lines/splitView are
    // for-loop-only forms, not real methods) — peekPathType answers side-effect-free,
    // without checking (and thereby misreporting on) the call itself.
    match iterable {
        Expr.MethodCall(mObj, mMethod, mArgs, mSpan) => {
            if mMethod == "lines" || mMethod == "splitView" {
                var recvIsString = false
                match peekPathType(ck, *mObj) {
                    Option.Some(t) => {
                        match peekDeref(t) {
                            TypeKind.TString => {
                                recvIsString = true
                            }
                            _ => {
                            }
                        }
                    }
                    Option.None => {
                    }
                }
                if recvIsString {
                    checkStringViewForIn(ck, varName, varName2, *mObj, mMethod, mArgs, body, fnRetType, span)
                    return
                }
            }
        }
        _ => {
        }
    }

    var iterType = checkExpr(ck, iterable)
    // slices (&[T]) and &Vec iterate like the owned collection — same loop shapes,
    // just borrowed instead of moved.
    match iterType.clone() {
        TypeKind.TRef(inner, mutable) => {
            match (*inner).clone() {
                TypeKind.TArray(e, s) => {
                    iterType = (*inner).clone()
                }
                TypeKind.TVec(e) => {
                    iterType = (*inner).clone()
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }

    // Iterating a Vec/Array/HashMap hands out element references into its own
    // storage; a push/insert mid-loop can realloc that storage out from under
    // them. Freeze the iterable's root for the loop body's life — same
    // mechanism a slice takes, held longer. Not applied to a byte-iterated
    // string (no element references escape a copy) or a user `next()`
    // iterator (owned values, not borrows).
    var iterFrozenRoot: Option<string> = Option.None
    var needsIterFreeze = false
    match iterType.clone() {
        TypeKind.TVec(e) => {
            needsIterFreeze = true
        }
        TypeKind.TArray(e, s) => {
            needsIterFreeze = true
        }
        TypeKind.THashMap(k, v) => {
            needsIterFreeze = true
        }
        _ => {
        }
    }
    if needsIterFreeze {
        match accessPath(iterable) {
            Option.Some(p) => {
                freezeName(ck, p.root, p.fields)
                iterFrozenRoot = Option.Some(p.root)
            }
            Option.None => {
            }
        }
    }

    pushScope(ck)
    ck.loopDepth = ck.loopDepth + 1

    // Determine loop variable type based on collection type
    match iterType {
        TypeKind.TVec(elem) => {
            let elemRef = TypeKind.TRef(Heap(elem.clone()), false)
            match varName2 {
                Option.Some(name2) => {
                    declare(ck, varName.clone(), VarInfo {
                        ty: tyI64(), mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    }
                    )
                    declare(ck, name2.clone(), VarInfo {
                        ty: elemRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    }
                    )
                }
                Option.None => {
                    declare(ck, varName.clone(), VarInfo {
                        ty: elemRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    }
                    )
                }
            }
        }
        TypeKind.TString => {
            let byteType = tyU8()
            match varName2 {
                Option.Some(name2) => {
                    declare(ck, varName.clone(), VarInfo {
                        ty: tyI64(), mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    }
                    )
                    declare(ck, name2.clone(), VarInfo {
                        ty: byteType, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    }
                    )
                }
                Option.None => {
                    declare(ck, varName.clone(), VarInfo {
                        ty: byteType, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    }
                    )
                }
            }
        }
        TypeKind.THashMap(key, val) => {
            let keyRef = TypeKind.TRef(Heap(key.clone()), false)
            let valRef = TypeKind.TRef(Heap(val.clone()), false)
            declare(ck, varName.clone(), VarInfo {
                ty: keyRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
            }
            )
            match varName2 {
                Option.Some(name2) => {
                    declare(ck, name2.clone(), VarInfo {
                        ty: valRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    }
                    )
                }
                Option.None => {
                }
            }
        }
        TypeKind.TArray(elem, size) => {
            let elemRef = TypeKind.TRef(Heap(elem.clone()), false)
            match varName2 {
                Option.Some(name2) => {
                    declare(ck, varName.clone(), VarInfo {
                        ty: tyI64(), mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    }
                    )
                    declare(ck, name2.clone(), VarInfo {
                        ty: elemRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    }
                    )
                }
                Option.None => {
                    declare(ck, varName.clone(), VarInfo {
                        ty: elemRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    }
                    )
                }
            }
        }
        TypeKind.TStruct(sname) => {
            // Channel<T> is iterable — `for x in ch` drains via recv() until closed.
            var isChan = false
            var elemTy = tyUnknown()
            for ii in 0..ck.structInsts.len {
                if ck.structInsts[ii].mangled == sname && ck.structInsts[ii].base == "Channel" {
                    isChan = true
                    if ck.structInsts[ii].args.len > 0 {
                        elemTy = ck.structInsts[ii].args[0].clone()
                    }
                }
            }
            if isChan {
                declare(ck, varName.clone(), VarInfo {
                    ty: elemTy, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                }
                )
            } else {
                var iterElem: Option<TypeKind> = Option.None
                if ck.inherentImpls.contains(sname) {
                    let implD = ck.inherentImpls.get(sname)!
                    if implD.methods.contains("next") {
                        iterElem = unwrapableInner(ck, implD.methods.get("next")!.ret)
                    }
                }
                match iterElem {
                    Option.Some(t) => {
                        declare(ck, varName.clone(), VarInfo {
                            ty: t, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                        }
                        )
                    }
                    Option.None => {
                        error(ck, "cannot iterate over type '" + sname.clone() + "'", cloneSpan(span))
                    }
                }
            }
        }
        _ => {
            if !typeEq(iterType, tyUnknown()) {
                error(ck, "cannot iterate over type '" + typeName(iterType) + "'", cloneSpan(span))
            }
        }
    }

    for s in body {
        checkStmt(ck, *s, fnRetType)
    }

    ck.loopDepth = ck.loopDepth - 1
    popScope(ck)
    match iterFrozenRoot {
        Option.Some(r) => {
            unfreezeName(ck, r)
        }
        Option.None => {
        }
    }
}

// -- Top-level: check a function body --

// A reference tucked inside a return type's storage (Option<&[T]>, a Vec<&T>
// return, ...) outlives whatever freeze the call site took for the call
// itself — nothing marks the OUTER value as borrowed the way a bare `&T`
// return does. `outer` is the enum's source name for a nicer message
// ("...inside 'Option'" rather than the mangled "...inside 'Option_i64'").
fn errorIfNestedRefReturn(ck: &mut Checker, func: &Function, retType: &TypeKind) {
    match retType {
        TypeKind.TRef(inner, mutable) => {
            return
        }
        _ => {
        }
    }
    if !nestedRef(ck, retType) {
        return
    }
    var outer = typeName(retType)
    match retType {
        TypeKind.TEnum(name) => {
            if ck.enums.contains(name) {
                outer = ck.enums.get(name)!.baseName.clone()
            }
        }
        _ => {
        }
    }
    error(ck, "function '" + func.name.clone() + "': cannot return a reference stored inside '" + outer + "'", Option.None)
}

// A view-returning method (`&[T]`/`&string` receiver getter) may only hand
// back storage reachable from `self` — the call site freezes the receiver
// and nothing else, so a view into a method-local or another param would
// dangle the moment that storage goes away. AST-level walk (not through the
// type-checked expression path): only needs the raw shape of each `return`.
fn viewReturnRoot(e: &Expr): Option<string> {
    match e {
        Expr.Ident(name, sp) => {
            return Option.Some(name.clone())
        }
        Expr.FieldAccess(obj, field, sp) => {
            return viewReturnRoot(*obj)
        }
        Expr.IndexAccess(obj, idx, sp) => {
            return viewReturnRoot(*obj)
        }
        Expr.MethodCall(obj, method, args, sp) => {
            return viewReturnRoot(*obj)
        }
        _ => {
            return Option.None
        }
    }
}

// The field chain from `self` a return value points into (`self.a[0..n]` ->
// `["a"]`, `self.data` -> `["data"]`, bare `self` -> `[]`). None when the
// value isn't rooted at self at all — that's already an error, reported by
// checkViewReturnStmt separately, so provenance recording just declines.
fn viewFieldChain(e: &Expr): Option<Vec<string>> {
    match e {
        Expr.Ident(name, sp) => {
            if name == "self" {
                return Option.Some(Vec.new())
            }
            return Option.None
        }
        Expr.FieldAccess(obj, field, sp) => {
            match viewFieldChain(*obj) {
                Option.Some(fs) => {
                    var nf = fs.clone()
                    nf.push(field.clone())
                    return Option.Some(nf)
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        Expr.IndexAccess(obj, idx, sp) => {
            return viewFieldChain(*obj)
        }
        Expr.MethodCall(obj, method, args, sp) => {
            return viewFieldChain(*obj)
        }
        _ => {
            return Option.None
        }
    }
}

fn stringVecEq(a: &Vec<string>, b: &Vec<string>): bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

fn checkViewReturnStmt(ck: &mut Checker, s: &Stmt, chains: &mut Vec<Vec<string>>) {
    match s {
        Stmt.Return(v, sp) => {
            match v {
                Option.Some(e) => {
                    match viewReturnRoot(*e) {
                        Option.Some(root) => {
                            if root != "self" {
                                error(ck, "cannot return a view of '" + root.clone() + "'", cloneSpan(sp))
                            }
                        }
                        Option.None => {
                        }
                    }
                    match viewFieldChain(*e) {
                        Option.Some(chain) => {
                            chains.push(chain)
                        }
                        Option.None => {
                        }
                    }
                }
                Option.None => {
                }
            }
        }
        Stmt.IfStmt(cond, thenBody, elseBody, sp) => {
            for s2 in thenBody {
                checkViewReturnStmt(ck, *s2, chains)
            }
            match elseBody {
                Option.Some(eb) => {
                    for s2 in eb {
                        checkViewReturnStmt(ck, *s2, chains)
                    }
                }
                Option.None => {
                }
            }
        }
        Stmt.MatchStmt(subj, arms, sp) => {
            for a in arms {
                for s2 in a.body {
                    checkViewReturnStmt(ck, *s2, chains)
                }
            }
        }
        _ => {
        }
    }
}

fn checkViewReturnProvenance(ck: &mut Checker, func: &Function, retType: &TypeKind) {
    if !isViewReturnType(retType) {
        return
    }
    if func.params.len == 0 || func.params[0].name != "self" {
        return
    }
    var chains: Vec<Vec<string>> = Vec.new()
    for s in func.body {
        checkViewReturnStmt(ck, *s, chains)
    }
    // Record provenance only when every `return` agrees on the same field
    // chain — a fork whose arms return different fields has no single answer,
    // so the call site falls back to freezing the whole receiver (still sound,
    // just less precise).
    if chains.len > 0 {
        var allSame = true
        for i in 1..chains.len {
            if !stringVecEq(chains[0], chains[i]) {
                allSame = false
            }
        }
        if allSame {
            ck.viewReturnFields.insert(func.name.clone(), chains[0].clone())
        }
    }
}

pub fn checkFunction(ck: &mut Checker, func: &Function) {
    pushScope(ck)
    let retType = resolveAstType(ck, func.retType)
    ck.currentFnRetType = retType.clone()
    errorIfNestedRefReturn(ck, func, retType)

    // Declare parameters
    for param in func.params {
        let pType = resolveAstType(ck, param.ty)
        // a &mut param makes the pointee assignable through the ref
        var pMut = false
        match pType.clone() {
            TypeKind.TRef(inner, m) => {
                pMut = m
            }
            _ => {
            }
        }
        declare(ck, param.name.clone(), VarInfo {
            ty: pType,
            mutable: pMut,
            moved: false,
            borrowed: false,
            read: false,
            span: Option.None,
        }
        )
    }

    // Check body
    for s in func.body {
        checkStmt(ck, *s, retType)
    }

    popScope(ck)
}

// -- Top-level: register declarations and check program --

pub fn registerFunction(ck: &mut Checker, func: &Function) {
    var params: Vec<FnParam> = Vec.new()
    for param in func.params {
        params.push(FnParam {
            name: param.name.clone(),
            ty: resolveAstType(ck, param.ty),
        }
        )
    }
    let sig = FnSig {
        params: params,
        ret: resolveAstType(ck, func.retType),
        variadic: func.isVariadic,
        isExtern: func.isExtern,
    }
    ck.functions.insert(func.name.clone(), sig)
}

pub fn registerStruct(ck: &mut Checker, decl: &StructDecl) {
    var fields: Vec<CkStructField> = Vec.new()
    for field in decl.fields {
        let fty = resolveAstType(ck, field.ty)
        // References are second-class: they can only live in a param or a local
        // binding, never in storage that outlives the call that took the borrow.
        // A struct field is exactly that kind of storage, direct or nested
        // (Vec<&T> etc — see nestedRef). Checked against a clone: matching `fty`
        // itself would move its payload out of the TRef arm, leaving it unusable
        // below for the field record and the nestedRef fallback.
        var isDirectRef = false
        match fty.clone() {
            TypeKind.TRef(inner, mutable) => {
                isDirectRef = true
            }
            _ => {
            }
        }
        if isDirectRef {
            error(ck, "struct '" + decl.name.clone() + "' field '" + field.name.clone() + "': references cannot be stored in structs", Option.None)
        } else if nestedRef(ck, fty) {
            error(ck, "struct '" + decl.name.clone() + "' field '" + field.name.clone() + "': references cannot be stored in a collection", Option.None)
        }
        fields.push(CkStructField {
            name: field.name.clone(),
            ty: fty,
        }
        )
    }
    let info = StructInfo {
        fields: fields,
        baseName: decl.name.clone(),
        noCopy: hasAttr(decl.attributes, "noCopy"),
    }
    ck.structs.insert(decl.name.clone(), info)
}

pub fn registerEnum(ck: &mut Checker, decl: &EnumDecl) {
    var variants: HashMap<string, VariantInfo> = HashMap.new()
    var i: i64 = 0
    while i < decl.variants.len {
        var fields: Vec<TypeKind> = Vec.new()
        for vfield in decl.variants[i].fields {
            fields.push(resolveAstType(ck, vfield))
        }
        variants.insert(decl.variants[i].name.clone(), VariantInfo {
            tag: i as i32,
            fields: fields,
        }
        )
        i = i + 1
    }
    let info = EnumInfo {
        baseName: decl.name.clone(),
        variants: variants,
    }
    ck.enums.insert(decl.name.clone(), info)
}

// Option<T> and Result<T, E> are compiler builtins with no source declaration;
// synthesize generic EnumDecls so the normal mono machinery instantiates them.
pub fn registerBuiltinGenericEnums(ck: &mut Checker) {
    var someFields: Vec<MiloType> = Vec.new()
    someFields.push(simpleType("T"))
    var optVariants: Vec<EnumVariant> = Vec.new()
    optVariants.push(EnumVariant {
        name: "Some", fields: someFields, discriminant: Option.None
    }
    )
    optVariants.push(EnumVariant {
        name: "None", fields: Vec.new(), discriminant: Option.None
    }
    )
    var optParams: Vec<TypeParam> = Vec.new()
    optParams.push(TypeParam {
        name: "T", bounds: Vec.new()
    }
    )
    registerGenericEnum(ck, EnumDecl {
        name: "Option",
        typeParams: optParams,
        variants: optVariants,
        attributes: Vec.new(),
    }
    )

    var okFields: Vec<MiloType> = Vec.new()
    okFields.push(simpleType("T"))
    var errFields: Vec<MiloType> = Vec.new()
    errFields.push(simpleType("E"))
    var resVariants: Vec<EnumVariant> = Vec.new()
    resVariants.push(EnumVariant {
        name: "Ok", fields: okFields, discriminant: Option.None
    }
    )
    resVariants.push(EnumVariant {
        name: "Err", fields: errFields, discriminant: Option.None
    }
    )
    var resParams: Vec<TypeParam> = Vec.new()
    resParams.push(TypeParam {
        name: "T", bounds: Vec.new()
    }
    )
    resParams.push(TypeParam {
        name: "E", bounds: Vec.new()
    }
    )
    registerGenericEnum(ck, EnumDecl {
        name: "Result",
        typeParams: resParams,
        variants: resVariants,
        attributes: Vec.new(),
    }
    )
}

// Annotation-side generic instantiation: `Option<i32>` must resolve to the
// monomorphized enum/struct, not TStruct("Option").
pub fn resolveAstType(ck: &mut Checker, ty: &MiloType): TypeKind {
    // resolve a type alias name to its base (preserving any &/&mut/* wrapper)
    if !ty.isFn && ty.typeArgs.len == 0 && ck.typeAliases.contains(ty.name) {
        var base = ck.typeAliases.get(ty.name)!
        if ty.ptrDepth > 0 {
            var i: i32 = 0
            while i < ty.ptrDepth {
                base = TypeKind.TPtr(Heap(base))
                i = i + 1
            }
            return base
        }
        if ty.isRef {
            return TypeKind.TRef(Heap(base), false)
        }
        if ty.isRefMut {
            return TypeKind.TRef(Heap(base), true)
        }
        return base
    }
    if ty.typeArgs.len > 0 && !ty.isFn {
        var base = tyUnknown()
        var matched = false
        if ck.genericEnums.contains(ty.name) {
            var typeArgs: Vec<TypeKind> = Vec.new()
            for i in 0..ty.typeArgs.len {
                typeArgs.push(resolveAstType(ck, ty.typeArgs[i]))
            }
            base = TypeKind.TEnum(monomorphizeEnum(ck, ty.name, typeArgs))
            matched = true
        } else if ck.genericStructs.contains(ty.name) {
            var typeArgs: Vec<TypeKind> = Vec.new()
            for i in 0..ty.typeArgs.len {
                typeArgs.push(resolveAstType(ck, ty.typeArgs[i]))
            }
            base = TypeKind.TStruct(monomorphizeStruct(ck, ty.name, typeArgs))
            matched = true
        } else if ty.name == "Vec" && ty.typeArgs.len == 1 {
            base = TypeKind.TVec(Heap(resolveAstType(ck, ty.typeArgs[0])))
            matched = true
        } else if ty.name == "Heap" && ty.typeArgs.len == 1 {
            let hinner = resolveAstType(ck, ty.typeArgs[0])
            // Heap<Interface> collapses to the interface type (a trait object fat
            // pointer whose data ptr is heap-allocated).
            var isIface = false
            match hinner.clone() {
                TypeKind.TStruct(nm) => {
                    if ck.traits.contains(nm) {
                        isIface = true base = hinner.clone()
                    }
                }
                _ => {
                }
            }
            if !isIface {
                base = TypeKind.THeap(Heap(hinner))
            }
            matched = true
        } else if ty.name == "HashMap" && ty.typeArgs.len == 2 {
            base = TypeKind.THashMap(Heap(resolveAstType(ck, ty.typeArgs[0])), Heap(resolveAstType(ck, ty.typeArgs[1])))
            matched = true
        }
        if matched {
            // Preserve any &/&mut/* wrapper the annotation spelled — dropping it
            // made a `&mut Arena<T>` param non-mutable and un-derefable.
            if ty.isArray {
                base = TypeKind.TArray(Heap(base), ty.arraySize)
            }
            if ty.ptrDepth > 0 {
                var i: i32 = 0
                while i < ty.ptrDepth {
                    base = TypeKind.TPtr(Heap(base))
                    i = i + 1
                }
                return base
            }
            if ty.isRef {
                return TypeKind.TRef(Heap(base), false)
            }
            if ty.isRefMut {
                return TypeKind.TRef(Heap(base), true)
            }
            return base
        }
    }
    return normalizeEnumNames(ck, typeFromAst(ty))
}

pub fn checkProgram(ck: &mut Checker, program: &Program) {
    // Phase 0: register builtin traits and generic types
    registerBuiltinTraits(ck)
    registerBuiltinGenericEnums(ck)
    // type aliases (`type Altitude = i32(0..N)`) resolve to their base type
    for ai in 0..program.typeAliases.len {
        ck.typeAliases.insert(program.typeAliases[ai].name.clone(), typeFromAst(program.typeAliases[ai].base))
    }
    // Register user-declared traits/interfaces BEFORE structs/fns so a trait name used
    // as a type (`&Iface`, `Heap<Iface>` struct fields) resolves during registration.
    for ti in 0..program.traits.len {
        let td = program.traits[ti]
        var tmethods: HashMap<string, TraitMethodInfo> = HashMap.new()
        for mi in 0..td.methods.len {
            var mparams: Vec<FnParam> = Vec.new()
            for pi in 0..td.methods[mi].params.len {
                mparams.push(FnParam {
                    name: td.methods[mi].params[pi].name.clone(), ty: resolveAstType(ck, td.methods[mi].params[pi].ty)
                }
                )
            }
            var hasDef = false
            match td.methods[mi].body {
                Option.Some(b) => {
                    hasDef = true
                }
                Option.None => {
                }
            }
            tmethods.insert(td.methods[mi].name.clone(), TraitMethodInfo {
                params: mparams, ret: resolveAstType(ck, td.methods[mi].retType), hasDefault: hasDef
            }
            )
        }
        var stps: Vec<string> = Vec.new()
        for si in 0..td.supertraits.len {
            stps.push(td.supertraits[si].clone())
        }
        ck.traits.insert(td.name.clone(), TraitInfo {
            name: td.name.clone(), supertraits: stps, methods: tmethods
        }
        )
    }

    // Phase 1: register all declarations (generics park on ck.generic* until
    // a use site provides concrete type args). Register ALL generic structs/enums
    // FIRST, so a concrete struct/enum whose field references a generic defined
    // later (e.g. `arena: Arena<Node>`) resolves it to the monomorphized name
    // rather than the flattened base.
    var i: i64 = 0
    for s in program.structs {
        if s.typeParams.len > 0 {
            registerGenericStruct(ck, s)
        }
    }
    for e in program.enums {
        if e.typeParams.len > 0 {
            registerGenericEnum(ck, e)
        }
    }
    for s in program.structs {
        if s.typeParams.len == 0 {
            registerStruct(ck, s)
        }
    }
    for e in program.enums {
        if e.typeParams.len == 0 {
            registerEnum(ck, e)
        }
    }
    for f in program.functions {
        if f.typeParams.len > 0 {
            registerGenericFn(ck, f)
        } else {
            registerFunction(ck, f)
        }
    }

    // Phase 1.5: enum payloads and struct fields were converted before every
    // enum name was registered — normalize TStruct(enumName) → TEnum(enumName)
    // now that the full name set is known.
    var enumNames: Vec<string> = Vec.new()
    for en, ev in ck.enums {
        enumNames.push(en.clone())
    }
    for ei in 0..enumNames.len {
        var info = ck.enums.get(enumNames[ei])!
        var newVariants: HashMap<string, VariantInfo> = HashMap.new()
        for vn, vi in info.variants {
            var fields: Vec<TypeKind> = Vec.new()
            for fi in 0..vi.fields.len {
                fields.push(normalizeEnumNames(ck, vi.fields[fi]))
            }
            newVariants.insert(vn.clone(), VariantInfo {
                tag: vi.tag, fields: fields
            }
            )
        }
        info.variants = newVariants
        ck.enums.insert(enumNames[ei].clone(), info)
    }
    var structNames: Vec<string> = Vec.new()
    for sn, sv in ck.structs {
        structNames.push(sn.clone())
    }
    for si in 0..structNames.len {
        var sInfo = ck.structs.get(structNames[si])!
        var newFields: Vec<CkStructField> = Vec.new()
        for fi in 0..sInfo.fields.len {
            newFields.push(CkStructField {
                name: sInfo.fields[fi].name.clone(),
                ty: normalizeEnumNames(ck, sInfo.fields[fi].ty),
            }
            )
        }
        sInfo.fields = newFields
        ck.structs.insert(structNames[si].clone(), sInfo)
    }

    // Phase 2: register impls and derive macros
    registerAllImpls(ck, program)
    synthesizeDefaultMethods(ck, program)
    processDerives(ck, program)

    // Phase 2.5: record view-return provenance (which field a `&[T]`/`&string`
    // getter method reads off `self`) for every impl method BEFORE any body is
    // checked. A caller in Phase 3 (`t.items()` inside `main`) needs the
    // answer already on file — recording it lazily inside checkFunction only
    // helped a CALLER that happens to be checked later than its callee, which
    // free-function/impl-method ordering does not guarantee (mirrors the
    // oracle's recordViewProvenance pre-pass over implFnsToCheck).
    var vi: i64 = 0
    while vi < ck.monomorphizedFns.len {
        let vfn = ck.monomorphizedFns[vi].clone()
        let vRetType = resolveAstType(ck, vfn.retType)
        checkViewReturnProvenance(ck, vfn, vRetType)
        vi = vi + 1
    }

    // Register module-level globals in a persistent scope below every function
    // scope, so function bodies can reference them (e.g. `if key == KEY_QUIT`).
    pushScope(ck)
    for gi in 0..program.globals.len {
        var gty = tyUnknown()
        match program.globals[gi].ty {
            Option.Some(t) => {
                gty = resolveAstType(ck, t)
            }
            Option.None => {
                gty = checkExpr(ck, *program.globals[gi].value)
            }
        }
        declare(ck, program.globals[gi].name.clone(), VarInfo {
            ty: gty, mutable: program.globals[gi].mutable, moved: false, borrowed: false, read: true,
            span: cloneSpan(program.globals[gi].span),
        }
        )
    }

    // Phase 3: check function bodies
    i = 0
    while i < program.functions.len {
        if !program.functions[i].isExtern && program.functions[i].typeParams.len == 0 {
            checkFunction(ck, program.functions[i])
        }
        i = i + 1
    }

    // Phase 4: check monomorphized functions
    i = 0
    while i < ck.monomorphizedFns.len {
        let monoFn = ck.monomorphizedFns[i].clone()
        checkFunction(ck, monoFn)
        i = i + 1
    }
}
