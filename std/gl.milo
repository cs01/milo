pub let GL_TEXTURE_MIN_FILTER: u32 = 0x2801

pub let GL_TEXTURE_WRAP_S: u32 = 0x2802

pub let GL_TEXTURE_WRAP_T: u32 = 0x2803

pub let GL_REPEAT: u32 = 0x2901

pub let GL_RGBA8: i32 = 0x8058

pub let GL_TEXTURE0: u32 = 0x84C0

pub let GL_CLAMP_TO_EDGE: i32 = 0x812F

pub let GL_DEPTH_COMPONENT24: u32 = 0x81A6

pub let GL_R32F: i32 = 0x822E

pub let GL_RGBA32F: i32 = 0x8814

pub let GL_RGB32F: i32 = 0x8815

pub let GL_RGBA16F: i32 = 0x881A

pub let GL_RGB16F: i32 = 0x881B

pub let GL_ARRAY_BUFFER: u32 = 0x8892

pub let GL_ELEMENT_ARRAY_BUFFER: u32 = 0x8893

pub let GL_STREAM_DRAW: u32 = 0x88E0

pub let GL_STATIC_DRAW: u32 = 0x88E4

pub let GL_DYNAMIC_DRAW: u32 = 0x88E8

pub let GL_FRAGMENT_SHADER: u32 = 0x8B30

pub let GL_VERTEX_SHADER: u32 = 0x8B31

pub let GL_COMPILE_STATUS: u32 = 0x8B81

pub let GL_LINK_STATUS: u32 = 0x8B82

pub let GL_INFO_LOG_LENGTH: u32 = 0x8B84

pub let GL_FRAMEBUFFER_COMPLETE: u32 = 0x8CD5

pub let GL_COLOR_ATTACHMENT0: u32 = 0x8CE0

pub let GL_DEPTH_ATTACHMENT: u32 = 0x8D00

pub let GL_FRAMEBUFFER: u32 = 0x8D40

pub let GL_RENDERBUFFER: u32 = 0x8D41
