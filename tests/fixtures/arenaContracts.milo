// @expect: 1024
// @expect: true
// @expect: 1024

from "std/mem" import {
    Arena
}

pub fn main(): i32 {
    var arena = Arena.new(1024)!

    let remaining = arena.remaining()
    print(remaining)

    let ptr = arena.alloc(64)!
    print(ptr > 0)

    arena.reset()
    print(arena.remaining())

    return 0
}
