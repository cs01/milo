// Welding the string back while a window is still out is refused. A StrShard is a
// raw pointer into the owner's buffer, so returning the string leaves the caller
// free to mutate or drop it under a live window: reads make OVERLAP sound, they do
// not make a dangling read sound. That is why the check is a count plus a per-index
// seen set and not a coverage-of-bytes test: neighbouring windows share bytes on
// purpose, so only `index` can say a window came home.
// @expect: refused: count, weld: expected 4 windows, got 3
// @expect: recovered 4 windows over 40 bytes
// @expect: welded after recovery: milo..............milo..............milo
// @expect: overlap welded: matches=3 len=40
// @expect: reclaimed undivided: milo..............milo..............milo
from "std/shard" import {
    StrShard, WeldReason, shatterStr
}

// "milo" sits at 0, at 18 and at 36. With four windows the one at 18 straddles a
// seam, so only an overlapping window can see it.
fn corpus(): string {
    return "milo..............milo..............milo"
}

// Count only matches BEGINNING in this window's own range. The window carries that
// length, so the last window's uneven remainder is not something to re-derive here.
fn countIn(w: &StrShard, needle: &string): i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < w.ownLen() {
        if w.matchesAt(i, needle) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

pub fn main(): i32 {
    let needle: string = "milo"

    // 1. One window kept back. The refusal hands the owner and the other three
    //    windows straight back, so the fix is to return the missing one and weld
    //    again, not to reread the file.
    var owner = shatterStr(corpus(), 4)
    var windows = owner.windows(needle.len - 1)
    let held = windows.pop()!
    match owner.weld(windows) {
        Result.Ok(_s) => {
            print("WRONG: welded with a window still out")
        }
        Result.Err(rej) => {
            var kind = "other"
            match rej.reason {
                WeldReason.CountMismatch => {
                    kind = "count"
                }
                WeldReason.Foreign => {
                    kind = "foreign"
                }
                WeldReason.NotCovered => {
                    kind = "coverage"
                }
                WeldReason.NoWorkers => {
                    kind = "no workers"
                }
            }
            print("refused: " + kind + ", " + rej.message())
            var back = rej.returned
            var again = rej.shards
            back.push(held)
            print("recovered " + back.len.toString() + " windows over " + again.len().toString() + " bytes")
            print("welded after recovery: " + again.weld(back)!)
        }
    }

    // 2. Overlapping windows still weld. They are handed back in reverse order too,
    //    since the check is by index and not by position in the Vec.
    var over = shatterStr(corpus(), 4)
    var ow = over.windows(needle.len - 1)
    var returned: Vec<StrShard> = Vec.new()
    var matches: i64 = 0
    while ow.len > 0 {
        let w = ow.pop()!
        matches = matches + countIn(w, needle)
        returned.push(w)
    }
    let whole = over.weld(returned)!
    print("overlap welded: matches=" + matches.toString() + " len=" + whole.len.toString())

    // 3. An owner that never divided has no window to wait for, and `weld` would
    //    refuse an empty set on the count, so `reclaim` is its way home.
    var undivided = shatterStr(corpus(), 4)
    print("reclaimed undivided: " + undivided.reclaim()!)
    return 0
}
