// std/gllink — the one GL declaration whose link flag differs per platform.
//
// Splitting all 300 bindings to vary one flag would duplicate the file three times,
// so only `@link` lives here; std/gl carries every other entry point and no link of
// its own, because one flag on the link line resolves all of them.
//
// Every arm MUST declare the same surface — that is the platform-split contract.
// darwin: `-framework OpenGL`, not a `-l` name.

@link("framework:OpenGL")
pub extern fn glGetError(): u32
