// Sequential in-place transform over one Vec<f64>. The workload every version
// must accomplish: a[i] = a[i] * 1.0000001 + 0.5 for all i.
from "std/time" import {
    epochMillis
}

pub fn main(): i32 {
    let n: i64 = 20000000
    var a: Vec<f64> = Vec.filled(n, 1.0)

    let t0 = epochMillis()
    var i: i64 = 0
    while i < n {
        a[i] = a[i] * 1.0000001 + 0.5
        i = i + 1
    }
    let t1 = epochMillis()

    // checksum so the work can't be optimized away
    var sum: f64 = 0.0
    var j: i64 = 0
    while j < n {
        sum = sum + a[j]
        j = j + 1
    }
    print("seq ms=" + (t1 - t0).toString() + " sum=" + sum.toString())
    return 0
}
