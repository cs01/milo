// @proven: 1
// @failed: 0
// @unknown: 1
// Soundness: an obligation the translator cannot express must be REPORTED as unknown,
// never dropped. A missing VC is indistinguishable from a discharged one in the tally,
// which turns silence into a checkmark.
//
// Preservation used to `continue` when the post-iteration state wouldn't translate. This
// loop's `v[i]` is an IndexAccess with no rule, so the obligation vanished and the whole
// function came back "1 condition, proven: 1, unknown: 0" — a clean green for an invariant
// that is false on the very first iteration. `milo run` prints 7, not 0.
//
// Establishment had the identical bug on the other half (`if (!UNSUPPORTED) { push }`), so
// an invariant untranslatable at BOTH ends produced zero conditions and a silent pass over
// a loop nothing checked.
//
// Expected now: establishment proves (`total == 0` holds on entry, no index involved) and
// preservation reports unknown with the reason attached.
pub fn f(v: Vec<i64>): i64 {
    var total: i64 = 0
    var i: i64 = 0
    while i < v.len
    invariant
    total == 0
    {
        total = total + v[i]
        i = i + 1
    }
    return total
}

fn main() {
    var v: Vec<i64> = Vec.new()
    v.push(3)
    v.push(4)
    print(f(v))
}
