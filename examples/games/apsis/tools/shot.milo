// Renders game states to PNG files, with no window and no keyboard.
//
//   milo run examples/games/apsis/tools/shot.milo -- /tmp/shots
//
// The graphical build cannot be driven by a test: it takes keystrokes and a
// harness has none. This walks the same World through the same renderer and
// writes what it would have drawn, which is the only way to LOOK at a screen
// that is four keypresses deep without being a person with a keyboard.
//
// It exists because `std/png` gained an encoder; before that the only way to see
// a frame was to run the game and photograph the display.

from "std/strconv" import {
    formatFloat
}
from "std/png" import {
    Png
}
from "std/fs" import {
    writeFile, makeDir
}
from "std/args" import {
    args
}
from "../gfx" import {
    canvasNew, present, canvasSetFont
}
from "../glyphs" import {
    fontLoad
}
from "../gfx3d" import {
    sceneNew
}
from "../assets" import {
    loadBodyTextures
}
from "../ephem" import {
    SEC_PER_DAY
}
from "../world" import {
    World, worldNew, startMission, replan, commitPlan, doCapture, advanceWorld,
    snapToBest, updateCamera, advancePhase, PHASE_PLAY
}
from "../render" import {
    W, H, drawScene, drawHud, drawOutcome, drawBriefing
}

fn dump(c: &mut Canvas, dir: &string, name: &string) {
    present(c, 0.30, 1.0)
    var px = ""
    var i = 0
    while i < W * H {
        let v = c.fb[i]
        px.push((v & 255) as u8)
        px.push(((v >> 8) & 255) as u8)
        px.push(((v >> 16) & 255) as u8)
        i = i + 1
    }
    match Png.encode(px, W, H, 3) {
        Result.Ok(enc) => {
            let path = dir + "/" + name + ".png"
            match writeFile(path, enc) {
                Result.Ok(_) => {
                    print("wrote " + path)
                }
                Result.Err(_) => {
                    print("write failed: " + path)
                }
            }
        }
        Result.Err(e) => {
            print("encode failed: " + e)
        }
    }
}

pub fn main(): i32 {
    let argv = args()
    var dir = "/tmp/shots"
    if argv.len > 1 {
        dir = argv[1].clone()
    }
    let _ = makeDir(dir, 493)

    var c = canvasNew(W, H)
    canvasSetFont(c, fontLoad(@embedFile("../bodies/font.png")))
    var scene = sceneNew(W, H)
    let texes = loadBodyTextures()
    var w = worldNew()

    // 1. Title.
    updateCamera(w, 3.0)
    drawScene(c, scene, w, texes)
    drawHud(c, w)
    drawBriefing(c, w)
    dump(c, dir, "01-title")

    // 2. Briefing for mission 1.
    advancePhase(w)
    drawScene(c, scene, w, texes)
    drawHud(c, w)
    drawBriefing(c, w)
    dump(c, dir, "02-briefing")

    // 3. Play, mid opening tour (the pad shot).
    advancePhase(w)
    updateCamera(w, 2.2)
    drawScene(c, scene, w, texes)
    drawHud(c, w)
    dump(c, dir, "03-pad")

    // 4. Play, tour finished: the planning screen.
    updateCamera(w, 12.0)
    drawScene(c, scene, w, texes)
    drawHud(c, w)
    dump(c, dir, "04-planning")

    // 5. Committed and coasting, half way.
    snapToBest(w)
    replan(w)
    commitPlan(w)
    let half = (w.track.caTime - w.t) * 0.5
    w.warp = half
    advanceWorld(w, 1.0)
    updateCamera(w, 0.1)
    drawScene(c, scene, w, texes)
    drawHud(c, w)
    dump(c, dir, "05-coasting")

    // 6. At the capture burn.
    w.warp = (w.track.caTime - w.t) * 2.0
    advanceWorld(w, 1.0)
    updateCamera(w, 0.1)
    drawScene(c, scene, w, texes)
    drawHud(c, w)
    dump(c, dir, "06-arrival")

    // 7. Captured.
    doCapture(w)
    drawScene(c, scene, w, texes)
    drawHud(c, w)
    drawOutcome(c, w)
    dump(c, dir, "07-captured")

    // 8. A later mission's planning screen, for a long interplanetary transfer.
    startMission(w, 1)
    advancePhase(w)
    updateCamera(w, 12.0)
    snapToBest(w)
    drawScene(c, scene, w, texes)
    drawHud(c, w)
    dump(c, dir, "08-mars-planning")
    return 0
}
