// @expect: 127 * -128 = -128
// @expect: -128 * 127 = -128
// @expect: -128 * -128 = 127
// @expect: -2 * 100 = -128
// @expect: 2000000000 * -3 = -2147483648
// @expect: 3 * 4 = 12
// Signed multiply overflows in whichever direction the true product points. codegen
// clamped to MAX either way, behind a comment calling it "a simplification — true
// saturation would check sign". It is not a simplification: (-2i8).saturatingMul(100) is
// -200, saturates to -128, and the old code answered 127 — wrong bound and wrong sign.
//
// saturatingAdd and saturatingSub always got this right, which is part of why it survived:
// the family looked tested.
pub fn main(): i32 {
    let hi: i8 = 127
    let lo: i8 = -128
    print("127 * -128 = " + hi.saturatingMul(lo).toString())
    print("-128 * 127 = " + lo.saturatingMul(hi).toString())
    print("-128 * -128 = " + lo.saturatingMul(lo).toString())

    let neg: i8 = -2
    let pos: i8 = 100
    print("-2 * 100 = " + neg.saturatingMul(pos).toString())

    let big: i32 = 2000000000
    let m3: i32 = -3
    print("2000000000 * -3 = " + big.saturatingMul(m3).toString())

    // No overflow: the saturation path must not disturb an ordinary product.
    let a: i8 = 3
    let b: i8 = 4
    print("3 * 4 = " + a.saturatingMul(b).toString())
    return 0
}
