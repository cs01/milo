// @expect: epoch ok
// @expect: sleep ok
// @expect: 0
// @expect: micros ok

from "std/time" import {
    epochMillis, now, since, sleepMs
}

pub fn main(): i32 {
    let start = now()
    let epoch = epochMillis()
    if epoch > 1000000000000 {
        print("epoch ok")
    }

    sleepMs(50)
    let d = since(start)
    if d.toMillis() >= 40 {
        print("sleep ok")
    }

    print(d.toSecs().toString())

    if d.toMicros() >= 40000 {
        print("micros ok")
    }
    return 0
}
