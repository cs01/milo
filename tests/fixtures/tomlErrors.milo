// std/toml rejection cases. These live in tests/fixtures/ rather than
// tests/errors/ because a TOML parse failure is a `Result.Err` value, not a
// compile error — tests/errors/ only grades what the type checker rejects.
// Asserting the whole message also pins the line and column, which is the part
// most likely to rot silently.
//
// Every case here is also in tests/toml-corpus/invalid/, where
// scripts/toml-oracle.py confirms Python's tomllib rejects it too.
from "std/toml" import {
    Toml
}

fn reject(label: string, src: string) {
    match Toml.parse(src) {
        Result.Ok(_t) => {
            print(label + ": ACCEPTED (should have been rejected)")
        }
        Result.Err(msg) => {
            print(label + ": " + msg)
        }
    }
}

pub fn main(): i32 {
    reject("dup-key", "name = \"a\"\nname = \"b\"\n")
    reject("dup-key-dotted", "a.b = 1\na.b = 2\n")
    reject("dup-table", "[a]\nx = 1\n\n[a]\ny = 2\n")
    reject("table-over-value", "a = 1\n\n[a]\nb = 2\n")
    reject("dotted-then-header", "[fruit]\napple.color = \"red\"\n\n[fruit.apple]\n")
    reject("header-then-dotted", "[x.y]\np = 1\n\n[x]\ny.q = 2\n")
    reject("extend-inline", "a = { b = 1 }\na.c = 2\n")
    reject("aot-over-table", "[a]\nx = 1\n\n[[a]]\ny = 2\n")
    reject("table-over-aot", "[[a]]\nx = 1\n\n[a]\ny = 2\n")
    reject("bad-escape", "a = \"back\\slash\"\n")
    reject("surrogate", "a = \"\\uD800\"\n")
    reject("unterminated-basic", "a = \"no closing quote\n")
    reject("unterminated-literal", "a = 'no closing quote\n")
    reject("unterminated-multiline", "a = \"\"\"never ends\n")
    reject("unterminated-array", "a = [1, 2\n")
    reject("inline-newline", "a = {\n  b = 1\n}\n")
    reject("inline-trailing-comma", "a = { b = 1, }\n")
    reject("leading-zero", "a = 01\n")
    reject("signed-hex", "a = +0xff\n")
    reject("trailing-underscore", "a = 1_\n")
    reject("bad-date", "a = 2024-02-30\n")
    reject("bad-hour", "a = 24:00:00\n")
    reject("text-after-value", "a = 1 b = 2\n")
    reject("no-value", "a =\n")
    // Python's tomllib accepts this one because Python integers are arbitrary
    // precision; the spec says an implementation that cannot hold the value
    // losslessly must reject it, so this case is ours alone.
    reject("int-overflow", "a = 99999999999999999999999999\n")
    return 0
}
// @expect: dup-key: toml: duplicate key 'name' (line 2, column 1)
// @expect: dup-key-dotted: toml: duplicate key 'b' (line 2, column 1)
// @expect: dup-table: toml: table 'a' is defined twice (line 4, column 1)
// @expect: table-over-value: toml: cannot redefine 'a' as a table (line 3, column 1)
// @expect: dotted-then-header: toml: table 'apple' is defined twice (line 4, column 1)
// @expect: header-then-dotted: toml: cannot redefine table 'y' with a dotted key (line 5, column 1)
// @expect: extend-inline: toml: cannot extend inline table 'a' (line 2, column 1)
// @expect: aot-over-table: toml: cannot redefine 'a' as an array of tables (line 4, column 1)
// @expect: table-over-aot: toml: cannot redefine 'a' as a table (line 4, column 1)
// @expect: bad-escape: toml: invalid escape sequence (line 1, column 10)
// @expect: surrogate: toml: invalid unicode escape (line 1, column 6)
// @expect: unterminated-basic: toml: unterminated basic string (line 1, column 22)
// @expect: unterminated-literal: toml: unterminated literal string (line 1, column 22)
// @expect: unterminated-multiline: toml: unterminated multi-line string (line 2, column 1)
// @expect: unterminated-array: toml: expected ',' or ']' in array (line 2, column 1)
// @expect: inline-newline: toml: newline is not allowed in an inline table (line 1, column 6)
// @expect: inline-trailing-comma: toml: trailing comma is not allowed in an inline table (line 1, column 14)
// @expect: leading-zero: toml: leading zeros are not allowed (line 1, column 5)
// @expect: signed-hex: toml: sign is not allowed on a prefixed integer (line 1, column 5)
// @expect: trailing-underscore: toml: misplaced underscore in number (line 1, column 6)
// @expect: bad-date: toml: date out of range (line 1, column 5)
// @expect: bad-hour: toml: time out of range (line 1, column 13)
// @expect: text-after-value: toml: expected newline after value (line 1, column 7)
// @expect: no-value: toml: expected a value (line 1, column 4)
// @expect: int-overflow: toml: integer out of range for i64 (line 1, column 23)
