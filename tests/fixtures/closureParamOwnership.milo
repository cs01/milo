// @expect: local 3560200
// @expect: temp 2760200
// @expect: fold 110
// A by-value owned parameter belongs to the CALLEE. A plain `fn` has always done that —
// its parameter gets an alive flag and a guarded drop at scope exit, skipped if the body
// moved the value out. A CLOSURE did not: it stored the parameter and registered a local
// and stopped there.
//
// The caller does not cover it either. It MOVES the value in — zeroes the slot, clears the
// alive flag — and then frees nothing. So nobody freed it, and every call through a closure
// leaked its owned argument.
//
// The strings here are ~16 KB on purpose. At small sizes `leaks` finds the abandoned block
// reachable from a stale stack slot and reports nothing, which is why 548 leak-gated
// fixtures never caught this. At this size it is 200 leaks per 200 calls, so the fixture
// has to allocate big enough for the oracle to see the failure it exists to catch.
pub fn main(): i32 {
    let f = (a: string): i64 => (a + "x").len

    // an owned LOCAL moved into the call
    var local = 0
    var i = 0
    while i < 200 {
        let s = ("ab" + i.toString()).repeat(4000)
        local = local + f(s)
        i = i + 1
    }
    print("local " + local.toString())

    // an owned TEMPORARY built at the call site
    var temp = 0
    var j = 0
    while j < 200 {
        temp = temp + f(("z" + j.toString()).repeat(4000))
        j = j + 1
    }
    print("temp " + temp.toString())

    // fold chains the accumulator through the callback, which is how this first showed up
    let v: Vec<i64> = [1, 2, 3]
    var folded = 0
    var k = 0
    while k < 20 {
        folded = folded + v.fold("s" + k.toString(), (a: string, x: &i64): string => a + x.toString()).len
        k = k + 1
    }
    print("fold " + folded.toString())
    return 0
}
