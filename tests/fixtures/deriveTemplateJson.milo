// The dogfood case for user-defined derives: a complete, recursive JSON serializer written
// entirely in Milo, with no compiler change and no `src/derive-json.ts`.
//
// It works because dispatch does the type-directed part that a macro would otherwise have
// to do: the template body is uniform (`self.@name.toJ()`) and traits pick the right
// implementation per field. That is the same division of labour serde uses — the macro
// emits `self.field.serialize()` and the blanket impls carry the weight — and it is why the
// template language needs no conditionals and stays non-Turing-complete.
//
// **This used to stop at container fields.** `impl ToJ for Vec<T>` parsed and was never
// instantiated, so a `Vec<string>` field reported `Vec has no method 'toJ'`. Blanket impls
// on builtin containers close that (see tests/fixtures/blanketImpl.milo), and the `tags`
// and `nums` fields below are here to keep it closed.
// @expect: {"id":7,"name":"x","ok":true,"sub":{"n":3},"tags":["a","b"],"nums":[1,2]}

trait ToJ {
    fn toJ(self: &Self): string
}

impl ToJ for i64 {
    fn toJ(self: &Self): string {
        return $"{self}"
    }
}

impl ToJ for bool {
    fn toJ(self: &Self): string {
        if self {
            return "true"
        }
        return "false"
    }
}

impl ToJ for string {
    fn toJ(self: &Self): string {
        return $"\"{self}\""
    }
}

impl ToJ for Vec<T> {
    fn toJ(self: &Self): string {
        var out = "["
        var first = true
        for x in self {
            if !first {
                out.pushStr(",")
            }
            out.pushStr(x.toJ())
            first = false
        }
        return out + "]"
    }
}

derive ToJ {
    fn toJ(self: &Self): string {
        var out = "{"
        @fields {
            if @index > 0 {
                out.pushStr(",")
            }
            out.pushStr($"\"@name\":")
            out.pushStr(self.@name.toJ())
        }
        return out + "}"
    }
}

@derive(ToJ)
struct Inner {
    n: i64,
}

@derive(ToJ)
struct Outer {
    id: i64, name: string, ok: bool, sub: Inner, tags: Vec<string>, nums: Vec<i64>,
}

fn main() {
    var tags: Vec<string> = Vec.new()
    tags.push("a")
    tags.push("b")
    var nums: Vec<i64> = Vec.new()
    nums.push(1)
    nums.push(2)
    let o = Outer {
        id: 7, name: "x", ok: true, sub: Inner {
            n: 3
        }
        , tags: tags, nums: nums
    }
    print(o.toJ())
}
