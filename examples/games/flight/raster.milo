// The band-parallel half of the 3D pipeline: triangle setup, the recorded draw
// command, and the scanline loops that N OS threads run over disjoint rows.
//
// Why this file exists at all
// ───────────────────────────
// A scanline rasteriser is embarrassingly parallel: split the frame into
// horizontal bands, give each band its own rows of the colour and depth buffers,
// and no two threads ever touch the same pixel. The catch in Milo is that a
// second-class `&mut [f32]` cannot cross a thread boundary, and the runtime-`n`
// `splitMut` that would carve one buffer into `n` disjoint windows is still
// unbuilt (docs/roadmap.md — "Dynamic splitMut"). Literal-range windows ship
// today, but a literal range means a band count baked into the source, and the
// band count wants to be `cpuCount()`.
//
// So the split is made by hand, in the smallest possible amount of unsafe code:
// `Job` carries the buffers' base addresses as plain integers, and a worker
// re-derives a typed pointer from them. Everything ABOVE this file stays safe —
// the recording path (`gfx3d.triangleV`) is ordinary Milo — and the disjointness
// argument is confined to `bandRaster` and stated at its head. That is the shape
// a real `splitMut` should eventually make redundant, not a workaround pretending
// to be a design.

from "std/math" import {
    Math
}
from "std/sysinfo" import {
    cpuCount
}

// How many horizontal bands a frame is cut into, which is how many OS threads a
// fan-out uses: one per core, but never so many that a band is a sliver. Below
// ~48 rows the per-band fixed costs (a thread spawn, a walk of the band's bin)
// start to dominate the pixels the band actually owns. One means "run it inline
// on this thread" — the serial path, kept for A/B measurement and for machines
// that report a single core.
pub fn bandsFor(h: i64): i64 {
    var n = cpuCount()
    if n < 1 {
        n = 1
    }
    if n > 16 {
        n = 16
    }
    let byHeight = h / 48
    if n > byHeight {
        n = byHeight
    }
    if n < 1 {
        n = 1
    }
    return n
}

// ── textures ──────────────────────────────────────────────────────────────────
//
// Power-of-two RGB textures sampled with wrap, generated procedurally at startup
// — there is no asset pipeline here, and none is needed for surface detail.

pub struct Texture {
    w: i64,
    h: i64,
    mask: i64, // w-1, w is a power of two
    // Aerial drapes keep their texels as the sRGB bytes that came off the wire,
    // decoded through `lut` at sample time. As f32 triples a 2048-square drape is
    // 50 MB, and four places preloaded at startup came to 200 MB of imagery —
    // enough to get the process killed by the memory guard. The bytes are a
    // quarter of that and the LUT makes the conversion exact anyway.
    pxu: Vec<u8>,
    lut: Vec<f32>, // 256 entries, sRGB byte -> linear
    byteSrc: bool,
    // Mirrored-repeat addressing instead of wrap. The detail textures tile, so
    // wrap is right for them. An ortho drape is a photograph of a finite place,
    // and the world REFLECTS at the map edge (see world3d.foldIn) — so the
    // imagery has to reflect on exactly the same period or the picture and the
    // terrain under it disagree at every seam.
    mirror: bool,
    shift: i64, // log2(w), for the row stride
    px: Vec<f32>, // 3 floats per texel
}

pub fn texNew(size: i64, shift: i64): Texture {
    return Texture {
        w: size,
        h: size,
        mask: size - 1,
        pxu: Vec.new(),
        lut: Vec.new(),
        byteSrc: false,
        mirror: false,
        shift: shift,
        px: Vec.filled(size * size * 3, 0.0),
    }
}

pub fn texSet(t: &mut Texture, x: i64, y: i64, r: f64, g: f64, b: f64) {
    let i = ((y << t.shift) + x) * 3
    t.px[i] = r as f32
    t.px[i + 1] = g as f32
    t.px[i + 2] = b as f32
}

// A `Texture` flattened to plain integers so it can ride inside a draw command
// and be read from a worker thread. A `Texture` owns three `Vec`s; a worker
// cannot be handed a borrow of one, and cloning a 2048-square drape per band per
// frame is not a thing anybody would do. The addresses are stable for as long as
// the Texture lives, which is the whole run — the textures are built once at
// startup and never resized.
pub struct TexRef {
    px: i64, // *f32, or 0 when byteSrc
    pxu: i64, // *u8, or 0 when !byteSrc
    lut: i64, // *f32, 256 entries
    w: i64,
    h: i64,
    mask: i64,
    shift: i64,
    mirror: bool,
    byteSrc: bool,
}

pub fn texRefNone(): TexRef {
    return TexRef {
        px: 0, pxu: 0, lut: 0, w: 0, h: 0, mask: 0, shift: 0, mirror: false, byteSrc: false
    }
}

pub fn texRef(t: &Texture): TexRef {
    var px: i64 = 0
    var pxu: i64 = 0
    var lut: i64 = 0
    if t.px.len > 0 {
        px = t.px.ptr() as i64
    }
    if t.pxu.len > 0 {
        pxu = t.pxu.ptr() as i64
    }
    if t.lut.len > 0 {
        lut = t.lut.ptr() as i64
    }
    return TexRef {
        px: px,
        pxu: pxu,
        lut: lut,
        w: t.w,
        h: t.h,
        mask: t.mask,
        shift: t.shift,
        mirror: t.mirror,
        byteSrc: t.byteSrc,
    }
}

// ── vertices ──────────────────────────────────────────────────────────────────

// A vertex: position, texture coordinate, and its own light term. Passing these
// as 25 loose f64 parameters was a standing invitation to transpose two of them —
// which happened three times while this file was being written. A struct costs
// nothing at runtime (same registers, no indirection) and makes the mistake
// unrepresentable. A map keyed by name would also fix it, and would put a hash
// lookup in the innermost loop of the program.
pub struct Vtx {
    x: f64,
    y: f64,
    z: f64,
    u: f64,
    v: f64,
    light: f64,
    // Per-vertex tint, multiplied with the triangle's base colour. Terrain needs
    // this: with one colour per quad, any surface whose colour varies with height
    // or slope draws its own tile grid, because neighbouring quads snap to
    // different values along an edge they share.
    r: f64,
    g: f64,
    b: f64,
    // How much of the detail texture to apply, 0..1. Terrain and water share one
    // draw call per quad, and the ground grain painted over water is the single
    // loudest cue that a surface is NOT water — static speckle cannot be moving
    // liquid. Fading it out per vertex keeps the shoreline seamless, which a
    // per-quad "is this a water tile" choice could not.
    tw: f64,
}

pub fn vtx(x: f64, y: f64, z: f64, u: f64, v: f64, light: f64): Vtx {
    return Vtx {
        x: x, y: y, z: z, u: u, v: v, light: light, r: 1.0, g: 1.0, b: 1.0, tw: 1.0
    }
}

pub fn vtxC(x: f64, y: f64, z: f64, u: f64, v: f64, light: f64, r: f64, g: f64, b: f64, tw: f64): Vtx {
    return Vtx {
        x: x, y: y, z: z, u: u, v: v, light: light, r: r, g: g, b: b, tw: tw
    }
}

// ── triangle setup ────────────────────────────────────────────────────────────

// Depth-buffered flat-shaded triangle in CAMERA space. Depth-tests on 1/z, which
// interpolates linearly in screen space — the reason the buffer stores 1/z.
// The setup all the rasterisers share: project to screen, cull backfaces and
// degenerates, and clamp the bounding box to the viewport. It was copied out
// three times, which is where an asymmetric bug hides — a fix to one copy's
// clamp is a bug in the other two.
pub struct Tri {
    x0: f64,
    y0: f64,
    x1: f64,
    y1: f64,
    x2: f64,
    y2: f64,
    iaz: f64,
    ibz: f64,
    icz: f64,
    invArea: f64,
    // How each edge function changes for one pixel of x. The inner loop steps
    // by these instead of evaluating the edges: same values, three adds instead
    // of nine multiply-adds, on the order of a million pixels a frame.
    e0x: f64,
    e1x: f64,
    e2x: f64,
    minX: i64,
    maxX: i64,
    minY: i64,
    maxY: i64,
    ok: bool, // false: culled, off-screen or degenerate — draw nothing
}

// Setup takes the viewport as two integers rather than the Scene it used to read
// them off: setup runs on the recording thread but its result is consumed by a
// worker, and a struct full of Vecs is not something a worker can hold.
pub fn triSetup(w: i64, h: i64, scale: f64, ccx: f64, ccy: f64, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, dx: f64, dy: f64, dz: f64): Tri {
    let iaz = 1.0 / az
    let ibz = 1.0 / bz
    let icz = 1.0 / dz
    let x0 = ccx + ax * scale * iaz
    let y0 = ccy - ay * scale * iaz
    let x1 = ccx + bx * scale * ibz
    let y1 = ccy - by * scale * ibz
    let x2 = ccx + dx * scale * icz
    let y2 = ccy - dy * scale * icz
    var t = Tri {
        x0: x0, y0: y0, x1: x1, y1: y1, x2: x2, y2: y2,
        iaz: iaz, ibz: ibz, icz: icz,
        invArea: 0.0,
        e0x: 0.0 - (y2 - y1), e1x: 0.0 - (y0 - y2), e2x: 0.0 - (y1 - y0),
        minX: 0, maxX: 0, minY: 0, maxY: 0,
        ok: false,
    }
    // backface / degenerate cull via signed area
    let area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
    if area <= 0.0 {
        return t
    }
    t.invArea = 1.0 / area
    var minX = Math.floor(Math.minF64(x0, Math.minF64(x1, x2))) as i64
    var maxX = Math.ceil(Math.maxF64(x0, Math.maxF64(x1, x2))) as i64
    var minY = Math.floor(Math.minF64(y0, Math.minF64(y1, y2))) as i64
    var maxY = Math.ceil(Math.maxF64(y0, Math.maxF64(y1, y2))) as i64
    if minX < 0 {
        minX = 0
    }
    if minY < 0 {
        minY = 0
    }
    if maxX > w {
        maxX = w
    }
    if maxY > h {
        maxY = h
    }
    if minX >= maxX || minY >= maxY {
        return t
    }
    t.minX = minX
    t.maxX = maxX
    t.minY = minY
    t.maxY = maxY
    t.ok = true
    return t
}

// Edge function values at the first pixel of row `py`. Non-negative in all three
// means the pixel is inside.
fn rowEdge0(t: &Tri, fy: f64, fx: f64): f64 {
    return (t.x2 - t.x1) * (fy - t.y1) - (t.y2 - t.y1) * (fx - t.x1)
}

fn rowEdge1(t: &Tri, fy: f64, fx: f64): f64 {
    return (t.x0 - t.x2) * (fy - t.y2) - (t.y0 - t.y2) * (fx - t.x2)
}

fn rowEdge2(t: &Tri, fy: f64, fx: f64): f64 {
    return (t.x1 - t.x0) * (fy - t.y0) - (t.y1 - t.y0) * (fx - t.x0)
}

// ── the recorded draw command ─────────────────────────────────────────────────

// One near-clipped, set-up triangle, everything a worker needs and nothing it
// cannot hold. All plain data: no Vec, no string, no reference. That is what
// makes it legal to read out of a raw pointer on another thread.
//
// Vertex colour and vertex light are kept apart rather than pre-multiplied
// because the two raster paths combine them differently — the textured path
// interpolates them separately and multiplies per pixel, the Gouraud path
// multiplies per vertex and interpolates the product. Those are not the same
// number, and folding them here would have changed every shaded pixel in the
// frame for no reason anyone could see in a diff.
pub struct Cmd {
    t: Tri,
    // vertex tints
    ar: f64,
    ag: f64,
    ab: f64,
    br: f64,
    bg: f64,
    bb: f64,
    dr: f64,
    dg: f64,
    db: f64,
    // vertex light terms
    al: f64,
    bl: f64,
    dl: f64,
    // texture coordinates already divided by z — what interpolates linearly in
    // screen space. Unused by the Gouraud path.
    au: f64,
    av: f64,
    bu: f64,
    bv: f64,
    du: f64,
    dv: f64,
    // per-vertex detail-texture weight
    atw: f64,
    btw: f64,
    dtw: f64,
    // triangle tint
    tr: f64,
    tg: f64,
    tb: f64,
    tex: TexRef,
    textured: bool,
}

// Everything one worker needs for one flush. Passed by value into the thread
// body, which is why every field is a scalar: a closure that captures this can
// be moved onto an OS thread, and a closure that captured `&mut Canvas` could
// not exist at all.
pub struct Job {
    cmdBase: i64, // *Cmd — the shared command list, read-only to every worker
    binBase: i64, // *i64 — this band's indices into it
    binLen: i64,
    hdrBase: i64, // *f32 — the shared colour buffer, 3 floats per pixel
    zBase: i64, // *f32 — the shared depth buffer, 1/z per pixel
    w: i64,
    y0: i64, // this band owns rows [y0, y1)
    y1: i64,
    fogR: f64,
    fogG: f64,
    fogB: f64,
    fogStart: f64,
    fogEnd: f64,
}

// ── the band worker ───────────────────────────────────────────────────────────

// Rasterise every command binned to this band, clipped to the band's own rows.
//
// SAFETY — the whole argument, in one place:
//
//   * `cmdBase` is read and never written. Every worker reads the same commands.
//   * `hdrBase` and `zBase` are written only at `y*w+x` for `y0 <= y < y1`. The
//     caller (`gfx3d.rasterFlush`) partitions [0,h) into half-open bands that
//     tile it exactly, so two workers never name the same pixel. Every write in
//     this function is guarded by the `py` bounds computed below, and `px` is
//     clamped into [0,w) by `triSetup`.
//   * The caller awaits every worker before it touches either buffer again, so
//     there is no read-during-write either.
//   * All four buffers outlive the flush: they are fields of the Canvas and
//     Scene the caller is holding by `&mut` across the await.
//
// The one thing that would break it is a band range that overlaps another's.
// That is computed in exactly one place, `bandRows`, for exactly that reason.
pub fn bandRaster(job: Job): i64 {
    var painted: i64 = 0
    unsafe {
        let cmds = job.cmdBase as *Cmd
        let bin = job.binBase as *i64
        let hdr = job.hdrBase as *f32
        let zbuf = job.zBase as *f32
        var k: i64 = 0
        while k < job.binLen {
            let cmd = cmds[bin[k]]
            var lo = cmd.t.minY
            var hi = cmd.t.maxY
            if lo < job.y0 {
                lo = job.y0
            }
            if hi > job.y1 {
                hi = job.y1
            }
            if lo < hi {
                if cmd.textured {
                    bandTex(cmd, job, hdr, zbuf, lo, hi)
                } else {
                    bandFlat(cmd, job, hdr, zbuf, lo, hi)
                }
                painted = painted + 1
            }
            k = k + 1
        }
    }
    return painted
}

// Perspective-correct textured span. u/z, v/z and the light term interpolate
// linearly in screen space; dividing by the interpolated 1/z at each pixel
// recovers the true value. That division is what "perspective-correct" buys —
// interpolating u,v directly makes the texture slide as a surface tilts.
fn bandTex(cmd: &Cmd, job: &Job, hdr: *f32, zbuf: *f32, lo: i64, hi: i64) {
    let t = cmd.t
    let tex = cmd.tex
    let w = job.w
    let fogSpan = 1.0 / (job.fogEnd - job.fogStart)
    let fx0 = (t.minX as f64) + 0.5
    var py = lo
    while py < hi {
        let fy = (py as f64) + 0.5
        var w0 = rowEdge0(t, fy, fx0)
        var w1 = rowEdge1(t, fy, fx0)
        var w2 = rowEdge2(t, fy, fx0)
        var idx = py * w + t.minX
        var px = t.minX
        while px < t.maxX {
            if w0 >= 0.0 && w1 >= 0.0 && w2 >= 0.0 {
                let l0 = w0 * t.invArea
                let l1 = w1 * t.invArea
                let l2 = w2 * t.invArea
                let invZ = l0 * t.iaz + l1 * t.ibz + l2 * t.icz
                unsafe {
                    if (zbuf[idx] as f64) < invZ {
                        zbuf[idx] = invZ as f32
                        let zz = 1.0 / invZ
                        let uu = (l0 * cmd.au + l1 * cmd.bu + l2 * cmd.du) * zz
                        let vv = (l0 * cmd.av + l1 * cmd.bv + l2 * cmd.dv) * zz
                        // Smooth shading: the light term is per vertex and interpolated,
                        // so a curved surface stops looking like a stack of flat facets.
                        let sh = l0 * cmd.al + l1 * cmd.bl + l2 * cmd.dl
                        let vr = l0 * cmd.ar + l1 * cmd.br + l2 * cmd.dr
                        let vg = l0 * cmd.ag + l1 * cmd.bg + l2 * cmd.dg
                        let vb = l0 * cmd.ab + l1 * cmd.bb + l2 * cmd.db
                        var tx2 = 0
                        var ty2 = 0
                        if tex.mirror {
                            // Fold onto a 2w period, then reflect the upper half.
                            // Masking by 2w-1 is what makes this correct for
                            // negative world coordinates too, which is most of the
                            // map: two's complement gives the positive residue.
                            tx2 = ((uu * (tex.w as f64)) as i64) & (tex.w * 2 - 1)
                            ty2 = ((vv * (tex.h as f64)) as i64) & (tex.h * 2 - 1)
                            if tx2 >= tex.w {
                                tx2 = tex.w * 2 - 1 - tx2
                            }
                            if ty2 >= tex.h {
                                ty2 = tex.h * 2 - 1 - ty2
                            }
                        } else {
                            tx2 = ((uu * (tex.w as f64)) as i64) & tex.mask
                            ty2 = ((vv * (tex.h as f64)) as i64) & tex.mask
                            if tx2 < 0 {
                                tx2 = 0
                            }
                            if ty2 < 0 {
                                ty2 = 0
                            }
                        }
                        let ti = ((ty2 << tex.shift) + tx2) * 3
                        var tex0 = 0.0
                        var tex1 = 0.0
                        var tex2 = 0.0
                        if tex.byteSrc {
                            let src = tex.pxu as *u8
                            let lut = tex.lut as *f32
                            tex0 = lut[src[ti] as i64] as f64
                            tex1 = lut[src[ti + 1] as i64] as f64
                            tex2 = lut[src[ti + 2] as i64] as f64
                        } else {
                            let src = tex.px as *f32
                            tex0 = src[ti] as f64
                            tex1 = src[ti + 1] as f64
                            tex2 = src[ti + 2] as f64
                        }
                        // texel faded toward 1 (no-op) where tw is low
                        let tw = l0 * cmd.atw + l1 * cmd.btw + l2 * cmd.dtw
                        var f = (zz - job.fogStart) * fogSpan
                        if f < 0.0 {
                            f = 0.0
                        }
                        if f > 1.0 {
                            f = 1.0
                        }
                        let o = idx * 3
                        let rr = cmd.tr * vr * sh * (1.0 + (tex0 - 1.0) * tw)
                        let gg = cmd.tg * vg * sh * (1.0 + (tex1 - 1.0) * tw)
                        let bb = cmd.tb * vb * sh * (1.0 + (tex2 - 1.0) * tw)
                        hdr[o] = (rr * (1.0 - f) + job.fogR * f) as f32
                        hdr[o + 1] = (gg * (1.0 - f) + job.fogG * f) as f32
                        hdr[o + 2] = (bb * (1.0 - f) + job.fogB * f) as f32
                    }
                }
            }
            w0 = w0 + t.e0x
            w1 = w1 + t.e1x
            w2 = w2 + t.e2x
            idx = idx + 1
            px = px + 1
        }
        py = py + 1
    }
}

// Gouraud span: the same interpolation minus the texel fetch. Distant terrain is
// most of the triangle count and does not need a texture, but it does need the
// per-vertex colour — without it the far field is a checkerboard of flat quads.
// The untextured *flat* triangles go through here too, as the degenerate case
// where all three vertices carry the same colour and a light term of 1.
fn bandFlat(cmd: &Cmd, job: &Job, hdr: *f32, zbuf: *f32, lo: i64, hi: i64) {
    let t = cmd.t
    let w = job.w
    let fogSpan = 1.0 / (job.fogEnd - job.fogStart)
    // colour folded with the vertex light up front, so the inner loop is 3 lerps
    let ar = cmd.ar * cmd.al * cmd.tr
    let ag = cmd.ag * cmd.al * cmd.tg
    let ab = cmd.ab * cmd.al * cmd.tb
    let br = cmd.br * cmd.bl * cmd.tr
    let bg = cmd.bg * cmd.bl * cmd.tg
    let bb = cmd.bb * cmd.bl * cmd.tb
    let dr = cmd.dr * cmd.dl * cmd.tr
    let dg = cmd.dg * cmd.dl * cmd.tg
    let db = cmd.db * cmd.dl * cmd.tb

    let fx0 = (t.minX as f64) + 0.5
    var py = lo
    while py < hi {
        let fy = (py as f64) + 0.5
        var w0 = rowEdge0(t, fy, fx0)
        var w1 = rowEdge1(t, fy, fx0)
        var w2 = rowEdge2(t, fy, fx0)
        var idx = py * w + t.minX
        var px = t.minX
        while px < t.maxX {
            if w0 >= 0.0 && w1 >= 0.0 && w2 >= 0.0 {
                let l0 = w0 * t.invArea
                let l1 = w1 * t.invArea
                let l2 = w2 * t.invArea
                let invZ = l0 * t.iaz + l1 * t.ibz + l2 * t.icz
                unsafe {
                    if (zbuf[idx] as f64) < invZ {
                        zbuf[idx] = invZ as f32
                        let depth = 1.0 / invZ
                        var f = (depth - job.fogStart) * fogSpan
                        if f < 0.0 {
                            f = 0.0
                        }
                        if f > 1.0 {
                            f = 1.0
                        }
                        let rr = l0 * ar + l1 * br + l2 * dr
                        let gg = l0 * ag + l1 * bg + l2 * dg
                        let bbv = l0 * ab + l1 * bb + l2 * db
                        let o = idx * 3
                        hdr[o] = (rr * (1.0 - f) + job.fogR * f) as f32
                        hdr[o + 1] = (gg * (1.0 - f) + job.fogG * f) as f32
                        hdr[o + 2] = (bbv * (1.0 - f) + job.fogB * f) as f32
                    }
                }
            }
            w0 = w0 + t.e0x
            w1 = w1 + t.e1x
            w2 = w2 + t.e2x
            idx = idx + 1
            px = px + 1
        }
        py = py + 1
    }
}
