// Drawing the flight world: sky, terrain, coins, the aircraft, and the HUD.

from "std/math" import {
    Math
}
from "./gfx" import {
    Canvas, fillRect, spot, line, text, textCentered, textWidth
}
from "./gfx3d" import {
    Scene, View, Camera, viewOf, sceneClear, triangle, shade, toCamera
}
from "./world3d" import {
    World, heightAt, TILE, VIEW_TILES
}

// Sky gradient plus a sun disc, painted before anything else. There is no depth
// test here — the terrain simply draws over it.
fn drawSky(c: &mut Canvas, s: &Scene, w: &World, v: &View) {
    for y in 0..c.h {
        let t = (y as f64) / (c.h as f64)
        let k = 1.0 - t
        let r = 0.10 + 0.34 * k * k + s.fogR * t * 0.55
        let g = 0.22 + 0.36 * k * k + s.fogG * t * 0.55
        let b = 0.52 + 0.34 * k * k + s.fogB * t * 0.40
        fillRect(c, 0.0, y as f64, c.w as f64, (y + 1) as f64, r * 0.42, g * 0.42, b * 0.45)
    }
    // sun projected from its direction, so it sits correctly as you turn
    let far = 6000.0
    let sp = toCamera(v, w.cam.x + s.sunX * far, w.cam.y + s.sunY * far, w.cam.z + s.sunZ * far)
    if sp.z > 1.0 {
        let sx = v.cx + sp.x * v.scale / sp.z
        let sy = v.cy - sp.y * v.scale / sp.z
        spot(c, sx, sy, 190.0, 0.16, 0.13, 0.07)
        spot(c, sx, sy, 62.0, 0.9, 0.78, 0.42)
        spot(c, sx, sy, 30.0, 1.9, 1.7, 1.2)
    }
}

pub fn themeName(t: i64): string {
    if t == 0 {
        return "COASTLINE"
    }
    if t == 1 {
        return "DESERT"
    }
    if t == 2 {
        return "FOREST"
    }
    return "CITY"
}

// Sky and fog per theme, so a new stretch of country reads instantly.
pub fn themeSky(s: &mut Scene, t: i64) {
    if t == 1 {
        s.fogR = 0.60
        s.fogG = 0.46
        s.fogB = 0.30
        s.sunX = 0.30
        s.sunY = 0.90
        s.sunZ = 0.30
    } else if t == 2 {
        s.fogR = 0.26
        s.fogG = 0.38
        s.fogB = 0.40
        s.sunX = 0.50
        s.sunY = 0.72
        s.sunZ = 0.48
    } else if t == 3 {
        s.fogR = 0.38
        s.fogG = 0.40
        s.fogB = 0.46
        s.sunX = 0.40
        s.sunY = 0.84
        s.sunZ = 0.36
    } else {
        s.fogR = 0.30
        s.fogG = 0.42
        s.fogB = 0.62
        s.sunX = 0.44
        s.sunY = 0.78
        s.sunZ = 0.44
    }
}

fn terrainColor(h: f64, slope: f64): Vec<f64> {
    var v: Vec<f64> = Vec.new()
    // water, sand, grass, rock, snow by height, with rock taking over on slopes
    if h < 0.0 {
        v.push(0.06)
        v.push(0.26)
        v.push(0.46)
        return v
    }
    if h < 16.0 {
        v.push(0.62)
        v.push(0.55)
        v.push(0.34)
        return v
    }
    if h > 168.0 {
        v.push(0.82)
        v.push(0.86)
        v.push(0.92)
        return v
    }
    if slope > 0.62 || h > 130.0 {
        v.push(0.34)
        v.push(0.31)
        v.push(0.30)
        return v
    }
    v.push(0.16)
    v.push(0.36)
    v.push(0.14)
    return v
}

// How many tiles are on the perimeter of ring `r` (ring 0 is the single centre).
fn ringCount(r: i64): i64 {
    if r == 0 {
        return 1
    }
    return 8 * r
}

// The `i`th tile offset around ring `r`, walking the square perimeter.
fn ringOffset(r: i64, i: i64): Vec<i64> {
    var v: Vec<i64> = Vec.new()
    if r == 0 {
        v.push(0)
        v.push(0)
        return v
    }
    let side = 2 * r
    let seg = i / side
    let k = i % side
    if seg == 0 {
        v.push(0 - r + k)
        v.push(0 - r)
    } else if seg == 1 {
        v.push(r)
        v.push(0 - r + k)
    } else if seg == 2 {
        v.push(r - k)
        v.push(r)
    } else {
        v.push(0 - r)
        v.push(r - k)
    }
    return v
}

fn themedColor(theme: i64, h: f64, slope: f64): Vec<f64> {
    var v: Vec<f64> = Vec.new()
    if h < 0.0 {
        // water everywhere except the city, which gets tarmac
        if theme == 3 {
            v.push(0.16)
            v.push(0.16)
            v.push(0.18)
        } else {
            v.push(0.06)
            v.push(0.26)
            v.push(0.46)
        }
        return v
    }
    if theme == 1 {
        // desert: sand, dune shadow, red rock
        if slope > 0.55 {
            v.push(0.46)
            v.push(0.24)
            v.push(0.14)
        } else {
            v.push(0.72)
            v.push(0.58)
            v.push(0.32)
        }
        return v
    }
    if theme == 2 {
        // forest: deep greens, rock on the steep parts, no snow
        if slope > 0.60 {
            v.push(0.26)
            v.push(0.24)
            v.push(0.22)
        } else if h > 150.0 {
            v.push(0.16)
            v.push(0.30)
            v.push(0.16)
        } else {
            v.push(0.09)
            v.push(0.26)
            v.push(0.10)
        }
        return v
    }
    if theme == 3 {
        // city: concrete, grey-green parks
        if slope > 0.5 {
            v.push(0.24)
            v.push(0.24)
            v.push(0.26)
        } else if h > 90.0 {
            v.push(0.34)
            v.push(0.34)
            v.push(0.36)
        } else {
            v.push(0.22)
            v.push(0.26)
            v.push(0.22)
        }
        return v
    }
    return terrainColor(h, slope)
}

pub fn drawWorld(c: &mut Canvas, s: &mut Scene, w: &World) {
    themeSky(s, w.theme)
    let v = viewOf(w.cam, c.w, c.h)
    sceneClear(s)
    drawSky(c, s, w, v)

    // Walk a grid of quads centred on the aircraft. Anything behind the camera is
    // rejected before any per-vertex work.
    let baseX = Math.floor(w.cam.x / TILE) as i64
    let baseZ = Math.floor(w.cam.z / TILE) as i64
    let fwdX = Math.sin(w.cam.yaw)
    let fwdZ = Math.cos(w.cam.yaw)

    // Front to back, in rings out from the camera tile. The z-buffer then rejects
    // hidden pixels with a single compare instead of shading them — near terrain
    // covers the screen several times over, so this is most of the frame budget.
    for ring in 0..VIEW_TILES {
        for step in 0..ringCount(ring) {
            let off = ringOffset(ring, step)
            let tx = baseX + off[0]
            let tz = baseZ + off[1]
            let x0 = (tx as f64) * TILE
            let z0 = (tz as f64) * TILE
            let x1 = x0 + TILE
            let z1 = z0 + TILE
            // cheap frustum reject: quad centre must be in front of the camera
            let mx = x0 + TILE * 0.5 - w.cam.x
            let mz = z0 + TILE * 0.5 - w.cam.z
            if mx * fwdX + mz * fwdZ < 0.0 - TILE {
                continue
            }
            let d2 = mx * mx + mz * mz
            let reach = (VIEW_TILES as f64) * TILE
            if d2 > reach * reach {
                continue
            }

            let h00 = heightAt(x0, z0)
            let h10 = heightAt(x1, z0)
            let h01 = heightAt(x0, z1)
            let h11 = heightAt(x1, z1)

            // face normal from the diagonal, good enough for flat shading
            let nx = (h00 - h10) * TILE
            let nz = (h00 - h01) * TILE
            let ny = TILE * TILE
            let nl = Math.sqrt(nx * nx + ny * ny + nz * nz)
            let ux = nx / nl
            let uy = ny / nl
            let uz = nz / nl
            let slope = 1.0 - uy
            let hAvg = (h00 + h10 + h01 + h11) * 0.25
            let col = themedColor(w.theme, hAvg, slope)
            let lit = shade(s, ux, uy, uz, 0.34)
            // a little banding by height so ridges read
            let band = 0.94 + 0.12 * Math.sin(hAvg * 0.09)
            let r = col[0] * lit * band
            let g = col[1] * lit * band
            let b = col[2] * lit * band

            triangle(c, s, v, x0, h00, z0, x0, h01, z1, x1, h10, z0, r, g, b)
            triangle(c, s, v, x1, h10, z0, x0, h01, z1, x1, h11, z1, r, g, b)
        }
    }

    drawProps(c, s, w, v, baseX, baseZ)
    drawRings(c, s, w, v)
    drawPlane(c, s, w, v)
    drawSparks(c, s, w, v)
}

// Ground detail. Each terrain tile near the aircraft may carry one prop, placed
// and sized from a stable hash so the scenery does not crawl as you fly. The kind
// follows the theme: palms on the coast, cactus in the desert, conifers in the
// forest, towers in the city.
fn propHash(x: i64, z: i64): f64 {
    let v = Math.sin((x as f64) * 271.9 + (z as f64) * 133.7) * 27183.1234
    return v - Math.floor(v)
}

fn box3(c: &mut Canvas, s: &mut Scene, v: &View, cx: f64, y0: f64, y1: f64, cz: f64, hw: f64, r: f64, g: f64, b: f64) {
    let x0 = cx - hw
    let x1 = cx + hw
    let z0 = cz - hw
    let z1 = cz + hw
    // four walls, brighter on the sunward pair, plus a cap
    triangle(c, s, v, x0, y0, z0, x0, y1, z0, x1, y1, z0, r, g, b)
    triangle(c, s, v, x0, y0, z0, x1, y1, z0, x1, y0, z0, r, g, b)
    triangle(c, s, v, x1, y0, z1, x1, y1, z1, x0, y1, z1, r * 0.7, g * 0.7, b * 0.7)
    triangle(c, s, v, x1, y0, z1, x0, y1, z1, x0, y0, z1, r * 0.7, g * 0.7, b * 0.7)
    triangle(c, s, v, x1, y0, z0, x1, y1, z0, x1, y1, z1, r * 0.85, g * 0.85, b * 0.85)
    triangle(c, s, v, x1, y0, z0, x1, y1, z1, x1, y0, z1, r * 0.85, g * 0.85, b * 0.85)
    triangle(c, s, v, x0, y0, z1, x0, y1, z1, x0, y1, z0, r * 0.55, g * 0.55, b * 0.55)
    triangle(c, s, v, x0, y0, z1, x0, y1, z0, x0, y0, z0, r * 0.55, g * 0.55, b * 0.55)
    triangle(c, s, v, x0, y1, z0, x0, y1, z1, x1, y1, z1, r * 1.15, g * 1.15, b * 1.15)
    triangle(c, s, v, x0, y1, z0, x1, y1, z1, x1, y1, z0, r * 1.15, g * 1.15, b * 1.15)
}

fn cone3(c: &mut Canvas, s: &mut Scene, v: &View, cx: f64, y0: f64, y1: f64, cz: f64, rad: f64, r: f64, g: f64, b: f64) {
    let segs = 6
    let step = 6.283185307179586 / (segs as f64)
    for k in 0..segs {
        let a0 = (k as f64) * step
        let a1 = ((k + 1) as f64) * step
        let p0x = cx + Math.cos(a0) * rad
        let p0z = cz + Math.sin(a0) * rad
        let p1x = cx + Math.cos(a1) * rad
        let p1z = cz + Math.sin(a1) * rad
        let sh = 0.65 + 0.35 * Math.cos(a0)
        triangle(c, s, v, p0x, y0, p0z, cx, y1, cz, p1x, y0, p1z, r * sh, g * sh, b * sh)
        triangle(c, s, v, p1x, y0, p1z, cx, y1, cz, p0x, y0, p0z, r * sh * 0.7, g * sh * 0.7, b * sh * 0.7)
    }
}

pub let PROP_TILES: i64 = 9

fn drawProps(c: &mut Canvas, s: &mut Scene, w: &World, v: &View, baseX: i64, baseZ: i64) {
    for gz in 0 - PROP_TILES..PROP_TILES {
        for gx in 0 - PROP_TILES..PROP_TILES {
            let tx = baseX + gx
            let tz = baseZ + gz
            let h = propHash(tx, tz)
            if h > 0.30 {
                continue // most tiles are empty
            }
            let jx = propHash(tx + 7919, tz) - 0.5
            let jz = propHash(tx, tz + 6271) - 0.5
            let x = (tx as f64) * TILE + TILE * (0.5 + jx * 0.7)
            let z = (tz as f64) * TILE + TILE * (0.5 + jz * 0.7)
            let g0 = heightAt(x, z)
            if g0 < 4.0 {
                continue // nothing grows in the water
            }
            let scale = 0.7 + h * 3.0
            if w.theme == 1 {
                // cactus: a trunk and one arm
                box3(c, s, v, x, g0, g0 + 16.0 * scale, z, 2.2, 0.16, 0.34, 0.14)
                box3(c, s, v, x + 3.0, g0 + 7.0 * scale, g0 + 13.0 * scale, z, 1.4, 0.14, 0.30, 0.12)
            } else if w.theme == 2 {
                // conifer
                box3(c, s, v, x, g0, g0 + 7.0 * scale, z, 1.4, 0.20, 0.12, 0.06)
                cone3(c, s, v, x, g0 + 5.0 * scale, g0 + 30.0 * scale, z, 7.0 * scale, 0.07, 0.26, 0.10)
            } else if w.theme == 3 {
                // tower block, height keyed off the same hash so a district varies
                let tall = 22.0 + propHash(tz, tx) * 90.0
                box3(c, s, v, x, g0, g0 + tall, z, 6.0 + h * 12.0, 0.30, 0.31, 0.34)
            } else {
                // palm: bare trunk, splayed fronds
                box3(c, s, v, x, g0, g0 + 15.0 * scale, z, 1.2, 0.26, 0.18, 0.09)
                cone3(c, s, v, x, g0 + 20.0 * scale, g0 + 13.0 * scale, z, 9.0 * scale, 0.10, 0.32, 0.12)
            }
        }
    }
}

// A ring: a tube of quads swept around a circle, standing across the course so
// you can see which way to be pointing when you reach it. Cleared rings expand
// and fade instead of vanishing.
fn drawRings(c: &mut Canvas, s: &mut Scene, w: &World, v: &View) {
    let segs = 14
    let tube = 5.0
    for i in 0..w.rings.len {
        var rad = w.rings[i].r
        var br = 1.0
        var cr = 1.5
        var cg = 1.15
        var cb = 0.25
        if !w.rings[i].alive {
            rad = w.rings[i].r * (1.0 + (1.0 - w.rings[i].pop) * 1.2)
            br = w.rings[i].pop
            cr = 0.5
            cg = 1.7
            cb = 0.7
            if br <= 0.03 {
                continue
            }
        }
        let cx = w.rings[i].x
        let cy = w.rings[i].y
        let cz = w.rings[i].z
        // ring plane: normal along `face`, so the hoop stands across the course
        let nx = Math.sin(w.rings[i].face)
        let nz = Math.cos(w.rings[i].face)
        let tx = nz
        let tz = 0.0 - nx
        let step = 6.283185307179586 / (segs as f64)
        for k in 0..segs {
            let a0 = (k as f64) * step
            let a1 = ((k + 1) as f64) * step
            let c0 = Math.cos(a0)
            let s0 = Math.sin(a0)
            let c1 = Math.cos(a1)
            let s1 = Math.sin(a1)
            // inner and outer edge of the tube at both ends of this segment
            let o0x = cx + tx * c0 * (rad + tube)
            let o0y = cy + s0 * (rad + tube)
            let o0z = cz + tz * c0 * (rad + tube)
            let i0x = cx + tx * c0 * (rad - tube)
            let i0y = cy + s0 * (rad - tube)
            let i0z = cz + tz * c0 * (rad - tube)
            let o1x = cx + tx * c1 * (rad + tube)
            let o1y = cy + s1 * (rad + tube)
            let o1z = cz + tz * c1 * (rad + tube)
            let i1x = cx + tx * c1 * (rad - tube)
            let i1y = cy + s1 * (rad - tube)
            let i1z = cz + tz * c1 * (rad - tube)
            // banded colour so the hoop reads as a solid object, not a circle
            var band = 1.0
            if k % 2 == 0 {
                band = 0.72
            }
            let r = cr * band * br
            let g = cg * band * br
            let b = cb * band * br
            // both faces, so the ring is solid from either side
            triangle(c, s, v, o0x, o0y, o0z, o1x, o1y, o1z, i0x, i0y, i0z, r, g, b)
            triangle(c, s, v, i0x, i0y, i0z, o1x, o1y, o1z, i1x, i1y, i1z, r, g, b)
            triangle(c, s, v, o1x, o1y, o1z, o0x, o0y, o0z, i0x, i0y, i0z, r * 0.6, g * 0.6, b * 0.6)
            triangle(c, s, v, o1x, o1y, o1z, i0x, i0y, i0z, i1x, i1y, i1z, r * 0.6, g * 0.6, b * 0.6)
        }
    }
}

// Sparks are camera-facing quads, so they stay visible whatever angle you clear
// the ring at.
fn drawSparks(c: &mut Canvas, _s: &mut Scene, w: &World, v: &View) {
    for i in 0..w.sparks.len {
        let p = toCamera(v, w.sparks[i].x, w.sparks[i].y, w.sparks[i].z)
        if p.z < 1.0 {
            continue
        }
        let sx = v.cx + p.x * v.scale / p.z
        let sy = v.cy - p.y * v.scale / p.z
        let t = w.sparks[i].life / w.sparks[i].maxLife
        let size = Math.clampF64(v.scale * 1.6 / p.z, 1.2, 14.0) * (0.4 + t)
        let f = t * t
        spot(c, sx, sy, size, w.sparks[i].cr * f, w.sparks[i].cg * f, w.sparks[i].cb * f)
    }
}

// The aircraft. Body-space points are given as (forward, right, up) offsets and
// transformed once, so the shape is easy to read and to change.
fn drawPlane(c: &mut Canvas, s: &mut Scene, w: &World, v: &View) {
    let yaw = w.plane.yaw
    let pitch = w.plane.pitch
    let roll = w.plane.roll
    let cy = Math.cos(yaw)
    let sy = Math.sin(yaw)
    let cp = Math.cos(pitch)
    let sp = Math.sin(pitch)
    let cr = Math.cos(roll)
    let sr = Math.sin(roll)
    let fx = sy * cp
    let fy = sp
    let fz = cy * cp
    let rx = cy * cr
    let ry = 0.0 - sr
    let rz = 0.0 - sy * cr
    let ux = fy * rz - fz * ry
    let uy = fz * rx - fx * rz
    let uz = fx * ry - fy * rx

    var px: Vec<f64> = Vec.new()
    var py: Vec<f64> = Vec.new()
    var pz: Vec<f64> = Vec.new()
    // nose, cockpit, mid, tail, wing roots and tips, tailplane, fin
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 24.0, 0.0, 0.0) // 0 nose
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 8.0, 0.0, 4.0) // 1 canopy top
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 6.0, 4.0, 0.0) // 2 mid right
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 6.0, 0.0 - 4.0, 0.0) // 3 mid left
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 8.0, 0.0, 0.0 - 3.0) // 4 belly
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 16.0, 0.0, 0.0) // 5 tail
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 4.0, 22.0, 0.0) // 6 right tip
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 4.0, 0.0 - 22.0, 0.0) // 7 left tip
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 14.0, 10.0, 1.0) // 8 right tailplane
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 14.0, 0.0 - 10.0, 1.0) // 9 left tailplane
    addPt(px, py, pz, w, fx, fy, fz, rx, ry, rz, ux, uy, uz, 0.0 - 15.0, 0.0, 11.0) // 10 fin top

    // fuselage: top and bottom shells, both windings so it is solid from any angle
    tri(c, s, v, px, py, pz, 0, 2, 1, 0.90, 0.92, 0.96)
    tri(c, s, v, px, py, pz, 0, 1, 3, 0.82, 0.84, 0.90)
    tri(c, s, v, px, py, pz, 1, 2, 5, 0.74, 0.76, 0.84)
    tri(c, s, v, px, py, pz, 1, 5, 3, 0.68, 0.70, 0.78)
    tri(c, s, v, px, py, pz, 0, 4, 2, 0.56, 0.58, 0.64)
    tri(c, s, v, px, py, pz, 0, 3, 4, 0.52, 0.54, 0.60)
    tri(c, s, v, px, py, pz, 4, 5, 2, 0.48, 0.50, 0.56)
    tri(c, s, v, px, py, pz, 4, 3, 5, 0.46, 0.48, 0.54)
    // swept wings, drawn from both sides
    tri(c, s, v, px, py, pz, 2, 6, 5, 0.86, 0.88, 0.93)
    tri(c, s, v, px, py, pz, 2, 5, 6, 0.60, 0.62, 0.70)
    tri(c, s, v, px, py, pz, 3, 5, 7, 0.86, 0.88, 0.93)
    tri(c, s, v, px, py, pz, 3, 7, 5, 0.60, 0.62, 0.70)
    // tailplane
    tri(c, s, v, px, py, pz, 5, 8, 9, 0.78, 0.80, 0.86)
    tri(c, s, v, px, py, pz, 5, 9, 8, 0.58, 0.60, 0.66)
    // fin, in the accent colour
    tri(c, s, v, px, py, pz, 5, 10, 0, 1.10, 0.42, 0.22)
    tri(c, s, v, px, py, pz, 5, 0, 10, 0.85, 0.32, 0.18)
    // canopy glass
    tri(c, s, v, px, py, pz, 1, 0, 2, 0.20, 0.42, 0.62)

    // engine glow behind the tail, brighter under throttle
    let ex = w.plane.x - fx * 18.0
    let ey = w.plane.y - fy * 18.0
    let ez = w.plane.z - fz * 18.0
    let ep = toCamera(v, ex, ey, ez)
    if ep.z > 1.0 {
        let sx = v.cx + ep.x * v.scale / ep.z
        let sy2 = v.cy - ep.y * v.scale / ep.z
        let k = (w.plane.speed - 180.0) / 140.0
        let sz = 6.0 + k * 10.0
        spot(c, sx, sy2, sz * v.scale / ep.z * 0.02 + 4.0, 1.4 + k, 0.55 + k * 0.5, 0.18)
    }
}

fn addPt(px: &mut Vec<f64>, py: &mut Vec<f64>, pz: &mut Vec<f64>, w: &World, fx: f64, fy: f64, fz: f64, rx: f64, ry: f64, rz: f64, ux: f64, uy: f64, uz: f64, f: f64, r: f64, u: f64) {
    px.push(w.plane.x + fx * f + rx * r + ux * u)
    py.push(w.plane.y + fy * f + ry * r + uy * u)
    pz.push(w.plane.z + fz * f + rz * r + uz * u)
}

fn tri(c: &mut Canvas, s: &mut Scene, v: &View, px: &Vec<f64>, py: &Vec<f64>, pz: &Vec<f64>, a: i64, b: i64, d: i64, r: f64, g: f64, bl: f64) {
    triangle(c, s, v, px[a], py[a], pz[a], px[b], py[b], pz[b], px[d], py[d], pz[d], r, g, bl)
}

// A reticle on the next coin, and an edge arrow when it is off screen. Without
// this the trail is easy to lose the moment you overshoot one.
pub fn drawGuide(c: &mut Canvas, w: &World, _s: &Scene) {
    let v = viewOf(w.cam, c.w, c.h)
    // nearest live coin ahead
    var bi = 0 - 1
    var bd = 1.0e18
    for i in 0..w.rings.len {
        if w.rings[i].alive {
            let dx = w.rings[i].x - w.plane.x
            let dy = w.rings[i].y - w.plane.y
            let dz = w.rings[i].z - w.plane.z
            let d = dx * dx + dy * dy + dz * dz
            if d < bd {
                bd = d
                bi = i
            }
        }
    }
    if bi < 0 {
        return
    }
    let p = toCamera(v, w.rings[bi].x, w.rings[bi].y, w.rings[bi].z)
    let pulse = 0.65 + 0.35 * Math.sin(w.time * 6.0)
    if p.z > 1.0 {
        let sx = v.cx + p.x * v.scale / p.z
        let sy = v.cy - p.y * v.scale / p.z
        if sx > 8.0 && sx < (c.w as f64) - 8.0 && sy > 8.0 && sy < (c.h as f64) - 8.0 {
            let r = Math.clampF64(900.0 / p.z, 16.0, 90.0)
            let a = 0.30 * r
            // four corner brackets
            line(c, sx - r, sy - r + a, sx - r, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx - r, sy - r, sx - r + a, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx + r, sy - r + a, sx + r, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx + r, sy - r, sx + r - a, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx - r, sy + r - a, sx - r, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx - r, sy + r, sx - r + a, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx + r, sy + r - a, sx + r, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(c, sx + r, sy + r, sx + r - a, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            return
        }
    }
    // off screen (or behind): pin an arrow on the edge pointing the way to turn
    var dirX = p.x
    var dirY = 0.0 - p.y
    if p.z <= 1.0 {
        dirY = 0.0
    }
    let l = Math.sqrt(dirX * dirX + dirY * dirY) + 0.001
    dirX = dirX / l
    dirY = dirY / l
    let rad = Math.minF64((c.w as f64), (c.h as f64)) * 0.36
    let ax = v.cx + dirX * rad
    let ay = v.cy + dirY * rad
    let px2 = 0.0 - dirY
    let py2 = dirX
    line(c, ax + dirX * 20.0, ay + dirY * 20.0, ax + px2 * 12.0, ay + py2 * 12.0, 0.5 * pulse, 1.3 * pulse, 0.6 * pulse)
    line(c, ax + dirX * 20.0, ay + dirY * 20.0, ax - px2 * 12.0, ay - py2 * 12.0, 0.5 * pulse, 1.3 * pulse, 0.6 * pulse)
    line(c, ax - px2 * 12.0, ay - py2 * 12.0, ax + px2 * 12.0, ay + py2 * 12.0, 0.4 * pulse, 1.0 * pulse, 0.5 * pulse)
}

pub fn drawHud(c: &mut Canvas, w: &World, s: &Scene, fps: i64) {
    text(c, 24, 22, "SCORE " + w.score.toString(), 3, 0.95, 0.80, 0.30)
    let alt = ((w.plane.y - heightAt(w.plane.x, w.plane.z)) as i64)
    text(c, 24, 58, "ALT " + alt.toString() + "   SPD " + (w.plane.speed as i64).toString(), 2, 0.35, 0.45, 0.55)
    let ts = "TRIS " + s.tris.toString() + "   " + fps.toString() + " FPS"
    text(c, c.w - 24 - textWidth(ts, 2), 22, ts, 2, 0.28, 0.36, 0.44)

    if w.combo > 1 {
        let f = Math.minF64(1.8, 0.7 + (w.combo as f64) * 0.07)
        textCentered(c, c.w / 2, 64, "x" + w.combo.toString(), 4, 1.5 * f, 1.1 * f, 0.25 * f)
    }

    // artificial horizon: a short line that rolls with the aircraft
    let hx = (c.w as f64) * 0.5
    let hy = (c.h as f64) - 74.0
    let ca = Math.cos(0.0 - w.plane.roll)
    let sa = Math.sin(0.0 - w.plane.roll)
    line(c, hx - ca * 70.0, hy - sa * 70.0, hx - ca * 22.0, hy - sa * 22.0, 0.3, 0.9, 0.5)
    line(c, hx + ca * 22.0, hy + sa * 22.0, hx + ca * 70.0, hy + sa * 70.0, 0.3, 0.9, 0.5)
    spot(c, hx, hy, 3.0, 0.4, 1.0, 0.6)

    if w.banner > 0.0 {
        var f = 1.0
        if w.banner < 1.0 {
            f = w.banner
        }
        textCentered(c, c.w / 2, 150, "FLYBY", 9, 1.3 * f, 1.0 * f, 0.35 * f)
        textCentered(c, c.w / 2, 240, "FLY THROUGH THE COINS", 2, 0.5 * f, 0.6 * f, 0.7 * f)
    }
    if w.hint > 0.0 {
        var f = 1.0
        if w.hint < 1.0 {
            f = w.hint
        }
        textCentered(c, c.w / 2, c.h - 130, "LEFT RIGHT TO BANK    UP DOWN TO CLIMB AND DIVE", 2, 0.45 * f, 0.5 * f, 0.6 * f)
        textCentered(c, c.w / 2, c.h - 106, "FOLLOW THE GREEN BRACKETS — YOU CANNOT CRASH", 2, 0.4 * f, 0.44 * f, 0.5 * f)
    }
}
