from "std/datetime" import {
    DateTime, monthName, weekdayName
}

pub fn main(): i32 {
    let dt = DateTime.fromEpoch(1705318245)
    print(dt.format())
    print(weekdayName(dt.weekday))
    print(monthName(dt.month))
    print(dt.year)
    print(dt.month)
    print(dt.day)
    return 0
}
// @expect: 2024-01-15T11:30:45
// @expect: Monday
// @expect: January
// @expect: 2024
// @expect: 1
// @expect: 15
