// FLYBY — a 3D flying game written in Milo.
//
//   milo build examples/games/flight/main.milo -o /tmp/flyby --release && /tmp/flyby
//   /tmp/flyby --city examples/games/flight/cities/sf.city
//
//   UP / DOWN      climb and dive — the only axis; the aircraft steers itself
//   SPACE          throttle up
//   ESC            quit
//   --pro          give back the bank axis on LEFT / RIGHT
//   --city <file>  fly a real place instead of the procedural world
//
// Real 3D: a perspective camera, near-plane clipping and a depth-buffered
// triangle rasteriser, all on the CPU in safe Milo (see gfx3d.milo). There is no
// GPU pipeline here — SDL only blits the finished frame.
//
// You cannot crash. The ground pushes you up if you dive into it.

from "./sdl" import {
    SDL_Init, SDL_CreateWindow, SDL_CreateRenderer, SDL_CreateTexture,
    SDL_UpdateTexture, SDL_RenderClear, SDL_RenderCopy, SDL_RenderPresent,
    SDL_ShowCursor, SDL_GetTicks, SDL_DestroyTexture, SDL_DestroyRenderer,
    SDL_DestroyWindow, SDL_Quit,
    SDL_INIT_VIDEO, SDL_INIT_AUDIO, SDL_WINDOWPOS_CENTERED, SDL_WINDOW_SHOWN,
    SDL_TEXTUREACCESS_STREAMING, SDL_PIXELFORMAT_ABGR8888,
    SDL_RENDERER_ACCELERATED, SDL_RENDERER_PRESENTVSYNC,
    inputNew, pollInput
}
from "./gfx" import {
    canvasNew, present
}
from "./gfx3d" import {
    sceneNew
}
from "./sound" import {
    soundNew, playRing, playRingBonus, playRegion, playBoost, playMiss,
    musicTick, musicToggle
}
from "./textures" import {
    groundTexture, planeTexture
}
from "./world3d" import {
    worldIn, worldUpdate, SEED
}
from "./city" import {
    City, cityLoad, cityEmpty
}
from "std/args" import {
    args
}
from "./render3d" import {
    drawWorld, drawHud, drawGuide, drawSpeedLines
}

pub let W: i64 = 1280

pub let H: i64 = 720

// `--city <file>` flies a real place instead of the procedural world, and
// `--pro` gives back the bank axis. The asset is read once, here, before the
// window even opens: nothing is fetched, decoded or streamed while flying.
fn loadCity(): City {
    let a = args()
    for i in 0..a.len {
        if a[i] == "--city" && i + 1 < a.len {
            match cityLoad(a[i + 1]) {
                Result.Ok(city) => {
                    print("flying " + city.name.clone() + " — " + city.bCount.toString() + " buildings")
                    return city
                }
                Result.Err(e) => {
                    print("could not load city: " + e)
                    return cityEmpty()
                }
            }
        }
    }
    return cityEmpty()
}

fn proMode(): bool {
    let a = args()
    for i in 0..a.len {
        if a[i] == "--pro" {
            return true
        }
    }
    return false
}

pub fn main(): i32 {
    let city = loadCity()
    let easy = !proMode()
    if SDL_Init(SDL_INIT_VIDEO | SDL_INIT_AUDIO) != 0 {
        print("SDL_Init failed")
        return 1
    }
    var win: *u8 = 0 as *u8
    var ren: *u8 = 0 as *u8
    var tex: *u8 = 0 as *u8
    var ok = true
    unsafe {
        let title = "FLYBY — written in Milo"
        win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, W as i32, H as i32, SDL_WINDOW_SHOWN)
        ren = SDL_CreateRenderer(win, 0 - 1, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC)
        tex = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING, W as i32, H as i32)
        if (win as i64) == 0 || (ren as i64) == 0 || (tex as i64) == 0 {
            ok = false
        }
        let _ = SDL_ShowCursor(0)
    }
    if !ok {
        print("SDL setup failed")
        return 2
    }

    var c = canvasNew(W, H)
    var s = sceneNew(W, H)
    var w = worldIn(SEED, city, easy)
    let groundTex = groundTexture()
    let skinTex = planeTexture()
    var snd = soundNew()
    var inp = inputNew()
    var ev: [u8; 64] = [0; 64]
    var last = SDL_GetTicks()
    var fpsAccum: f64 = 0.0
    var fpsFrames: i64 = 0
    var fpsShown: i64 = 0

    while !inp.quit {
        let now = SDL_GetTicks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        if dt > 0.05 {
            dt = 0.05
        }
        if dt < 0.0005 {
            dt = 0.0005
        }
        pollInput(inp, ev)

        if inp.mute {
            musicToggle(snd)
        }
        musicTick(snd)

        worldUpdate(w, dt, inp.moveX, inp.moveY, inp.boost)
        drawWorld(c, s, w, groundTex, skinTex)

        fpsAccum = fpsAccum + dt
        fpsFrames = fpsFrames + 1
        if fpsAccum > 0.5 {
            fpsShown = ((fpsFrames as f64) / fpsAccum) as i64
            fpsAccum = 0.0
            fpsFrames = 0
        }
        if w.evRing {
            playRing(snd)
        }
        if w.evBonus {
            playRingBonus(snd)
        }
        if w.evRegion {
            playRegion(snd)
        }
        if w.evBoost {
            playBoost(snd)
        }
        if w.evMiss {
            playMiss(snd)
        }
        drawSpeedLines(c, w)
        drawGuide(c, w, s)
        drawHud(c, w, s, fpsShown)

        var exposure = 1.0
        if w.flash > 0.0 {
            exposure = 1.0 + w.flash * 0.8
        }
        present(c, 0.35, exposure)

        unsafe {
            SDL_UpdateTexture(tex, 0 as *u8, c.fb[0].addrOf() as *u8, (W * 4) as i32)
            SDL_RenderClear(ren)
            SDL_RenderCopy(ren, tex, 0 as *u8, 0 as *u8)
            SDL_RenderPresent(ren)
        }
    }
    // Tear down in creation order's reverse. SDL_Quit would reclaim all of it
    // anyway, but a leak an example teaches is a leak someone copies.
    SDL_DestroyTexture(tex)
    SDL_DestroyRenderer(ren)
    SDL_DestroyWindow(win)
    SDL_Quit()
    return 0
}
