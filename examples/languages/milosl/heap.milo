// milosl object heap: one generational arena for every heap value, plus a
// mark-sweep collector over it.
//
// The reason the collector is worth writing at all in an example this small:
// in C, a mark-sweep bug that frees a reachable object is a use-after-free the
// program discovers ten thousand instructions later as corrupted data. Here the
// freed slot's generation has moved on, so the still-live nan-boxed Value fails
// the check and unboxing yields None. A wrong GC produces a caught dangling
// reference at the exact instruction that touched it. `Heap.buggy` exists to
// demonstrate precisely that, on purpose.
from "./value" import {
    Value
}
from "std/arena" import {
    Arena, Handle, arenaWith, arenaHandles
}

pub enum Obj {
    Str(string),
    List(Vec<Value>),
    // Index into the VM's function table. Functions are compile-time entities
    // that outlive every collection, so the object only carries the index.
    Fn(i64),
}

pub struct Heap {
    objs: Arena<Obj>,
    // Captured once at construction. A Handle needs it, and reading it back
    // off some previously-issued handle at every unbox site is the kind of
    // bookkeeping that belongs in one place.
    id: i64,
    marks: Vec<bool>,
    allocs: i64,
    nextGc: i64,
    gcRuns: i64,
    // Number of unbox attempts that hit a dead slot. In a correct run this is
    // zero; it is the observable signal that the generation check did its job.
    danglingCaught: i64,
    // When true, the sweep also frees one *reachable* object. This is the
    // deliberate collector bug the demo shows being caught.
    buggy: bool,
}

impl Heap {
    fn new(): Heap {
        var objs: Arena<Obj> = Arena<Obj>.new()
        // Slot 0 is a permanent sentinel. Allocating it is also how the arena's
        // id is learned, since the id is only observable through a handle.
        let sentinel = objs.alloc(Obj.Fn(-1))
        var marks: Vec<bool> = Vec.new()
        marks.push(true)
        return Heap {
            objs: objs,
            id: sentinel.arenaId,
            marks: marks,
            allocs: 0,
            nextGc: 64,
            gcRuns: 0,
            danglingCaught: 0,
            buggy: false,
        }
    }

    fn alloc(self: &mut Self, o: Obj): Value {
        let h = self.objs.alloc(o)
        let idx = h.index as i64
        while self.marks.len <= idx {
            self.marks.push(false)
        }
        self.allocs = self.allocs + 1
        return Value.obj(h.index, h.generation)
    }

    fn allocStr(self: &mut Self, s: string): Value {
        return self.alloc(Obj.Str(s))
    }
    fn allocList(self: &mut Self, xs: Vec<Value>): Value {
        return self.alloc(Obj.List(xs))
    }
    fn allocFn(self: &mut Self, fnIndex: i64): Value {
        return self.alloc(Obj.Fn(fnIndex))
    }

    fn handleOf(self: &Self, v: &Value): Handle<Obj> {
        return Handle {
            arenaId: self.id,
            index: v.objIndex(),
            generation: v.objGeneration(),
        }
    }

    // True when the box still names a live object. A forged or stale u64 is
    // simply false here; it never becomes a dereference.
    fn valid(self: &Self, v: &Value): bool {
        if !v.isObj() {
            return false
        }
        return self.objs.valid(self.handleOf(v))
    }

    fn liveCount(self: &Self): i64 {
        return self.objs.len()
    }
    fn allocCount(self: &Self): i64 {
        return self.allocs
    }
    fn gcCount(self: &Self): i64 {
        return self.gcRuns
    }
    fn danglingCount(self: &Self): i64 {
        return self.danglingCaught
    }
    fn setBuggy(self: &mut Self, b: bool) {
        self.buggy = b
    }
    fn noteDangling(self: &mut Self) {
        self.danglingCaught = self.danglingCaught + 1
    }

    // ── GC ──
    //
    // Three phases the VM drives, so the heap never needs to know what a stack
    // frame or a global table looks like.

    fn gcShouldRun(self: &Self): bool {
        return self.allocs >= self.nextGc
    }

    fn gcBegin(self: &mut Self) {
        var i: i64 = 0
        while i < self.marks.len {
            self.marks[i] = false
            i = i + 1
        }
        // Slot 0 is the sentinel and is never collectable.
        self.marks[0] = true
    }

    // Mark `v` and everything it reaches. Iterative rather than recursive: a
    // deeply nested list must not be able to blow the native stack.
    fn gcMark(self: &mut Self, v: Value) {
        var work: Vec<Value> = Vec.new()
        work.push(v)
        while work.len > 0 {
            let cur = work[work.len - 1]
            work.pop()!
            if !cur.isObj() {
                continue
            }
            let h = self.handleOf(cur)
            if !self.objs.valid(h) {
                continue
            }
            let idx = h.index as i64
            if self.marks[idx] {
                continue
            }
            self.marks[idx] = true
            // Children are pushed from inside the borrow rather than cloned
            // out of it: a Value is 8 bytes and Copy, so this moves no strings
            // and no vectors.
            let _ = arenaWith(self.objs, h, (o: &Obj): i64 => {
                match o {
                    List(xs) => {
                        for x in xs {
                            work.push(x)
                        }
                        return 0
                    }
                    Str(s) => {
                        return 0
                    }
                    Fn(n) => {
                        return 0
                    }
                }
            }
            )
        }
    }

    // Free every unmarked slot. Returns how many were reclaimed.
    fn gcSweep(self: &mut Self): i64 {
        var freed: i64 = 0
        var buggedOne = false
        let handles = arenaHandles(self.objs)
        for h in handles {
            let idx = h.index as i64
            if idx == 0 {
                continue
            }
            var doomed = !self.marks[idx]
            // The planted collector bug: free the first reachable object too.
            if self.buggy && !doomed && !buggedOne {
                doomed = true
                buggedOne = true
            }
            if doomed {
                self.objs.free(h)
                freed = freed + 1
            }
        }
        self.gcRuns = self.gcRuns + 1
        self.allocs = 0
        let live = self.objs.len()
        self.nextGc = live * 2
        if self.nextGc < 64 {
            self.nextGc = 64
        }
        return freed
    }
}

// Borrow the object a Value names and run `f` on it. None when the box is
// stale, forged, or not an object at all. This is the only way to reach an
// object's contents, which is what makes "every dereference is checked" a
// structural property rather than a convention.
pub fn heapWith<R>(h: &Heap, v: &Value, f: (&Obj) => R): Option<R> {
    if !v.isObj() {
        return Option.None
    }
    return arenaWith(h.objs, h.handleOf(v), f)
}

// Replace the object a Value names. False when the box is stale.
pub fn heapSet(h: &mut Heap, v: &Value, o: Obj): bool {
    if !v.isObj() {
        return false
    }
    let handle = h.handleOf(v)
    return h.objs.set(handle, o)
}
