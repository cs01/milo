// @error: 'x' shadows an outer binding
// `while let` desugars to `while true { if let P = subj { body } else { break } }`
// (see parseWhile in src/parser.ts), so it routes through the same IfLetStmt
// path and must point at the pattern's own binding, not print bare.
enum Opt4 { Some4(i32), None4 }

fn main(): i32 {
    let x = 1
    var o = Opt4.Some4(3)
    while let Opt4.Some4(x) = o {
        o = Opt4.None4
        return x
    }
    return 0
}
