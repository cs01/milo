// `Name<T, U>.method()` IS valid, so `Name<T, U> { … }` reads like it should be. It is
// not, and it used to fail as `unexpected token ','` pointing at the type-argument comma
// — a character the author had no reason to suspect. The error names both ways out.
// @error: is not a struct literal
struct Pair<A, B> {
    a: A,
    b: B,
}

fn main() {
    let p = Pair<i64, string> { a: 1, b: "x" }
    print(p.a)
}
