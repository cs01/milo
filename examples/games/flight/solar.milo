// Where the sun actually is, for a real place at a real moment.
//
// The weather presets carried a hand-picked sun direction per region, which is
// fine for an invented world and wrong for a real one: the whole point of flying
// over the actual San Francisco under the actual current sky is that the light
// comes from where the light is coming from. A shadow that falls the wrong way
// is worse than no shadow, because the eye reads shadow direction long before it
// reads anything else in the frame.
//
// NOAA's solar position equations, which are accurate to well under a degree
// over any date this game will ever be handed. That is far tighter than the
// half-degree the sun's own disc subtends, so the error is invisible.
//
// World axes, fixed by how `tools/fetchcity.milo` projects OSM coordinates:
// +x is EAST, +z is NORTH, +y is up. Getting this backwards puts the morning sun
// in the west, which looks fine in a still and is obviously wrong the moment the
// day runs.

from "std/math" import {
    Math
}
from "std/datetime" import {
    DateTime
}

let PI: f64 = 3.141592653589793

let DEG: f64 = 3.141592653589793 / 180.0

// A unit vector pointing FROM the ground TOWARD the sun, in world axes, plus the
// elevation that produced it. `up` is the sine of the elevation, so it is
// negative at night and the existing shaders already read it that way.
pub struct SunDir {
    x: f64,
    y: f64,
    z: f64,
    // Degrees above the horizon, negative when down. Kept because the renderer
    // wants to know about civil twilight, which is a threshold on this and not
    // on the vector.
    elevationDeg: f64,
    // Degrees clockwise from north.
    azimuthDeg: f64,
}

fn isLeap(y: i32): bool {
    if y % 400 == 0 {
        return true
    }
    if y % 100 == 0 {
        return false
    }
    return y % 4 == 0
}

// 1 on 1 January.
fn dayOfYear(t: &DateTime): i64 {
    var cum: Vec<i64> = Vec.new()
    cum.push(0)
    cum.push(31)
    cum.push(59)
    cum.push(90)
    cum.push(120)
    cum.push(151)
    cum.push(181)
    cum.push(212)
    cum.push(243)
    cum.push(273)
    cum.push(304)
    cum.push(334)
    var m = t.month as i64
    if m < 1 {
        m = 1
    }
    if m > 12 {
        m = 12
    }
    var d = cum[m - 1] + (t.day as i64)
    if m > 2 {
        if isLeap(t.year) {
            d = d + 1
        }
    }
    return d
}

// The sun over `lat`/`lon` (degrees, north and east positive) at the UTC moment
// `t`.
pub fn sunAt(lat: f64, lon: f64, t: &DateTime): SunDir {
    let doy = dayOfYear(t) as f64
    let utcMin = (t.hour as f64) * 60.0 + (t.minute as f64) + (t.second as f64) / 60.0

    // Fractional year, in radians. The hour term matters: without it the
    // declination is a step function at midnight and the sun jitters at the
    // date boundary.
    let g = 2.0 * PI / 365.0 * (doy - 1.0 + (utcMin / 60.0 - 12.0) / 24.0)

    // The equation of time, in minutes — the difference between clock noon and
    // the sun actually being due south. It swings about ±15 minutes over a year
    // and dropping it is a visible error in shadow direction.
    let eqTime = 229.18 * (0.000075 + 0.001868 * Math.cos(g) - 0.032077 * Math.sin(g) - 0.014615 * Math.cos(2.0 * g) - 0.040849 * Math.sin(2.0 * g))

    let decl = 0.006918
    - 0.399912 * Math.cos(g)
    + 0.070257 * Math.sin(g)
    - 0.006758 * Math.cos(2.0 * g)
    + 0.000907 * Math.sin(2.0 * g)
    - 0.002697 * Math.cos(3.0 * g)
    + 0.001480 * Math.sin(3.0 * g)

    // True solar time in minutes. Four minutes per degree of longitude is the
    // earth turning; the input is UTC so no timezone ever enters this.
    var tst = utcMin + eqTime + 4.0 * lon
    // Fold into a day so the hour angle stays in range near the date line.
    while tst < 0.0 {
        tst = tst + 1440.0
    }
    while tst >= 1440.0 {
        tst = tst - 1440.0
    }

    let ha = (tst / 4.0 - 180.0) * DEG
    let latR = lat * DEG

    let sinLat = Math.sin(latR)
    let cosLat = Math.cos(latR)
    let sinDecl = Math.sin(decl)
    let cosDecl = Math.cos(decl)

    var cosZen = sinLat * sinDecl + cosLat * cosDecl * Math.cos(ha)
    if cosZen > 1.0 {
        cosZen = 1.0
    }
    if cosZen < -1.0 {
        cosZen = -1.0
    }
    let zen = Math.acos(cosZen)
    let elev = PI / 2.0 - zen

    // Azimuth from the spherical triangle. The denominator vanishes when the sun
    // is at the zenith or exactly on the horizon; both are directions where the
    // azimuth does not matter, so a clamp is the whole handling it needs.
    let sinZen = Math.sin(zen)
    var az = 0.0
    if sinZen > 0.000001 {
        if cosLat > 0.000001 {
            var c = (sinLat * cosZen - sinDecl) / (cosLat * sinZen)
            if c > 1.0 {
                c = 1.0
            }
            if c < -1.0 {
                c = -1.0
            }
            az = PI - Math.acos(c)
        }
    }
    // Before solar noon the sun is east of the meridian, after it is west, and
    // the arccos above cannot tell those apart on its own.
    if ha > 0.0 {
        az = 2.0 * PI - az
    }

    let cosElev = Math.cos(elev)
    return SunDir {
        x: cosElev * Math.sin(az),
        y: Math.sin(elev),
        z: cosElev * Math.cos(az),
        elevationDeg: elev / DEG,
        azimuthDeg: az / DEG,
    }
}

// The sun over a place right now.
pub fn sunNow(lat: f64, lon: f64): SunDir {
    let t = DateTime.now()
    return sunAt(lat, lon, t)
}

// ── the moon ──────────────────────────────────────────────────────────────────
//
// Night used to be black. Not dark: black. Outside the lit part of the frame the
// ground took an ambient of about a thousandth and the tone curve took that to
// zero, so a night flight was an instrument panel floating over nothing. The fix
// is not more exposure, it is a second light — because there IS a second light,
// and where it is and how much of it there is are both computable.
//
// Meeus, Astronomical Algorithms, chapter 47, truncated to the terms that matter
// at this scale. The moon is half a degree wide and this is good to a few
// arcminutes, which is nothing you can see; what has to be RIGHT is the phase
// and where in the sky it is, because a full moon in the wrong quarter of the
// sky lights the wrong side of every building.

pub struct MoonDir {
    x: f64,
    y: f64,
    z: f64,
    elevationDeg: f64,
    azimuthDeg: f64,
    // Fraction of the disc lit, 0 at new and 1 at full. This is the dial the
    // brightness rides: a crescent is not a dimmer full moon, it is about a
    // twentieth of one.
    illuminated: f64,
    // Angle between sun and moon as seen from here. 0 at new, 180 at full.
    elongationDeg: f64,
}

fn wrap360(x: f64): f64 {
    var v = x % 360.0
    if v < 0.0 {
        v = v + 360.0
    }
    return v
}

// Julian Day for a UTC calendar moment. Meeus chapter 7, Gregorian only — the
// places this flies over have all been on the Gregorian calendar for longer than
// there have been aeroplanes.
pub fn julianDay(t: &DateTime): f64 {
    var y = t.year as i64
    var m = t.month as i64
    if m <= 2 {
        y = y - 1
        m = m + 12
    }
    let a = y / 100
    let b = 2 - a + a / 4
    let day = (t.day as f64)
    + ((t.hour as f64) + (t.minute as f64) / 60.0 + (t.second as f64) / 3600.0) / 24.0
    return (365.25 * ((y + 4716) as f64)) as i64 as f64
    + ((30.6001 * ((m + 1) as f64)) as i64 as f64)
    + day + (b as f64) - 1524.5
}

// Greenwich mean sidereal time in degrees. This is what turns a position on the
// sky into a position over a place, and it is the one term where being an hour
// out puts the moon fifteen degrees from where it is.
fn gmstDeg(jd: f64): f64 {
    let d = jd - 2451545.0
    return wrap360(280.46061837 + 360.98564736629 * d)
}

// Where a point on the celestial sphere is, seen from `lat`/`lon` at `jd`.
// Returns elevation and azimuth in degrees, azimuth clockwise from north.
fn horizonOf(raDeg: f64, decDeg: f64, lat: f64, lon: f64, jd: f64): SunDir {
    let ha = (wrap360(gmstDeg(jd) + lon - raDeg)) * DEG
    let dec = decDeg * DEG
    let latR = lat * DEG
    let sinAlt = Math.sin(latR) * Math.sin(dec) + Math.cos(latR) * Math.cos(dec) * Math.cos(ha)
    let alt = Math.asin(Math.clampF64(sinAlt, 0.0 - 1.0, 1.0))
    // atan2 form rather than acos: it needs no separate east/west correction, and
    // the +180 puts zero at north instead of at south.
    var az = Math.atan2(Math.sin(ha), Math.cos(ha) * Math.sin(latR) - Math.tan(dec) * Math.cos(latR))
    az = wrap360(az / DEG + 180.0)
    let cosAlt = Math.cos(alt)
    return SunDir {
        x: cosAlt * Math.sin(az * DEG),
        y: Math.sin(alt),
        z: cosAlt * Math.cos(az * DEG),
        elevationDeg: alt / DEG,
        azimuthDeg: az,
    }
}

// Ecliptic longitude and latitude to right ascension and declination. Returns
// (ra, dec) in degrees, packed into the two fields of a Vec2-shaped pair — milo
// has no tuple, and two out-params on a struct read worse than this does.
pub struct RaDec {
    raDeg: f64,
    decDeg: f64,
}

fn eclipticToEquatorial(lonDeg: f64, latDeg: f64, oblDeg: f64): RaDec {
    let l = lonDeg * DEG
    let b = latDeg * DEG
    let e = oblDeg * DEG
    let ra = Math.atan2(Math.sin(l) * Math.cos(e) - Math.tan(b) * Math.sin(e), Math.cos(l))
    let dec = Math.asin(Math.clampF64(Math.sin(b) * Math.cos(e) + Math.cos(b) * Math.sin(e) * Math.sin(l), 0.0 - 1.0, 1.0))
    return RaDec {
        raDeg: wrap360(ra / DEG),
        decDeg: dec / DEG,
    }
}

// The sun's ecliptic longitude. Separate from `sunAt` on purpose: that one is
// NOAA's horizon-coordinate recipe and never forms a longitude at all, so the
// two are independent paths to the same sky and the fixture makes them agree.
pub fn sunEclipticLonDeg(jd: f64): f64 {
    let t = (jd - 2451545.0) / 36525.0
    let l0 = 280.46646 + 36000.76983 * t + 0.0003032 * t * t
    let m = (357.52911 + 35999.05029 * t - 0.0001537 * t * t) * DEG
    let c = 1.914602 * Math.sin(m) + 0.019993 * Math.sin(2.0 * m) + 0.000289 * Math.sin(3.0 * m)
    return wrap360(l0 + c)
}

pub fn obliquityDeg(jd: f64): f64 {
    let t = (jd - 2451545.0) / 36525.0
    return 23.439291 - 0.0130042 * t
}

// The moon's ecliptic longitude and latitude, degrees.
pub fn moonEclipticLonDeg(jd: f64): f64 {
    let t = (jd - 2451545.0) / 36525.0
    let lp = 218.3164477 + 481267.88123421 * t
    let d = (297.8501921 + 445267.1114034 * t) * DEG
    let m = (357.5291092 + 35999.0502909 * t) * DEG
    let mp = (134.9633964 + 477198.8675055 * t) * DEG
    return wrap360(lp + 6.289 * Math.sin(mp) - 1.274 * Math.sin(2.0 * d - mp) + 0.658 * Math.sin(2.0 * d) - 0.186 * Math.sin(m) - 0.059 * Math.sin(2.0 * mp - 2.0 * d) - 0.057 * Math.sin(mp - 2.0 * d + m) + 0.053 * Math.sin(mp + 2.0 * d) + 0.046 * Math.sin(2.0 * d - m) + 0.041 * Math.sin(mp - m) - 0.035 * Math.sin(d) - 0.031 * Math.sin(mp + m))
}

pub fn moonEclipticLatDeg(jd: f64): f64 {
    let t = (jd - 2451545.0) / 36525.0
    let d = (297.8501921 + 445267.1114034 * t) * DEG
    let mp = (134.9633964 + 477198.8675055 * t) * DEG
    let f = (93.2720950 + 483202.0175233 * t) * DEG
    return 5.128 * Math.sin(f)
    + 0.281 * Math.sin(mp + f)
    - 0.278 * Math.sin(f - mp)
    - 0.173 * Math.sin(f - 2.0 * d)
    + 0.055 * Math.sin(2.0 * d + f - mp)
    - 0.046 * Math.sin(2.0 * d + mp - f)
    + 0.033 * Math.sin(2.0 * d + f)
    + 0.017 * Math.sin(2.0 * mp + f)
}

// Elongation from ECLIPTIC longitudes: the angle between the two bodies as
// projected onto the ecliptic, corrected for the moon's latitude. This is one of
// the two independent routes to the same number.
pub fn elongationFromEclipticDeg(jd: f64): f64 {
    let dl = (moonEclipticLonDeg(jd) - sunEclipticLonDeg(jd)) * DEG
    let b = moonEclipticLatDeg(jd) * DEG
    return Math.acos(Math.clampF64(Math.cos(b) * Math.cos(dl), 0.0 - 1.0, 1.0)) / DEG
}

// Elongation from EQUATORIAL coordinates: the angular separation of two points
// on the sphere, from their right ascensions and declinations. The other route.
// The fixture requires these two to agree; they share no line of arithmetic
// beyond the ephemeris series themselves, so a sign slip in the coordinate
// conversion cannot hide in both.
pub fn elongationFromEquatorialDeg(jd: f64): f64 {
    let obl = obliquityDeg(jd)
    let sunEq = eclipticToEquatorial(sunEclipticLonDeg(jd), 0.0, obl)
    let moonEq = eclipticToEquatorial(moonEclipticLonDeg(jd), moonEclipticLatDeg(jd), obl)
    let d1 = sunEq.decDeg * DEG
    let d2 = moonEq.decDeg * DEG
    let dra = (sunEq.raDeg - moonEq.raDeg) * DEG
    let c = Math.sin(d1) * Math.sin(d2) + Math.cos(d1) * Math.cos(d2) * Math.cos(dra)
    return Math.acos(Math.clampF64(c, 0.0 - 1.0, 1.0)) / DEG
}

// The sun again, by a completely different road: ecliptic longitude, then a
// rotation into equatorial coordinates, then the hour angle.
//
// `sunAt` above is NOAA's horizon-coordinate recipe and never forms a longitude
// at all. This one shares the moon's machinery instead. They are two
// independent implementations of the same sky and the fixture makes them agree,
// which is the only check either of them has that does not require an
// almanac -- and it is what says the moon's coordinate chain is right, since the
// moon has no NOAA recipe to be checked against.
pub fn sunAtEcliptic(lat: f64, lon: f64, t: &DateTime): SunDir {
    let jd = julianDay(t)
    let eq = eclipticToEquatorial(sunEclipticLonDeg(jd), 0.0, obliquityDeg(jd))
    return horizonOf(eq.raDeg, eq.decDeg, lat, lon, jd)
}

// The moon over `lat`/`lon` at the UTC moment `t`.
pub fn moonAt(lat: f64, lon: f64, t: &DateTime): MoonDir {
    let jd = julianDay(t)
    let obl = obliquityDeg(jd)
    let eq = eclipticToEquatorial(moonEclipticLonDeg(jd), moonEclipticLatDeg(jd), obl)
    let h = horizonOf(eq.raDeg, eq.decDeg, lat, lon, jd)
    let elong = elongationFromEclipticDeg(jd)
    // Illuminated fraction. The phase angle is the supplement of the elongation
    // to within a fraction of a degree at this distance, and that error is far
    // below what a brightness ramp resolves.
    let k = (1.0 - Math.cos(elong * DEG)) * 0.5
    return MoonDir {
        x: h.x, y: h.y, z: h.z,
        elevationDeg: h.elevationDeg,
        azimuthDeg: h.azimuthDeg,
        illuminated: Math.clampF64(k, 0.0, 1.0),
        elongationDeg: elong,
    }
}

pub fn moonNow(lat: f64, lon: f64): MoonDir {
    let t = DateTime.now()
    return moonAt(lat, lon, t)
}
