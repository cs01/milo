// The player: where the camera stands and where it points.
//
// You do not walk. This is a shooting gallery: the whole game is where the
// muzzle is pointing when a target snaps up, and a player hunting for a firing
// position is a player not shooting. Standing still also means the range can be
// laid out once and be the same range every round.
//
// Yaw is measured so that 0 looks down +Z, which is down the street, and both
// axes are clamped to keep the rigs in front of you: turning to face an empty
// stretch of desert is not a decision worth offering.

from "std/math" import {
    Math
}
from "./mat4" import {
    lookAt, multiply, perspective
}
from "./vec3" import {
    Vec3, v3
}

pub let EYE_HEIGHT: f64 = 1.68

// How far off centre you may look, in radians. Wide enough to cover both rails
// and the far end of the street, short of the point where the town runs out.
pub let YAW_LIMIT: f64 = 0.62

pub let PITCH_UP: f64 = 0.30

pub let PITCH_DOWN: f64 = -0.42

pub struct Camera {
    pos: Vec3,
    yaw: f64,
    pitch: f64,
    bob: f64,
    // Recoil is applied to the view, not to the gun model alone: a shot that
    // does not move the camera does not feel like a shot.
    kickPitch: f64,
    kickYaw: f64,
    fov: f64,
}

pub fn newCamera(): Camera {
    return Camera {
        pos: v3(0.0, EYE_HEIGHT, 8.0),
        yaw: 0.0,
        pitch: -0.02,
        bob: 0.0,
        kickPitch: 0.0,
        kickYaw: 0.0,
        fov: 1.48,
    }
}

impl Camera {
    fn forward(self: &Self): Vec3 {
        let cp = Math.cos(self.pitch + self.kickPitch)
        return v3(Math.sin(self.yaw + self.kickYaw) * cp, Math.sin(self.pitch + self.kickPitch), Math.cos(self.yaw + self.kickYaw) * cp)
    }

    // Flat forward, for walking: looking at the sky should not slow you down.
    fn walkForward(self: &Self): Vec3 {
        return v3(Math.sin(self.yaw), 0.0, Math.cos(self.yaw))
    }

    fn right(self: &Self): Vec3 {
        return v3(Math.cos(self.yaw), 0.0, -Math.sin(self.yaw))
    }

    fn eye(self: &Self): Vec3 {
        return self.pos + v3(0.0, Math.sin(self.bob * 2.0) * 0.022, 0.0)
    }

    fn look(self: &mut Self, dx: f64, dy: f64, sensitivity: f64) {
        self.yaw = Math.clampF64(self.yaw - dx * sensitivity, -YAW_LIMIT, YAW_LIMIT)
        self.pitch = Math.clampF64(self.pitch - dy * sensitivity, PITCH_DOWN, PITCH_UP)
    }

    // `fov` is HORIZONTAL. A vertical fov looks correct on one aspect ratio and
    // claustrophobic on a wide monitor, which is the wrong way round: what a
    // player notices is how much of the street is in view side to side.
    fn viewProj(self: &Self, aspect: f64): Vec<f32> {
        return multiply(self.projM(aspect), self.viewM())
    }

    fn viewM(self: &Self): Vec<f32> {
        let e = self.eye()
        return lookAt(e, e + self.forward(), v3(0.0, 1.0, 0.0))
    }

    fn projM(self: &Self, aspect: f64): Vec<f32> {
        let fovY = 2.0 * Math.atan(Math.tan(self.fov * 0.5) / aspect)
        return perspective(fovY, aspect, 0.06, 14000.0)
    }

    // The tangent of the half field of view on each axis. The AO pass rebuilds a
    // view position from a pixel and a distance out of exactly these two numbers.
    fn tanHalfX(self: &Self): f64 {
        return Math.tan(self.fov * 0.5)
    }

    // Recoil recovers on a spring, faster than it was applied.
    fn settle(self: &mut Self, dt: f64) {
        self.kickPitch = self.kickPitch - self.kickPitch * Math.minF64(dt * 11.0, 1.0)
        self.kickYaw = self.kickYaw - self.kickYaw * Math.minF64(dt * 11.0, 1.0)
        // The bob is a breathing sway now rather than a footfall: a shooter
        // standing still is not perfectly still, and a viewmodel that is
        // perfectly still is the tell that it is a picture.
        self.bob = self.bob + dt * 0.9
    }

    fn kick(self: &mut Self, pitch: f64, yaw: f64) {
        self.kickPitch = self.kickPitch + pitch
        self.kickYaw = self.kickYaw + yaw
    }
}
