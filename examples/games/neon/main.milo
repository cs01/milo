// NEON — a twin-stick arena shooter written in Milo.
//
// Build and play:
//   milo run examples/games/neon/main.milo --release
//
//   ARROW KEYS / WASD   move — this is the only control you need
//   MOUSE               optional: takes over aiming while you move it
//                       (otherwise the gun locks the nearest threat by itself)
//   SPACE               bomb
//   1 2 3               pick an upgrade between waves
//   ENTER               restart after a game over
//   ESC                 quit
//
// The point of this example is the code, not the score: see README.md for what
// each system is meant to prove about second-class references.

from "std/math" import {
    Math
}
from "./sdl" import {
    SDL_Init, SDL_CreateWindow, SDL_CreateRenderer, SDL_CreateTexture,
    SDL_UpdateTexture, SDL_RenderClear, SDL_RenderCopy, SDL_RenderPresent,
    SDL_ShowCursor, SDL_GetTicks, SDL_Delay, SDL_DestroyWindow, SDL_Quit,
    SDL_INIT_VIDEO, SDL_WINDOWPOS_CENTERED, SDL_WINDOW_SHOWN,
    SDL_TEXTUREACCESS_STREAMING, SDL_PIXELFORMAT_ABGR8888,
    SDL_RENDERER_ACCELERATED, SDL_RENDERER_PRESENTVSYNC,
    Input, inputNew, pollInput
}
from "./gfx" import {
    Canvas, canvasNew, present, text, textCentered, textWidth
}
from "./world" import {
    World, worldNew, worldUpdate, worldReset, choosePerk, nearestEnemy, alive
}
from "./render" import {
    Shapes, shapesNew, drawWorld, drawHud, drawAim, drawLock
}
from "std/random" import {
    Random
}

pub let W: i64 = 1280

pub let H: i64 = 720

pub fn main(): i32 {
    if SDL_Init(SDL_INIT_VIDEO) != 0 {
        print("SDL_Init failed")
        return 1
    }
    var win: *u8 = 0 as *u8
    var ren: *u8 = 0 as *u8
    var tex: *u8 = 0 as *u8
    var ok = true
    unsafe {
        let title = "NEON — written in Milo"
        win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, W as i32, H as i32, SDL_WINDOW_SHOWN)
        ren = SDL_CreateRenderer(win, 0 - 1, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC)
        tex = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING, W as i32, H as i32)
        if (win as i64) == 0 || (ren as i64) == 0 || (tex as i64) == 0 {
            ok = false
        }
        let _ = SDL_ShowCursor(0)
    }
    if !ok {
        print("SDL setup failed")
        return 2
    }

    var c = canvasNew(W, H)
    var world = worldNew(W as f64, H as f64)
    let shapes = shapesNew()
    var inp = inputNew()
    var ev: [u8; 64] = [0; 64]

    var last = SDL_GetTicks()
    var lastMouseX: f64 = 0.0
    var lastMouseY: f64 = 0.0
    var mouseIdle: f64 = 99.0 // start in auto-aim; the mouse claims it when moved
    var fpsAccum: f64 = 0.0
    var fpsFrames: i64 = 0
    var fpsShown: i64 = 0
    var titleTimer = 6.0
    var restartHeld = false
    var pickHeld = false

    while !inp.quit {
        let now = SDL_GetTicks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        if dt > 0.05 {
            dt = 0.05 // a long stall must not teleport anything through a wall
        }
        if dt < 0.0005 {
            dt = 0.0005
        }

        pollInput(inp, ev, 1.0)

        // Aim: locks onto the nearest threat by default, so the whole game is
        // playable one-handed on the arrow keys. Touching the mouse hands aiming
        // back to the mouse until it goes still again — no mode to discover, and
        // no second stick to learn.
        let mdx = inp.mouseX - lastMouseX
        let mdy = inp.mouseY - lastMouseY
        if mdx * mdx + mdy * mdy > 4.0 {
            mouseIdle = 0.0
        } else {
            mouseIdle = mouseIdle + dt
        }
        lastMouseX = inp.mouseX
        lastMouseY = inp.mouseY
        let usingMouse = mouseIdle < 2.0

        var aim = world.player.ang
        var lockX = 0.0
        var lockY = 0.0
        var locked = false
        if usingMouse {
            let adx = inp.mouseX - world.player.x
            let ady = inp.mouseY - world.player.y
            if adx * adx + ady * ady > 4.0 {
                aim = Math.atan2(ady, adx)
            }
        } else {
            let h = nearestEnemy(world, world.player.x, world.player.y, 4000.0, 0 - 1)
            if alive(world, h) {
                lockX = world.ents[h.slot].x
                lockY = world.ents[h.slot].y
                locked = true
                let tgt = Math.atan2(lockY - world.player.y, lockX - world.player.x)
                // Turn toward the mark instead of snapping, so a target dying does
                // not teleport the gun across the screen.
                var d = tgt - aim
                while d > 3.14159265358979 {
                    d = d - 6.28318530717959
                }
                while d < 0.0 - 3.14159265358979 {
                    d = d + 6.28318530717959
                }
                aim = aim + d * Math.minF64(1.0, dt * 14.0)
            }
        }
        // Always firing. Holding a button to shoot adds nothing here.
        let wantFire = true

        if world.perkPick {
            if inp.pick > 0 && !pickHeld {
                choosePerk(world, inp.pick - 1)
            }
        }
        pickHeld = inp.pick > 0

        if world.gameOver && inp.restart && !restartHeld {
            worldReset(world)
            titleTimer = 0.0
        }
        restartHeld = inp.restart

        worldUpdate(world, dt, inp.moveX, inp.moveY, aim, wantFire, inp.bomb)

        // screen shake
        var ox = 0.0
        var oy = 0.0
        if world.shake > 0.2 {
            ox = Random.floatRange(0.0 - world.shake, world.shake)
            oy = Random.floatRange(0.0 - world.shake, world.shake)
        }

        drawWorld(c, world, shapes, ox, oy)
        if usingMouse {
            drawAim(c, world, inp.mouseX, inp.mouseY, aim)
        } else if locked {
            drawLock(c, world, lockX, lockY, aim, world.time)
        }
        drawHud(c, world)

        fpsAccum = fpsAccum + dt
        fpsFrames = fpsFrames + 1
        if fpsAccum > 0.5 {
            fpsShown = ((fpsFrames as f64) / fpsAccum) as i64
            fpsAccum = 0.0
            fpsFrames = 0
        }
        text(c, 24, H - 30, fpsShown.toString() + " FPS", 2, 0.18, 0.30, 0.38)
        // Control strip stays up permanently — cheap, and there is nowhere else to
        // find this out.
        let help = "ARROWS MOVE    AUTO-AIM (MOUSE OVERRIDES)    SPACE BOMB    ESC QUIT"
        text(c, W - 24 - textWidth(help, 2), H - 30, help, 2, 0.18, 0.30, 0.38)

        if titleTimer > 0.0 {
            titleTimer = titleTimer - dt
            var f = 1.0
            if titleTimer < 1.0 {
                f = titleTimer
            }
            textCentered(c, W / 2, H / 2 - 90, "NEON", 12, 0.6 * f, 1.4 * f, 2.0 * f)
            textCentered(c, W / 2, H / 2 + 10, "WRITTEN IN MILO", 3, 1.4 * f, 1.0 * f, 0.4 * f)
            textCentered(c, W / 2, H / 2 + 60, "ARROW KEYS MOVE — THE GUN AIMS ITSELF", 2, 0.7 * f, 0.9 * f, 1.2 * f)
            textCentered(c, W / 2, H / 2 + 88, "SPACE BOMB      1 2 3 UPGRADES      ESC QUIT", 2, 0.5 * f, 0.7 * f, 0.9 * f)
        }

        var exposure = 1.0
        if world.flash > 0.0 {
            exposure = 1.0 + world.flash * 2.2
        }
        present(c, 1.0, exposure)

        unsafe {
            SDL_UpdateTexture(tex, 0 as *u8, c.fb[0].addrOf() as *u8, (W * 4) as i32)
            SDL_RenderClear(ren)
            SDL_RenderCopy(ren, tex, 0 as *u8, 0 as *u8)
            SDL_RenderPresent(ren)
        }
    }

    SDL_DestroyWindow(win)
    SDL_Quit()
    return 0
}
