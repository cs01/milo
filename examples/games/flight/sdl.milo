// SDL2 bindings and one frame of input, for FLYBY.
//
// Raw pointers live here and in sound.milo (the audio device queue) and nowhere
// else. Everything above — flight model, terrain, rasteriser, framebuffer — is
// safe Milo.

@link("SDL2")
pub extern fn SDL_Init(flags: u32): i32

pub extern fn SDL_CreateWindow(title: *u8, x: i32, y: i32, w: i32, h: i32, flags: u32): *u8

pub extern fn SDL_CreateRenderer(win: *u8, index: i32, flags: u32): *u8

pub extern fn SDL_CreateTexture(ren: *u8, format: u32, access: i32, w: i32, h: i32): *u8

pub extern fn SDL_UpdateTexture(tex: *u8, rect: *u8, pixels: *u8, pitch: i32): i32

pub extern fn SDL_RenderClear(ren: *u8): i32

pub extern fn SDL_RenderCopy(ren: *u8, tex: *u8, src: *u8, dst: *u8): i32

pub extern fn SDL_RenderPresent(ren: *u8): void

pub extern fn SDL_PollEvent(event: *u8): i32

pub extern fn SDL_GetKeyboardState(numkeys: *i32): *u8

pub extern fn SDL_ShowCursor(toggle: i32): i32

pub extern fn SDL_GetTicks(): u32

pub extern fn SDL_Delay(ms: u32): void

pub extern fn SDL_DestroyTexture(tex: *u8): void

pub extern fn SDL_DestroyRenderer(ren: *u8): void

pub extern fn SDL_DestroyWindow(win: *u8): void

pub extern fn SDL_Quit(): void

pub let SDL_INIT_VIDEO: u32 = 0x20

// SDL will not open an audio device unless the audio subsystem was initialised.
// Leaving this out does not error — SDL_OpenAudioDevice just returns 0, the
// Sound struct records ok=false, and every play() silently no-ops. The game runs
// perfectly and makes no noise at all.
pub let SDL_INIT_AUDIO: u32 = 0x10

pub let SDL_WINDOWPOS_CENTERED: i32 = 0x2FFF0000

pub let SDL_WINDOW_SHOWN: u32 = 0x4

pub let SDL_TEXTUREACCESS_STREAMING: i32 = 1

pub let SDL_PIXELFORMAT_ABGR8888: u32 = 0x16762004

pub let SDL_QUIT: u32 = 0x100

pub let SDL_RENDERER_ACCELERATED: u32 = 0x2

pub let SDL_RENDERER_PRESENTVSYNC: u32 = 0x4

// USB HID scancodes, which is what SDL_GetKeyboardState is indexed by.
pub let SC_A: i64 = 4

pub let SC_D: i64 = 7

pub let SC_M: i64 = 16

pub let SC_S: i64 = 22

pub let SC_W: i64 = 26

pub let SC_ESC: i64 = 41

pub let SC_SPACE: i64 = 44

pub let SC_RIGHT: i64 = 79

pub let SC_LEFT: i64 = 80

pub let SC_DOWN: i64 = 81

pub let SC_UP: i64 = 82

// One frame of input, snapshotted out of SDL so the rest of the game never
// touches a pointer.
pub struct Input {
    moveX: f64, // bank: -1 left, +1 right
    moveY: f64, // pitch: +1 climb, -1 dive
    boost: bool,
    quit: bool,
    mute: bool, // edge-triggered: true only on the frame M goes down
    muteHeld: bool,
    // Step to the next / previous place, edge-triggered. In the default
    // one-axis mode the aircraft steers itself, so LEFT and RIGHT carry no
    // control input and are free to do this. `--pro` takes the bank axis back
    // and these go quiet, because there the same keys are flying the aeroplane.
    placeStep: i64,
    placeHeld: bool,
    // Stick, not camera: the key you press is where you push the nose, so UP
    // dives and DOWN climbs. This is how every flight sim maps a stick and it
    // is the default here; `--natural` flips it back to UP-climbs.
    invert: bool,
}

pub fn inputNew(invert: bool): Input {
    return Input {
        moveX: 0.0, moveY: 0.0, boost: false, quit: false, mute: false, muteHeld: false,
        placeStep: 0, placeHeld: false,
        invert: invert,
    }
}

// Poll SDL and fill `inp`.
pub fn pollInput(inp: &mut Input, ev: &mut [u8; 64]) {
    inp.moveX = 0.0
    inp.moveY = 0.0
    inp.boost = false
    inp.mute = false
    inp.placeStep = 0

    unsafe {
        while SDL_PollEvent(ev) != 0 {
            let evType: u32 = (ev[0] as u32) | ((ev[1] as u32) << 8) | ((ev[2] as u32) << 16) | ((ev[3] as u32) << 24)
            if evType == SDL_QUIT {
                inp.quit = true
            }
        }
        let ks = SDL_GetKeyboardState(0 as *i32)
        if ks[SC_ESC] != 0 {
            inp.quit = true
        }
        // Edge-triggered, or holding M would toggle the music every frame.
        let mDown = ks[SC_M] != 0
        if mDown && !inp.muteHeld {
            inp.mute = true
        }
        inp.muteHeld = mDown
        if ks[SC_A] != 0 {
            inp.moveX = inp.moveX - 1.0
        }
        if ks[SC_D] != 0 {
            inp.moveX = inp.moveX + 1.0
        }
        // `moveY` is a pitch rate, +1 climb: the sign flips once, at the end,
        // rather than in four places.
        if ks[SC_W] != 0 {
            inp.moveY = inp.moveY + 1.0
        }
        if ks[SC_S] != 0 {
            inp.moveY = inp.moveY - 1.0
        }
        // Arrows do the same thing as WASD.
        if ks[SC_LEFT] != 0 {
            inp.moveX = inp.moveX - 1.0
        }
        if ks[SC_RIGHT] != 0 {
            inp.moveX = inp.moveX + 1.0
        }
        if ks[SC_UP] != 0 {
            inp.moveY = inp.moveY + 1.0
        }
        if ks[SC_DOWN] != 0 {
            inp.moveY = inp.moveY - 1.0
        }
        if inp.invert {
            inp.moveY = 0.0 - inp.moveY
        }
        // Edge-triggered like M: held down, this would rip through every place
        // in the rotation in a fraction of a second.
        let stepDown = ks[SC_LEFT] != 0 || ks[SC_RIGHT] != 0
        if stepDown && !inp.placeHeld {
            if ks[SC_RIGHT] != 0 {
                inp.placeStep = 1
            } else {
                inp.placeStep = 0 - 1
            }
        }
        inp.placeHeld = stepDown
        if ks[SC_SPACE] != 0 {
            inp.boost = true
        }
    }
}
