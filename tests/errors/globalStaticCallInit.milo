// @error: initializer is not a compile-time constant
// A static method call parses as an EnumLit, and the const-init guard used to accept any
// EnumLit whose arguments were const — which a zero-arg call vacuously is. So this was
// folded to a constant instead of run: two module-scope arenas both took id 0, and a
// handle from one resolved in the other. Rejected now, until module-scope runtime
// initialization actually exists.
from "std/arena" import { Arena, Handle }

struct Node {
    v: i64
}

var poolA: Arena<Node> = Arena<Node>.new()

pub fn main() {
    let a = poolA.alloc(Node { v: 11 })
    print(poolA.get(a)!.v)
}
