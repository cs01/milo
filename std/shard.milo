// std/shard — in-place parallelism by dividing OWNERSHIP, not by sharing references.
//
// The problem: applying a transform to a large Vec across several cores. Milo
// will not let a reference cross a thread boundary, so the safe route has been to
// give every worker its own copy of a chunk and stitch the copies back together.
// For a 20M-element buffer that copy costs more than the parallelism saves.
//
// The way out is not to weaken the reference rules, it is to make ownership
// divisible. `shatter` CONSUMES a Vec and returns an owner holding it, from which
// you take disjoint windows. Each window is an ordinary owned value, so a worker
// receives it by move like any other value, and the aliasing argument is the move
// checker that already shipped:
//
//     var data: Vec<f64> = Vec.filled(n, 1.0)
//     var owner = shatter(data, 4)     // `data` is moved; nothing else can reach it
//     let windows = owner.windows()!   // 4 disjoint Shard<f64>
//     ... hand each window to a worker by move, transform in place ...
//     let back = owner.weld(returned)! // the original Vec, same allocation
//
// The three things that make that safe are all rules Milo already had:
//
//   - `shatter` consumes the Vec, so after it there is no binding through which
//     the buffer can be reached except the windows.
//   - the windows are disjoint BY CONSTRUCTION: window i covers exactly
//     [i*chunk, (i+1)*chunk), computed here, never supplied by the caller.
//   - `Shard` is @noCopy, so handing the same window to two workers is
//     `error: use of moved variable`, not a race.
//
// What is NOT proven, and is checked at runtime instead: that every window comes
// back to `weld`. A window is a raw pointer into the owner's buffer, so a program
// that drops the owner while a worker still holds one has a use-after-free that
// nothing here catches. `weld` verifies that the windows it is handed all came
// from this shatter and cover it exactly, and fails deterministically otherwise.
// Keep the owner alive until weld: that is the one obligation this module asks of
// you, and it is the residue that stays honest in docs/residue-vs-rust.md.

from "std/os" import {
    free, malloc
}
from "std/runtime" import {
    Promise
}
from "std/sync" import {
    Channel
}

// A disjoint, owned window over part of one Vec's storage.
//
// @noCopy is doing real work here: a struct of a pointer and three integers would
// otherwise be Copy, and a Copy window could be handed to two workers at once,
// which is exactly the race the design claims to make unrepresentable.
@noCopy
pub struct Shard<T> {
    base: *T,
    len: i64,
    start: i64,
    shatterId: i64,
    index: i64,
}

// Fixed-size window: no push, no pop, no resize. The buffer's identity has to
// survive until weld, and a window that could reallocate would break that.
impl Shard<T> {
    // Elements in this window.
    fn len(self: &Self): i64 {
        return self.len
    }

    // Which window of the shatter this is, counting from 0.
    fn index(self: &Self): i64 {
        return self.index
    }

    // Where this window begins in the ORIGINAL buffer. Without it a worker can only
    // do position-independent work: a filter that needs to know which pixel, row or
    // sample it is looking at has no way to find out, because a window's own indices
    // all start at 0. Global position of element `i` is `start() + i`.
    fn start(self: &Self): i64 {
        return self.start
    }

    // The element at `i` within THIS window. Bounds-checked against the window's own
    // length, so a stray index cannot reach a sibling window's elements.
    fn get(self: &Self, i: i64): T {
        assert(i >= 0 && i < self.len, "shard: index out of range")
        unsafe {
            return self.base[i]
        }
    }

    // Overwrite the element at `i` within this window. Bounds-checked the same way.
    fn set(self: &mut Self, i: i64, val: T): void {
        assert(i >= 0 && i < self.len, "shard: index out of range")
        unsafe {
            self.base[i] = val
        }
    }

}

// Safety: the windows a shatter hands out are pairwise disjoint by construction,
// the Vec they cover was consumed by that shatter so no other binding reaches it,
// and @noCopy means a window has exactly one owner at a time. What crosses the
// thread boundary is therefore a pointer into memory nothing else can touch for
// as long as the window is alive.
unsafe

impl Send for Shard {
}

// Why a weld was refused, with no text attached: the numbers that used to be
// baked into a sentence (which window, how many were expected) live next to the
// data in the rejection, so a caller can branch on the cause instead of matching
// on a string.
pub enum WeldReason {
    // A window from a different shatter, or a hand-built one.
    Foreign,
    // The count is right but the coverage is not: a duplicate and a gap.
    NotCovered,
    // Wrong number of windows handed back.
    CountMismatch,
    // `parallelMapWith` was given no states, so there would be no worker to run on.
    NoWorkers,
}

// Owns the buffer while it is divided. Hold this until weld.
pub struct Shards<T> {
    buf: Vec<T>,
    count: i64,
    shatterId: i64,
    handedOut: bool,
}

// Why a refused weld is a struct and not a message: `weld` consumes the owner AND
// the windows, so a `Result<Vec<T>, string>` would destroy a 20M-element buffer
// and every window over it the instant a caller miscounted. This module exists so
// that buffer is never copied, which makes dropping it the one failure it cannot
// afford. The rejection carries all of it home: fix the set and weld again. Same
// shape, and the same reason, as `FreezeRejected` in std/arena and `ThawRejected`
// in std/seal.
pub struct WeldRejected<T> {
    // The owner, still holding the buffer untouched.
    shards: Shards<T>,
    // The windows exactly as they were handed in, in the order given.
    returned: Vec<Shard<T>>,
    // What was wrong.
    reason: WeldReason,
    // The window the refusal is about, or -1 when no single window is at fault.
    index: i64,
}

impl WeldRejected<T> {
    // A sentence for a human. The machine-readable form is `reason` and `index`;
    // this exists so a caller that only wants to log has something to log.
    fn message(self: &Self): string {
        match self.reason {
            WeldReason.CountMismatch => {
                return "weld: expected " + self.shards.count.toString() + " windows, got " + self.returned.len.toString()
            }
            WeldReason.Foreign => {
                return "weld: window " + self.index.toString() + " did not come from this shatter"
            }
            WeldReason.NotCovered => {
                return "weld: window " + self.index.toString() + " came back twice, or never came back"
            }
            WeldReason.NoWorkers => {
                return "parallelMapWith: states is empty, so there is no worker to run on"
            }
        }
    }
}

// Per-process shatter identity, so a window cannot be welded into the wrong owner.
// Allocated atomically because shatter can run on a Promise.blocking worker.
var nextShatterId: i64 = 1

// ESCAPE HATCH. Prefer `parallelMap`, which is this whole cycle in one call and the
// form in which `weld` cannot fail. Reach here only when the workers must differ from
// each other, or when you want the windows for something other than one task each.
//
// Consume a Vec and return an owner that can hand out `n` disjoint windows over
// its storage. O(1): nothing is copied, and the Vec's buffer is untouched.
//
// `n` is clamped to at least 1 and at most the element count, so a caller asking
// for more windows than elements gets one window per element rather than a pile
// of empty ones aliasing the same address.
pub fn shatter<T>(v: Vec<T>, n: i64): Shards<T> {
    var id: i64 = 0
    unsafe {
        id = _atomicAddI64((nextShatterId.addrOf()) as *u8, 1)
    }
    var wanted = n
    if wanted < 1 {
        wanted = 1
    }
    if v.len > 0 && wanted > v.len {
        wanted = v.len
    }
    var s: Shards<T> = Shards {
        buf: v,
        count: wanted,
        shatterId: id,
        handedOut: false,
    }
    return s
}

impl Shards<T> {
    // How many windows this shatter divides into.
    fn count(self: &Self): i64 {
        return self.count
    }

    // Elements across all windows.
    fn len(self: &Self): i64 {
        return self.buf.len
    }

    // ESCAPE HATCH (see `shatter`). The windows, once. A second call returns an empty
    // Vec rather than a second set of pointers to the same storage, which would hand
    // out aliases and defeat the whole design.
    fn windows(self: &mut Self): Vec<Shard<T>> {
        var out: Vec<Shard<T>> = Vec.new()
        if self.handedOut {
            return out
        }
        self.handedOut = true
        let total = self.buf.len
        let chunk = total / self.count
        var i: i64 = 0
        unsafe {
            let p = self.buf.ptr()
            while i < self.count {
                let lo = i * chunk
                var hi = lo + chunk
                if i == self.count - 1 {
                    hi = total
                }
                var sh: Shard<T> = Shard {
                    base: ((p as i64) + lo * sizeOf<T>()) as *T,
                    len: hi - lo,
                    start: lo,
                    shatterId: self.shatterId,
                    index: i,
                }
                out.push(sh)
                i = i + 1
            }
        }
        return out
    }

    // ESCAPE HATCH (see `shatter`). Reassemble: consume the owner and the windows, and
    // hand back the original Vec with its original allocation.
    //
    // The checks are what keep a mistake a logic error instead of corruption: every
    // window must carry this shatter's identity, and the set must cover every index
    // exactly once. A missing window would mean some worker still holds a pointer
    // into this buffer, and returning the Vec then would be the use-after-free this
    // module exists to avoid.
    //
    // A refusal costs nothing: the `WeldRejected` hands the owner and every window
    // back, so the caller fixes the set and welds again.
    fn weld(self: Self, returned: Vec<Shard<T>>): Result<Vec<T>, WeldRejected<T>> {
        var reason: WeldReason = WeldReason.CountMismatch
        var bad: i64 = -1
        var ok = returned.len == self.count
        if ok {
            var seen: Vec<bool> = Vec.new()
            var i: i64 = 0
            while i < self.count {
                seen.push(false)
                i = i + 1
            }
            // Every check records its verdict and leaves; the rejection is built
            // once, at the bottom. Returning from inside the loop instead would
            // mean moving `returned` while the loop still borrows it.
            for w in returned {
                if w.shatterId != self.shatterId || w.index < 0 || w.index >= self.count {
                    reason = WeldReason.Foreign
                    bad = w.index
                    ok = false
                    break
                }
                if seen[w.index] {
                    reason = WeldReason.NotCovered
                    bad = w.index
                    ok = false
                    break
                }
                seen[w.index] = true
            }
            if ok {
                var j: i64 = 0
                while j < self.count {
                    if !seen[j] {
                        reason = WeldReason.NotCovered
                        bad = j
                        ok = false
                        j = self.count
                    } else {
                        j = j + 1
                    }
                }
            }
        }
        if !ok {
            var r: WeldRejected<T> = WeldRejected {
                shards: self, returned: returned, reason: reason, index: bad
            }
            return Result.Err(r)
        }
        return Result.Ok(self.buf)
    }

    // Take the buffer back from an owner that never handed a window out.
    //
    // This is the way home for a refusal that happens BEFORE any division, where
    // `weld` is not an option because there are no windows to weld. Once
    // `windows` has run, some worker may hold a pointer into the buffer, so the
    // only sound route back is `weld` and its coverage check; `handedOut` records
    // exactly that moment, which is why it is the condition here.
    fn reclaim(self: Self): Result<Vec<T>, Shards<T>> {
        if self.handedOut {
            return Result.Err(self)
        }
        return Result.Ok(self.buf)
    }
}

// Divide, run on `workers` threads, reassemble. The whole cycle in one call.
//
//     let out = parallelMap(pixels, 4, shade)!
//
// This is the shape almost every use wants, and doing it by hand means draining the
// window Vec, building a Vec of Promises, awaiting them and welding — plumbing that
// says nothing about the work. Reach for shatter/windows/weld directly only when the
// workers need to differ from each other, or when you want the windows for something
// other than one task each.
//
// `f` is a plain function rather than a closure because each worker needs its own
// copy: a capturing closure would be moved into the first task and gone for the rest.
// Everything the work depends on therefore travels in the window itself, which is
// also what keeps the workers from sharing anything.
pub fn parallelMap<T>(v: Vec<T>, workers: i64, f: (Shard<T>) => Shard<T>): Result<Vec<T>, WeldRejected<T>> {
    var owner = shatter(v, workers)
    var windows = owner.windows()
    var ps: Vec<Promise<Shard<T>>> = Vec.new()
    while windows.len > 0 {
        let w = windows.pop()!
        ps.push(Promise<Shard<T>>.blocking(move(): Shard<T> => {
            return f(w)
        }
        ))
    }
    let back = Promise.all(ps).await()!
    return owner.weld(back)
}

// The result of a stateful parallel map: the transformed buffer, plus every
// worker's environment handed back in the order the environments were given.
pub struct Mapped<T, S> {
    data: Vec<T>,
    states: Vec<S>,
}

// parallelMap with two things it cannot express: more windows than workers, and
// per-worker state.
//
// More windows than workers is how uneven work balances out. parallelMap spawns
// one thread per window, so over-partitioning a 64-window render costs 64 OS
// threads. Here `states.len` fixes the worker count and the windows go into a
// queue the workers pull from: a worker that drew a cheap window pulls another,
// and one that drew the expensive window keeps grinding without idling the rest.
//
// The states are the answer to "why must `f` be a plain function": a closure
// cannot be copied to N workers, so whatever it would have captured travels as an
// explicit owned value instead. Each worker moves one `S` in, threads it through
// every window it processes, and hands it back through the result. Configuration
// rides in, accumulators ride out, and nothing is shared: an S is on exactly one
// thread at a time, which is the same move-checker argument the windows use.
//
// Which worker processes which window is scheduling, so state a caller reads back
// must not encode the assignment: per-worker tallies merge into totals that are
// deterministic even though each worker's share is not.
pub fn parallelMapWith<T, S>(v: Vec<T>, windows: i64, states: Vec<S>, f: (Shard<T>, &mut S) => Shard<T>): Result<Mapped<T, S>, WeldRejected<T>> {
    // `v` was moved in at the call, so refusing here with a message alone would
    // take the caller's buffer down with the refusal. Shatter it into an owner
    // that never hands a window out and refuse with THAT: `rej.shards.reclaim()`
    // gives the buffer back whole. `states` is empty by definition of this
    // refusal, so there is nothing of the caller's in it to return.
    //
    // A non-positive `windows` is not checked at all: `shatter` already clamps the
    // count to at least one, so the old guard rejected an input the divider was
    // about to accept.
    if states.len <= 0 {
        var idle = shatter(v, 1)
        var none: Vec<Shard<T>> = Vec.new()
        var r: WeldRejected<T> = WeldRejected {
            shards: idle, returned: none, reason: WeldReason.NoWorkers, index: -1
        }
        return Result.Err(r)
    }
    var owner = shatter(v, windows)
    var ws = owner.windows()
    // `shatter` clamps the count to one window per element, so asking for more
    // windows than the buffer has elements yields FEWER than `windows`. Every
    // count below has to come from the windows that actually exist: driving the
    // collection loop off the parameter instead waits for windows nobody will
    // send, and since this function still holds a sender on `out`, that wait
    // never ends. Over-partitioning a small input is the exact thing this
    // function tells callers to do, so the parameter is the wrong source.
    let made = ws.len
    // Capacity = one slot per window on both queues, so every send below
    // completes without a waiting reader and no interleaving can deadlock.
    let jobs = Channel<Shard<T>>.new(made)!
    let out = Channel<Shard<T>>.new(made)!
    var ps: Vec<Promise<S>> = Vec.new()
    var sts = states
    while sts.len > 0 {
        let st = sts.pop()!
        let jc = jobs.clone()
        let oc = out.clone()
        ps.push(Promise<S>.blocking(move(): S => {
            var s = st
            while true {
                let j = jc.recv()
                if j.isErr() {
                    break
                }
                oc.send(f(j!, s))!
            }
            return s
        }
        ))
    }
    while ws.len > 0 {
        jobs.send(ws.pop()!)!
    }
    jobs.close()
    var back: Vec<Shard<T>> = Vec.new()
    for i in 0..made {
        back.push(out.recv()!)
    }
    var got = Promise.all(ps).await()!
    // Workers were spawned by popping states from the tail, so `got` is the
    // caller's order reversed; popping it again restores the order given.
    var ordered: Vec<S> = Vec.new()
    while got.len > 0 {
        ordered.push(got.pop()!)
    }
    let data = owner.weld(back)?
    return Result.Ok(Mapped {
        data: data, states: ordered
    }
    )
}

// ---------------------------------------------------------------------------
// Read-only windows over a string.
// ---------------------------------------------------------------------------
//
// The Vec side above divides ownership so workers can WRITE disjoint ranges. A
// scanner does not write at all, and the buffer it wants to divide is almost always
// a `string`, because that is what `readFile` hands back. Converting one to a
// `Vec<u8>` first costs a full copy (19-33 ms for 51 MiB, against a 34 ms scan), so
// the copy would eat the parallelism it was bought for.
//
// So this is the read-only half: the owner keeps the string, the windows are views,
// and nothing mutates. The two consequences of nobody writing are:
//
//   - windows may OVERLAP. A literal that straddles a boundary is missed by disjoint
//     windows, and the usual fix is to scan the seams afterwards. Overlap is sound
//     here precisely because these are reads, so `windows(overlap)` lets a scanner
//     ask for `needle.len - 1` bytes of slack and stop thinking about seams. Mind
//     that a match inside the overlap is found by BOTH neighbours, so a counter must
//     ignore hits that begin at or past its own `len` minus the overlap.
//   - `weld` is only about giving the string back. There is no coverage obligation
//     the way there is for the writing side, but the identity check stays, because
//     welding a window from another shatter still means the caller lost track.

@noCopy
pub struct StrShard {
    base: *u8,
    len: i64,
    start: i64,
    shatterId: i64,
    index: i64,
}

impl StrShard {
    // Bytes in this window, including any overlap it was given.
    fn len(self: &Self): i64 {
        return self.len
    }

    // Where this window begins in the original string.
    fn start(self: &Self): i64 {
        return self.start
    }

    // Which window of the shatter this is, counting from 0.
    fn index(self: &Self): i64 {
        return self.index
    }

    // The byte at `i` within this window, bounds-checked against its length.
    fn byteAt(self: &Self, i: i64): u8 {
        assert(i >= 0 && i < self.len, "str shard: index out of range")
        unsafe {
            return self.base[i]
        }
    }

    // Whether this window's bytes at `i` match `needle`. Bounded by the window, so a
    // needle running past the end is simply not a match here; give the window an
    // overlap if you need to catch one that straddles the boundary.
    fn matchesAt(self: &Self, i: i64, needle: &string): bool {
        if i < 0 || i + needle.len > self.len {
            return false
        }
        var k: i64 = 0
        unsafe {
            while k < needle.len {
                if self.base[i + k] != needle[k] {
                    return false
                }
                k = k + 1
            }
        }
        return true
    }
}

// Safety: every window is a read-only view of a string the owner holds for as long
// as the windows are alive, and no method on StrShard writes. Overlapping windows
// are therefore fine: concurrent reads of the same bytes race with nothing.
unsafe

impl Send for StrShard {
}

pub struct StrShards {
    buf: string,
    count: i64,
    shatterId: i64,
    handedOut: bool,
}

// The reading side's refusal, carrying the string back for the same reason the
// writing side carries the buffer back: `weld` consumes the owner, and a 51 MiB
// file that a scanner misrouted is not something to throw away over a diagnostic.
pub struct StrWeldRejected {
    // The owner, still holding the string.
    shards: StrShards,
    // The windows exactly as they were handed in.
    returned: Vec<StrShard>,
    // Always `Foreign` today: reads have no coverage obligation, so identity is
    // the only thing this side can refuse over.
    reason: WeldReason,
    // The window that came from another shatter.
    index: i64,
}

impl StrWeldRejected {
    // A sentence for a human; `reason` and `index` are the machine-readable form.
    fn message(self: &Self): string {
        return "weld: window " + self.index.toString() + " did not come from this shatter"
    }
}

// Consume a string and return an owner that hands out `n` read-only windows.
//
// Unlike the Vec side there is no one-call form to prefer: `parallelMap` is map-shaped
// (Vec<T> in, Vec<T> out) and a scan returns something else entirely, so this IS the
// supported way to divide a string across workers.
pub fn shatterStr(s: string, n: i64): StrShards {
    var id: i64 = 0
    unsafe {
        id = _atomicAddI64((nextShatterId.addrOf()) as *u8, 1)
    }
    var wanted = n
    if wanted < 1 {
        wanted = 1
    }
    if s.len > 0 && wanted > s.len {
        wanted = s.len
    }
    var out: StrShards = StrShards {
        buf: s,
        count: wanted,
        shatterId: id,
        handedOut: false,
    }
    return out
}

impl StrShards {
    // How many windows this shatter divides into.
    fn count(self: &Self): i64 {
        return self.count
    }

    // Bytes in the underlying string, across all windows.
    fn len(self: &Self): i64 {
        return self.buf.len
    }

    // The windows, once. `overlap` extends each window that far into the next, so a
    // scanner looking for an `m`-byte needle passes `m - 1` and never has to stitch
    // the seams. Pass 0 for exactly disjoint windows.
    fn windows(self: &mut Self, overlap: i64): Vec<StrShard> {
        var out: Vec<StrShard> = Vec.new()
        if self.handedOut {
            return out
        }
        self.handedOut = true
        let total = self.buf.len
        let chunk = total / self.count
        var i: i64 = 0
        unsafe {
            let p = self.buf.cstr()
            while i < self.count {
                let lo = i * chunk
                var hi = lo + chunk
                if i == self.count - 1 {
                    hi = total
                }
                var end = hi + overlap
                if end > total {
                    end = total
                }
                var sh: StrShard = StrShard {
                    base: ((p as i64) + lo) as *u8,
                    len: end - lo,
                    start: lo,
                    shatterId: self.shatterId,
                    index: i,
                }
                out.push(sh)
                i = i + 1
            }
        }
        return out
    }

    // Give the string back. Windows are reads, so unlike the writing side there is no
    // coverage obligation; the identity check stays because a foreign window means the
    // caller has lost track of which shatter it is holding.
    fn weld(self: Self, returned: Vec<StrShard>): Result<string, StrWeldRejected> {
        var bad: i64 = -1
        for w in returned {
            if w.shatterId != self.shatterId {
                bad = w.index
                break
            }
        }
        if bad >= 0 {
            var r: StrWeldRejected = StrWeldRejected {
                shards: self, returned: returned, reason: WeldReason.Foreign, index: bad
            }
            return Result.Err(r)
        }
        return Result.Ok(self.buf)
    }
}
