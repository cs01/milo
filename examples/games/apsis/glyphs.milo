// A real typeface, instead of a 5x7 bitmap.
//
// Every game in this repo inherited the same blocky 5x7 font from the first one,
// and at the sizes this HUD needs it is genuinely hard to read — which is the
// only reason anyone ever notices a font. This one is Menlo, rasterised by
// CoreText into an alpha atlas by `tools/mkfont.swift`, decoded here, and drawn
// with bilinear sampling so it stays smooth at any size rather than at integer
// multiples of one.
//
// Glyphs are ASCII 32..126 in a 16-column grid of 24x40 cells. The atlas is
// stored as RGB because the decoder in std/png handles truecolour and not
// greyscale; only the red channel is read.

from "std/math" import {
    Math
}
from "std/png" import {
    Png
}

pub let CELL_W: i64 = 24

pub let CELL_H: i64 = 40

pub let COLS: i64 = 16

pub let FIRST: i64 = 32

pub let LAST: i64 = 126

// Menlo's advance is 0.6 em and the cell is 24 wide for an 18px advance, so a
// glyph box is 4/3 of the advance and 40/18 of it tall. Keeping the advance at
// `6 * scale` means every existing layout calculation still lands where it did.
pub let ADVANCE_PER_SCALE: f64 = 6.0

pub struct Font {
    w: i64,
    h: i64,
    a: Vec<u8>, // one byte of coverage per texel
    ok: bool,
}

pub fn fontEmpty(): Font {
    return Font {
        w: 0, h: 0, a: Vec.new(), ok: false
    }
}

pub fn fontLoad(png: &string): Font {
    match Png.decode(png) {
        Result.Ok(img) => {
            var a: Vec<u8> = Vec.filled(img.width * img.height, 0 as u8)
            var i = 0
            while i < img.width * img.height {
                a[i] = img.pixels[i * img.channels]
                i = i + 1
            }
            return Font {
                w: img.width, h: img.height, a: a, ok: true
            }
        }
        Result.Err(_) => {
            return fontEmpty()
        }
    }
}

// Bilinear coverage at a point inside the atlas, in texel coordinates.
fn sample(f: &Font, x: f64, y: f64): f64 {
    let x0 = Math.floor(x) as i64
    let y0 = Math.floor(y) as i64
    let fx = x - (x0 as f64)
    let fy = y - (y0 as f64)
    var acc = 0.0
    var j = 0
    while j < 2 {
        var i = 0
        while i < 2 {
            let sx = x0 + i
            let sy = y0 + j
            if sx >= 0 && sx < f.w && sy >= 0 && sy < f.h {
                var wx = 1.0 - fx
                if i == 1 {
                    wx = fx
                }
                var wy = 1.0 - fy
                if j == 1 {
                    wy = fy
                }
                acc = acc + (f.a[sy * f.w + sx] as f64) * wx * wy
            }
            i = i + 1
        }
        j = j + 1
    }
    return acc / 255.0
}

pub fn glyphAdvance(scale: i64): f64 {
    return ADVANCE_PER_SCALE * (scale as f64)
}

// Draw one glyph with its top-left box corner at (px, py).
fn glyph(hdr: &mut Vec<f32>, cw: i64, ch: i64, f: &Font, code: i64, px: f64, py: f64, boxW: f64, boxH: f64, r: f64, g: f64, b: f64) {
    if code < FIRST || code > LAST {
        return
    }
    let idx = code - FIRST
    let cx = ((idx % COLS) * CELL_W) as f64
    let cy = ((idx / COLS) * CELL_H) as f64
    var y = 0
    let ih = Math.ceil(boxH) as i64
    let iw = Math.ceil(boxW) as i64
    while y < ih {
        let ty = cy + ((y as f64) + 0.5) / boxH * (CELL_H as f64)
        let dy = (py as i64) + y
        if dy >= 0 && dy < ch {
            var x = 0
            while x < iw {
                let tx = cx + ((x as f64) + 0.5) / boxW * (CELL_W as f64)
                let dx = (px as i64) + x
                if dx >= 0 && dx < cw {
                    let a = sample(f, tx, ty)
                    if a > 0.004 {
                        let o = (dy * cw + dx) * 3
                        hdr[o] = hdr[o] + ((r * a) as f32)
                        hdr[o + 1] = hdr[o + 1] + ((g * a) as f32)
                        hdr[o + 2] = hdr[o + 2] + ((b * a) as f32)
                    }
                }
                x = x + 1
            }
        }
        y = y + 1
    }
}

pub fn drawText(hdr: &mut Vec<f32>, cw: i64, ch: i64, f: &Font, x: i64, y: i64, s: &string, scale: i64, r: f64, g: f64, b: f64) {
    if !f.ok {
        return
    }
    let adv = glyphAdvance(scale)
    let boxW = adv * 4.0 / 3.0
    let boxH = boxW * (CELL_H as f64) / (CELL_W as f64)
    var i = 0
    while i < s.len {
        glyph(hdr, cw, ch, f, s[i] as i64, (x as f64) + adv * (i as f64), (y as f64) - boxH * 0.16, boxW, boxH, r, g, b)
        i = i + 1
    }
}
