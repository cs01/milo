// JSON parse + walk using std/json
from "std/json" import {
    Json
}
from "std/fs" import {
    readFile
}

fn main(): i32 {
    if _miloArgCount() < 2 {
        print("usage: json <file>")
        return 2
    }
    var content: string = ""
    match readFile(_miloArgAt(1)) {
        Result.Ok(d) => {
            content = d
        }
        Result.Err(e) => {
            print("err: ", e)
            return 1
        }
    }
    var doc = Json.parse("null")!
    match Json.parse(content) {
        Result.Ok(d) => {
            doc = d
        }
        Result.Err(e) => {
            print("parse error: ", e)
            return 1
        }
    }
    var sum: f64 = 0.0
    var active: i64 = 0
    // Cursor navigation, so the benchmark still measures parsing rather than the
    // deep clone an owned accessor would do per item.
    let items = doc.curField(doc.curRoot(), "items")
    let n = doc.curLen(items)
    var i: i64 = 0
    while i < n {
        let item = doc.curChild(items, i)
        match doc.curFloat(doc.curField(item, "price")) {
            Option.Some(p) => {
                sum = sum + p
            }
            Option.None => {
            }
        }
        match doc.curBool(doc.curField(item, "active")) {
            Option.Some(a) => {
                if a {
                    active = active + 1
                }
            }
            Option.None => {
            }
        }
        i = i + 1
    }
    print("items=", n, " sum=", sum, " active=", active)
    return 0
}
