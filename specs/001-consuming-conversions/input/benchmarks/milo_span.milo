// Seal/Span prototype: seal the doc (consume it into a read-only wrapper),
// scan storing Spans (two integers), consume via transient views. Zero copies.
from "std/time" import {
    epochMillis
}
from "std/fmt" import {
    join
}

struct Span {
    start: i64,
    len: i64,
}

// Prototype Sealed<u8>: owns the string, exposes ONLY read methods.
// Mutation isn't rejected by a check — no such method exists on the type.
struct Sealed {
    data: string,
}

impl Sealed {
    fn len(self: &Self): i64 {
        return self.data.len
    }
    fn byte(self: &Self, i: i64): u8 {
        return self.data[i]
    }
    // resolve a span transiently: sum its bytes without materializing
    fn byteSum(self: &Self, s: &Span): i64 {
        var acc: i64 = 0
        var k = s.start
        let end = s.start + s.len
        while k < end {
            acc = acc + (self.data[k] as i64)
            k = k + 1
        }
        return acc
    }
}

fn seal(v: string): Sealed {
    return Sealed {
        data: v
    } // consumes: O(1), zero copies
}

fn genDoc(records: i64): string {
    var parts: Vec<string> = Vec.withCapacity(records + 2)
    parts.push("[")
    var i: i64 = 0
    while i < records {
        let id = i.toString()
        var pad = ""
        var z = id.len
        while z < 6 {
            pad = pad + "0"
            z = z + 1
        }
        var rec = ""
        if i > 0 {
            rec = ","
        }
        rec = rec + "{\"name\":\"user_" + pad + id + "\",\"mail\":\"user_" + pad + id
        + "@example.com\",\"note\":\"lorem ipsum dolor sit amet " + pad + id + "\"}"
        parts.push(rec)
        i = i + 1
    }
    parts.push("]")
    return join(parts, "")
}

pub fn main(): i32 {
    let records: i64 = 500000
    let raw = genDoc(records)
    print("doc bytes=" + raw.len.toString())

    let src = seal(raw) // raw is moved — mutation no longer exists
    let t0 = epochMillis()

    var spans: Vec<Span> = Vec.new()
    var i: i64 = 0
    let n = src.len()
    while i < n {
        if src.byte(i) == 34 {
            let start = i + 1
            var j = start
            while j < n {
                if src.byte(j) == 34 {
                    break
                }
                j = j + 1
            }
            spans.push(Span {
                start: start, len: j - start
            }
            ) // two integers
            i = j + 1
        } else {
            i = i + 1
        }
    }

    var sum: i64 = 0
    var count: i64 = 0
    for s in spans {
        sum = sum + src.byteSum(s)
        count = count + 1
    }
    let t1 = epochMillis()
    print("span ms=" + (t1 - t0).toString() + " strings=" + count.toString() + " sum=" + sum.toString())
    return 0
}
