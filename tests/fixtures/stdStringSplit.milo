// @expect: foo
// @expect: 3
// @expect: hello world
// @expect: aXbXc
// @expect: abcabc
// @expect: 6

from "std/string" import {
    strIndexOf, strRepeat, strReplace, strSplit
}

pub fn main(): i32 {
    let parts = "hello,world,foo".split(",")
    for p in parts {
        print(p)
    }
    print(parts.len)

    let replaced = "hello-world".replace("-", " ")
    print(replaced)

    let r2 = "a_b_c".replace("_", "X")
    print(r2)

    let repeated = "abc".repeat(2)
    print(repeated)

    let idx = "hello world".indexOf("world")!
    print(idx)

    return 0
}
