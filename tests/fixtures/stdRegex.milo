// @skip-os: win32
// std/regex binds POSIX regcomp, which the MSVC CRT does not provide.

// @expect: match
// @expect: no match
// @expect: 42
// @expect: 3

from "std/regex" import {
    Regex
}

pub fn main(): i32 {
    match Regex.compile("[0-9]+") {
        Result.Ok(re) => {
            if re.isMatch("hello 123") {
                print("match")
            }
            if !re.isMatch("no digits") {
                print("no match")
            }

            match re.find("abc 42 def 99") {
                Option.Some(m) => {
                    let input = "abc 42 def 99"
                    print(input[m.start..m.end])
                }
                Option.None => {
                    print("none")
                }
            }

            let all = re.findAll("abc 42 def 99 ghi 7")
            print(all.len.toString())
        }
        Result.Err(_e) => {
            print("compile fail")
        }
    }
    return 0
}
