// milox — a small scripting language whose entire point is its value
// representation. See README.md.
//
// @run: demo
from "./value" import {
    Value, QNAN, SIGN
}
from "./heap" import {
    Heap, Obj, heapWith
}
from "./compiler" import {
    compile, CompileResult
}
from "./vm" import {
    VM
}
from "./disasm" import {
    disassemble
}
from "std/argparse" import {
    ArgParser
}
from "std/fs" import {
    readFile
}
from "std/time" import {
    now, since
}

let DEMO: string = "
// milox demo: everything the language has.
var greeting = \"milox\";
print greeting + \" says hi\";

fn fib(n) {
  if (n < 2) return n;
  return fib(n - 1) + fib(n - 2);
}
print fib(20);

var xs = [1, 2, 3, 4, 5];
var total = 0;
var i = 0;
while (i < len(xs)) {
  total = total + xs[i];
  i = i + 1;
}
print total;

xs[0] = 100;
print xs;

var words = [\"the\", \"quick\", \"brown\"];
var joined = \"\";
i = 0;
while (i < len(words)) {
  joined = joined + words[i] + \" \";
  i = i + 1;
}
print joined;
print true and !false;
print nil == nil;
"

// A reachable list is handed to a collector that has been told to free one live
// object. In C this is a use-after-free that surfaces later as corrupted data;
// here the next touch of the box fails the generation check.
let GC_BUG_PROGRAM: string = "
var keep = [1, 2, 3];
var i = 0;
while (i < 400) {
  var garbage = [i, i];
  i = i + 1;
}
print keep[0];
"

fn runSource(src: string, disasm: bool, stats: bool, buggyGc: bool, stressGc: bool): bool {
    var heap: Heap = Heap.new()
    let result = compile(src, heap)
    if !result.ok {
        for e in result.errors {
            print(e)
        }
        return false
    }
    if disasm {
        print(disassemble(result.functions, heap))
    }
    var vm: VM = VM.new(heap, result.functions)
    vm.setBuggyGc(buggyGc)
    vm.setStressGc(stressGc)
    let t0 = now()
    let ok = vm.run()
    let d = since(t0)
    if !ok {
        print(vm.error())
    }
    if stats {
        print("--- " + d.toMillis().toString() + "ms, " + vm.stepCount().toString() + " instructions, " + vm.allocCount().toString() + " allocations, " + vm.gcCount().toString() + " collections, " + vm.liveObjects().toString() + " live objects, " + vm.danglingCaught().toString() + " dangling references caught")
    }
    return ok
}

// Every 64-bit pattern an attacker could produce, tagged to claim it is a heap
// pointer. In a C nan-boxed VM the mantissa becomes an address and gets
// dereferenced; bun shipped exactly that bug in `bun:ffi` (upstream commit
// 179978a6f9, "purify NaNs before NaN-boxing doubles from native code").
fn demoForge() {
    var heap: Heap = Heap.new()
    let real = heap.allocStr("a live object")
    var st: u64 = 0x9e3779b97f4a7c15
    var i: i64 = 0
    var reached: i64 = 0
    var rejected: i64 = 0
    let N: i64 = 2000000
    while i < N {
        st = st ^ (st << 13)
        st = st ^ (st >> 7)
        st = st ^ (st << 17)
        let forged = Value {
            bits: SIGN | QNAN | (st & 0x3ffffffffffff)
        }
        match heapWith(heap, forged, (o: &Obj): i64 => {
            return 1
        }
        ) {
            Some(n) => {
                reached = reached + 1
            }
            None => {
                rejected = rejected + 1
            }
        }
        i = i + 1
    }
    print("forged " + N.toString() + " object boxes from random 64-bit payloads")
    print("  dereferenced: " + reached.toString())
    print("  rejected by the generation check: " + rejected.toString())
    let stillThere = heapWith(heap, real, (o: &Obj): bool => {
        return true
    }
    )
    print("  the real object is untouched: " + stillThere.isSome().toString())
}

// A host program embedding milox. The rule is authored as text, so it can come
// from a config file, a designer, or a database, and changing it needs no
// recompile of the host. Everything crossing the boundary is a Value.
let DYNAMIC: string = "
// one list, five different types
var stuff = [1, \"two\", true, nil, [3, 4]];
print stuff;
print len(stuff);

// a variable that changes type whenever it feels like it
var x = 42;
print x;
x = \"now i am a string\";
print x;
x = [x, x];
print x;

// functions are values
fn double(n) { return n * 2; }
fn shout(s) { return s + \"!\"; }
var ops = [double, shout];
print ops;
print ops[0](21);
print ops[1](\"hey\");

// pick a function at runtime
fn pick(which) { if (which < 1) return double; return shout; }
print pick(0)(50);
print pick(9)(\"dynamic dispatch\");

// nested structure, mutated in place
var tree = [[1, 2], [3, [4, 5]]];
tree[1][1][0] = 99;
print tree;

// closure-ish: a list carrying its own operation
fn apply(f, v) { return f(v); }
print apply(double, 8);

// dictionaries: string keys, insertion order, values of any type
var enemy = {\"name\": \"goblin\", \"hp\": 12, \"tags\": [\"cave\", \"fast\"]};
print enemy;
print enemy[\"hp\"];
enemy[\"hp\"] = 3;
enemy[\"state\"] = \"flee\";
print enemy;
print keys(enemy);
print len(enemy);
print has(enemy, \"state\");
print enemy[\"gold\"];
print {};

// dicts and lists nest either way around
var party = [{\"n\": \"a\"}, {\"n\": \"b\"}];
party[1][\"n\"] = \"z\";
print party;
var world = {\"grid\": [[1, 2], [3, 4]]};
world[\"grid\"][1][0] = 9;
print world;
"

let RULE_CAUTIOUS: string = "
if (hp < 30) {
  state = \"flee\";
  speed = speed * 2;
} else {
  state = \"attack\";
}
log = [name, state, hp, speed];
"

let RULE_RECKLESS: string = "
state = \"attack\";
speed = speed * 3;
log = [name, state, hp, speed];
"

let RULE_BROKEN: string = "
var xs = [1, 2, 3];
state = \"about to reach past the end\";
print xs[9999];
state = \"never runs\";
"

fn runRule(label: string, rule: string, hp: f64, speed: f64, name: string) {
    var heap: Heap = Heap.new()
    let r = compile(rule, heap)
    if !r.ok {
        for e in r.errors {
            print("  " + e)
        }
        return
    }
    var vm: VM = VM.new(heap, r.functions)
    // Host state in.
    vm.defineGlobalString("name", name)
    vm.defineGlobalNumber("hp", hp)
    vm.defineGlobalNumber("speed", speed)
    vm.defineGlobalString("state", "idle")
    vm.defineGlobalNumber("log", 0.0)
    let ok = vm.run()
    print("  " + label)
    if !ok {
        print("    " + vm.error())
    }
    // Host state out — readable whether or not the script finished.
    print("    state = " + vm.showGlobal("state"))
    print("    speed = " + vm.showGlobal("speed"))
    print("    log   = " + vm.showGlobal("log"))
}

fn demoEmbed() {
    print("one host, three scripts, no recompile between them")
    print("")
    runRule("cautious rule, wounded (hp 12)", RULE_CAUTIOUS.clone(), 12.0, 3.0, "goblin")
    print("")
    runRule("cautious rule, healthy (hp 80)", RULE_CAUTIOUS.clone(), 80.0, 3.0, "goblin")
    print("")
    runRule("reckless rule, same host", RULE_RECKLESS.clone(), 80.0, 3.0, "ogre")
    print("")
    runRule("broken rule reaches past the end of a list", RULE_BROKEN.clone(), 80.0, 3.0, "imp")
    print("")
    print("the broken script stopped at the bad instruction and the host still")
    print("read its state back. a script cannot express an address, so there is")
    print("no bug it can write that reaches host memory.")
}

pub fn main(): i32 {
    var parser = ArgParser.new("milox", "a small scripting language whose every runtime value is 8 bytes")
    parser.addOptionalPositional("target", "a .milox script to run, or a demo name (default: demo)")
    parser.addBool("disasm", "d", "dump bytecode before running")
    parser.addBool("stats", "s", "print instruction, allocation and GC counts")
    parser.addBool("gc-stress", "", "collect on every allocation (clox's DEBUG_STRESS_GC)")
    parser.setEpilog("demos:\n" + "  demo      a tour of the language\n" + "  dynamic   heterogeneous lists, retyped variables, functions as values\n" + "  embed     embed milox in a host program and pass values across\n" + "  gc-bug    free a reachable object on purpose, watch it get caught\n" + "  forge     forge 2M object references, watch none of them deref")
    let parsed = parser.parse()

    let target = parsed.getString("target") ?? "demo"
    let disasm = parsed.getBool("disasm")
    let stats = parsed.getBool("stats")
    let stressGc = parsed.getBool("gc-stress")

    if target == "demo" {
        if !runSource(DEMO, disasm, stats, false, stressGc) {
            return 1
        }
        return 0
    }
    if target == "dynamic" {
        if !runSource(DYNAMIC.clone(), disasm, stats, false, stressGc) {
            return 1
        }
        return 0
    }
    if target == "embed" {
        demoEmbed()
        return 0
    }
    if target == "forge" {
        demoForge()
        return 0
    }
    if target == "gc-bug" {
        print("running with a deliberately broken collector that frees one reachable object")
        print("")
        let ok = runSource(GC_BUG_PROGRAM, disasm, true, true, stressGc)
        print("")
        if ok {
            print("the collector bug did not happen to hit a live object this run")
        } else {
            print("caught at the instruction that touched it, with a line number.")
            print("the same bug in a C nan-boxed VM is a use-after-free that surfaces")
            print("somewhere else entirely, as corrupted data or a crash.")
        }
        // The planted bug being caught is the demo succeeding.
        return 0
    }
    match readFile(target) {
        Ok(src) => {
            if !runSource(src, disasm, stats, false, stressGc) {
                return 1
            }
            return 0
        }
        Err(e) => {
            print("milox: cannot read '" + target + "'")
            print(parser.helpText())
            return 1
        }
    }
}
