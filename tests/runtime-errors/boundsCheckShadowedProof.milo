// The companion to tests/fixtures/boundsCheckShadowedVec: that one locks that a
// valid index survives, this one locks WHICH length a failing index is compared
// against. `buf` is declared twice in sibling scopes (nested shadowing is a
// checker error, so this is the only shape the bug takes) and the loop runs off
// the end of the second one. The report must read 2/2 — the length of the vec
// actually indexed. Before the fix it read 0/0: the length came from the first
// `buf`'s slot, which its drop had already zeroed.
//
// That zeroing is also why this bug could only ever trap early, never read out of
// bounds silently — a stale length is 0, and 0 fails every check.

// @runtime-error: array index out of bounds: 2/2

fn mk(n: i64): Vec<i64> {
    var v: Vec<i64> = Vec.new()
    var i: i64 = 0
    while i < n {
        v.push(i)
        i = i + 1
    }
    return v
}

pub fn main() {
    var seed: i64 = 0
    if true {
        let buf = mk(8)
        seed = buf[7]
    }
    print($"seed={seed}")
    var sum: i64 = 0
    var n: i64 = 0
    while n < 8 {
        let buf = mk(2)
        sum = sum + buf[n]
        n = n + 1
    }
    print($"sum={sum}")
}
