// Game state, and the rules that move it.
//
// The camera lives here rather than in the renderer because where you are
// looking is something the game reasons about: committing a plan moves the
// focus, and arriving moves it again.
//
// The loop is plan → commit → coast → capture. Nothing in it asks the player for
// a number: the plan comes from a date and a flight time, the commit spends what
// the plan said it would, and the capture burn is offered when the ship is at
// periapsis and not before.

from "std/math" import {
    Math
}
from "./vec3" import {
    Vec3, v3
}
from "./ephem" import {
    Body, bodyTable, soiRadius, timeOf, SEC_PER_DAY, AU,
    BODY_COUNT, SUN, MERCURY, VENUS, EARTH, MOON, MARS, JUPITER, SATURN
}
from "./nbody" import {
    Ship, Ephem, Track, ephemBuild, ephemPos, ephemVel, propagate, advance,
    orbitAbout, dominantBody, Orbit
}
from "./lambert" import {
    lambert
}
from "./plan" import {
    Burn, noBurn, ejection, ejectionState, planeContaining, parkingOrbit,
    aimPoint, captureBurn, solveArrival, refineToPoint, Capture
}
from "./mission" import {
    Mission, missionTable, MISSION_COUNT
}

// The game is in exactly one of three states, and they exist because dropping a
// player straight into a three-panel instrument display of a transfer they did
// not ask for explains nothing. Title first: the whole solar system and the six
// places they will go. Then a briefing that says what the three steps are. Only
// then the mission itself.
pub let PHASE_TITLE: i64 = 0

pub let PHASE_BRIEF: i64 = 1

pub let PHASE_PLAY: i64 = 2

pub struct World {
    phase: i64,
    bodies: Vec<Body>,
    e: Ephem,
    missions: Vec<Mission>,
    mission: i64,
    unlocked: i64,

    ship: Ship,
    t: f64,
    warp: f64,
    paused: bool,

    budget: f64,
    spent: f64,

    focus: i64,
    // Which of the three framings the camera is in. The map view is the only one
    // that shows the plan, and it is also the one where both worlds are a pixel
    // across — so the other two exist purely to let the player look at the
    // places they are flying between.
    view: i64,
    // The opening sweep: 1 at mission start, easing to 0. The camera starts
    // wide and high and settles into the working view, because a static cut to
    // a map of the solar system does not tell you it IS a map of the solar
    // system — the move does.
    sweep: f64,
    dragging: bool,
    camDist: f64,
    camYaw: f64,
    camPitch: f64,

    // The plan. Two numbers the player sets — when to leave, and how long to
    // take — and everything else is derived.
    planDep: f64,
    planTof: f64,
    planValid: bool,
    planDv: f64,
    planArrVinf: f64,
    planPost: Ship, // ship state just after the departure burn
    planMcT: f64, // when the course correction happens
    planFix: Vec3, // and what it is
    planEjDv: f64, // cost of the departure burn alone
    track: Track,
    trackValid: bool,
    // The orbit the ship is on RIGHT NOW, integrated once when something changes
    // rather than once per frame. Recomputing it every frame made it shimmer:
    // the step-size rule records a slightly different set of points each time,
    // so the polyline crawled even with the game paused.
    liveTrack: Track,

    // Committed: the departure burn has been paid for and the correction is
    // still pending.
    committed: bool,
    mccDone: bool,
    // Has the player moved a dial yet. ENTER is inert until they have.
    //
    // Without this the game opens on a solved, affordable plan and the only key
    // it advertises finishes the mission — so a new player wins mission one
    // without touching a control or learning what the number means, then meets
    // Mars, where the same reflex fails, with no model of why.
    hasScrubbed: bool,

    captured: bool,
    failed: bool,
    won: bool,
    message: string,
    messageAge: f64,
    // The live preview: a coarse trajectory redrawn as the player scrubs, plus
    // the cost of every departure date at the current flight time.
    preview: bool,
    curve: Vec<f64>,
    curveBest: f64,
    curveWorst: f64,
    curveBestI: i64,

}

fn emptyTrack(): Track {
    return Track {
        pts: Vec.new(), times: Vec.new(), tEnd: 0.0,
        endPos: v3(0.0, 0.0, 0.0), endVel: v3(0.0, 0.0, 0.0),
        hit: 0 - 1, caDist: 0.0, caTime: 0.0, caRelSpeed: 0.0, steps: 0,
    }
}

pub fn say(w: &mut World, s: string) {
    w.message = s
    w.messageAge = 0.0
}

// True when the destination orbits the departure body — the Moon mission. That
// transfer happens entirely inside the Earth's gravity well, so it is solved
// about the Earth rather than about the Sun, and there is no escape hyperbola at
// all. It is the same Lambert solver with a different central body.
// Progressive disclosure. The date scrubber and its cost curve are mission 2's
// content and B is mission 3's, because on the Moon run the departure date moves
// the price by under one per cent — teaching a dial that does nothing is worse
// than teaching nothing.
pub fn showsDateDial(w: &World): bool {
    return w.mission >= 1
}

pub fn showsBestKey(w: &World): bool {
    return w.mission >= 2
}

pub fn isLocalHop(w: &World, m: i64): bool {
    return w.bodies[w.missions[m].to].parent == w.missions[m].from
}

pub fn worldNew(): World {
    let bodies = bodyTable()
    // One grid for the whole campaign: twenty years at six hours is about 29 000
    // samples of eight bodies, built once in a fraction of a second, so no
    // mission ever rebuilds it mid-flight.
    let e = ephemBuild(bodies, timeOf(2030, 1, 1), timeOf(2050, 1, 1), 21600.0)
    let missions = missionTable()
    var w = World {
        phase: PHASE_TITLE,
        bodies: bodies, e: e, missions: missions, mission: 0, unlocked: 0,
        ship: Ship {
            pos: v3(0.0, 0.0, 0.0), vel: v3(0.0, 0.0, 0.0)
        }
        ,
        t: 0.0, warp: 60.0, paused: true,
        budget: 0.0, spent: 0.0,
        focus: EARTH, view: 1, sweep: 0.0, dragging: false, camDist: 4.0e7, camYaw: 0.6, camPitch: 0.45,
        planDep: 0.0, planTof: 0.0, planValid: false, planDv: 0.0, planArrVinf: 0.0,
        planPost: Ship {
            pos: v3(0.0, 0.0, 0.0), vel: v3(0.0, 0.0, 0.0)
        }
        ,
        planMcT: 0.0, planFix: v3(0.0, 0.0, 0.0), planEjDv: 0.0,
        track: emptyTrack(), trackValid: false, liveTrack: emptyTrack(),
        committed: false, mccDone: false, hasScrubbed: false,
        captured: false, failed: false, won: false,
        message: "", messageAge: 0.0,
        preview: false, curve: Vec.new(), curveBest: 0.0, curveWorst: 0.0, curveBestI: 0,
    }
    startMission(w, 0)
    return w
}

pub fn startMission(w: &mut World, idx: i64) {
    var i = idx
    if i < 0 {
        i = 0
    }
    if i >= MISSION_COUNT {
        i = MISSION_COUNT - 1
    }
    w.mission = i
    let from = w.missions[i].from
    let to = w.missions[i].to
    let t0 = w.missions[i].windowOpen
    let park = w.bodies[from].radius + w.missions[i].parkAlt
    let tof = w.missions[i].nominalTof

    // Start in the plane the expected transfer wants, so the player is never
    // silently charged for a plane change they did not choose (see plan.milo).
    var normal = v3(0.0, 0.0, 1.0)
    if isLocalHop(w, i) {
        let r2 = ephemPos(w.e, to, t0 + tof) - ephemPos(w.e, from, t0 + tof)
        normal = planeContaining(r2)
    } else {
        let sol = lambert(ephemPos(w.e, from, t0), ephemPos(w.e, to, t0 + tof), tof, w.e.mu[SUN], true)
        if sol.ok {
            normal = planeContaining(sol.v1 - ephemVel(w.e, from, t0))
        }
    }
    w.ship = parkingOrbit(w.e, from, park, t0, normal, 0.0)
    w.t = t0
    w.budget = w.missions[i].budget
    w.spent = 0.0
    w.paused = true
    w.warp = 60.0
    w.focus = from
    w.sweep = 1.0
    // Open on the DAY side. The camera angle is arbitrary, but a first frame
    // showing an unlit planet looks like a bug in the lighting rather than like
    // night, and the terminator is the best thing on screen.
    setView(w, VIEW_ROUTE)
    w.planDep = t0 + w.missions[i].nominalWait
    w.planTof = tof
    w.planValid = false
    w.trackValid = false
    w.committed = false
    w.mccDone = false
    w.hasScrubbed = false
    w.captured = false
    w.failed = false
    w.won = false
    w.preview = false
    w.phase = PHASE_BRIEF
    // Deliberately NOT the optimum. This used to call snapToBest, so the game
    // opened on the cheapest transfer in the window: B was a no-op, neither
    // input changed anything worth looking at, and the whole campaign was ENTER,
    // hold `.`, ENTER, six times over. Starting part-way up the curve means the
    // first arrow press makes a number go down, which is the entire lesson.
    w.planTof = tof * 0.62
    w.planDep = t0 + w.missions[i].windowSpan * 0.68
    buildCurve(w)
    // A real, solved plan at that deliberately-suboptimal point, so the price is
    // on screen from the first frame and the player can see it FALL when they
    // press an arrow. Showing nothing until they scrub hides the feedback that
    // makes the input make sense.
    replan(w)
    refreshLive(w)
}

// ENTER advances the state machine. One key does the whole game.
pub fn advancePhase(w: &mut World) {
    if w.phase == PHASE_TITLE {
        w.phase = PHASE_BRIEF
        return
    }
    if w.phase == PHASE_BRIEF {
        w.phase = PHASE_PLAY
        w.sweep = 1.0
    }
}

pub fn resetMission(w: &mut World) {
    startMission(w, w.mission)
}

// ── planning ──────────────────────────────────────────────────────────────────

// The cheapest departure velocity for a local hop, searched over one lap of the
// parking orbit.
//
// Unlike an interplanetary departure there is no asymptote to line up, so the
// burn point is not determined by geometry — but it still matters enormously,
// because leaving from the wrong side of the orbit means fighting the Earth for
// half the trip. Sampling a full revolution and keeping the cheapest is both the
// simplest way to find it and a fair description of what the answer means:
// wait until you are at the right point in your orbit.
fn bestLocalBurn(w: &World, from: i64, to: i64, tof: f64): Burn {
    let mu = w.e.mu[from]
    let r = (w.ship.pos - ephemPos(w.e, from, w.t)).len()
    let period = Math.pi() * 2.0 * Math.sqrt(r * r * r / mu)
    var best = noBurn()
    var bestCost = 1.0e30
    var k = 0
    while k < 72 {
        let dt = period * (k as f64) / 72.0
        let bt = w.t + dt
        let at = bt + tof
        let s = advance(w.e, w.ship, w.t, dt)
        let r1 = s.pos - ephemPos(w.e, from, bt)
        let r2 = ephemPos(w.e, to, at) - ephemPos(w.e, from, at)
        let sol = lambert(r1, r2, tof, mu, true)
        if sol.ok {
            let have = s.vel - ephemVel(w.e, from, bt)
            let dv = sol.v1 - have
            if dv.len() < bestCost {
                bestCost = dv.len()
                best = Burn {
                    t: bt, dv: dv, valid: true
                }
            }
        }
        k = k + 1
    }
    return best
}

// Work out the burn for the current departure date and flight time, refine it
// against the real integrator, and remember the trajectory it produces.
pub fn replan(w: &mut World) {
    if w.committed {
        say(w, "already under way — R to start over")
        return
    }
    let m = w.mission
    let from = w.missions[m].from
    let to = w.missions[m].to
    let tof = w.planTof
    let wantPeri = w.bodies[to].radius + w.missions[m].captureAlt

    if isLocalHop(w, m) {
        let burn = bestLocalBurn(w, from, to, tof)
        if !burn.valid {
            w.planValid = false
            say(w, "no transfer for that flight time")
            return
        }
        let atBurn = advance(w.e, w.ship, w.t, burn.t - w.t)
        let post = Ship {
            pos: atBurn.pos, vel: atBurn.vel + burn.dv
        }
        // Refine straight from the burn: a lunar transfer is only a few days, so
        // it is not the ill-conditioned mess an interplanetary departure is, and
        // there is no separate correction to schedule.
        // The arrival speed has to be measured at ARRIVAL. Taking it at the burn
        // gives about 10 km/s rather than the real 0.9, and the gravity focusing
        // factor that turns a wanted periapsis into an aim point is very
        // sensitive to it — the aim came out three times too close and the ship
        // flew into the Moon. One throwaway propagation buys the real number.
        let rough = propagate(w.e, post, burn.t, tof, 8, to)
        let arrVinf = rough.endVel - ephemVel(w.e, to, rough.tEnd)
        let aim = ephemPos(w.e, to, burn.t + tof)
        let fix = solveArrival(w.e, post, burn.t, burn.t + tof, to, wantPeri, arrVinf, 4)
        let cruise = Ship {
            pos: post.pos, vel: post.vel + fix
        }
        let _ = aim
        w.track = propagate(w.e, cruise, burn.t, tof + 3.0 * SEC_PER_DAY, 512, to)
        w.planDep = burn.t
        w.planPost = post
        w.planMcT = burn.t
        w.planFix = fix
        w.planEjDv = burn.dv.len()
        // The quote includes the ARRIVAL burn. Quoting departure only is how a
        // mission gets committed to at 6.6 km/s and then dies at the far end
        // needing 9.4 more; the number on screen has to be the whole trip.
        w.planDv = burn.dv.len() + fix.len() + arrivalEstimate(w, w.track)
        w.planArrVinf = (w.track.endVel - ephemVel(w.e, to, w.track.tEnd)).len()
        w.planValid = true
        w.trackValid = true
        return
    }

    let dep = w.planDep
    let arr = dep + tof
    let park = w.bodies[from].radius + w.missions[m].parkAlt
    let sol = lambert(ephemPos(w.e, from, dep), ephemPos(w.e, to, arr), tof, w.e.mu[SUN], true)
    if !sol.ok {
        w.planValid = false
        say(w, "no transfer exists for that date")
        return
    }
    let vinf = sol.v1 - ephemVel(w.e, from, dep)
    let vinfArr = sol.v2 - ephemVel(w.e, to, arr)
    let normal = planeContaining(vinf)
    let ej = ejection(w.e.mu[from], park, vinf, normal)
    if !ej.valid {
        w.planValid = false
        say(w, "that departure is not reachable")
        return
    }
    let post = ejectionState(w.e, from, dep, park, vinf, normal)
    // Correct twenty days out, where the trajectory is far less sensitive than at
    // periapsis — the same reason real missions schedule their first correction
    // there rather than immediately.
    let mcT = dep + 20.0 * SEC_PER_DAY
    let coast = advance(w.e, post, dep, 20.0 * SEC_PER_DAY)
    let fix = solveArrival(w.e, coast, mcT, arr, to, wantPeri, vinfArr, 4)
    let cruise = Ship {
        pos: coast.pos, vel: coast.vel + fix
    }
    w.track = propagate(w.e, cruise, mcT, arr - mcT + 25.0 * SEC_PER_DAY, 512, to)
    w.planPost = post
    w.planMcT = mcT
    w.planFix = fix
    w.planEjDv = ej.dvMag
    w.planDv = ej.dvMag + fix.len() + arrivalEstimate(w, w.track)
    w.planArrVinf = vinfArr.len()
    w.planValid = true
    w.trackValid = true
}

// What the capture burn at the far end will cost, taken from the trajectory that
// was actually computed rather than from the patched-conic guess.
pub fn arrivalEstimate(w: &World, tr: &Track): f64 {
    let to = w.missions[w.mission].to
    let mu = w.e.mu[to]
    let peri = tr.caDist
    if peri <= 0.0 || peri > 1.0e12 {
        return 0.0
    }
    // `caRelSpeed` is the speed at CLOSEST APPROACH, which is already at the
    // bottom of the well — it is not the hyperbolic excess. Feeding it through
    // sqrt(vinf^2 + 2mu/r) adds the fall a second time and overstated the Mars
    // capture by 1.2 km/s, which was enough to price every mission out of its
    // own budget.
    let vPeri = tr.caRelSpeed
    let apo = w.bodies[to].radius + w.missions[w.mission].captureApo
    var a = (peri + apo) * 0.5
    if a < peri {
        a = peri
    }
    let vEll = Math.sqrt(mu * (2.0 / peri - 1.0 / a))
    if vPeri <= vEll {
        return 0.0
    }
    return vPeri - vEll
}

// Spend the departure burn and start flying it.
pub fn commitPlan(w: &mut World) {
    if !w.hasScrubbed {
        return
    }
    if !w.planValid {
        say(w, "nothing planned — press P")
        return
    }
    if w.committed {
        say(w, "already under way")
        return
    }
    if w.spent + w.planDv > w.budget {
        say(w, "that plan costs more than the budget left")
        return
    }
    w.ship = Ship {
        pos: w.planPost.pos, vel: w.planPost.vel
    }
    w.t = w.planDep
    w.spent = w.spent + w.planEjDv
    w.committed = true
    w.mccDone = false
    w.paused = false
    w.warp = 20000.0
    setView(w, VIEW_ROUTE)
    refreshLive(w)
}

// ── the capture burn ──────────────────────────────────────────────────────────

pub fn currentCapture(w: &World): Capture {
    let to = w.missions[w.mission].to
    let apo = w.bodies[to].radius + w.missions[w.mission].captureApo
    return captureBurn(w.e, w.ship, w.t, to, apo)
}

pub fn doCapture(w: &mut World) {
    let to = w.missions[w.mission].to
    let cap = currentCapture(w)
    if !cap.possible {
        say(w, "nothing to capture from — you are not falling toward it")
        return
    }
    if w.spent + cap.dv > w.budget {
        say(w, "not enough left in the tank for that burn")
        w.failed = true
        return
    }
    let rel = w.ship.vel - ephemVel(w.e, to, w.t)
    w.ship = Ship {
        pos: w.ship.pos, vel: w.ship.vel - rel.norm().scale(cap.dv)
    }
    w.spent = w.spent + cap.dv
    refreshLive(w)
    w.paused = true
    w.warp = 60.0
    w.focus = to
    checkCapture(w)
}

// Arrival is a stable capture orbit: closed, about the right body, with the
// periapsis in the band the mission asked for. "Closed at the instant of the
// burn" is not enough — a grazing ellipse whose periapsis is inside the
// atmosphere is not an orbit, and neither is one the Sun takes back a week
// later, so the test is re-run after a lap.
pub fn checkCapture(w: &mut World) {
    let to = w.missions[w.mission].to
    let dom = dominantBody(w.e, w.ship.pos, w.t)
    if dom != to {
        say(w, "not captured — " + w.bodies[to].name.clone() + " is not the one holding you")
        return
    }
    let ob = orbitAbout(w.e, w.ship, w.t, to)
    if !ob.closed {
        say(w, "still on an escape trajectory")
        return
    }
    // What counts as arrival is a genuinely BOUND orbit, not a bullseye. The
    // mission's capture altitude is what the planner aims for; judging the
    // player against it to the kilometre would be scoring them on the shooting
    // solver's residual rather than on their own decisions.
    if ob.periapsis < w.bodies[to].radius + 50.0e3 {
        say(w, "that orbit grazes the surface")
        w.failed = true
        return
    }
    // Bound to the target rather than merely curving: an ellipse whose apoapsis
    // reaches past the sphere of influence belongs to the Sun, and it will be
    // taken back.
    if ob.apoapsis > soiRadius(w.bodies, to) {
        say(w, "captured for now, but that apoapsis is outside " + w.bodies[to].name.clone() + "'s pull")
        return
    }
    // One full revolution later, is it still an orbit?
    let later = advance(w.e, w.ship, w.t, ob.period)
    let ob2 = orbitAbout(w.e, later, w.t + ob.period, to)
    if !ob2.closed || ob2.periapsis < w.bodies[to].radius {
        say(w, "that orbit does not survive a lap")
        return
    }
    w.captured = true
    w.won = true
    if w.mission >= w.unlocked {
        w.unlocked = w.mission + 1
    }
    say(w, "captured at " + w.bodies[to].name.clone())
}

// ── stepping ──────────────────────────────────────────────────────────────────

pub fn shipAbout(w: &World): i64 {
    return dominantBody(w.e, w.ship.pos, w.t)
}

pub fn shipOrbit(w: &World): Orbit {
    return orbitAbout(w.e, w.ship, w.t, shipAbout(w))
}

pub let VIEW_DEPART: i64 = 0

pub let VIEW_ROUTE: i64 = 1

pub let VIEW_ARRIVE: i64 = 2

// Frame one of the three views. Each picks its own subject and its own distance,
// because "zoom" means something completely different at a parking orbit and at
// the scale of a transfer, and asking the player to find each one on a scroll
// wheel spanning eleven orders of magnitude is asking too much.
pub fn setView(w: &mut World, v: i64) {
    let m = w.mission
    w.view = v
    if v == VIEW_DEPART {
        w.focus = w.missions[m].from
        w.camDist = w.bodies[w.missions[m].from].radius * 7.0
        w.camPitch = 0.30
    } else {
        if v == VIEW_ARRIVE {
            w.focus = w.missions[m].to
            w.camDist = w.bodies[w.missions[m].to].radius * 9.0
            w.camPitch = 0.30
        } else {
            w.focus = w.missions[m].from
            w.camDist = routeDist(w)
            w.camPitch = 0.95
        }
    }
    // Point at the day side, so a close view opens on a lit planet.
    let toSun = (v3(0.0, 0.0, 0.0) - ephemPos(w.e, w.focus, w.t)).norm()
    w.camYaw = Math.atan2(toSun.y, toSun.x) + 0.55
}

// Minimum on-screen radius, in pixels, that a body is allowed to shrink to.
// Only the two worlds the mission is about, and only on the route map, where
// true scale would render both of them invisible.
pub fn camMinPix(w: &World, id: i64): f64 {
    if w.view != VIEW_ROUTE || w.sweep > 0.0 {
        return 0.0
    }
    if id == w.missions[w.mission].from || id == w.missions[w.mission].to {
        return 11.0
    }
    return 0.0
}

// How far out the route view has to sit to contain the whole trip.
//
// A fixed distance per mission is a guess, and it was wrong in the direction
// that matters: a five-day lunar transfer arcs well past the Moon's own orbit,
// so the ship spent the middle of the flight below the bottom of the screen with
// no trajectory visible at all. Measuring the drawn path is the only framing
// that cannot be wrong.
pub fn routeDist(w: &World): f64 {
    let m = w.mission
    let from = w.missions[m].from
    let to = w.missions[m].to
    let local = isLocalHop(w, m)
    var far = 0.0
    if local {
        far = (ephemPos(w.e, to, w.t) - ephemPos(w.e, from, w.t)).len()
    } else {
        far = w.bodies[to].el.a
        if w.bodies[from].el.a > far {
            far = w.bodies[from].el.a
        }
    }
    // Include every point of whichever path is on screen.
    // Only up to ARRIVAL. The propagation runs past the encounter so the closest
    // approach is bracketed, and that tail can fly a long way — including it in
    // the framing zoomed the view out until the entire mission was a dot in the
    // middle of an empty screen, which is what the whole coast phase looked like.
    var i = 0
    while i < w.track.pts.len {
        if w.track.times[i] <= w.track.caTime {
            var d = 0.0
            if local {
                d = (w.track.pts[i] - ephemPos(w.e, from, w.track.times[i])).len()
            } else {
                d = w.track.pts[i].len()
            }
            if d > far {
                far = d
            }
        }
        i = i + 1
    }
    return far * 1.35
}

pub fn cycleView(w: &mut World) {
    var v = w.view + 1
    if v > 2 {
        v = 0
    }
    setView(w, v)
}

// Camera motion that is not the player's: the opening sweep, and a slow drift
// so a paused solar system is never a still image.
pub let TOUR_SECS: f64 = 9.0

// The opening tour, and the drift.
//
// A map of the solar system drawn from ten million kilometres is a diagram of
// dots, and nothing about a still frame of it says that the dots are photographs
// of worlds or that the view can be turned. So a mission opens ON the planet,
// close enough to see the terminator move, and pulls back to the route over a
// few seconds. The pull-out is what explains the map.
//
// The drift is the other half: at three degrees a second, a paused game is still
// visibly a three-dimensional scene being looked at from somewhere, which no
// amount of instruction text achieves.
// The route framing follows the plan: change the flight time and the arc grows,
// so the camera has to grow with it or the path leaves the screen mid-edit.
pub fn reframeRoute(w: &mut World) {
    if w.view == VIEW_ROUTE {
        let want = routeDist(w)
        // Eased rather than snapped, or every keypress jolts the view.
        w.camDist = w.camDist * 0.72 + want * 0.28
    }
}

pub fn updateCamera(w: &mut World, wall: f64) {
    if w.sweep > 0.0 {
        w.sweep = w.sweep - wall / TOUR_SECS
        if w.sweep < 0.0 {
            w.sweep = 0.0
        }
    }
    if !w.dragging {
        w.camYaw = w.camYaw + wall * 0.055
    }
    reframeRoute(w)
}

// Re-integrate the ship's current orbit for drawing. Called when the state
// actually changes — after a step, after a burn, after a new plan — and never
// from the renderer.
pub fn refreshLive(w: &mut World) {
    let about = dominantBody(w.e, w.ship.pos, w.t)
    let ob = orbitAbout(w.e, w.ship, w.t, about)
    var span = 3.0 * 3600.0
    if ob.closed {
        span = ob.period
    }
    // While a transfer is under way the useful horizon is "until you get there",
    // not "one revolution of whatever you are technically orbiting" — which
    // during a coast to the Moon is a sixty-day ellipse around the Earth drawn
    // as a wandering line with nothing to do with the trip.
    if w.committed && !w.captured && w.track.caTime > w.t {
        span = w.track.caTime - w.t + 3600.0
    }
    if span > 60.0 * SEC_PER_DAY {
        span = 60.0 * SEC_PER_DAY
    }
    w.liveTrack = propagate(w.e, w.ship, w.t, span, 200, 0 - 1)
}

pub fn skipTour(w: &mut World) {
    w.sweep = 0.0
}

// Distance is interpolated in the LOG, not linearly: the tour crosses four
// orders of magnitude between a planet's surface and a transfer orbit, and a
// linear ease spends nine tenths of its time in the last percent of that.
pub fn camDistNow(w: &World): f64 {
    if w.sweep <= 0.0 {
        return w.camDist
    }
    let close = w.bodies[w.focus].radius * 6.0
    // Hold the close shot for the first third, then ease out.
    var t = w.sweep / 0.66
    if t > 1.0 {
        t = 1.0
    }
    let e = t * t * (3.0 - 2.0 * t)
    return Math.exp(Math.log(close) * e + Math.log(w.camDist) * (1.0 - e))
}

pub fn camPitchNow(w: &World): f64 {
    if w.sweep <= 0.0 {
        return w.camPitch
    }
    var t = w.sweep / 0.66
    if t > 1.0 {
        t = 1.0
    }
    let e = t * t * (3.0 - 2.0 * t)
    return 0.16 * e + w.camPitch * (1.0 - e)
}

pub fn advanceWorld(w: &mut World, wall: f64) {
    w.messageAge = w.messageAge + wall
    if w.paused || w.won || w.failed {
        return
    }
    var span = wall * w.warp
    if span <= 0.0 {
        return
    }
    // The correction is part of the plan the player approved and paid for, so it
    // happens on schedule rather than needing a second keypress in the middle of
    // a time warp that may be running at ten thousand times real speed.
    if w.committed && !w.mccDone && w.t + span >= w.planMcT {
        let toMcc = w.planMcT - w.t
        if toMcc > 0.0 {
            w.ship = advance(w.e, w.ship, w.t, toMcc)
            w.t = w.planMcT
            span = span - toMcc
        }
        w.ship = Ship {
            pos: w.ship.pos, vel: w.ship.vel + w.planFix
        }
        w.spent = w.spent + w.planFix.len()
        w.mccDone = true
        say(w, "course correction: " + fmtSpeed(w.planFix.len()))
    }
    // Stop AT the burn.
    //
    // The capture burn is the one instant in a five-day flight that matters, it
    // is a few minutes wide, and the player is crossing that flight at eighty
    // thousand times real speed. Expecting them to feather the warp key onto it
    // is not a difficulty, it is a trap — the first real playthrough sailed
    // three days past the Moon and ended up on a 622 000 km ellipse around the
    // Earth. Time now lands exactly on periapsis and stops itself.
    var hitNode = false
    if w.committed && !w.captured && w.track.caTime > w.t {
        if w.t + span >= w.track.caTime {
            span = w.track.caTime - w.t
            hitNode = true
        }
    }
    if span > 0.0 {
        w.ship = advance(w.e, w.ship, w.t, span)
        w.t = w.t + span
        refreshLive(w)
    }
    if hitNode {
        w.paused = true
        w.warp = 60.0
        setView(w, VIEW_ARRIVE)
        say(w, "periapsis — press ENTER to capture")
    }

    // Coming in: swap to the arrival view on its own. The player is watching a
    // date tick over at ten thousand times real speed and should not have to
    // also be watching a distance readout to know when to look.
    if w.committed && w.view != VIEW_ARRIVE {
        let to = w.missions[w.mission].to
        if (ephemPos(w.e, to, w.t) - w.ship.pos).len() < soiRadius(w.bodies, to) * 1.2 {
            setView(w, VIEW_ARRIVE)
            say(w, "arriving at " + w.bodies[to].name.clone())
        }
    }

    // Ran into something.
    var b = 0
    while b < BODY_COUNT {
        if (ephemPos(w.e, b, w.t) - w.ship.pos).len() < w.bodies[b].radius {
            w.failed = true
            say(w, "lost — impact on " + w.bodies[b].name.clone())
            b = BODY_COUNT
        } else {
            b = b + 1
        }
    }
}

fn fmtSpeed(v: f64): string {
    let n = (v * 10.0) as i64
    return ((n / 10) as i64).toString() + "." + ((n % 10) as i64).toString() + " m/s"
}

// ── the porkchop ──────────────────────────────────────────────────────────────

// The cost of leaving on every day of the window, for every flight time, as one
// picture.
//
// This is the whole skill of interplanetary mission design compressed into a
// heat map with a blue valley in it, and clicking the valley is the entire
// interaction. The number in each cell is the departure burn plus the arrival
// burn — total mission cost, not just the part that is easy to compute, because
// a cheap departure into a brutal arrival is the classic trap and a plot that
// hides it would be teaching the wrong lesson.
// What one (departure, flight time) pair costs, all in: the burn out of the
// parking orbit plus the burn into the capture orbit at the far end.
//
// Departure alone is the number that is easy to compute and it is the wrong one
// to show. A cheap departure into a brutal arrival is the classic trap — the
// fast transfers to Venus and Mercury are exactly that — and a readout that
// hides the second half would be teaching the opposite of the lesson.
pub fn cellCost(w: &World, dep: f64, tof: f64): f64 {
    let m = w.mission
    let from = w.missions[m].from
    let to = w.missions[m].to
    let park = w.bodies[from].radius + w.missions[m].parkAlt
    let capPeri = w.bodies[to].radius + w.missions[m].captureAlt
    let capApo = w.bodies[to].radius + w.missions[m].captureApo
    if isLocalHop(w, m) {
        let r2 = ephemPos(w.e, to, dep + tof) - ephemPos(w.e, from, dep + tof)
        let nrm = planeContaining(r2)
        let r1 = r2.norm().rotate(nrm, 0.0 - Math.pi() * 0.5).scale(park)
        let sol = lambert(r1, r2, tof, w.e.mu[from], true)
        if !sol.ok {
            return 1.0e30
        }
        // Priced as a SPEED change, not as a vector difference against a guessed
        // burn direction. Where in the parking orbit the burn happens is not the
        // player's problem — `bestLocalBurn` finds the point that lines the two
        // up — so charging them for the misalignment of an arbitrary sample
        // point is charging for the sampling. It read as 7.9 km/s for a lunar
        // transfer that actually costs 3.2.
        let circ = Math.sqrt(w.e.mu[from] / park)
        var dvDep = sol.v1.len() - circ
        if dvDep < 0.0 {
            dvDep = 0.0 - dvDep
        }
        // Arrival speed relative to the MOON, in the same frame the Lambert was
        // solved in. Both terms have to be geocentric: subtracting the Moon's
        // heliocentric velocity from a geocentric arrival velocity is a 30 km/s
        // error, and it showed up on screen as a lunar transfer costing 34 km/s.
        let moonRel = ephemVel(w.e, to, dep + tof) - ephemVel(w.e, from, dep + tof)
        let arrV = (sol.v2 - moonRel).len()
        let aCap = (capPeri + capApo) * 0.5
        let vHyp = Math.sqrt(arrV * arrV + 2.0 * w.e.mu[to] / capPeri)
        let vEll = Math.sqrt(w.e.mu[to] * (2.0 / capPeri - 1.0 / aCap))
        return dvDep + (vHyp - vEll)
    }
    let sol = lambert(ephemPos(w.e, from, dep), ephemPos(w.e, to, dep + tof), tof, w.e.mu[SUN], true)
    if !sol.ok {
        return 1.0e30
    }
    let vinf = (sol.v1 - ephemVel(w.e, from, dep)).len()
    let vinfArr = (sol.v2 - ephemVel(w.e, to, dep + tof)).len()
    let dvDep = Math.sqrt(vinf * vinf + 2.0 * w.e.mu[from] / park) - Math.sqrt(w.e.mu[from] / park)
    let aCap = (capPeri + capApo) * 0.5
    let vHyp = Math.sqrt(vinfArr * vinfArr + 2.0 * w.e.mu[to] / capPeri)
    let vEll = Math.sqrt(w.e.mu[to] * (2.0 / capPeri - 1.0 / aCap))
    return dvDep + (vHyp - vEll)
}

pub let CURVE_N: i64 = 240

// The cost of every departure date at the current flight time, as a curve to
// draw under the scrubber. Two hundred and forty Lambert solves, about a
// millisecond, so it can be rebuilt every time the flight time changes.
pub fn buildCurve(w: &mut World) {
    var v: Vec<f64> = Vec.new()
    var best = 1.0e30
    var worst = 0.0
    var bestI = 0
    let t0 = w.missions[w.mission].windowOpen
    let span = w.missions[w.mission].windowSpan
    var i = 0
    while i < CURVE_N {
        let dep = t0 + span * (i as f64) / ((CURVE_N - 1) as f64)
        let c = cellCost(w, dep, w.planTof)
        if c < best {
            best = c
            bestI = i
        }
        if c < 1.0e29 && c > worst {
            worst = c
        }
        v.push(c)
        i = i + 1
    }
    w.curve = v
    w.curveBest = best
    w.curveWorst = worst
    w.curveBestI = bestI
}

// A cheap, honest preview of where the current plan actually goes.
//
// The full plan runs a shooting solver — hundreds of propagations — which is
// milliseconds well spent once, and far too slow to redo on every frame while an
// arrow key is held down. This skips the correction entirely and flies the
// coarse patched-conic burn through the real integrator, so what the player sees
// while scrubbing is a true trajectory that simply has not been corrected yet.
pub fn buildPreview(w: &mut World) {
    if w.committed {
        return
    }
    let m = w.mission
    let from = w.missions[m].from
    let to = w.missions[m].to
    let tof = w.planTof
    let park = w.bodies[from].radius + w.missions[m].parkAlt
    if isLocalHop(w, m) {
        let burn = bestLocalBurn(w, from, to, tof)
        if !burn.valid {
            w.preview = false
            return
        }
        let atBurn = advance(w.e, w.ship, w.t, burn.t - w.t)
        let post = Ship {
            pos: atBurn.pos, vel: atBurn.vel + burn.dv
        }
        w.track = propagate(w.e, post, burn.t, tof, 400, to)
        w.preview = true
        w.planValid = false
        return
    }
    let dep = w.planDep
    let sol = lambert(ephemPos(w.e, from, dep), ephemPos(w.e, to, dep + tof), tof, w.e.mu[SUN], true)
    if !sol.ok {
        w.preview = false
        return
    }
    let vinf = sol.v1 - ephemVel(w.e, from, dep)
    let normal = planeContaining(vinf)
    let ej = ejection(w.e.mu[from], park, vinf, normal)
    if !ej.valid {
        w.preview = false
        return
    }
    let post = ejectionState(w.e, from, dep, park, vinf, normal)
    w.track = propagate(w.e, post, dep, tof, 400, to)
    w.preview = true
    w.planValid = false
}

// Slide the departure date and the flight time, in days.
pub fn scrub(w: &mut World, dDep: f64, dTof: f64) {
    if w.committed {
        return
    }
    let m = w.mission
    let t0 = w.missions[m].windowOpen
    let t1 = t0 + w.missions[m].windowSpan
    var dep = w.planDep + dDep * SEC_PER_DAY
    if dep < t0 {
        dep = t0
    }
    if dep > t1 {
        dep = t1
    }
    let mid = w.missions[m].nominalTof
    var tof = w.planTof + dTof * SEC_PER_DAY
    if tof < mid * 0.45 {
        tof = mid * 0.45
    }
    if tof > mid * 1.75 {
        tof = mid * 1.75
    }
    let tofChanged = tof != w.planTof
    if dep != w.planDep || tofChanged {
        w.hasScrubbed = true
    }
    w.planDep = dep
    w.planTof = tof
    if tofChanged || w.curve.len == 0 {
        buildCurve(w)
    }
    buildPreview(w)
}

// Jump to the cheapest transfer in the window.
//
// The cheap cost model is a patched conic; the price the player is actually
// charged comes from a shooting solver over the full force model. Those two
// disagree most exactly where it matters — on fast, high-energy transfers — and
// a search that trusts the cheap model walks into that gap and returns something
// nobody can fly. Ranking on it alone picked a 748-day Jupiter shot that really
// cost 40 km/s and called it the best in the window.
//
// So the model only RANKS, and each shortlisted flight time is priced by the
// real planner. Five real plans is about a quarter of a second — affordable for
// a keypress, and it means the number on screen is the number they get.
pub fn snapToBest(w: &mut World) {
    if w.committed {
        return
    }
    let m = w.mission
    let t0 = w.missions[m].windowOpen
    let span = w.missions[m].windowSpan
    let mid = w.missions[m].nominalTof
    var mults: Vec<f64> = Vec.new()
    mults.push(0.8)
    mults.push(1.0)
    mults.push(1.25)
    mults.push(1.55)
    var bestTotal = 1.0e30
    var bestDep = w.planDep
    var bestTof = w.planTof
    var k = 0
    while k < mults.len {
        w.planTof = mid * mults[k]
        buildCurve(w)
        w.planDep = t0 + span * (w.curveBestI as f64) / ((CURVE_N - 1) as f64)
        replan(w)
        if w.planValid && w.track.hit < 0 && w.planDv < bestTotal {
            bestTotal = w.planDv
            bestDep = w.planDep
            bestTof = w.planTof
        }
        k = k + 1
    }
    w.planTof = bestTof
    w.planDep = bestDep
    // Pressing B is a choice, the same as moving a dial — it must satisfy the
    // "you have to touch something before you can launch" gate, or the one
    // shortcut the game offers leaves you unable to commit.
    w.hasScrubbed = true
    buildCurve(w)
    replan(w)
}
