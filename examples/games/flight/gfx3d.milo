// A small 3D pipeline on top of the 2D HDR canvas: perspective camera, near-plane
// clipping, and a depth-buffered triangle rasteriser with flat shading and fog.
//
// Everything is safe Milo — the z-buffer is a Vec<f32>, the vertex lists are
// Vec<f64>, and no raw pointer appears anywhere in this file.

from "std/math" import {
    Math
}
from "./gfx" import {
    Canvas
}

pub struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

// Vector math as operators and methods, not as loose scalars.
//
// Everything below used to be written out one component at a time, and the cost
// was not typing: a cross product spelled three times in three files is three
// chances to transpose an index, which is exactly what happened while this file
// was being written. `Vec3` is Copy, passed in registers, and every one of these
// inlines to the same code the by-hand version emitted — the safety is free.
impl Add for Vec3 {
    fn add(self: &Self, o: &Self): Self {
        return Vec3 {
            x: self.x + o.x, y: self.y + o.y, z: self.z + o.z
        }
    }
}

impl Sub for Vec3 {
    fn sub(self: &Self, o: &Self): Self {
        return Vec3 {
            x: self.x - o.x, y: self.y - o.y, z: self.z - o.z
        }
    }
}

// Componentwise, which is what `Mul` means for a vector type. Scaling by a
// scalar is `.scale(k)` — Milo's `Mul` trait fixes the right-hand side to `Self`,
// so `v * 2.0` is not expressible today (see docs/backlog.md, operator RHS).
impl Mul for Vec3 {
    fn mul(self: &Self, o: &Self): Self {
        return Vec3 {
            x: self.x * o.x, y: self.y * o.y, z: self.z * o.z
        }
    }
}

impl Vec3 {
    fn scale(self: &Self, k: f64): Vec3 {
        return Vec3 {
            x: self.x * k, y: self.y * k, z: self.z * k
        }
    }

    fn dot(self: &Self, o: &Vec3): f64 {
        return self.x * o.x + self.y * o.y + self.z * o.z
    }

    fn cross(self: &Self, o: &Vec3): Vec3 {
        return Vec3 {
            x: self.y * o.z - self.z * o.y,
            y: self.z * o.x - self.x * o.z,
            z: self.x * o.y - self.y * o.x,
        }
    }

    fn len(self: &Self): f64 {
        return Math.sqrt(self.dot(self))
    }

    // Guarded: a zero-length direction is a bug upstream, but returning NaN from
    // it turns that bug into a whole frame of black pixels a long way from the
    // cause.
    fn norm(self: &Self): Vec3 {
        let l = self.len()
        if l <= 0.0 {
            return Vec3 {
                x: 0.0, y: 0.0, z: 0.0
            }
        }
        return self.scale(1.0 / l)
    }

    fn lerp(self: &Self, o: &Vec3, t: f64): Vec3 {
        return Vec3 {
            x: self.x + (o.x - self.x) * t,
            y: self.y + (o.y - self.y) * t,
            z: self.z + (o.z - self.z) * t,
        }
    }
}

pub fn v3(x: f64, y: f64, z: f64): Vec3 {
    return Vec3 {
        x: x, y: y, z: z
    }
}

// A linear-light colour. Same story as Vec3: three loose f64 parameters at the
// end of every drawing call, in an order nothing but convention enforced.
pub struct Rgb {
    r: f64,
    g: f64,
    b: f64,
}

impl Add for Rgb {
    fn add(self: &Self, o: &Self): Self {
        return Rgb {
            r: self.r + o.r, g: self.g + o.g, b: self.b + o.b
        }
    }
}

impl Mul for Rgb {
    fn mul(self: &Self, o: &Self): Self {
        return Rgb {
            r: self.r * o.r, g: self.g * o.g, b: self.b * o.b
        }
    }
}

impl Rgb {
    fn scale(self: &Self, k: f64): Rgb {
        return Rgb {
            r: self.r * k, g: self.g * k, b: self.b * k
        }
    }

    fn lerp(self: &Self, o: &Rgb, t: f64): Rgb {
        return Rgb {
            r: self.r + (o.r - self.r) * t,
            g: self.g + (o.g - self.g) * t,
            b: self.b + (o.b - self.b) * t,
        }
    }
}

pub fn rgb(r: f64, g: f64, b: f64): Rgb {
    return Rgb {
        r: r, g: g, b: b
    }
}

pub struct Camera {
    x: f64,
    y: f64,
    z: f64,
    yaw: f64, // heading, radians
    pitch: f64,
    roll: f64,
    fov: f64, // vertical field of view, radians
    near: f64,
    far: f64,
}

pub struct Scene {
    zbuf: Vec<f32>,
    w: i64,
    h: i64,
    // sun direction, normalised, pointing FROM the surface TOWARD the light
    sunX: f64,
    sunY: f64,
    sunZ: f64,
    fogR: f64,
    fogG: f64,
    fogB: f64,
    fogStart: f64,
    fogEnd: f64,
    tris: i64, // triangles actually rasterised this frame
}

pub fn sceneNew(w: i64, h: i64): Scene {
    return Scene {
        zbuf: Vec.filled(w * h, 0.0),
        w: w,
        h: h,
        sunX: 0.44,
        sunY: 0.78,
        sunZ: 0.44,
        fogR: 0.30,
        fogG: 0.42,
        fogB: 0.62,
        fogStart: 420.0,
        fogEnd: 1500.0,
        tris: 0,
    }
}

pub fn sceneClear(s: &mut Scene) {
    let n = s.w * s.h
    for i in 0..n {
        s.zbuf[i] = 0.0 // storing 1/z, so 0 is infinitely far
    }
    s.tris = 0
}

// ── camera transform ──────────────────────────────────────────────────────────

// An orientation as three axes. The trig block that builds these was written out
// three times — camera, aircraft model, wingtip contrails — and the three copies
// had drifted: two of them rolled about a slightly different axis than the
// camera did, so a banked, pitched aircraft was drawn tilted a few degrees off
// the frame it was actually flying in.
pub struct Frame {
    fwd: Vec3,
    right: Vec3,
    up: Vec3,
}

pub fn frameOf(yaw: f64, pitch: f64, roll: f64): Frame {
    let cy = Math.cos(yaw)
    let sy = Math.sin(yaw)
    let cp = Math.cos(pitch)
    let sp = Math.sin(pitch)
    let cr = Math.cos(roll)
    let sr = Math.sin(roll)
    let fwd = v3(sy * cp, sp, cy * cp)
    // right = the world-up-crossed heading; up follows from the other two
    let right = v3(cy, 0.0, 0.0 - sy)
    let up = fwd.cross(right)
    // Roll rotates right and up about forward, leaving forward alone. The signs
    // look backwards because this basis is left-handed — fwd × right is +up, not
    // -up — so the textbook `right·cos + up·sin` rolls the wrong way round the
    // heading: a right turn came out with the left wing down and the horizon
    // tilting away from the turn instead of into it.
    return Frame {
        fwd: fwd,
        right: right.scale(cr) - up.scale(sr),
        up: up.scale(cr) + right.scale(sr),
    }
}

pub struct View {
    // Rows of the world→camera rotation, precomputed once per frame. These were
    // twelve loose f64 fields (rx, ry, rz, ux, …) — the same three vectors, spelled
    // so that no function could take "the right vector" as one thing.
    right: Vec3,
    up: Vec3,
    fwd: Vec3,
    eye: Vec3,
    scale: f64, // vertical projection scale in pixels
    cx: f64,
    cy: f64,
    // Carried from the Camera rather than read off a global: the clip plane and
    // the draw distance are properties of the camera looking at the scene, and
    // a second camera (a mirror, a map inset) would need its own.
    near: f64,
    far: f64,
}

pub fn viewOf(c: &Camera, w: i64, h: i64): View {
    let f = frameOf(c.yaw, c.pitch, c.roll)
    let scale = (h as f64) * 0.5 / Math.tan(c.fov * 0.5)
    return View {
        right: f.right,
        up: f.up,
        fwd: f.fwd,
        eye: v3(c.x, c.y, c.z),
        scale: scale,
        cx: (w as f64) * 0.5,
        cy: (h as f64) * 0.5,
        near: c.near,
        far: c.far,
    }
}

// World point → camera space. z is depth along the view direction. Three dot
// products, which is what this always was under the twelve field names.
pub fn toCameraV(v: &View, p: &Vec3): Vec3 {
    let d = p - v.eye
    return v3(d.dot(v.right), d.dot(v.up), d.dot(v.fwd))
}

pub fn toCamera(v: &View, x: f64, y: f64, z: f64): Vec3 {
    return toCameraV(v, v3(x, y, z))
}

// ── rasteriser ────────────────────────────────────────────────────────────────

// Depth-buffered flat-shaded triangle in CAMERA space. Depth-tests on 1/z, which
// interpolates linearly in screen space — the reason the buffer stores 1/z.
fn rasterCam(c: &mut Canvas, s: &mut Scene, v: &View, a: &Vec3, b: &Vec3, d: &Vec3, col: &Rgb) {
    // project
    let iaz = 1.0 / a.z
    let ibz = 1.0 / b.z
    let icz = 1.0 / d.z
    let x0 = v.cx + a.x * v.scale * iaz
    let y0 = v.cy - a.y * v.scale * iaz
    let x1 = v.cx + b.x * v.scale * ibz
    let y1 = v.cy - b.y * v.scale * ibz
    let x2 = v.cx + d.x * v.scale * icz
    let y2 = v.cy - d.y * v.scale * icz

    // backface / degenerate cull via signed area
    let area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
    if area <= 0.0 {
        return
    }

    var minX = Math.floor(Math.minF64(x0, Math.minF64(x1, x2))) as i64
    var maxX = Math.ceil(Math.maxF64(x0, Math.maxF64(x1, x2))) as i64
    var minY = Math.floor(Math.minF64(y0, Math.minF64(y1, y2))) as i64
    var maxY = Math.ceil(Math.maxF64(y0, Math.maxF64(y1, y2))) as i64
    if minX < 0 {
        minX = 0
    }
    if minY < 0 {
        minY = 0
    }
    if maxX > s.w {
        maxX = s.w
    }
    if maxY > s.h {
        maxY = s.h
    }
    if minX >= maxX || minY >= maxY {
        return
    }

    s.tris = s.tris + 1
    let invArea = 1.0 / area
    var py = minY
    while py < maxY {
        let fy = (py as f64) + 0.5
        var px = minX
        while px < maxX {
            let fx = (px as f64) + 0.5
            // edge functions; all non-negative means inside
            let w0 = (x2 - x1) * (fy - y1) - (y2 - y1) * (fx - x1)
            if w0 < 0.0 {
                px = px + 1
                continue
            }
            let w1 = (x0 - x2) * (fy - y2) - (y0 - y2) * (fx - x2)
            if w1 < 0.0 {
                px = px + 1
                continue
            }
            let w2 = (x1 - x0) * (fy - y0) - (y1 - y0) * (fx - x0)
            if w2 < 0.0 {
                px = px + 1
                continue
            }
            let l0 = w0 * invArea
            let l1 = w1 * invArea
            let l2 = w2 * invArea
            let invZ = l0 * iaz + l1 * ibz + l2 * icz
            let idx = py * s.w + px
            if (s.zbuf[idx] as f64) < invZ {
                s.zbuf[idx] = invZ as f32
                let depth = 1.0 / invZ
                // linear fog toward the sky colour
                var f = (depth - s.fogStart) / (s.fogEnd - s.fogStart)
                if f < 0.0 {
                    f = 0.0
                }
                if f > 1.0 {
                    f = 1.0
                }
                let o = idx * 3
                c.hdr[o] = (col.r * (1.0 - f) + s.fogR * f) as f32
                c.hdr[o + 1] = (col.g * (1.0 - f) + s.fogG * f) as f32
                c.hdr[o + 2] = (col.b * (1.0 - f) + s.fogB * f) as f32
            }
            px = px + 1
        }
        py = py + 1
    }
}

// A world-space triangle, clipped against the near plane and then rasterised.
// Clipping matters: a triangle straddling the camera plane projects to garbage,
// and terrain directly under a low-flying plane does exactly that.
pub fn triangle(c: &mut Canvas, s: &mut Scene, v: &View, wa: &Vec3, wb: &Vec3, wd: &Vec3, col: &Rgb) {
    let a = toCameraV(v, wa)
    let b = toCameraV(v, wb)
    let d = toCameraV(v, wd)

    let ina = a.z > v.near
    let inb = b.z > v.near
    let inc = d.z > v.near
    var n = 0
    if ina {
        n = n + 1
    }
    if inb {
        n = n + 1
    }
    if inc {
        n = n + 1
    }
    if n == 0 {
        return
    }
    if n == 3 {
        rasterCam(c, s, v, a, b, d, col)
        return
    }
    // Sutherland–Hodgman against the single near plane, producing 3 or 4 points.
    // One Vec of points, not three parallel Vecs of coordinates: the parallel
    // form let a push land in two of the three and nothing would say so.
    var poly: Vec<Vec3> = Vec.new()
    clipEdge(poly, a, b, v.near)
    clipEdge(poly, b, d, v.near)
    clipEdge(poly, d, a, v.near)
    if poly.len < 3 {
        return
    }
    for i in 1..poly.len - 1 {
        rasterCam(c, s, v, poly[0], poly[i], poly[i + 1], col)
    }
}

fn clipEdge(out: &mut Vec<Vec3>, a: &Vec3, b: &Vec3, near: f64) {
    let ina = a.z > near
    let inb = b.z > near
    if ina {
        out.push(a)
    }
    if ina != inb {
        let t = (near - a.z) / (b.z - a.z)
        let p = a.lerp(b, t)
        out.push(v3(p.x, p.y, near))
    }
}

// Compatibility wrappers over the struct-based path, so call sites that pass
// loose coordinates keep working.
pub fn triangleTex(c: &mut Canvas, s: &mut Scene, view: &View, t: &Texture, wax: f64, way: f64, waz: f64, au: f64, av: f64, wbx: f64, wby: f64, wbz: f64, bu: f64, bv: f64, wcx: f64, wcy: f64, wcz: f64, cu: f64, cv: f64, tr: f64, tg: f64, tb: f64) {
    triangleV(c, s, view, t, vtx(wax, way, waz, au, av, 1.0), vtx(wbx, wby, wbz, bu, bv, 1.0), vtx(wcx, wcy, wcz, cu, cv, 1.0), tr, tg, tb)
}

// Lambert term for a triangle whose world-space normal is (nx,ny,nz).
pub fn shade(s: &Scene, nx: f64, ny: f64, nz: f64, ambient: f64): f64 {
    var d = nx * s.sunX + ny * s.sunY + nz * s.sunZ
    if d < 0.0 {
        d = 0.0
    }
    return ambient + (1.0 - ambient) * d
}

// ── textures ──────────────────────────────────────────────────────────────────
//
// Power-of-two RGB textures sampled with wrap, generated procedurally at startup
// — there is no asset pipeline here, and none is needed for surface detail.

pub struct Texture {
    w: i64,
    h: i64,
    mask: i64, // w-1, w is a power of two
    shift: i64, // log2(w), for the row stride
    px: Vec<f32>, // 3 floats per texel
}

pub fn texNew(size: i64, shift: i64): Texture {
    return Texture {
        w: size,
        h: size,
        mask: size - 1,
        shift: shift,
        px: Vec.filled(size * size * 3, 0.0),
    }
}

pub fn texSet(t: &mut Texture, x: i64, y: i64, r: f64, g: f64, b: f64) {
    let i = ((y << t.shift) + x) * 3
    t.px[i] = r as f32
    t.px[i + 1] = g as f32
    t.px[i + 2] = b as f32
}

// Perspective-correct textured triangle. The extra work over the flat path is
// interpolating u/z and v/z alongside 1/z and dividing per pixel — which is what
// "perspective-correct" means: interpolating u,v directly in screen space slides
// the texture around as the surface tilts away.
// A vertex: position, texture coordinate, and its own light term. Passing these
// as 25 loose f64 parameters was a standing invitation to transpose two of them —
// which happened three times while this file was being written. A struct costs
// nothing at runtime (same registers, no indirection) and makes the mistake
// unrepresentable. A map keyed by name would also fix it, and would put a hash
// lookup in the innermost loop of the program.
pub struct Vtx {
    x: f64,
    y: f64,
    z: f64,
    u: f64,
    v: f64,
    light: f64,
    // Per-vertex tint, multiplied with the triangle's base colour. Terrain needs
    // this: with one colour per quad, any surface whose colour varies with height
    // or slope draws its own tile grid, because neighbouring quads snap to
    // different values along an edge they share.
    r: f64,
    g: f64,
    b: f64,
    // How much of the detail texture to apply, 0..1. Terrain and water share one
    // draw call per quad, and the ground grain painted over water is the single
    // loudest cue that a surface is NOT water — static speckle cannot be moving
    // liquid. Fading it out per vertex keeps the shoreline seamless, which a
    // per-quad "is this a water tile" choice could not.
    tw: f64,
}

pub fn vtx(x: f64, y: f64, z: f64, u: f64, v: f64, light: f64): Vtx {
    return Vtx {
        x: x, y: y, z: z, u: u, v: v, light: light, r: 1.0, g: 1.0, b: 1.0, tw: 1.0
    }
}

pub fn vtxC(x: f64, y: f64, z: f64, u: f64, v: f64, light: f64, r: f64, g: f64, b: f64, tw: f64): Vtx {
    return Vtx {
        x: x, y: y, z: z, u: u, v: v, light: light, r: r, g: g, b: b, tw: tw
    }
}

// Perspective-correct textured triangle in CAMERA space. u/z, v/z and the light
// term interpolate linearly in screen space; dividing by the interpolated 1/z at
// each pixel recovers the true value. That division is what "perspective-correct"
// buys — interpolating u,v directly makes the texture slide as a surface tilts.
fn rasterCamTex(c: &mut Canvas, s: &mut Scene, view: &View, t: &Texture, a: &Vtx, b: &Vtx, d: &Vtx, tr: f64, tg: f64, tb: f64) {
    let iaz = 1.0 / a.z
    let ibz = 1.0 / b.z
    let icz = 1.0 / d.z
    let x0 = view.cx + a.x * view.scale * iaz
    let y0 = view.cy - a.y * view.scale * iaz
    let x1 = view.cx + b.x * view.scale * ibz
    let y1 = view.cy - b.y * view.scale * ibz
    let x2 = view.cx + d.x * view.scale * icz
    let y2 = view.cy - d.y * view.scale * icz

    let area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
    if area <= 0.0 {
        return
    }
    var minX = Math.floor(Math.minF64(x0, Math.minF64(x1, x2))) as i64
    var maxX = Math.ceil(Math.maxF64(x0, Math.maxF64(x1, x2))) as i64
    var minY = Math.floor(Math.minF64(y0, Math.minF64(y1, y2))) as i64
    var maxY = Math.ceil(Math.maxF64(y0, Math.maxF64(y1, y2))) as i64
    if minX < 0 {
        minX = 0
    }
    if minY < 0 {
        minY = 0
    }
    if maxX > s.w {
        maxX = s.w
    }
    if maxY > s.h {
        maxY = s.h
    }
    if minX >= maxX || minY >= maxY {
        return
    }
    s.tris = s.tris + 1
    let invArea = 1.0 / area
    let au = a.u * iaz
    let av = a.v * iaz
    let bu = b.u * ibz
    let bv = b.v * ibz
    let du = d.u * icz
    let dv = d.v * icz

    var py = minY
    while py < maxY {
        let fy = (py as f64) + 0.5
        var px = minX
        while px < maxX {
            let fx = (px as f64) + 0.5
            let w0 = (x2 - x1) * (fy - y1) - (y2 - y1) * (fx - x1)
            if w0 < 0.0 {
                px = px + 1
                continue
            }
            let w1 = (x0 - x2) * (fy - y2) - (y0 - y2) * (fx - x2)
            if w1 < 0.0 {
                px = px + 1
                continue
            }
            let w2 = (x1 - x0) * (fy - y0) - (y1 - y0) * (fx - x0)
            if w2 < 0.0 {
                px = px + 1
                continue
            }
            let l0 = w0 * invArea
            let l1 = w1 * invArea
            let l2 = w2 * invArea
            let invZ = l0 * iaz + l1 * ibz + l2 * icz
            let idx = py * s.w + px
            if (s.zbuf[idx] as f64) < invZ {
                s.zbuf[idx] = invZ as f32
                let zz = 1.0 / invZ
                let uu = (l0 * au + l1 * bu + l2 * du) * zz
                let vv = (l0 * av + l1 * bv + l2 * dv) * zz
                // Smooth shading: the light term is per vertex and interpolated,
                // so a curved surface stops looking like a stack of flat facets.
                let sh = l0 * a.light + l1 * b.light + l2 * d.light
                let vr = l0 * a.r + l1 * b.r + l2 * d.r
                let vg = l0 * a.g + l1 * b.g + l2 * d.g
                let vb = l0 * a.b + l1 * b.b + l2 * d.b
                var tx2 = ((uu * (t.w as f64)) as i64) & t.mask
                var ty2 = ((vv * (t.h as f64)) as i64) & t.mask
                if tx2 < 0 {
                    tx2 = 0
                }
                if ty2 < 0 {
                    ty2 = 0
                }
                let ti = ((ty2 << t.shift) + tx2) * 3
                // texel faded toward 1 (no-op) where tw is low
                let tw = l0 * a.tw + l1 * b.tw + l2 * d.tw
                var f = (zz - s.fogStart) / (s.fogEnd - s.fogStart)
                if f < 0.0 {
                    f = 0.0
                }
                if f > 1.0 {
                    f = 1.0
                }
                let o = idx * 3
                let rr = tr * vr * sh * (1.0 + ((t.px[ti] as f64) - 1.0) * tw)
                let gg = tg * vg * sh * (1.0 + ((t.px[ti + 1] as f64) - 1.0) * tw)
                let bb = tb * vb * sh * (1.0 + ((t.px[ti + 2] as f64) - 1.0) * tw)
                c.hdr[o] = (rr * (1.0 - f) + s.fogR * f) as f32
                c.hdr[o + 1] = (gg * (1.0 - f) + s.fogG * f) as f32
                c.hdr[o + 2] = (bb * (1.0 - f) + s.fogB * f) as f32
            }
            px = px + 1
        }
        py = py + 1
    }
}

// World-space textured triangle, near-clipped. The clip carries every vertex
// attribute by the same parameter, which a struct makes automatic.
pub fn triangleV(c: &mut Canvas, s: &mut Scene, view: &View, t: &Texture, wa: &Vtx, wb: &Vtx, wd: &Vtx, tr: f64, tg: f64, tb: f64) {
    let ca = toCamera(view, wa.x, wa.y, wa.z)
    let cb = toCamera(view, wb.x, wb.y, wb.z)
    let cd = toCamera(view, wd.x, wd.y, wd.z)
    let a = vtxC(ca.x, ca.y, ca.z, wa.u, wa.v, wa.light, wa.r, wa.g, wa.b, wa.tw)
    let b = vtxC(cb.x, cb.y, cb.z, wb.u, wb.v, wb.light, wb.r, wb.g, wb.b, wb.tw)
    let d = vtxC(cd.x, cd.y, cd.z, wd.u, wd.v, wd.light, wd.r, wd.g, wd.b, wd.tw)
    if a.z > view.near && b.z > view.near && d.z > view.near {
        rasterCamTex(c, s, view, t, a, b, d, tr, tg, tb)
        return
    }
    if a.z <= view.near && b.z <= view.near && d.z <= view.near {
        return
    }
    var poly: Vec<Vtx> = Vec.new()
    clipV(poly, a, b, view.near)
    clipV(poly, b, d, view.near)
    clipV(poly, d, a, view.near)
    if poly.len < 3 {
        return
    }
    for i in 1..poly.len - 1 {
        rasterCamTex(c, s, view, t, poly[0], poly[i], poly[i + 1], tr, tg, tb)
    }
}

fn clipV(out: &mut Vec<Vtx>, a: &Vtx, b: &Vtx, near: f64) {
    let ina = a.z > near
    let inb = b.z > near
    if ina {
        out.push(vtxC(a.x, a.y, a.z, a.u, a.v, a.light, a.r, a.g, a.b, a.tw))
    }
    if ina != inb {
        let t = (near - a.z) / (b.z - a.z)
        out.push(vtxC(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, near, a.u + (b.u - a.u) * t, a.v + (b.v - a.v) * t, a.light + (b.light - a.light) * t, a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, a.tw + (b.tw - a.tw) * t))
    }
}

// Gouraud-shaded, untextured triangle in CAMERA space. Same interpolation as the
// textured path minus the texel fetch: distant terrain is most of the triangle
// count, and it does not need a texture, but it does need the per-vertex colour —
// without it the far field is a checkerboard of flat quads.
fn rasterCamG(c: &mut Canvas, s: &mut Scene, v: &View, a: &Vtx, b: &Vtx, d: &Vtx, tr: f64, tg: f64, tb: f64) {
    let iaz = 1.0 / a.z
    let ibz = 1.0 / b.z
    let icz = 1.0 / d.z
    let x0 = v.cx + a.x * v.scale * iaz
    let y0 = v.cy - a.y * v.scale * iaz
    let x1 = v.cx + b.x * v.scale * ibz
    let y1 = v.cy - b.y * v.scale * ibz
    let x2 = v.cx + d.x * v.scale * icz
    let y2 = v.cy - d.y * v.scale * icz

    let area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
    if area <= 0.0 {
        return
    }
    var minX = Math.floor(Math.minF64(x0, Math.minF64(x1, x2))) as i64
    var maxX = Math.ceil(Math.maxF64(x0, Math.maxF64(x1, x2))) as i64
    var minY = Math.floor(Math.minF64(y0, Math.minF64(y1, y2))) as i64
    var maxY = Math.ceil(Math.maxF64(y0, Math.maxF64(y1, y2))) as i64
    if minX < 0 {
        minX = 0
    }
    if minY < 0 {
        minY = 0
    }
    if maxX > s.w {
        maxX = s.w
    }
    if maxY > s.h {
        maxY = s.h
    }
    if minX >= maxX || minY >= maxY {
        return
    }
    s.tris = s.tris + 1
    let invArea = 1.0 / area
    // colour already folded with the vertex light, so the inner loop is 3 lerps
    let ar = a.r * a.light * tr
    let ag = a.g * a.light * tg
    let ab = a.b * a.light * tb
    let br = b.r * b.light * tr
    let bg = b.g * b.light * tg
    let bb2 = b.b * b.light * tb
    let dr = d.r * d.light * tr
    let dg = d.g * d.light * tg
    let db = d.b * d.light * tb

    var py = minY
    while py < maxY {
        let fy = (py as f64) + 0.5
        var px = minX
        while px < maxX {
            let fx = (px as f64) + 0.5
            let w0 = (x2 - x1) * (fy - y1) - (y2 - y1) * (fx - x1)
            if w0 < 0.0 {
                px = px + 1
                continue
            }
            let w1 = (x0 - x2) * (fy - y2) - (y0 - y2) * (fx - x2)
            if w1 < 0.0 {
                px = px + 1
                continue
            }
            let w2 = (x1 - x0) * (fy - y0) - (y1 - y0) * (fx - x0)
            if w2 < 0.0 {
                px = px + 1
                continue
            }
            let l0 = w0 * invArea
            let l1 = w1 * invArea
            let l2 = w2 * invArea
            let invZ = l0 * iaz + l1 * ibz + l2 * icz
            let idx = py * s.w + px
            if (s.zbuf[idx] as f64) < invZ {
                s.zbuf[idx] = invZ as f32
                let depth = 1.0 / invZ
                var f = (depth - s.fogStart) / (s.fogEnd - s.fogStart)
                if f < 0.0 {
                    f = 0.0
                }
                if f > 1.0 {
                    f = 1.0
                }
                let rr = l0 * ar + l1 * br + l2 * dr
                let gg = l0 * ag + l1 * bg + l2 * dg
                let bbv = l0 * ab + l1 * bb2 + l2 * db
                let o = idx * 3
                c.hdr[o] = (rr * (1.0 - f) + s.fogR * f) as f32
                c.hdr[o + 1] = (gg * (1.0 - f) + s.fogG * f) as f32
                c.hdr[o + 2] = (bbv * (1.0 - f) + s.fogB * f) as f32
            }
            px = px + 1
        }
        py = py + 1
    }
}

// World-space Gouraud triangle, near-clipped. u/v on the vertices are ignored.
pub fn triangleG(c: &mut Canvas, s: &mut Scene, view: &View, wa: &Vtx, wb: &Vtx, wd: &Vtx, tr: f64, tg: f64, tb: f64) {
    let ca = toCamera(view, wa.x, wa.y, wa.z)
    let cb = toCamera(view, wb.x, wb.y, wb.z)
    let cd = toCamera(view, wd.x, wd.y, wd.z)
    let a = vtxC(ca.x, ca.y, ca.z, wa.u, wa.v, wa.light, wa.r, wa.g, wa.b, wa.tw)
    let b = vtxC(cb.x, cb.y, cb.z, wb.u, wb.v, wb.light, wb.r, wb.g, wb.b, wb.tw)
    let d = vtxC(cd.x, cd.y, cd.z, wd.u, wd.v, wd.light, wd.r, wd.g, wd.b, wd.tw)
    if a.z > view.near && b.z > view.near && d.z > view.near {
        rasterCamG(c, s, view, a, b, d, tr, tg, tb)
        return
    }
    if a.z <= view.near && b.z <= view.near && d.z <= view.near {
        return
    }
    var poly: Vec<Vtx> = Vec.new()
    clipV(poly, a, b, view.near)
    clipV(poly, b, d, view.near)
    clipV(poly, d, a, view.near)
    if poly.len < 3 {
        return
    }
    for i in 1..poly.len - 1 {
        rasterCamG(c, s, view, poly[0], poly[i], poly[i + 1], tr, tg, tb)
    }
}
