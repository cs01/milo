// Every iteration builds nested objects that live only on the stack at the
// moment the outer container is created. If a collection ran between popping
// them and allocating the container, they would be freed while reachable.
var last = nil;
var i = 0;
while (i < 4000) {
  var inner = ["tag" + "-x", [i, i + 1]];
  last = [inner, {"k": [i, i, i]}, ["a", ["b", ["c"]]]];
  i = i + 1;
}
print last;
print last[0][1][1];
print last[1]["k"][2];
print last[2][1][1][0];
