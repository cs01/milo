// @expect: ok: 99
// @expect: err: -1

pub enum Outcome {
    Ok(i32),
    Err(i32),
}

pub fn main(): i32 {
    let a = Outcome.Ok(99)
    if let Outcome.Ok(v) = a {
        print("ok: ", v)
    } else {
        print("err branch")
    }

    let b = Outcome.Err(-1)
    if let Outcome.Ok(v) = b {
        print("ok branch")
    } else {
        print("err: ", -1)
    }

    return 0
}
