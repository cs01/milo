// Zero-copy iteration over a custom container: it hands out a `&[T]` view of its store
// (a non-owning fat pointer, no clone) and callers iterate or pass that view directly —
// including a slice *rvalue* straight into a call, which is now materialized by-ref.
struct IntSet {
    data: Vec<i64>
}

impl IntSet {
    fn add(self: &mut Self, x: i64): void {
        self.data.push(x)
    }
    fn view(self: &Self): &[i64] {
        return self.data[0..self.data.len]
    }
}

fn total(xs: &[i64]): i64 {
    var s = 0
    for x in xs {
        s = s + x
    }
    return s
}

fn main() {
    var set = IntSet {
        data: Vec.new()
    }
    set.add(10)
    set.add(20)
    set.add(30)

    // iterate the returned view directly (rvalue slice)
    var s = 0
    for x in set.view() {
        s = s + x
    }
    // @expect: 60
    print(s)

    // pass a returned view straight to a fn (rvalue slice arg)
    // @expect: 60
    print(total(set.view()))

    // pass a sub-slice rvalue straight to a fn
    // @expect: 50
    print(total(set.data[1..3]))
}
