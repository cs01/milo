{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "milox",
  "scopeName": "source.milox",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#builtin" },
    { "include": "#function-decl" },
    { "include": "#function-call" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.milox",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.milox",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.milox", "match": "\\\\[nt\"\\\\]" },
        { "name": "invalid.illegal.unknown-escape.milox", "match": "\\\\." }
      ]
    },
    "number": {
      "name": "constant.numeric.milox",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "keyword": {
      "patterns": [
        { "name": "keyword.control.milox", "match": "\\b(if|else|while|return)\\b" },
        { "name": "keyword.declaration.milox", "match": "\\b(var|fn)\\b" },
        { "name": "keyword.other.print.milox", "match": "\\bprint\\b" },
        { "name": "keyword.operator.logical.milox", "match": "\\b(and|or)\\b" }
      ]
    },
    "constant": {
      "name": "constant.language.milox",
      "match": "\\b(true|false|nil)\\b"
    },
    "builtin": {
      "name": "support.function.builtin.milox",
      "match": "\\b(len|keys|has)\\b(?=\\s*\\()"
    },
    "function-decl": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.milox" },
        "2": { "name": "entity.name.function.milox" }
      }
    },
    "function-call": {
      "name": "entity.name.function.call.milox",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
    },
    "operator": {
      "name": "keyword.operator.milox",
      "match": "(==|!=|<=|>=|[-+*/<>=!])"
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.milox", "match": "[,;:]" },
        { "name": "punctuation.section.brackets.milox", "match": "[\\[\\]{}()]" }
      ]
    }
  }
}
