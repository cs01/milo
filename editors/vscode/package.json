{
  "name": "milo-lang",
  "displayName": "Milo Language",
  "description": "Language support for Milo — syntax highlighting, diagnostics, hover, go-to-definition, format on save",
  "publisher": "milo-language",
  "version": "0.3.0",
  "license": "MIT",
  "icon": "icon.png",
  "repository": { "type": "git", "url": "https://github.com/milo-language/milo.git", "directory": "editors/vscode" },
  "homepage": "https://milo-language.github.io/milo/",
  "bugs": { "url": "https://github.com/milo-language/milo/issues" },
  "keywords": ["milo", "systems programming", "memory safety", "llvm", "language server"],
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Formatters"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:milo"],
  "contributes": {
    "languages": [{
      "id": "milo",
      "aliases": ["Milo", "milo"],
      "extensions": [".milo"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "milo",
      "scopeName": "source.milo",
      "path": "./syntaxes/milo.tmLanguage.json"
    }],
    "commands": [
      { "command": "milo.runFile", "title": "Milo: Run Current File" },
      { "command": "milo.restartServer", "title": "Milo: Restart Language Server" }
    ],
    "configurationDefaults": {
      "[milo]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "milo-language.milo-lang"
      }
    },
    "configuration": {
      "title": "Milo",
      "properties": {
        "milo.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `milo` executable. Leave empty to search `~/.local/bin`, `~/.milo/bin`, Homebrew, `/usr/local/bin`, then `PATH`."
        },
        "milo.compilerRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "Dev-only fallback: absolute path to a Milo compiler checkout (the dir containing `src/main.ts`), run via `bun`. Only consulted when no `milo` executable is found — set `milo.path` instead unless you're working on the compiler itself."
        },
        "milo.debug": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Verbose LSP tracing (sets `MILO_LSP_DEBUG=1`). Logs each request's params and why hover/definition returned empty. Run `Milo: Restart Language Server` after changing."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun build src/extension.ts --target=node --format=cjs --external vscode --minify --outfile out/extension.js",
    "watch": "bun build src/extension.ts --target=node --format=cjs --external vscode --outfile out/extension.js --watch",
    "package": "bunx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
