// A struct with a field moved out is not the whole value any more, so using it AS a whole
// shows the emptied field as if it were data — 'Pair { a: "", b: "two" }'. Reading a
// different field stays fine; this is only the whole-value use. Rust: E0382, borrow of
// partially moved value.
// @error: is incomplete
struct Pair {
    a: string,
    b: string,
}

fn main() {
    let p = Pair {
        a: "one", b: "two"
    }
    let x = p.a
    print(x)
    print(p.b)
    print(p)
}
