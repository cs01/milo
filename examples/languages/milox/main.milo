// milox — a small scripting language whose entire point is its value
// representation: every runtime value is 8 bytes. See README.md.
//
// This file is only the command line. Running a program lives in runner.milo,
// the demonstrations live in demos.milo, and every milox program they use is a
// real file under scripts/.
//
// @run: demo
from "./runner" import {
    RunOptions, runSource
}
from "./demos" import {
    demoForge, demoGcBug, demoEmbed
}
from "std/argparse" import {
    ArgParser
}
from "std/fs" import {
    readFile
}

pub fn main(): i32 {
    var parser = ArgParser.new("milox", "a small scripting language whose every runtime value is 8 bytes")
    parser.addOptionalPositional("target", "a .milox script to run, or a demo name")
    parser.addBool("disasm", "d", "dump bytecode before running")
    parser.addBool("stats", "s", "print instruction, allocation and GC counts")
    parser.addBool("gc-stress", "", "collect on every allocation (clox's DEBUG_STRESS_GC)")
    parser.setEpilog("demos:\n" + "  demo      a tour of the language\n" + "  dynamic   heterogeneous lists, retyped variables, functions as values\n" + "  embed     embed milox in a host program and pass values across\n" + "  gc-bug    free a reachable object on purpose, watch it get caught\n" + "  forge     forge 2M object references, watch none of them deref")
    let parsed = parser.parse()

    var opts = RunOptions {
        disasm: parsed.getBool("disasm"),
        stats: parsed.getBool("stats"),
        buggyGc: false,
        stressGc: parsed.getBool("gc-stress"),
    }

    // No target: print help rather than silently running a canned program,
    // whose output looks exactly like output from a script the user thought
    // they had passed.
    let Option.Some(target) = parsed.getString("target") else {
        print(parser.helpText())
        return 0
    }

    if target == "demo" {
        if runSource(@embedFile("scripts/demo.milox"), opts) {
            return 0
        }
        return 1
    }
    if target == "dynamic" {
        if runSource(@embedFile("scripts/dynamic.milox"), opts) {
            return 0
        }
        return 1
    }
    if target == "embed" {
        demoEmbed()
        return 0
    }
    if target == "forge" {
        demoForge()
        return 0
    }
    if target == "gc-bug" {
        // The planted bug being caught is the demo succeeding, so this always
        // exits 0.
        demoGcBug(opts)
        return 0
    }
    match readFile(target) {
        Ok(src) => {
            if runSource(src, opts) {
                return 0
            }
            return 1
        }
        Err(e) => {
            print("milox: cannot read '" + target + "'")
            print(parser.helpText())
            return 1
        }
    }
}
