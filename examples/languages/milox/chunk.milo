// milox bytecode: a flat instruction stream plus a constant pool.
//
// Operands are inline bytes following the opcode, so the compiler emits and the
// VM decodes the same layout with no separate operand table.
from "./value" import {
    Value
}

pub enum Op {
    Constant, // u16 const index -> push
    Nil,
    True,
    False,
    Pop,
    GetLocal, // u16 slot
    SetLocal, // u16 slot
    GetGlobal, // u16 name const index
    SetGlobal, // u16 name const index
    DefineGlobal, // u16 name const index
    Equal,
    Greater,
    Less,
    Add,
    Subtract,
    Multiply,
    Divide,
    Not,
    Negate,
    Print,
    Jump, // u16 forward offset
    JumpIfFalse, // u16 forward offset
    Loop, // u16 backward offset
    Call, // u8 argc
    NewList, // u16 element count (popped from stack)
    Index, // list, index -> element
    SetIndex, // list, index, value -> value
    Len,
    Return,
    // Appended at the end with the next free byte numbers: opByte/opFromByte
    // are a manual mapping precisely so a new variant cannot renumber the
    // existing ones.
    NewDict, // u16 pair count; stack holds key,value,key,value,... first pair deepest
    Keys,
    Has,
}

pub struct Chunk {
    code: Vec<u8>,
    lines: Vec<i32>,
    constants: Vec<Value>,
    // Constants that are heap objects (strings) are recorded so the collector
    // can root them: a chunk outlives every collection but its string values
    // live in the same arena as everything else.
    constantStrings: Vec<i64>,
}

impl Chunk {
    fn new(): Chunk {
        return Chunk {
            code: Vec.new(), lines: Vec.new(), constants: Vec.new(), constantStrings: Vec.new()
        }
    }
    fn writeOp(self: &mut Self, op: Op, line: i32) {
        self.code.push(opByte(op))
        self.lines.push(line)
    }
    fn writeByte(self: &mut Self, b: u8, line: i32) {
        self.code.push(b)
        self.lines.push(line)
    }
    fn writeU16(self: &mut Self, v: i64, line: i32) {
        self.code.push(((v >> 8) & 0xff) as u8)
        self.lines.push(line)
        self.code.push((v & 0xff) as u8)
        self.lines.push(line)
    }
    fn addConstant(self: &mut Self, v: Value): i64 {
        self.constants.push(v)
        return self.constants.len - 1
    }
    fn len(self: &Self): i64 {
        return self.code.len
    }
    fn lineAt(self: &Self, ip: i64): i32 {
        if ip < 0 || ip >= self.lines.len {
            return 0
        }
        return self.lines[ip]
    }
}

// Op <-> byte. A dense manual mapping rather than a cast, so adding a variant
// in the middle cannot silently renumber a serialized chunk.
pub fn opByte(op: Op): u8 {
    match op {
        Constant => {
            return 0
        }
        Nil => {
            return 1
        }
        True => {
            return 2
        }
        False => {
            return 3
        }
        Pop => {
            return 4
        }
        GetLocal => {
            return 5
        }
        SetLocal => {
            return 6
        }
        GetGlobal => {
            return 7
        }
        SetGlobal => {
            return 8
        }
        DefineGlobal => {
            return 9
        }
        Equal => {
            return 10
        }
        Greater => {
            return 11
        }
        Less => {
            return 12
        }
        Add => {
            return 13
        }
        Subtract => {
            return 14
        }
        Multiply => {
            return 15
        }
        Divide => {
            return 16
        }
        Not => {
            return 17
        }
        Negate => {
            return 18
        }
        Print => {
            return 19
        }
        Jump => {
            return 20
        }
        JumpIfFalse => {
            return 21
        }
        Loop => {
            return 22
        }
        Call => {
            return 23
        }
        NewList => {
            return 24
        }
        Index => {
            return 25
        }
        SetIndex => {
            return 26
        }
        Len => {
            return 27
        }
        Return => {
            return 28
        }
        NewDict => {
            return 29
        }
        Keys => {
            return 30
        }
        Has => {
            return 31
        }
    }
}

pub fn opName(b: u8): string {
    let names: Vec<string> = ["CONST", "NIL", "TRUE", "FALSE", "POP", "GETLOC", "SETLOC", "GETGLB", "SETGLB", "DEFGLB", "EQ", "GT", "LT", "ADD", "SUB", "MUL", "DIV", "NOT", "NEG", "PRINT", "JMP", "JMPF", "LOOP", "CALL", "NEWLIST", "INDEX", "SETINDEX", "LEN", "RET", "NEWDICT", "KEYS", "HAS"]
    let i = b as i64
    if i < 0 || i >= names.len {
        return "??"
    }
    return names[i]
}

// Byte -> Op. The VM only ever executes bytecode this compiler emitted, so an
// unrecognized byte is a compiler bug, not input validation: abort loudly
// rather than inventing a behavior for it.
pub fn opFromByte(b: u8): Op {
    match b as i64 {
        0 => {
            return Op.Constant
        }
        1 => {
            return Op.Nil
        }
        2 => {
            return Op.True
        }
        3 => {
            return Op.False
        }
        4 => {
            return Op.Pop
        }
        5 => {
            return Op.GetLocal
        }
        6 => {
            return Op.SetLocal
        }
        7 => {
            return Op.GetGlobal
        }
        8 => {
            return Op.SetGlobal
        }
        9 => {
            return Op.DefineGlobal
        }
        10 => {
            return Op.Equal
        }
        11 => {
            return Op.Greater
        }
        12 => {
            return Op.Less
        }
        13 => {
            return Op.Add
        }
        14 => {
            return Op.Subtract
        }
        15 => {
            return Op.Multiply
        }
        16 => {
            return Op.Divide
        }
        17 => {
            return Op.Not
        }
        18 => {
            return Op.Negate
        }
        19 => {
            return Op.Print
        }
        20 => {
            return Op.Jump
        }
        21 => {
            return Op.JumpIfFalse
        }
        22 => {
            return Op.Loop
        }
        23 => {
            return Op.Call
        }
        24 => {
            return Op.NewList
        }
        25 => {
            return Op.Index
        }
        26 => {
            return Op.SetIndex
        }
        27 => {
            return Op.Len
        }
        28 => {
            return Op.Return
        }
        29 => {
            return Op.NewDict
        }
        30 => {
            return Op.Keys
        }
        31 => {
            return Op.Has
        }
        _ => {
            assert(false, "milox: invalid opcode byte in generated bytecode")
            return Op.Return
        }
    }
}
