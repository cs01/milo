// Ownership-fission prototype in today's Milo, no compiler changes.
// One malloc'd f64 buffer; shatter = O(1) construction of disjoint owned
// windows; workers mutate IN PLACE on real OS threads; weld = join + verify.
// The unsafe seam is this file, exactly as the plan predicts for std/shard.
from "std/time" import {
    epochMillis
}
from "std/runtime" import {
    Promise
}
from "std/os" import {
    malloc, free
}

struct Shard {
    base: *f64,
    len: i64,
}

// Safety: shatterRaw hands out pairwise-disjoint windows and the only other
// path to the buffer (the raw base pointer) is not touched until every shard
// has been welded back via Promise.all. No two threads ever share an index.
unsafe

impl Send for Shard {
}

fn transform(s: Shard): Shard {
    unsafe {
        var i: i64 = 0
        while i < s.len {
            s.base[i] = s.base[i] * 1.0000001 + 0.5
            i = i + 1
        }
    }
    return s
}

pub fn main(): i32 {
    let n: i64 = 20000000
    let workers: i64 = 4

    unsafe {
        let raw = malloc(n * 8)
        let buf = raw as *f64
        var i: i64 = 0
        while i < n {
            buf[i] = 1.0
            i = i + 1
        }

        let t0 = epochMillis()

        // shatter: O(1) per shard, zero copies
        let chunk = n / workers
        var ps: Vec<Promise<Shard>> = Vec.new()
        for k in 0..workers {
            let lo = k * chunk
            var hi = lo + chunk
            if k == workers - 1 {
                hi = n
            }
            let s = Shard {
                base: ((buf as i64) + lo * 8) as *f64, len: hi - lo
            }
            ps.push(Promise<Shard>.blocking(move(): Shard => {
                return transform(s)
            }
            ))
        }

        // weld: join all windows, verify coverage
        let back = Promise.all(ps).await()!
        var covered: i64 = 0
        for s2 in back {
            covered = covered + s2.len
        }
        let t1 = epochMillis()
        if covered != n {
            print("weld FAILED: coverage mismatch")
            return 1
        }

        var sum: f64 = 0.0
        var j: i64 = 0
        while j < n {
            sum = sum + buf[j]
            j = j + 1
        }
        print("shard ms=" + (t1 - t0).toString() + " sum=" + sum.toString())
        free(raw)
    }
    return 0
}
