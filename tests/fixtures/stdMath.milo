// @expect: 3
// @expect: 1024
// @expect: 3
// @expect: 4
// @expect: 4
// @expect: 42
// @expect: 7
// @expect: 3
// @expect: 7
// @expect: 10
// @expect: 3.14159

from "std/math" import {
    Math
}

pub fn main(): i32 {
    print(Math.sqrt(9.0).toString())
    print(Math.pow(2.0, 10.0).toString())
    print(Math.floor(3.7).toString())
    print(Math.ceil(3.2).toString())
    print(Math.round(3.5).toString())
    print(Math.abs(0.0 - 42.0).toString())
    let n = 0 as i64 - 7 as i64
    print(Math.absI64(n).toString())
    print(Math.minI64(3, 7).toString())
    print(Math.maxI64(3, 7).toString())
    print(Math.clampI64(15, 0, 10).toString())
    print(Math.pi().toString())
    return 0
}
