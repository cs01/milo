// RFC 4648 §10 base64 test vectors — the canonical conformance set.
// Standard encode (with padding), decode round-trip, and base64url (- _ , no padding).
// @expect: empty=[]
// @expect: f=Zg==
// @expect: fo=Zm8=
// @expect: foo=Zm9v
// @expect: foob=Zm9vYg==
// @expect: fooba=Zm9vYmE=
// @expect: foobar=Zm9vYmFy
// @expect: rt=foobar
// @expect: url_foob=Zm9vYg
// @expect: url_fo=Zm8

from "std/base64" import {
    Base64
}

pub fn main(): i32 {
    print("empty=[", Base64.encode(""), "]")
    print("f=", Base64.encode("f"))
    print("fo=", Base64.encode("fo"))
    print("foo=", Base64.encode("foo"))
    print("foob=", Base64.encode("foob"))
    print("fooba=", Base64.encode("fooba"))
    print("foobar=", Base64.encode("foobar"))
    print("rt=", Base64.decode("Zm9vYmFy"))
    print("url_foob=", Base64.urlEncode("foob"))
    print("url_fo=", Base64.urlEncode("fo"))
    return 0
}
