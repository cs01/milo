#!/bin/sh
# Format staged .milo files with bin/milo-fmt (built on demand by `milo fmt`).
# Enable with: git config core.hooksPath .githooks
#
# src-milo/ is no longer excluded: M1 landed (docs/self-hosting.md), so nothing is
# bisecting that history any more, and the directory has been run through fmt.
#
# tests/errors/ is excluded because those fixtures are intentionally malformed
# (they must fail the type-checker/parser). Reformatting can rewrite or delete
# the exact construct under test — e.g. the formatter strips a mid-expression
# ';' that the parser is meant to reject — silently breaking the fixture.
set -e

# 1. Format staged .milo files (skip src-milo/ and tests/errors/ per the notes above).
staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.milo' | grep -vE '^tests/errors/' || true)
if [ -n "$staged" ]; then
    # shellcheck disable=SC2086
    echo "$staged" | while IFS= read -r f; do
        [ -f "$f" ] || continue
        bun run src/main.ts fmt -w "$f" >/dev/null
        git add -- "$f"
    done
fi

# 2. Regenerate the docs/scripts.md index when a script is added, removed, or has its
# purpose line edited. tests/scriptsDoc.test.ts fails CI on a stale index, and the way
# that happens is adding a script and committing it without the doc — so fix it here
# rather than let the author find out from a red build.
if git diff --cached --name-only --diff-filter=ACMDR | grep -qE '^(scripts/|\.githooks/)'; then
    bun run scripts/gen-scripts-doc.ts >/dev/null
    git add -- docs/scripts.md
fi

# 3. Regenerate the compiler-source index when a src file is added, removed, or has its
# purpose line edited. Same reasoning as the scripts index: tests/srcDoc.test.ts fails CI
# on a stale one, and the way that happens is adding a file to src/.
if git diff --cached --name-only --diff-filter=ACMDR | grep -qE '^src/.*\.ts$'; then
    bun run scripts/gen-src-doc.ts >/dev/null
    git add -- docs/src.md
fi

# 4. Refill the corpus counts quoted in prose when the corpus changes. Same reasoning as
# above: tests/docStats.test.ts fails CI on a stale count, and the way that happens is
# adding a fixture. Counts come from `git ls-files`, so this must run AFTER staging.
if git diff --cached --name-only --diff-filter=ACMDR | grep -qE '^(tests/(fixtures|errors|runtime-errors|prove)/|std/|examples/)'; then
    bun run scripts/gen-stats.ts >/dev/null
    git add -- CLAUDE.md AGENTS.md README.md docs/testing.md docs/roadmap.md
fi

# 5. Deterministic lint + auto-fix on all staged files (scripts/lint.ts).
# Runs regardless of whether any .milo files are staged. Fixes are re-staged
# inside lint.ts; an unfixable error exits non-zero and aborts the commit.
bun run scripts/lint.ts --staged --fix
