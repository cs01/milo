// FLYBY — the world: a noise heightmap, a wandering trail of coins, and an
// arcade flight model. No fail state; you cannot crash, only skim.

from "std/math" import {
    Math
}
from "std/random" import {
    Random
}
from "./gfx3d" import {
    Camera, Scene, Vec3
}

pub let TILE: f64 = 44.0 // world units per terrain quad

pub let VIEW_TILES: i64 = 24 // radius of the drawn terrain grid

// A ring you fly THROUGH, Pilotwings-style: far easier to read at speed than a
// coin you have to touch, and it tells you which way to be pointing.
pub struct Ring {
    x: f64,
    y: f64,
    z: f64,
    face: f64, // heading the ring faces along, radians
    r: f64,
    alive: bool,
    pop: f64, // expands and fades once flown through
    side: f64, // signed distance of the aircraft last frame, for crossing detection
}

// A point on a wingtip contrail. Trails are ring buffers of world points, drawn
// as fading segments — cheap, and they make a hard bank read instantly.
pub struct Trail {
    x: f64,
    y: f64,
    z: f64,
    life: f64,
}

// A 3D spark thrown out when a ring is cleared.
pub struct Spark {
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
    life: f64,
    maxLife: f64,
    cr: f64,
    cg: f64,
    cb: f64,
}

pub struct Plane {
    x: f64,
    y: f64,
    z: f64,
    yaw: f64,
    pitch: f64,
    roll: f64,
    speed: f64,
}

pub struct World {
    plane: Plane,
    cam: Camera,
    rings: Vec<Ring>,
    sparks: Vec<Spark>,
    trailL: Vec<Trail>,
    trailR: Vec<Trail>,
    trailTick: f64,
    boosting: bool,
    afterburner: f64, // 0..1, drains while boosting and refills when you let off
    theme: i64,
    prevTheme: i64,
    themeMix: f64, // 1 → fully the previous region, 0 → fully the new one
    level: i64,
    cleared: i64, // rings cleared in total
    toNext: i64, // rings remaining before the country changes
    pathT: f64, // how far along the coin trail we have laid track
    // Trail head. Kept here rather than read off the end of `rings`, which is
    // swap-removed and so does not hold the newest ring last.
    trailX: f64,
    trailZ: f64,
    score: i64,
    combo: i64,
    comboTimer: f64,
    best: i64,
    time: f64,
    flash: f64,
    shake: f64,
    banner: f64,
    hint: f64,
}

// Smooth value noise — the same hash-based field the mining game uses, so the
// terrain is identical every run.
fn hash2(x: i64, y: i64): f64 {
    let v = Math.sin((x as f64) * 127.1 + (y as f64) * 311.7) * 43758.5453
    return v - Math.floor(v)
}

fn noise(x: f64, y: f64): f64 {
    let x0 = Math.floor(x) as i64
    let y0 = Math.floor(y) as i64
    let fx = x - (x0 as f64)
    let fy = y - (y0 as f64)
    let sx = fx * fx * (3.0 - 2.0 * fx)
    let sy = fy * fy * (3.0 - 2.0 * fy)
    let n00 = hash2(x0, y0)
    let n10 = hash2(x0 + 1, y0)
    let n01 = hash2(x0, y0 + 1)
    let n11 = hash2(x0 + 1, y0 + 1)
    let a = n00 + (n10 - n00) * sx
    let b = n01 + (n11 - n01) * sx
    return a + (b - a) * sy
}

// Three octaves: broad ranges, ridges, then a little roughness.
pub fn heightAt(x: f64, z: f64): f64 {
    let a = noise(x * 0.0032, z * 0.0032) * 210.0
    let b = noise(x * 0.0090, z * 0.0090) * 74.0
    let c = noise(x * 0.0280, z * 0.0280) * 17.0
    return a + b + c - 120.0
}

pub fn worldNew(): World {
    var w = World {
        plane: Plane {
            x: 0.0, y: 160.0, z: 0.0, yaw: 0.0, pitch: 0.0, roll: 0.0, speed: 190.0
        }
        ,
        cam: Camera {
            x: 0.0, y: 0.0, z: 0.0, yaw: 0.0, pitch: 0.0, roll: 0.0, fov: 1.15, near: 0.6, far: 1400.0
        }
        ,
        rings: Vec.new(),
        sparks: Vec.new(),
        trailL: Vec.new(),
        trailR: Vec.new(),
        trailTick: 0.0,
        boosting: false,
        afterburner: 1.0,
        theme: 0,
        prevTheme: 0,
        themeMix: 0.0,
        level: 1,
        cleared: 0,
        toNext: 10,
        pathT: 0.0,
        trailX: 0.0,
        trailZ: 0.0,
        score: 0,
        combo: 0,
        comboTimer: 0.0,
        best: 0,
        time: 0.0,
        flash: 0.0,
        shake: 0.0,
        banner: 3.0,
        hint: 8.0,
    }
    w.plane.y = heightAt(0.0, 0.0) + 150.0
    for i in 0..10 {
        layRing(w)
    }
    return w
}

// The course wanders as a slow sine in heading, so it curls through valleys and
// over ridges instead of running dead straight.
pub fn layRing(w: &mut World) {
    w.pathT = w.pathT + 1.0
    let t = w.pathT
    let heading = Math.sin(t * 0.030) * 0.9 + Math.sin(t * 0.008) * 2.0
    // Far apart: a hoop you have to line up needs room to line up in.
    let step = 300.0
    let nx = w.trailX + Math.sin(heading) * step
    let nz = w.trailZ + Math.cos(heading) * step
    w.trailX = nx
    w.trailZ = nz
    let ground = heightAt(nx, nz)
    let ride = 90.0 + 60.0 * (0.5 + 0.5 * Math.sin(t * 0.13))
    w.rings.push(Ring {
        x: nx,
        y: ground + ride,
        z: nz,
        face: heading,
        r: 62.0,
        alive: true,
        pop: 0.0,
        side: 0.0 - 1.0,
    }
    )
}

pub fn worldUpdate(w: &mut World, dt: f64, inRoll: f64, inPitch: f64, boost: bool) {
    w.time = w.time + dt
    if w.flash > 0.0 {
        w.flash = w.flash - dt * 1.8
    }
    if w.shake > 0.0 {
        w.shake = w.shake * Math.pow(0.02, dt)
    }
    if w.banner > 0.0 {
        w.banner = w.banner - dt
    }
    if w.themeMix > 0.0 {
        w.themeMix = w.themeMix - dt * 0.55
        if w.themeMix < 0.0 {
            w.themeMix = 0.0
        }
    }
    if w.hint > 0.0 && (inRoll != 0.0 || inPitch != 0.0) {
        w.hint = w.hint - dt
    }
    if w.comboTimer > 0.0 {
        w.comboTimer = w.comboTimer - dt
        if w.comboTimer <= 0.0 {
            w.combo = 0
        }
    }

    // Arcade flight: roll banks the aircraft, and a banked aircraft turns. Pitch
    // is direct. Both self-centre, so letting go levels you out.
    // Roll is rate-controlled and self-centres, so letting go rolls wings-level.
    w.plane.roll = w.plane.roll + (inRoll * 3.0 - w.plane.roll * 3.0) * dt
    w.plane.roll = Math.clampF64(w.plane.roll, 0.0 - 1.25, 1.25)
    // Pitch HOLDS where you put it, with only a weak return to level. Springing
    // back to zero the instant you let go is what made the vertical axis feel
    // wrong — you could never settle into a climb.
    w.plane.pitch = w.plane.pitch + (inPitch * 1.5 - w.plane.pitch * 0.5) * dt
    w.plane.pitch = Math.clampF64(w.plane.pitch, 0.0 - 0.85, 0.85)
    w.plane.yaw = w.plane.yaw + w.plane.roll * 1.55 * dt

    // Energy, not a constant: a dive trades height for speed and a climb trades
    // it back. Throttle shifts the whole band. This is why the number on the HUD
    // was static before — nothing was driving it but the boost key.
    // Afterburner is a budget, not a switch: it drains in about four seconds and
    // takes eight to come back, so a boost is a decision rather than a held key.
    var burning = false
    if boost && w.afterburner > 0.0 {
        burning = true
        w.afterburner = w.afterburner - dt * 0.25
        if w.afterburner < 0.0 {
            w.afterburner = 0.0
        }
    } else {
        w.afterburner = Math.minF64(1.0, w.afterburner + dt * 0.125)
    }
    w.boosting = burning
    var target = 175.0
    if burning {
        target = 320.0
    }
    w.plane.speed = w.plane.speed + (target - w.plane.speed) * Math.minF64(1.0, dt * 0.9)
    w.plane.speed = w.plane.speed - Math.sin(w.plane.pitch) * 190.0 * dt
    w.plane.speed = Math.clampF64(w.plane.speed, 95.0, 430.0)

    let cp = Math.cos(w.plane.pitch)
    w.plane.x = w.plane.x + Math.sin(w.plane.yaw) * cp * w.plane.speed * dt
    w.plane.z = w.plane.z + Math.cos(w.plane.yaw) * cp * w.plane.speed * dt
    w.plane.y = w.plane.y + Math.sin(w.plane.pitch) * w.plane.speed * dt

    // You cannot crash: the ground pushes you up and the sky pushes you down.
    let ground = heightAt(w.plane.x, w.plane.z)
    let floorY = ground + 26.0
    if w.plane.y < floorY {
        w.plane.y = w.plane.y + (floorY - w.plane.y) * Math.minF64(1.0, dt * 7.0)
        if w.plane.pitch < 0.0 {
            w.plane.pitch = w.plane.pitch * 0.85
        }
    }
    if w.plane.y > ground + 900.0 {
        w.plane.y = ground + 900.0
    }

    // chase camera, trailing and slightly above
    let backX = 0.0 - Math.sin(w.plane.yaw) * 58.0
    let backZ = 0.0 - Math.cos(w.plane.yaw) * 58.0
    w.cam.x = w.cam.x + (w.plane.x + backX - w.cam.x) * Math.minF64(1.0, dt * 6.0)
    w.cam.y = w.cam.y + (w.plane.y + 20.0 - w.cam.y) * Math.minF64(1.0, dt * 6.0)
    w.cam.z = w.cam.z + (w.plane.z + backZ - w.cam.z) * Math.minF64(1.0, dt * 6.0)
    w.cam.yaw = w.plane.yaw
    w.cam.pitch = w.plane.pitch * 0.55 - 0.06
    w.cam.roll = w.cam.roll + (w.plane.roll * 0.5 - w.cam.roll) * Math.minF64(1.0, dt * 5.0)

    updateRings(w, dt)
    updateTrails(w, dt)
}

// Ring passing: watch which side of the ring's plane the aircraft is on. When
// that flips and it happened inside the hoop, it counts. Distance-based tests
// miss at speed; a plane crossing cannot.
fn updateRings(w: &mut World, dt: f64) {
    var toLay: i64 = 0
    var i: i64 = 0
    while i < w.rings.len {
        if w.rings[i].pop > 0.0 {
            w.rings[i].pop = w.rings[i].pop - dt * 1.6
        }
        var drop = false
        if w.rings[i].alive {
            let nx = Math.sin(w.rings[i].face)
            let nz = Math.cos(w.rings[i].face)
            let dx = w.plane.x - w.rings[i].x
            let dy = w.plane.y - w.rings[i].y
            let dz = w.plane.z - w.rings[i].z
            let sideNow = dx * nx + dz * nz
            let prev = w.rings[i].side
            w.rings[i].side = sideNow
            if prev < 0.0 && sideNow >= 0.0 {
                // radial offset within the ring's plane
                let px2 = dx - nx * sideNow
                let pz2 = dz - nz * sideNow
                let rad = Math.sqrt(px2 * px2 + dy * dy + pz2 * pz2)
                if rad < w.rings[i].r {
                    clearRing(w, i)
                    toLay = toLay + 1
                }
            }
        }
        if !w.rings[i].alive && w.rings[i].pop <= 0.0 {
            drop = true
        }
        let bx = w.rings[i].x - w.plane.x
        let bz = w.rings[i].z - w.plane.z
        if bx * Math.sin(w.plane.yaw) + bz * Math.cos(w.plane.yaw) < 0.0 - 420.0 {
            if w.rings[i].alive {
                toLay = toLay + 1
                w.combo = 0
            }
            drop = true
        }
        if drop {
            let last = w.rings.len - 1
            w.rings[i] = w.rings[last]
            let _ = w.rings.pop()
        } else {
            i = i + 1
        }
    }
    for k in 0..toLay {
        layRing(w)
    }
    updateSparks(w, dt)
}

fn clearRing(w: &mut World, i: i64) {
    w.rings[i].alive = false
    w.rings[i].pop = 1.0
    w.combo = w.combo + 1
    w.comboTimer = 6.0
    w.cleared = w.cleared + 1
    w.score = w.score + 50 * Math.minI64(w.combo, 20)
    if w.score > w.best {
        w.best = w.score
    }
    w.flash = Math.maxF64(w.flash, 0.45)
    w.shake = Math.maxF64(w.shake, 4.0)
    // A burst of sparks around the hoop, thrown outward in its plane and given
    // gravity, so the reward is something you fly through rather than a number.
    let nx = Math.sin(w.rings[i].face)
    let nz = Math.cos(w.rings[i].face)
    let tx = nz
    let tz = 0.0 - nx
    for k in 0..44 {
        let a = Random.floatRange(0.0, 6.283185307179586)
        let sp = Random.floatRange(30.0, 130.0)
        let rr = w.rings[i].r
        let ox = tx * Math.cos(a) * rr
        let oy = Math.sin(a) * rr
        let oz = tz * Math.cos(a) * rr
        let life = Random.floatRange(0.5, 1.3)
        w.sparks.push(Spark {
            x: w.rings[i].x + ox,
            y: w.rings[i].y + oy,
            z: w.rings[i].z + oz,
            vx: tx * Math.cos(a) * sp + Random.floatRange(0.0 - 20.0, 20.0),
            vy: Math.sin(a) * sp + 40.0,
            vz: tz * Math.cos(a) * sp + Random.floatRange(0.0 - 20.0, 20.0),
            life: life,
            maxLife: life,
            cr: 1.7,
            cg: 1.25 + Random.floatRange(0.0, 0.4),
            cb: 0.30,
        }
        )
    }
    // every ten rings, a new stretch of country — announced beforehand and
    // crossfaded rather than snapped, so it reads as flying somewhere new
    w.toNext = w.toNext - 1
    if w.toNext <= 0 {
        w.toNext = 10
        w.level = w.level + 1
        w.prevTheme = w.theme
        w.theme = (w.theme + 1) % 4
        w.themeMix = 1.0
        w.banner = 3.4
        w.flash = 1.0
        w.shake = 9.0
    }
}

// Wingtip vortices: emitted faster the harder you are pulling, so a tight turn
// leaves a thick pair of ribbons and level flight leaves almost nothing.
fn updateTrails(w: &mut World, dt: f64) {
    var load = Math.abs(w.plane.roll) + Math.abs(w.plane.pitch) * 0.6
    if w.boosting {
        load = load + 1.6
    }
    w.trailTick = w.trailTick - dt * (6.0 + load * 26.0)
    if w.trailTick <= 0.0 {
        w.trailTick = 1.0
        let cy = Math.cos(w.plane.yaw)
        let sy = Math.sin(w.plane.yaw)
        let cp = Math.cos(w.plane.pitch)
        let sp = Math.sin(w.plane.pitch)
        let cr = Math.cos(w.plane.roll)
        let sr = Math.sin(w.plane.roll)
        let fx = sy * cp
        let fy = sp
        let fz = cy * cp
        let rx = cy * cr
        let ry = 0.0 - sr
        let rz = 0.0 - sy * cr
        let life = 0.8 + load * 0.9
        w.trailL.push(Trail {
            x: w.plane.x - fx * 4.0 - rx * 22.0, y: w.plane.y - fy * 4.0 - ry * 22.0, z: w.plane.z - fz * 4.0 - rz * 22.0, life: life
        }
        )
        w.trailR.push(Trail {
            x: w.plane.x - fx * 4.0 + rx * 22.0, y: w.plane.y - fy * 4.0 + ry * 22.0, z: w.plane.z - fz * 4.0 + rz * 22.0, life: life
        }
        )
    }
    ageTrail(w.trailL, dt)
    ageTrail(w.trailR, dt)
}

fn ageTrail(t: &mut Vec<Trail>, dt: f64) {
    var i: i64 = 0
    while i < t.len {
        t[i].life = t[i].life - dt
        if t[i].life <= 0.0 {
            // ordered removal: a trail is a path, so it cannot be swap-removed
            for k in i..t.len - 1 {
                t[k] = t[k + 1]
            }
            let _ = t.pop()
        } else {
            i = i + 1
        }
    }
}

fn updateSparks(w: &mut World, dt: f64) {
    var i: i64 = 0
    while i < w.sparks.len {
        w.sparks[i].life = w.sparks[i].life - dt
        if w.sparks[i].life <= 0.0 {
            let last = w.sparks.len - 1
            w.sparks[i] = w.sparks[last]
            let _ = w.sparks.pop()
        } else {
            w.sparks[i].vy = w.sparks[i].vy - 150.0 * dt
            let d = Math.pow(0.5, dt)
            w.sparks[i].vx = w.sparks[i].vx * d
            w.sparks[i].vz = w.sparks[i].vz * d
            w.sparks[i].x = w.sparks[i].x + w.sparks[i].vx * dt
            w.sparks[i].y = w.sparks[i].y + w.sparks[i].vy * dt
            w.sparks[i].z = w.sparks[i].z + w.sparks[i].vz * dt
            i = i + 1
        }
    }
}
