// A refused weld must not eat the buffer. This module's whole reason to exist is
// that a large Vec is never copied, so a rejection that dropped the owner would
// destroy the one thing the caller could not afford to lose over a miscount.
// Every failure path here recovers the data and finishes the job.
// @expect: refused: count, index=-1, weld: expected 4 windows, got 3
// @expect: recovered 4 windows over 8 elements
// @expect: welded after recovery: n=8 sum=28
// @expect: refused: foreign, weld: window 0 did not come from this shatter
// @expect: each owner welded its own windows: 2 2
// @expect: refused: no workers
// @expect: reclaimed undivided buffer: n=5 sum=15
// @expect: str refused: weld: window 0 did not come from this shatter
// @expect: str recovered: hello
from "std/shard" import {
    Shard, WeldReason, parallelMapWith, shatter, shatterStr
}

pub struct Env {
    seen: i64,
}

fn touch(w: Shard<i64>, e: &mut Env): Shard<i64> {
    e.seen = e.seen + 1
    return w
}

pub fn main(): i32 {
    // 1. Hand back too few windows. The rejection returns the owner and every
    //    window that WAS handed back, so the fix is to put the missing one back
    //    and weld again, not to rebuild the buffer.
    var data: Vec<i64> = Vec.new()
    for i in 0..8 {
        data.push(i)
    }
    var owner = shatter(data, 4)
    var windows = owner.windows()
    let held = windows.pop()!
    match owner.weld(windows) {
        Result.Ok(_v) => {
            print("WRONG: welded with a window missing")
        }
        Result.Err(rej) => {
            var kind = "other"
            match rej.reason {
                WeldReason.CountMismatch => {
                    kind = "count"
                }
                WeldReason.Foreign => {
                    kind = "foreign"
                }
                WeldReason.NotCovered => {
                    kind = "coverage"
                }
                WeldReason.NoWorkers => {
                    kind = "no workers"
                }
            }
            print("refused: " + kind + ", index=" + rej.index.toString() + ", " + rej.message())
            var back = rej.returned
            var again = rej.shards
            back.push(held)
            print("recovered " + back.len.toString() + " windows over " + again.len().toString() + " elements")
            let v = again.weld(back)!
            var sum: i64 = 0
            for x in v {
                sum = sum + x
            }
            print("welded after recovery: n=" + v.len.toString() + " sum=" + sum.toString())
        }
    }

    // 2. Windows from the wrong shatter. Both owners survive the mistake, so the
    //    caller can route each set to the owner it actually belongs to.
    var a: Vec<i64> = Vec.new()
    a.push(1)
    a.push(2)
    var b: Vec<i64> = Vec.new()
    b.push(3)
    b.push(4)
    var oa = shatter(a, 2)
    var ob = shatter(b, 2)
    var wa = oa.windows()
    var wb = ob.windows()
    match oa.weld(wb) {
        Result.Ok(_v) => {
            print("WRONG: welded foreign windows")
        }
        Result.Err(rej) => {
            print("refused: foreign, " + rej.message())
            var ownerA = rej.shards
            var windowsB = rej.returned
            let va = ownerA.weld(wa)!
            let vb = ob.weld(windowsB)!
            print("each owner welded its own windows: " + va.len.toString() + " " + vb.len.toString())
        }
    }

    // 3. parallelMapWith refuses before it divides anything when there is no
    //    worker to run on. The buffer was moved in, so the refusal has to bring it
    //    back: an owner that never handed a window out, which `reclaim` unwraps.
    var c: Vec<i64> = Vec.new()
    for k in 1..6 {
        c.push(k)
    }
    var noStates: Vec<Env> = Vec.new()
    match parallelMapWith(c, 4, noStates, touch) {
        Result.Ok(_m) => {
            print("WRONG: mapped with no workers")
        }
        Result.Err(rej) => {
            print("refused: no workers")
            var idle = rej.shards
            let v = idle.reclaim()!
            var sum: i64 = 0
            for x in v {
                sum = sum + x
            }
            print("reclaimed undivided buffer: n=" + v.len.toString() + " sum=" + sum.toString())
        }
    }

    // 4. The reading side loses its string on a refusal just as easily, and gets
    //    it back the same way.
    var sa = shatterStr("hello", 1)
    var sb = shatterStr("world", 1)
    let foreignStr = sb.windows(0)
    match sa.weld(foreignStr) {
        Result.Ok(_s) => {
            print("WRONG: welded a foreign string window")
        }
        Result.Err(rej) => {
            print("str refused: " + rej.message())
            var mineOwner = rej.shards
            var theirs = rej.returned
            // `sa` never handed a window out, so the recovered owner can still
            // divide its own string and weld that back.
            let mine = mineOwner.windows(0)
            print("str recovered: " + mineOwner.weld(mine)!)
            let _theirString = sb.weld(theirs)!
        }
    }
    return 0
}
