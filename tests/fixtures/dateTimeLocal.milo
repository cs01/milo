// @skip-os: win32
// this fixture declares its own POSIX externs (localtime_r, setenv); Windows
// spells them localtime_s/_putenv_s — a test-side portability limit, not a
// compiler gap.

from "std/datetime" import {
    DateTime, weekdayName
}

pub extern fn setenv(name: *u8, value: *u8, overwrite: i32): i32

pub fn main(): i32 {
    // Pin TZ so the fixture is deterministic on any machine. tzset() runs
    // inside DateTime.fromEpochLocal, so the new TZ takes effect per call.
    let _a = setenv("TZ", "UTC", 1)
    let utc = DateTime.fromEpochLocal(1705318245)
    print(utc.format())
    print(weekdayName(utc.weekday))

    // Fixed-offset zone (no DST ambiguity): UTC-5 all year.
    let _b = setenv("TZ", "EST5", 1)
    let est = DateTime.fromEpochLocal(1705318245)
    print(est.format())
    return 0
}
// @expect: 2024-01-15T11:30:45
// @expect: Monday
// @expect: 2024-01-15T06:30:45
