// Compiling and running a milox program, and the pieces of the CLI that need
// to reach into the VM. Kept apart from main.milo so the entry point is only
// argument handling and dispatch.
from "./heap" import {
    Heap
}
from "./compiler" import {
    compile
}
from "./vm" import {
    VM
}
from "./disasm" import {
    disassemble
}
from "std/time" import {
    now, since
}

pub struct RunOptions {
    disasm: bool,
    stats: bool,
    buggyGc: bool,
    stressGc: bool,
}

pub fn defaultOptions(): RunOptions {
    return RunOptions {
        disasm: false, stats: false, buggyGc: false, stressGc: false
    }
}

// Compile `src` and run it. False on a compile or runtime error, both already
// reported. This is the whole embedding recipe in eight lines: make a heap,
// compile against it, hand both to a VM, run.
pub fn runSource(src: string, opts: &RunOptions): bool {
    var heap: Heap = Heap.new()
    let result = compile(src, heap)
    if !result.ok {
        for e in result.errors {
            print(e)
        }
        return false
    }
    if opts.disasm {
        print(disassemble(result.functions, heap))
    }
    var vm: VM = VM.new(heap, result.functions)
    vm.setBuggyGc(opts.buggyGc)
    vm.setStressGc(opts.stressGc)
    let t0 = now()
    let ok = vm.run()
    let d = since(t0)
    if !ok {
        print(vm.error())
    }
    if opts.stats {
        print("--- " + d.toMillis().toString() + "ms, " + vm.stepCount().toString() + " instructions, " + vm.allocCount().toString() + " allocations, " + vm.gcCount().toString() + " collections, " + vm.liveObjects().toString() + " live objects, " + vm.danglingCaught().toString() + " dangling references caught")
    }
    return ok
}
