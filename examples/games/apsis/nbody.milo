// The integrator. This is the whole physics claim of the game.
//
// The ship feels Newtonian gravity from every body at once — no patched conics,
// no sphere-of-influence switching, no special case for "in orbit" versus "in
// transit". `accel` is four lines and it is the only force model there is.
//
// The important consequence is that PREDICTION AND FLIGHT ARE THE SAME CODE.
// `propagate` is what draws the dotted line on the map, and `advance` is what
// moves the ship; both call `rk4Step`, both use the same step-size rule, and the
// step rule is a pure function of the state. So a trajectory the player was shown is
// the trajectory they get, to the last metre, and a gravity assist works because
// the maths worked and not because an assist was scripted.

from "std/math" import {
    Math
}
from "./vec3" import {
    Vec3, v3
}
from "./ephem" import {
    Body, State, bodyState, BODY_COUNT, SUN, EARTH, MOON
}

pub struct Ship {
    pos: Vec3,
    vel: Vec3,
}

// ── sampled ephemeris ─────────────────────────────────────────────────────────
//
// Evaluating the analytic ephemeris inside the integrator is what a first cut
// does and it is far too slow: a two-year prediction at a few thousand seconds a
// step is ~50k steps, times four RK4 stages, times eight bodies — 1.6M Kepler
// solves and lunar series evaluations for ONE dotted line, redrawn every time
// the player nudges a handle.
//
// Instead every body is sampled onto a uniform grid once, and the integrator
// reads it back with a cubic Hermite. Hermite is the right interpolant here
// because the sampler already has the velocity: matching value AND slope at both
// ends makes the reconstruction C1 and drops the error to fourth order in the
// grid spacing, so a six-hour grid reproduces the Earth's position to under a
// kilometre — a thousand times finer than the underlying model's own accuracy.
pub struct Ephem {
    t0: f64,
    dt: f64,
    n: i64,
    // Flattened [sample][body], because Vec<Vec<Vec3>> costs a pointer chase per
    // read and this is read four times per body per step.
    pos: Vec<Vec3>,
    vel: Vec<Vec3>,
    mu: Vec<f64>,
    radius: Vec<f64>,
}

pub fn ephemBuild(bodies: &Vec<Body>, t0: f64, t1: f64, dt: f64): Ephem {
    let n = (Math.ceil((t1 - t0) / dt) as i64) + 2
    var pos: Vec<Vec3> = Vec.new()
    var vel: Vec<Vec3> = Vec.new()
    var mu: Vec<f64> = Vec.new()
    var radius: Vec<f64> = Vec.new()
    var b = 0
    while b < BODY_COUNT {
        mu.push(bodies[b].mu)
        radius.push(bodies[b].radius)
        b = b + 1
    }
    var i = 0
    while i < n {
        let t = t0 + (i as f64) * dt
        var j = 0
        while j < BODY_COUNT {
            let s = bodyState(bodies, j, t)
            pos.push(s.pos)
            vel.push(s.vel)
            j = j + 1
        }
        i = i + 1
    }
    return Ephem {
        t0: t0, dt: dt, n: n, pos: pos, vel: vel, mu: mu, radius: radius
    }
}

// Cubic Hermite on the bracketing pair of samples. Clamped at both ends rather
// than extrapolating: a prediction that runs off the end of the grid should
// degrade into a frozen solar system, which looks obviously wrong on screen,
// instead of into a polynomial blow-up that looks like a plausible trajectory.
pub fn ephemPos(e: &Ephem, id: i64, t: f64): Vec3 {
    let x = (t - e.t0) / e.dt
    var i = Math.floor(x) as i64
    if i < 0 {
        i = 0
    }
    if i > e.n - 2 {
        i = e.n - 2
    }
    let s = x - (i as f64)
    let k0 = i * BODY_COUNT + id
    let k1 = k0 + BODY_COUNT
    let p0 = e.pos[k0]
    let p1 = e.pos[k1]
    let m0 = e.vel[k0].scale(e.dt)
    let m1 = e.vel[k1].scale(e.dt)
    let s2 = s * s
    let s3 = s2 * s
    let h00 = 2.0 * s3 - 3.0 * s2 + 1.0
    let h10 = s3 - 2.0 * s2 + s
    let h01 = -2.0 * s3 + 3.0 * s2
    let h11 = s3 - s2
    return p0.scale(h00) + m0.scale(h10) + p1.scale(h01) + m1.scale(h11)
}

pub fn ephemVel(e: &Ephem, id: i64, t: f64): Vec3 {
    let x = (t - e.t0) / e.dt
    var i = Math.floor(x) as i64
    if i < 0 {
        i = 0
    }
    if i > e.n - 2 {
        i = e.n - 2
    }
    let s = x - (i as f64)
    let k0 = i * BODY_COUNT + id
    let k1 = k0 + BODY_COUNT
    let p0 = e.pos[k0]
    let p1 = e.pos[k1]
    let m0 = e.vel[k0].scale(e.dt)
    let m1 = e.vel[k1].scale(e.dt)
    let s2 = s * s
    let g00 = 6.0 * s2 - 6.0 * s
    let g10 = 3.0 * s2 - 4.0 * s + 1.0
    let g01 = -6.0 * s2 + 6.0 * s
    let g11 = 3.0 * s2 - 2.0 * s
    return (p0.scale(g00) + m0.scale(g10) + p1.scale(g01) + m1.scale(g11)).scale(1.0 / e.dt)
}

// ── force model ───────────────────────────────────────────────────────────────

pub fn accel(e: &Ephem, p: &Vec3, t: f64): Vec3 {
    var a = v3(0.0, 0.0, 0.0)
    var i = 0
    while i < BODY_COUNT {
        let d = ephemPos(e, i, t) - p
        let r2 = d.dot(d)
        // A ship exactly at a body's centre is unreachable in play — the surface
        // stops it first — but a prediction that clips a body would divide by
        // zero and poison the rest of the run with NaN, which draws nothing at
        // all rather than drawing the impact.
        if r2 > 1.0 {
            let r = Math.sqrt(r2)
            a = a + d.scale(e.mu[i] / (r2 * r))
        }
        i = i + 1
    }
    return a
}

// Which body dominates the ship's acceleration right now. Drives the display
// frame, the "you are orbiting X" readout, and capture detection.
pub fn dominantBody(e: &Ephem, p: &Vec3, t: f64): i64 {
    var best = SUN
    var bestA = 0.0
    var i = 0
    while i < BODY_COUNT {
        let d = ephemPos(e, i, t) - p
        let r2 = d.dot(d)
        if r2 > 1.0 {
            let a = e.mu[i] / r2
            if a > bestA {
                bestA = a
                best = i
            }
        }
        i = i + 1
    }
    return best
}

// ── step size ─────────────────────────────────────────────────────────────────

pub let STEPS_PER_ORBIT: f64 = 400.0

pub let DT_MIN: f64 = 0.25

pub let DT_MAX: f64 = 21600.0

// A pure function of position, which is what makes the whole thing reproducible:
// re-running from the same state replays the same step sequence, so the flown
// path cannot drift from the predicted one no matter what the frame rate did.
//
// The rule is "a fixed fraction of the local orbital period", taken over every
// body and minimised. Near the Earth that is seconds; in cruise it saturates at
// DT_MAX. Distance alone would not do: 400 steps per orbit is the accuracy knob,
// and the period is what converts it into a time.
//
// The period rule alone is not enough, because it only looks at where the ship
// IS. A ship crossing a planet's neighbourhood at speed can be far enough away
// at the top of a step for the period rule to allow six hours, and be through
// the planet and out the other side by the bottom of it — the well never gets
// sampled, so the encounter silently does not happen. The second term bounds how
// much of the remaining distance to a body one step may eat, which is what makes
// a fast flyby resolve instead of tunnelling.
pub let TRAVERSE_FRAC: f64 = 0.1

pub fn stepFor(e: &Ephem, p: &Vec3, v: &Vec3, t: f64): f64 {
    var dt = DT_MAX
    let tau = Math.pi() * 2.0
    var i = 0
    while i < BODY_COUNT {
        let d = ephemPos(e, i, t) - p
        let r = d.len()
        if r > 1.0 {
            let period = tau * Math.sqrt(r * r * r / e.mu[i])
            let cand = period / STEPS_PER_ORBIT
            if cand < dt {
                dt = cand
            }
            let rel = (v - ephemVel(e, i, t)).len()
            if rel > 1.0 {
                let cross = TRAVERSE_FRAC * r / rel
                if cross < dt {
                    dt = cross
                }
            }
        }
        i = i + 1
    }
    if dt < DT_MIN {
        return DT_MIN
    }
    return dt
}

// Classical RK4. Fixed step within the call; the caller picks the step.
pub fn rk4Step(e: &Ephem, s: &Ship, t: f64, h: f64): Ship {
    let k1v = accel(e, s.pos, t)
    let k2p = s.vel + k1v.scale(h * 0.5)
    let k2v = accel(e, s.pos + s.vel.scale(h * 0.5), t + h * 0.5)
    let k3p = s.vel + k2v.scale(h * 0.5)
    let k3v = accel(e, s.pos + k2p.scale(h * 0.5), t + h * 0.5)
    let k4p = s.vel + k3v.scale(h)
    let k4v = accel(e, s.pos + k3p.scale(h), t + h)
    let dp = (s.vel + k2p.scale(2.0) + k3p.scale(2.0) + k4p).scale(h / 6.0)
    let dv = (k1v + k2v.scale(2.0) + k3v.scale(2.0) + k4v).scale(h / 6.0)
    return Ship {
        pos: s.pos + dp, vel: s.vel + dv
    }
}

// ── propagation ───────────────────────────────────────────────────────────────

pub let HIT_NONE: i64 = -1

// What a prediction found, alongside the polyline it drew.
pub struct Track {
    pts: Vec<Vec3>,
    // Wall-clock time of each point, so the map can put a marker at "in 6 days"
    // and the node editor can scrub along the path.
    times: Vec<f64>,
    tEnd: f64,
    endPos: Vec3,
    endVel: Vec3,
    // Body the ship struck, or HIT_NONE. A prediction that ends in a surface is
    // a legitimate answer and the map draws it in red.
    hit: i64,
    // Closest approach to the body the caller nominated, and when.
    caDist: f64,
    caTime: f64,
    caRelSpeed: f64,
    steps: i64,
}

// Integrate from `s` at `t` for `span` seconds, recording at most `maxPts`
// points and watching `watch` for a closest approach.
//
// The recorded polyline is decimated by TURN ANGLE, not by step count and not by
// time. Steps bunch up enormously near a body (seconds each) and stretch out in
// cruise (hours each): every-Nth-step spends the whole point budget on the first
// hour above the Earth and draws the interplanetary leg as three points, while
// every-N-seconds does the opposite and cuts the corner clean through a
// periapsis. Turn angle is scale-free — it puts points exactly where the path
// bends, which is where a polyline needs them and nowhere else.
pub fn propagate(e: &Ephem, s: &Ship, t: f64, span: f64, maxPts: i64, watch: i64): Track {
    var pts: Vec<Vec3> = Vec.new()
    var times: Vec<f64> = Vec.new()
    var cur = Ship {
        pos: s.pos, vel: s.vel
    }
    var now = t
    let tEnd = t + span
    var hit = HIT_NONE
    var caDist = 1.0e30
    var caTime = t
    var caRel = 0.0
    var steps = 0
    // cos 2 degrees. Below this the polyline is smooth at any zoom the map uses.
    let turnCos = 0.99939
    var lastDir = cur.vel.norm()
    var lastRecT = t
    pts.push(cur.pos)
    times.push(now)
    while now < tEnd && steps < 2000000 {
        var h = stepFor(e, cur.pos, cur.vel, now)
        if now + h > tEnd {
            h = tEnd - now
        }
        if h <= 0.0 {
            now = tEnd
        } else {
            let next = rk4Step(e, cur, now, h)
            cur = next
            now = now + h
            steps = steps + 1
        }

        if watch >= 0 {
            let d = (ephemPos(e, watch, now) - cur.pos).len()
            if d < caDist {
                caDist = d
                caTime = now
                caRel = (cur.vel - ephemVel(e, watch, now)).len()
            }
        }

        var b = 0
        while b < BODY_COUNT {
            if (ephemPos(e, b, now) - cur.pos).len() < e.radius[b] {
                hit = b
                b = BODY_COUNT
            } else {
                b = b + 1
            }
        }

        let dir = cur.vel.norm()
        if pts.len < maxPts && (dir.dot(lastDir) < turnCos || now - lastRecT > span * 0.02) {
            pts.push(cur.pos)
            times.push(now)
            lastDir = dir
            lastRecT = now
        }
        if hit != HIT_NONE {
            now = tEnd
        }
    }
    pts.push(cur.pos)
    times.push(now)
    return Track {
        pts: pts, times: times, tEnd: now, endPos: cur.pos, endVel: cur.vel,
        hit: hit, caDist: caDist, caTime: caTime, caRelSpeed: caRel, steps: steps
    }
}

// Advance the live ship by exactly `span` seconds. Same stepper, no recording.
pub fn advance(e: &Ephem, s: &Ship, t: f64, span: f64): Ship {
    var cur = Ship {
        pos: s.pos, vel: s.vel
    }
    var now = t
    let tEnd = t + span
    var guard = 0
    while now < tEnd && guard < 2000000 {
        var h = stepFor(e, cur.pos, cur.vel, now)
        if now + h > tEnd {
            h = tEnd - now
        }
        if h <= 0.0 {
            now = tEnd
        } else {
            cur = rk4Step(e, cur, now, h)
            now = now + h
        }
        guard = guard + 1
    }
    return cur
}

// ── orbital elements of the ship, for the readouts ────────────────────────────

pub struct Orbit {
    // Relative to the body it is measured about.
    periapsis: f64, // metres from centre
    apoapsis: f64, // metres from centre; negative when the orbit is open
    ecc: f64,
    inc: f64,
    period: f64, // seconds; negative when the orbit is open
    energy: f64, // specific orbital energy, J/kg
    speed: f64,
    altitude: f64,
    closed: bool,
}

// Two-body elements about `about`. The ship's real motion is n-body, so this is
// an OSCULATING orbit — the ellipse it would follow if every other body vanished
// this instant. That is exactly the right thing to show: it answers "am I
// captured, and how high is my periapsis", which is the question the player has.
pub fn orbitAbout(e: &Ephem, s: &Ship, t: f64, about: i64): Orbit {
    let mu = e.mu[about]
    let rv = s.pos - ephemPos(e, about, t)
    let vv = s.vel - ephemVel(e, about, t)
    let r = rv.len()
    let v = vv.len()
    let energy = v * v * 0.5 - mu / r
    let hv = rv.cross(vv)
    let h = hv.len()
    // e = ((v^2 - mu/r) r - (r.v) v) / mu
    let ev = (rv.scale(v * v - mu / r) - vv.scale(rv.dot(vv))).scale(1.0 / mu)
    let ecc = ev.len()
    var inc = 0.0
    if h > 0.0 {
        inc = Math.acos(Math.clampF64(hv.z / h, -1.0, 1.0))
    }
    let closed = energy < 0.0
    var a = 0.0
    var apo = -1.0
    var period = -1.0
    if closed {
        a = -mu / (2.0 * energy)
        apo = a * (1.0 + ecc)
        period = Math.pi() * 2.0 * Math.sqrt(a * a * a / mu)
    }
    // Valid for every conic, which is why it is written from angular momentum
    // rather than from a(1-e): `a` does not exist for a parabola and flips sign
    // for a hyperbola, and an escaping ship is a normal thing to be looking at.
    let peri = h * h / mu / (1.0 + ecc)
    return Orbit {
        periapsis: peri, apoapsis: apo, ecc: ecc, inc: inc, period: period,
        energy: energy, speed: v, altitude: r - e.radius[about], closed: closed
    }
}
