// A state machine where the states ARE the values. No types, no enum, no
// dispatch table declared anywhere -- functions in a list, picked at runtime.

fn idle(fuel)    { print ["idle", fuel];  return 1; }
fn burn(fuel)    { print ["burn", fuel];  if (fuel < 3) return 2; return 1; }
fn coast(fuel)   { print ["coast", fuel]; return 2; }

var states = [idle, burn, coast];
var names  = ["idle", "burn", "coast"];

var s = 0;
var fuel = 6;
var t = 0;
while (t < 6) {
  var f = states[s];
  s = f(fuel);
  if (fuel > 0) fuel = fuel - 1;
  t = t + 1;
}
print "ended in " + names[s];
