// Mandelbrot set in milox. Every number here is an f64 stored as itself inside
// an 8-byte value; nothing is boxed on the heap except the strings.

var W = 78;
var H = 26;
var MAXI = 40;

fn shade(i) {
  if (i >= MAXI) return "@";
  if (i > 20) return "%";
  if (i > 12) return "*";
  if (i > 7)  return "+";
  if (i > 4)  return ":";
  if (i > 2)  return ".";
  return " ";
}

fn escapes(cr, ci) {
  var zr = 0;
  var zi = 0;
  var i = 0;
  while (i < MAXI) {
    var zr2 = zr * zr;
    var zi2 = zi * zi;
    if (zr2 + zi2 > 4) return i;
    zi = 2 * zr * zi + ci;
    zr = zr2 - zi2 + cr;
    i = i + 1;
  }
  return MAXI;
}

var y = 0;
while (y < H) {
  var line = "";
  var x = 0;
  while (x < W) {
    var cr = -2.2 + 3.0 * x / W;
    var ci = -1.2 + 2.4 * y / H;
    line = line + shade(escapes(cr, ci));
    x = x + 1;
  }
  print line;
  y = y + 1;
}
