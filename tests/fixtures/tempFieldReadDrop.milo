// Reading a field off a value nobody owns still has to destroy that value.
//
// `makeRes().id` materialises the returned struct into a temporary, reads the field,
// and used to walk away: the destructor never ran, for the temporary and for a struct
// literal alike. Bound values were always fine, which is why nothing caught it.
//
// It leaks no memory when the struct owns heap, because the field read moves that
// field out and the moved value is released on its own. So `leaks` and ASan are both
// clean while a user destructor is silently skipped, and counting Drop runs is the
// only thing that sees it.
// @expect: 7
// @expect: 7
// @expect: temps 2
// @expect: literal 1
// @expect: bound 2
// @expect: indexedTemp 2
var drops: i64 = 0

struct Res {
    id: i64,
}

impl Drop for Res {
    fn drop(self: &mut Self): void {
        drops = drops + 1
    }
}

fn makeRes(): Res {
    return Res {
        id: 7
    }
}

fn makeVec(): Vec<Res> {
    var v: Vec<Res> = Vec.new()
    v.push(makeRes())
    v.push(makeRes())
    return v
}

fn report(label: string): void {
    print(label + " " + drops.toString())
    drops = 0
}

fn main(): void {
    print(makeRes().id)
    print(makeRes().id)
    report("temps")

    let _n = Res {
        id: 0
    }
        .id
    report("literal")

    // a bound value is dropped by its scope, not by the field read
    if true {
        let a = makeRes()
        let b = makeRes()
        let _sum = a.id + b.id
    }
    report("bound")

    // reading a field THROUGH an indexed temporary: the container is materialised by
    // genIndexObjectPtr and registered for its caller to release, and this read path
    // was the one that never took the mark, so the container was never freed
    let _k = makeVec() [0].id
    report("indexedTemp")
}
