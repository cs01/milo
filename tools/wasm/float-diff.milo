// Differential probe for the wasm64 runtime's float formatting and parsing
// (tools/wasm/runtime.c's dtoa/strtod). Build and run this the same program
// twice — once natively, once with --target=wasm64 — and diff stdout byte for
// byte; the native binary's libc is the oracle. tools/wasm/float-diff.sh does
// exactly that.
//
// One line per value: `<ieee bits as u64> <printed text> <round-trip verdict>`,
// where the verdict is `=` if parsing the printed text back yields the
// bit-identical double, `!` if it parses to something else (a round-trip bug),
// and `n` if std's parser rejects the text (which it does for inf/nan by
// design, so `n` is expected exactly there).
//
// The bits column matters as much as the text: it proves both binaries were
// handed the same value before formatting, so a diff can only come from the
// formatter or the parser, never from the value construction drifting.

from "std/binary" import {
    Bytes
}

// xorshift64* — deterministic across targets, and built only from xor/shift so
// nothing here depends on wrapping arithmetic.
@wrapping
fn nextRand(seed: u64): u64 {
    var x = seed
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    return x
}

fn emit(v: f64) {
    let bits = Bytes.f64ToBits(v)
    let text = v.toString()
    var verdict = "n"
    match text.parseF64() {
        Option.Some(back) => {
            if Bytes.f64ToBits(back) == bits {
                verdict = "="
            } else {
                verdict = "!"
            }
        }
        Option.None => {
            verdict = "n"
        }
    }
    print(bits.toString() + " " + text + " " + verdict)
}

fn main() {
    // Hand-picked edge cases: zeros and their sign, the subnormal/normal
    // boundary, the extremes of the exponent range, the values whose shortest
    // form needs all 17 digits, and the magnitudes where %g flips notation.
    let edges: [u64; 32] = [0x0000000000000000, // +0
    0x8000000000000000, // -0
    0x0000000000000001, // smallest subnormal
    0x0000000000000002, 0x000FFFFFFFFFFFFF, // largest subnormal
    0x0010000000000000, // smallest normal
    0x0010000000000001, 0x7FEFFFFFFFFFFFFF, // DBL_MAX
    0xFFEFFFFFFFFFFFFF, // -DBL_MAX
    0x7FF0000000000000, // +inf
    0xFFF0000000000000, // -inf
    0x7FF8000000000000, // quiet NaN
    0xFFF8000000000000, // NaN, sign bit set
    0x3FF0000000000000, // 1.0
    0xBFF0000000000000, // -1.0
    0x3FB999999999999A, // 0.1
    0x3FD5555555555555, // 1/3
    0x3FD3333333333333, // 0.3
    0x3FD3333333333334, // 0.30000000000000004
    0x4059000000000000, // 100.0
    0x4341C37937E08000, // 1e16
    0x4406345785D8A000, // 1e21
    0x444B1AE4D6E2EF50, // 1e22
    0x4480F0CF064DD592, // 1e23 (not exactly representable)
    0x3E7AD7F29ABCAF48, // 1e-7
    0x419D6F3454000000, // 123456789.0
    0x419D6F34547E6B75, // 123456789.123456
    0x7FEFFFFFFFFFFFFE, 0x0008000000000000, 0x000000000000000F, 0x43F0000000000000, // 2^64
    0x4B18000000000000, // 2^54 + 2^52
    ]
    var i: i64 = 0
    while i < 32 {
        emit(Bytes.f64FromBits(edges[i]))
        i = i + 1
    }

    // Every exponent field, with a fixed mantissa: sweeps subnormals, the whole
    // normal range, and inf/nan in one pass.
    var e: u64 = 0
    while e < 2048 {
        emit(Bytes.f64FromBits((e << 52) | 0x0009A1B2C3D4E5F6))
        e = e + 1
    }

    var state: u64 = 0x9E3779B97F4A7C15

    // Uniform random bit patterns: mostly enormous or minuscule exponents, plus
    // a share of inf/nan. Catches the exponent-form paths.
    var n: i64 = 0
    while n < 2000 {
        state = nextRand(state)
        emit(Bytes.f64FromBits(state))
        n = n + 1
    }

    // Random values with the exponent confined near 1.0, i.e. the range where
    // %g stays in fixed notation and the fraction-digit path runs.
    n = 0
    while n < 2000 {
        state = nextRand(state)
        let r = state
        let exponent = (r >> 52) % 61 + 993 // unbiased exponent in [-30, 30]
        emit(Bytes.f64FromBits((exponent << 52) | (r & 0x000FFFFFFFFFFFFF)))
        n = n + 1
    }

    // Exactly-integral values and round powers of ten — the cases where a
    // digit-count bug shows up as "1e+02" instead of "100".
    var k: i64 = 0
    while k < 340 {
        var p: f64 = 1.0
        var j: i64 = 0
        while j < k {
            p = p * 10.0
            j = j + 1
        }
        emit(p)
        emit(0.0 - p)
        emit(1.0 / p)
        k = k + 1
    }
    n = 0
    while n < 1000 {
        state = nextRand(state)
        let r = (state % 1000000007) as f64
        emit(r)
        emit(r / 7.0)
        emit(r * 1024.0)
        n = n + 1
    }
}
