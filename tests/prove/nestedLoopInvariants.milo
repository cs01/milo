// @proven: 5
// @failed: 0
// @unknown: 0
// Both loops contribute establishment and preservation obligations.
pub fn nestedLoops(): i64
ensures result >= 0
{
    var x: i64 = 0
    while x < 1
    invariant
    x >= 0
    {
        var y: i64 = 0
        while y < 1
        invariant
        y >= 0
        {
            y = y + 1
        }
        x = x + 1
    }
    return x
}
