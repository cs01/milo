// @error: use of moved variable 'data'
// shatter CONSUMES the Vec. That is the whole aliasing argument: after it there is
// no binding through which the buffer can be reached except the disjoint windows,
// so nothing the workers touch can alias anything the caller still holds.
from "std/shard" import {
    shatter
}

pub fn main(): i32 {
    var data: Vec<f64> = Vec.new()
    data.push(1.0)
    var owner = shatter(data, 2)
    data.push(2.0)
    print(owner.count().toString())
    return 0
}
