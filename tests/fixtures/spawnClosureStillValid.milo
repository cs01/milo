// @expect: in-task len=34
// @expect: in-task len=34
// @expect: in-task len=34

// A closure value is `{ptr fn, ptr env}` and `fn` is a Copy type, so `Task.spawn(f)`
// hands the task a COPY and leaves the caller holding an equally valid one. Anything
// that frees the env on the task's side therefore frees memory the caller can still
// reach: making `reapTask` free it turned this program into a use-after-free, and the
// captured string's length read 34 inside the task and 5 after the join — no crash, no
// diagnostic, just a wrong answer. The env leaks instead, on purpose, until an owning
// closure is non-Copy and passing one into spawn is a move (docs/backlog.md #20).
from "std/runtime" import {
    Task
}

pub fn main(): i32 {
    var s = "heap"
    s.pushStr("-payload-long-enough-to-matter")
    let f = move(): void => {
        print("in-task len=" + s.len.toString())
    }
    let t = Task.spawn(f)
    t.join()
    // The caller's copy of the pair still points at the env the task ran from. Calling it
    // after the task has been reaped is what reads freed memory if anything freed it.
    f()
    f()
    return 0
}
