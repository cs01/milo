// @expect: error: 404

pub enum Either<T, E> {
    Ok(T),
    Err(E),
}

pub fn main(): i32 {
    let r: Either<i32, i32> = Either.Err(404)
    match r {
        Either.Ok(val) => {
            print("ok: ", val)
        }
        Either.Err(code) => {
            print("error: ", code)
        }
    }
    return 0
}
