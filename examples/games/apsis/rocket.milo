// A launch vehicle, on a pad, built out of triangles.
//
// Modelled rather than photographed, for two reasons. A photograph cannot light
// its own engine — and the engine lighting is the whole point of showing the
// vehicle at all, because it is what makes a number like "3.12 km/s" feel like
// something happening to a machine. And a model of no particular rocket carries
// no company's markings, which is a question a screenshot of a real vehicle
// would raise and this does not.
//
// Everything here is in metres in a local frame with +z up and the pad deck at
// z = 0, and it is drawn by the same rasteriser as the planets.

from "std/math" import {
    Math
}
from "./vec3" import {
    Vec3, v3
}
from "./gfx3d" import {
    Scene, View, triangleG
}
from "./raster" import {
    vtxC
}

// A 70 m two-stage vehicle: near enough to the class of thing that flies people
// somewhere, and its proportions are what make it read as a rocket at a glance.
pub let BODY_R: f64 = 1.85

pub let BODY_H: f64 = 47.0

pub let UPPER_H: f64 = 16.0

pub let CONE_H: f64 = 7.0

fn quad(s: &mut Scene, v: &View, a: &Vec3, b: &Vec3, c: &Vec3, d: &Vec3, r: f64, g: f64, bl: f64) {
    let va = vtxC(a.x, a.y, a.z, 0.0, 0.0, 1.0, r, g, bl, 0.0)
    let vb = vtxC(b.x, b.y, b.z, 0.0, 0.0, 1.0, r, g, bl, 0.0)
    let vc = vtxC(c.x, c.y, c.z, 0.0, 0.0, 1.0, r, g, bl, 0.0)
    let vd = vtxC(d.x, d.y, d.z, 0.0, 0.0, 1.0, r, g, bl, 0.0)
    // Both windings. The vehicle is a closed hull so back faces are invisible,
    // but the pad structure and the fins are single-sided sheets that have to be
    // there from underneath too.
    triangleG(s, v, va, vb, vc, 1.0, 1.0, 1.0)
    triangleG(s, v, va, vc, vd, 1.0, 1.0, 1.0)
    triangleG(s, v, va, vc, vb, 1.0, 1.0, 1.0)
    triangleG(s, v, va, vd, vc, 1.0, 1.0, 1.0)
}

// A tube between two radii, shaded by facet angle so it reads as a cylinder
// rather than as a flat band.
fn tube(s: &mut Scene, v: &View, o: &Vec3, z0: f64, z1: f64, r0: f64, r1: f64, segs: i64, lightDir: &Vec3, base: f64, k: f64) {
    var i = 0
    while i < segs {
        let a0 = Math.pi() * 2.0 * (i as f64) / (segs as f64)
        let a1 = Math.pi() * 2.0 * ((i + 1) as f64) / (segs as f64)
        let n0 = v3(Math.cos(a0), Math.sin(a0), 0.0)
        let n1 = v3(Math.cos(a1), Math.sin(a1), 0.0)
        let mid = (n0 + n1).norm()
        var lit = mid.dot(lightDir)
        if lit < 0.0 {
            lit = 0.0
        }
        let sh = base + k * lit * lit
        quad(s, v, o + v3(n0.x * r0, n0.y * r0, z0), o + v3(n1.x * r0, n1.y * r0, z0), o + v3(n1.x * r1, n1.y * r1, z1), o + v3(n0.x * r1, n0.y * r1, z1), sh, sh, sh * 1.02)
        i = i + 1
    }
}

// `scale` converts metres to render units; `up` is the local +z in render space.
pub struct Stand {
    o: Vec3, // pad deck centre, render space
    ex: Vec3, // local +x
    ey: Vec3, // local +y
    ez: Vec3, // local +z (up)
    s: f64, // metres -> render units
}

pub fn standAt(o: &Vec3, up: &Vec3, east: &Vec3, metres: f64): Stand {
    let ez = up.norm()
    var ex = east - ez.scale(ez.dot(east))
    if ex.len() < 1.0e-9 {
        ex = ez.anyPerp()
    }
    ex = ex.norm()
    return Stand {
        o: o, ex: ex, ey: ez.cross(ex).norm(), ez: ez, s: metres
    }
}

fn at(st: &Stand, x: f64, y: f64, z: f64): Vec3 {
    return st.o + st.ex.scale(x * st.s) + st.ey.scale(y * st.s) + st.ez.scale(z * st.s)
}

// The vehicle itself, with `throttle` in 0..1 lighting the engine.
pub fn drawRocket(s: &mut Scene, v: &View, st: &Stand, throttle: f64, lift: f64) {
    let lightDir = v3(0.55, 0.35, 0.0).norm()
    let o = at(st, 0.0, 0.0, lift)
    let sc = st.s
    let up = st.ez
    let _ = up

    // First stage.
    tubeLocal(s, v, st, lift, lift + BODY_H, BODY_R, BODY_R, 24, lightDir, 0.16, 0.62)
    // Interstage, slightly darker so the two stages read apart.
    tubeLocal(s, v, st, lift + BODY_H, lift + BODY_H + 2.0, BODY_R, BODY_R, 24, lightDir, 0.09, 0.30)
    // Second stage and the fairing shoulder.
    tubeLocal(s, v, st, lift + BODY_H + 2.0, lift + BODY_H + 2.0 + UPPER_H, BODY_R, BODY_R, 24, lightDir, 0.16, 0.62)
    tubeLocal(s, v, st, lift + BODY_H + 2.0 + UPPER_H, lift + BODY_H + 2.0 + UPPER_H + CONE_H, BODY_R, 0.12, 24, lightDir, 0.18, 0.66)
    // Engine bell.
    tubeLocal(s, v, st, lift - 2.6, lift, 1.35, BODY_R * 0.62, 20, lightDir, 0.05, 0.22)

    // Grid fins near the top of the first stage, four of them, as thin sheets.
    var f = 0
    while f < 4 {
        let a = Math.pi() * 0.5 * (f as f64) + 0.4
        let ca = Math.cos(a)
        let sa = Math.sin(a)
        let z0 = lift + BODY_H - 6.0
        let z1 = z0 + 3.4
        quad(s, v, at(st, ca * BODY_R, sa * BODY_R, z0), at(st, ca * (BODY_R + 2.6), sa * (BODY_R + 2.6), z0 + 0.6), at(st, ca * (BODY_R + 2.6), sa * (BODY_R + 2.6), z1), at(st, ca * BODY_R, sa * BODY_R, z1), 0.22, 0.23, 0.25)
        f = f + 1
    }

    if throttle > 0.01 {
        drawPlume(s, v, st, throttle, lift)
    }
    let _ = o
    let _ = sc
}

fn tubeLocal(s: &mut Scene, v: &View, st: &Stand, z0: f64, z1: f64, r0: f64, r1: f64, segs: i64, lightDir: &Vec3, base: f64, k: f64) {
    var i = 0
    while i < segs {
        let a0 = Math.pi() * 2.0 * (i as f64) / (segs as f64)
        let a1 = Math.pi() * 2.0 * ((i + 1) as f64) / (segs as f64)
        let mid = ((a0 + a1) * 0.5)
        var lit = Math.cos(mid) * lightDir.x + Math.sin(mid) * lightDir.y
        if lit < 0.0 {
            lit = 0.0
        }
        let sh = base + k * lit * lit
        quad(s, v, at(st, Math.cos(a0) * r0, Math.sin(a0) * r0, z0), at(st, Math.cos(a1) * r0, Math.sin(a1) * r0, z0), at(st, Math.cos(a1) * r1, Math.sin(a1) * r1, z1), at(st, Math.cos(a0) * r1, Math.sin(a0) * r1, z1), sh, sh, sh * 1.03)
        i = i + 1
    }
}

// The exhaust: a stack of widening rings, brightest at the throat and falling
// off down the plume, drawn well above 1.0 so the canvas's bloom pass turns it
// into glare rather than into a cone of flat orange.
fn drawPlume(s: &mut Scene, v: &View, st: &Stand, throttle: f64, lift: f64) {
    let len = 26.0 * throttle
    let rings = 9
    var i = 0
    while i < rings {
        let f0 = (i as f64) / (rings as f64)
        let f1 = ((i + 1) as f64) / (rings as f64)
        let z0 = lift - 2.6 - len * f0
        let z1 = lift - 2.6 - len * f1
        let r0 = 1.1 + 2.6 * f0 * f0
        let r1 = 1.1 + 2.6 * f1 * f1
        // White at the throat, through yellow, to a deep orange at the tip.
        let heat = (1.0 - f0) * (1.0 - f0)
        let rr = (0.9 + 5.5 * heat) * throttle
        let gg = (0.35 + 3.6 * heat * heat) * throttle
        let bb = (0.10 + 1.7 * heat * heat * heat) * throttle
        var k = 0
        while k < 16 {
            let a0 = Math.pi() * 2.0 * (k as f64) / 16.0
            let a1 = Math.pi() * 2.0 * ((k + 1) as f64) / 16.0
            quad(s, v, at(st, Math.cos(a0) * r0, Math.sin(a0) * r0, z0), at(st, Math.cos(a1) * r0, Math.sin(a1) * r0, z0), at(st, Math.cos(a1) * r1, Math.sin(a1) * r1, z1), at(st, Math.cos(a0) * r1, Math.sin(a0) * r1, z1), rr, gg, bb)
            k = k + 1
        }
        i = i + 1
    }
}

// The pad: a deck, four hold-down legs and a service tower. Enough structure to
// give the vehicle a scale and a place to be, and no more — the subject is the
// rocket.
pub fn drawPad(s: &mut Scene, v: &View, st: &Stand) {
    let deck = 26.0
    quad(s, v, at(st, -deck, -deck, -1.0), at(st, deck, -deck, -1.0), at(st, deck, deck, -1.0), at(st, -deck, deck, -1.0), 0.075, 0.080, 0.095)
    // Flame trench, a darker slot under the engine.
    quad(s, v, at(st, -6.0, -6.0, -0.94), at(st, 6.0, -6.0, -0.94), at(st, 6.0, 6.0, -0.94), at(st, -6.0, 6.0, -0.94), 0.02, 0.02, 0.025)

    // Service tower: a square column of struts, offset to one side.
    let tx = 13.0
    var lvl = 0
    while lvl < 16 {
        let z0 = -1.0 + (lvl as f64) * 5.0
        let z1 = z0 + 5.0
        var c = 0
        while c < 4 {
            let a = Math.pi() * 0.5 * (c as f64) + 0.785
            let dx = tx + Math.cos(a) * 3.2
            let dy = Math.sin(a) * 3.2
            quad(s, v, at(st, dx - 0.22, dy - 0.22, z0), at(st, dx + 0.22, dy + 0.22, z0), at(st, dx + 0.22, dy + 0.22, z1), at(st, dx - 0.22, dy - 0.22, z1), 0.20, 0.21, 0.23)
            c = c + 1
        }
        // One horizontal band per level, which is what makes it read as a
        // lattice rather than as four poles.
        quad(s, v, at(st, tx - 3.4, -3.4, z1 - 0.2), at(st, tx + 3.4, -3.4, z1 - 0.2), at(st, tx + 3.4, 3.4, z1 - 0.2), at(st, tx - 3.4, 3.4, z1 - 0.2), 0.15, 0.16, 0.18)
        lvl = lvl + 1
    }
}
