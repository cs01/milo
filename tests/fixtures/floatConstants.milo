// f64.NAN / f64.INF / f64.NEG_INF namespace constants and the std/math predicates.
from "std/math" import {
    Math
}

pub fn main(): i32 {
    print(Math.isNan(f64.NAN)) // NaN != NaN
    print(Math.isInf(f64.INF))
    print(Math.isInf(f64.NEG_INF))
    print(Math.isFinite(f64.INF))
    return 0
}
